// =====================================================================
// CM2 availability -- the four model cases (FM-33)
// Run in DAX Studio connected to the Power BI Desktop model (or paste each
// EVALUATE into Power BI Desktop's DAX query view). CI has no DAX engine, so
// tests/test_powerbi_cm2_truthful.py checks the measure STRUCTURE; these
// queries check the BEHAVIOUR on the real model. Run each block on its own.
//
// Data needed:
//   CASE 1 -- today's seed file (only the 3 EXAMPLE ROW template rows).
//   CASE 2 -- at least one real expense row (e.g. after PR #229 is approved).
//   CASE 3 -- an expense row whose chain does not resolve (in #229: Tnsi
//             Retail Pvt Ltd, customer 1100027).
//   CASE 4 -- expense rows for some chains but not others (#229 again).
// =====================================================================

// CASE 1 -- no expense rows (template rows must be gone, CM2 BLANK, not NSV)
// EXPECT: RowsLoaded = BLANK (0 rows), ExpenseLoaded = BLANK, CM2 = BLANK,
//         CM2Pct = BLANK, NSV = a real number.
EVALUATE
ROW (
    "RowsLoaded",    COUNTROWS ( 'PL Expense Input' ),
    "ExpenseLoaded", [Total Expense Amount Loaded],
    "NSV",           [Total Primary Article NSV],
    "CM2",           [CM2 Value],
    "CM2Pct",        [CM2 %]
)

// CASE 2 -- valid (mapped) expense rows, by month
// EXPECT: in months WITH expense, CM2 = NSV - Expense exactly;
//         in months WITHOUT expense, Expense and CM2 are BLANK (never CM2 = NSV).
EVALUATE
SUMMARIZECOLUMNS (
    'Date Table'[MonthStart],
    "NSV",     [Total Primary Article NSV],
    "Expense", [Total P&L Expense],
    "CM2",     [CM2 Value],
    "Check",   IF ( ISBLANK ( [Total P&L Expense] ),
                    IF ( ISBLANK ( [CM2 Value] ), "OK blank", "FAIL shows CM2 without expense" ),
                    IF ( [CM2 Value] = [Total Primary Article NSV] - [Total P&L Expense], "OK", "FAIL arithmetic" ) )
)
ORDER BY 'Date Table'[MonthStart]

// CASE 3 -- unmapped expense only (rows whose chain does not resolve)
// EXPECT: Unmapped > 0, Mapped = BLANK, CM2 = BLANK -- unmapped rows are
//         reported in QC but never deducted, and never turn into CM2 = NSV.
EVALUATE
CALCULATETABLE (
    ROW (
        "Unmapped", [Total P&L Expense (Unmapped)],
        "Mapped",   [Total P&L Expense],
        "CM2",      [CM2 Value]
    ),
    FILTER ( ALL ( 'PL Expense Input' ), ISBLANK ( 'PL Expense Input'[Resolved Chain] ) )
)

// CASE 4 -- one dimension member without expense while another has it
// EXPECT: chains with expense show CM2 = NSV - expense; chains without
//         expense show BLANK expense AND BLANK CM2. The Violations query
//         below must return 0.
EVALUATE
SUMMARIZECOLUMNS (
    'Fact Primary Article'[Chain],
    "NSV",          [Total Primary Article NSV],
    "ChainExpense", [Total P&L Expense (by Chain)],
    "ChainCM2",     [Chain-wise CM2],
    "ChainCM2Pct",  [Chain-wise CM2 %]
)
ORDER BY [NSV] DESC

EVALUATE
ROW (
    "Violations",
    COUNTROWS (
        FILTER (
            VALUES ( 'Fact Primary Article'[Chain] ),
            ISBLANK ( [Total P&L Expense (by Chain)] ) && NOT ISBLANK ( [Chain-wise CM2] )
        )
    )
)

// =====================================================================
// Filter-context cases (review of #233): the chain / brand / category
// expense measures must keep Month and FY filters. They used
// FILTER(ALL('PL Expense Input'), ...), which also cleared the Date Table
// filters reaching the expense table, so one month could carry every
// month's expense. Needs expense rows in at least two months (e.g. #229).
// =====================================================================

// CASE 5 -- same chain, two months: each month carries only its own expense
// EXPECT: for every Chain x Month, ChainExpense = MonthRowsExpense (the rows
//         loaded for that chain in that month); Leak = 0 on every row.
EVALUATE
FILTER (
    ADDCOLUMNS (
        SUMMARIZECOLUMNS ( 'Fact Primary Article'[Chain], 'Date Table'[MonthStart] ),
        "ChainExpense", [Total P&L Expense (by Chain)],
        "MonthRowsExpense",
            VAR _c = 'Fact Primary Article'[Chain]
            VAR _m = 'Date Table'[MonthStart]
            RETURN CALCULATE ( SUM ( 'PL Expense Input'[Expense Amount (INR Lakh)] ),
                REMOVEFILTERS (),
                'PL Expense Input'[Resolved Chain] = _c, 'PL Expense Input'[MonthStart] = _m )
    ),
    NOT ISBLANK ( [ChainExpense] ) || NOT ISBLANK ( [MonthRowsExpense] )
)

EVALUATE
ROW ( "Leak", COUNTROWS ( FILTER (
    ADDCOLUMNS (
        SUMMARIZECOLUMNS ( 'Fact Primary Article'[Chain], 'Date Table'[MonthStart] ),
        "E", [Total P&L Expense (by Chain)],
        "R", VAR _c = 'Fact Primary Article'[Chain] VAR _m = 'Date Table'[MonthStart]
             RETURN CALCULATE ( SUM ( 'PL Expense Input'[Expense Amount (INR Lakh)] ), REMOVEFILTERS (),
                 'PL Expense Input'[Resolved Chain] = _c, 'PL Expense Input'[MonthStart] = _m )
    ),
    ROUND ( COALESCE ( [E], 0 ) - COALESCE ( [R], 0 ), 4 ) <> 0 ) ) )

// CASE 6 -- FY filter does not leak another FY's expense
// EXPECT: "2026-27" (FY27) = FY27 rows only; "2025-26" (FY26) = BLANK expense
//         and BLANK CM2 while all loaded rows are FY27 (true for #229's
//         Apr-Aug 2026 load). 'Date Table'[FY Year] is from DAX/00_DateTable.dax.
EVALUATE
SUMMARIZECOLUMNS (
    'Date Table'[FY Year],
    "Expense",      [Total P&L Expense],
    "TopChainExp",  CALCULATE ( [Total P&L Expense (by Chain)], TOPN ( 1, VALUES ( 'Fact Primary Article'[Chain] ), [Total Primary Article NSV] ) ),
    "CM2",          [CM2 Value]
)

// CASE 7 -- brand and category keep the month filter too
// EXPECT: Leak = 0 for both (same check as CASE 5 on Resolved Brand / Category).
EVALUATE
ROW (
    "BrandLeak", COUNTROWS ( FILTER (
        ADDCOLUMNS ( SUMMARIZECOLUMNS ( 'Fact Primary Article'[Brand], 'Date Table'[MonthStart] ),
            "E", [Total P&L Expense (by Brand)],
            "R", VAR _b = 'Fact Primary Article'[Brand] VAR _m = 'Date Table'[MonthStart]
                 RETURN CALCULATE ( SUM ( 'PL Expense Input'[Expense Amount (INR Lakh)] ), REMOVEFILTERS (),
                     'PL Expense Input'[Resolved Brand] = _b, NOT ISBLANK ( 'PL Expense Input'[Resolved Chain] ),
                     'PL Expense Input'[MonthStart] = _m ) ),
        ROUND ( COALESCE ( [E], 0 ) - COALESCE ( [R], 0 ), 4 ) <> 0 ) ),
    "CategoryLeak", COUNTROWS ( FILTER (
        ADDCOLUMNS ( SUMMARIZECOLUMNS ( 'Fact Primary Article'[Category], 'Date Table'[MonthStart] ),
            "E", [Total P&L Expense (by Category)],
            "R", VAR _k = 'Fact Primary Article'[Category] VAR _m = 'Date Table'[MonthStart]
                 RETURN CALCULATE ( SUM ( 'PL Expense Input'[Expense Amount (INR Lakh)] ), REMOVEFILTERS (),
                     'PL Expense Input'[Resolved Category] = _k, NOT ISBLANK ( 'PL Expense Input'[Resolved Chain] ),
                     'PL Expense Input'[MonthStart] = _m ) ),
        ROUND ( COALESCE ( [E], 0 ) - COALESCE ( [R], 0 ), 4 ) <> 0 ) )
)

// CASE 8 -- no expense in the selected period still returns BLANK
// EXPECT: for a month with NSV but no expense rows, ChainExpense and ChainCM2
//         are BLANK for every chain (never the chain's NSV). Violations = 0.
EVALUATE
ROW ( "Violations", COUNTROWS ( FILTER (
    ADDCOLUMNS ( SUMMARIZECOLUMNS ( 'Fact Primary Article'[Chain], 'Date Table'[MonthStart] ),
        "E", [Total P&L Expense (by Chain)], "C", [Chain-wise CM2] ),
    ISBLANK ( [E] ) && NOT ISBLANK ( [C] ) ) ) )
