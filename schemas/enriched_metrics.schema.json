{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Enriched Metrics Schema",
  "description": "Advanced analytics metrics: elasticity, promotional elasticity, and correlation data",
  "type": "object",
  "properties": {
    "elasticity": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chain": { "type": "string" },
          "article": { "type": "string" },
          "elasticity_coefficient": { "type": "number", "minimum": -2, "maximum": 2 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "sample_size": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "promo_elasticity": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chain": { "type": "string" },
          "tier_1_elasticity": { "type": "number" },
          "tier_2_elasticity": { "type": "number" },
          "tier_3_elasticity": { "type": "number" },
          "optimal_range": { "type": "string" },
          "roi_efficiency": { "type": "number", "minimum": 0 }
        }
      }
    },
    "correlations": {
      "type": "object",
      "properties": {
        "by_chain": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "correlation": { "type": "number", "minimum": -1, "maximum": 1 },
              "anomaly_flags": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "summary": {
          "type": "object",
          "properties": {
            "optimal_depth_range": { "type": "string" },
            "avg_correlation": { "type": "number", "minimum": -1, "maximum": 1 }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "model_version": { "type": "string" },
        "confidence_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "period_covered": { "type": "string" }
      }
    }
  },
  "additionalProperties": true
}
