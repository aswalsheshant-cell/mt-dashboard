          {
            "name": "SAH %",
            "dataType": "string",
            "sourceColumn": "SAH %"
          },
          {
            "name": "Data Source Name",
            "dataType": "string",
            "sourceColumn": "Data Source Name"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "Fact Nielsen Brand Cut",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// QUERY: Fact Nielsen Brand Cut  (grain = Month x Nielsen Category x Brand; one \"(Category)\" row per month and category)",
                "// Source = RawDataFolders\\Nielsen_Brand_Cut_Monthly (copy the file from SeedData\\Nielsen\\Nielsen_Brand_Cut_Monthly)",
                "// The brand cuts of the Nielsen Cuts tab: value, value and volume share, price per ml, weighted (WD) and numeric (ND) distribution, stores,",
                "// sales per store and share among stores that stock the brand (SAH). WD, ND and SAH are percentage points (89.5 = 89.5%); shares are decimals",
                "// (0.128 = 12.8%), as in Fact Nielsen. The \"(Category)\" row carries the category value and price per ml: Is Category Row = \"Yes\".",
                "// Relate Date Table[MonthStart] -> [MonthStart]; Brand -> Nielsen Competitor Master[Brand] (not for the \"(Category)\" row).",
                "// =====================================================================",
                "let",
                "    Source = fnCombineFolder(pRootFolder & \"\\RawDataFolders\\Nielsen_Brand_Cut_Monthly\", null, {\"Month\", \"FY Year\", \"Nielsen Category\", \"Brand\", \"Is Category Row\", \"Zone\", \"Value Cr\", \"Value Share %\", \"Volume Share %\", \"Price Per Ml\", \"WD %\", \"ND %\", \"Stores\", \"Sales Per Store Rs\", \"SAH %\", \"Data Source Name\"}),",
                "    Typed = Table.TransformColumnTypes(Source, {",
                "        {\"Month\", type text}, {\"FY Year\", type text}, {\"Nielsen Category\", type text}, {\"Brand\", type text}, {\"Is Category Row\", type text}, {\"Zone\", type text},",
                "        {\"Value Cr\", type number}, {\"Value Share %\", type number}, {\"Volume Share %\", type number}, {\"Price Per Ml\", type number},",
                "        {\"WD %\", type number}, {\"ND %\", type number}, {\"Stores\", type number}, {\"Sales Per Store Rs\", type number}, {\"SAH %\", type number}, {\"Data Source Name\", type text}",
                "    }),",
                "    AddMonthStart = Table.AddColumn(Typed, \"MonthStart\", each",
                "        let",
                "            m = Text.BetweenDelimiters([Month], \"\", \"'\"),",
                "            yy = Text.AfterDelimiter([Month], \"'\"),",
                "            monthNum = Record.FieldOrDefault(",
                "                [Jan=1,Feb=2,Mar=3,Apr=4,May=5,Jun=6,Jul=7,Aug=8,Sep=9,Oct=10,Nov=11,Dec=12], m, null)",
                "        in if monthNum = null then null else #date(2000 + Number.FromText(yy), monthNum, 1),",
                "        type date)",
                "in",
                "    AddMonthStart"
              ]
            }
          }
        ]
      },
      {
        "name": "Fact Store Type",
        "columns": [
          {
            "name": "Store Key",
            "dataType": "string",
            "sourceColumn": "Store Key"
          },
          {
            "name": "Chain",
            "dataType": "string",
            "sourceColumn": "Chain"
          },
          {
            "name": "State",
            "dataType": "string",
            "sourceColumn": "State"
          },
          {
            "name": "Zone",
            "dataType": "string",
            "sourceColumn": "Zone"
          },
          {
            "name": "Store Type",
            "dataType": "string",
            "sourceColumn": "Store Type"
          },
          {
            "name": "NFL Kind",
            "dataType": "string",
            "sourceColumn": "NFL Kind"
          },
          {
            "name": "LY Months Sold",
            "dataType": "int64",
            "sourceColumn": "LY Months Sold"
          },
          {
            "name": "Growth Basis",
            "dataType": "double",
            "sourceColumn": "Growth Basis"
          },
          {
            "name": "NSV This Year Rs",
            "dataType": "double",
            "sourceColumn": "NSV This Year Rs"
          },
          {
            "name": "NSV Last Year Same Months Rs",
            "dataType": "double",
            "sourceColumn": "NSV Last Year Same Months Rs"
          },
          {
            "name": "Period",
            "dataType": "dateTime",
            "sourceColumn": "Period"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "Fact Store Type",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// QUERY: Fact Store Type  (grain = one row per store: LFL / NFL / No LY store data / Lost)",
                "// Source = SeedData\\Store_Cuts\\store_type_aug26.csv (store-level data stays in SeedData, not RawDataFolders, per the restricted-source rule; rebuild it each month with scripts/build_store_cuts.py)",
                "// LFL = sold this year and in the same months last year. NFL = no sales last year in those months. Lost = sold last year, nothing this year (State and Zone are \"Not available\").",
                "// NFL Kind: New = no sales anywhere last year; Restarted = sold last year in another month (Sep-Mar) so not a new store; \"Not NFL\" for the other types.",
                "// LY Months Sold = months (of Apr-Aug last year) the store had sales; Growth Basis = \"Enough history\" when 3 or more. Store-level growth is shown only for those stores.",
                "// \"No LY store data\" = Reliance Retail non-counter: last year came state-level only, so it is kept out of LFL. Brand Counter stores are not in this table (offtake rule).",
                "// NSV is in rupees. Relate Chain -> the chain dimension if you want chain slicers to cut it; State and Zone are text columns for direct use.",
                "// =====================================================================",
                "let",
                "    Source = Csv.Document(File.Contents(pRootFolder & \"\\SeedData\\Store_Cuts\\store_type_aug26.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {",
                "        {\"Store Key\", type text}, {\"Chain\", type text}, {\"State\", type text}, {\"Zone\", type text}, {\"Store Type\", type text}, {\"NFL Kind\", type text}, {\"LY Months Sold\", Int64.Type}, {\"Growth Basis\", type text},",
                "        {\"NSV This Year Rs\", type number}, {\"NSV Last Year Same Months Rs\", type number}, {\"Period\", type text}",
                "    })",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "Fact Pack Size",
        "columns": [
          {
            "name": "MonthStart",
            "dataType": "dateTime",
            "sourceColumn": "MonthStart"
          },
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month"
          },
          {
            "name": "FY Year",
            "dataType": "string",
            "sourceColumn": "FY Year"
          },
          {
            "name": "Category",
            "dataType": "string",
            "sourceColumn": "Category"
          },
          {
            "name": "Pack",
            "dataType": "string",
            "sourceColumn": "Pack"
          },
          {
            "name": "NSV Rs",
            "dataType": "double",
            "sourceColumn": "NSV Rs"
          },
          {
            "name": "Stores Selling",
            "dataType": "int64",
            "sourceColumn": "Stores Selling"
          },
          {
            "name": "Pack Sort",
            "dataType": "int64",
            "sourceColumn": "Pack Sort"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "Fact Pack Size",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// QUERY: Fact Pack Size  (grain = Month x Category x Pack size)",
                "// Source = SeedData\\Store_Cuts\\pack_size_monthly_fy27.csv (store-level data stays in SeedData, not RawDataFolders, per the restricted-source rule; rebuild each month with scripts/build_store_cuts.py)",
                "// Pack = net weight in g / ml as in the offtake file (\"Not stated\" when blank). Last year's store file carries no pack, so pack YoY is not possible: use MoM.",
                "// NSV is in rupees. \"Stores Selling\" is per row: do not add it up across packs or months. Relate MonthStart -> Date Table[MonthStart].",
                "// =====================================================================",
                "let",
                "    Source = Csv.Document(File.Contents(pRootFolder & \"\\SeedData\\Store_Cuts\\pack_size_monthly_fy27.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {",
                "        {\"Month\", type text}, {\"FY Year\", type text}, {\"Category\", type text}, {\"Pack\", type text}, {\"NSV Rs\", type number}, {\"Stores Selling\", type number}",
                "    }),",
                "    AddMonthStart = Table.AddColumn(Typed, \"MonthStart\", each",
                "        let",
                "            m = Text.BetweenDelimiters([Month], \"\", \"'\"),",
                "            yy = Text.AfterDelimiter([Month], \"'\"),",
                "            monthNum = Record.FieldOrDefault(",
                "                [Jan=1,Feb=2,Mar=3,Apr=4,May=5,Jun=6,Jul=7,Aug=8,Sep=9,Oct=10,Nov=11,Dec=12], m, null)",
                "        in if monthNum = null then null else #date(2000 + Number.FromText(yy), monthNum, 1),",
                "        type date),",
                "    AddPackSort = Table.AddColumn(AddMonthStart, \"Pack Sort\", each try Number.FromText([Pack]) otherwise 99999, type number)",
                "in",
                "    AddPackSort"
              ]
            }
          }
        ]
      },
      {
        "name": "Fact Sales Cuts",
        "columns": [
          {
            "name": "MonthStart",
            "dataType": "dateTime",
            "sourceColumn": "MonthStart"
          },
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month"
          },
          {
            "name": "FY Year",
            "dataType": "string",
            "sourceColumn": "FY Year"
          },
          {
            "name": "Zone",
            "dataType": "string",
            "sourceColumn": "Zone"
          },
          {
            "name": "Brand",
            "dataType": "string",
            "sourceColumn": "Brand"
          },
          {
            "name": "Category",
            "dataType": "string",
            "sourceColumn": "Category"
          },
          {
            "name": "Sub Category",
            "dataType": "string",
            "sourceColumn": "Sub Category"
          },
          {
            "name": "Store Type",
            "dataType": "string",
            "sourceColumn": "Store Type"
          },
          {
            "name": "NSV Rs",
            "dataType": "double",
            "sourceColumn": "NSV Rs"
          },
          {
            "name": "Stores Selling",
            "dataType": "int64",
            "sourceColumn": "Stores Selling"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "Fact Sales Cuts",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// QUERY: Fact Sales Cuts  (grain = Month x Zone x Brand x Sub Category x Store Type)",
                "// Source = SeedData\\Store_Cuts\\sales_cuts_fy27.csv (store-level data stays in SeedData, not RawDataFolders, per the restricted-source rule; rebuild each month with scripts/build_store_cuts.py)",
                "// FY27 offtake NSV (Brand Counter left out) split by store type: LFL, NFL New, NFL Restarted, No LY store data. Last year has no brand or sub-category",
                "// in the store file, so there is no brand / sub-category YoY here; zone growth comes from the main offtake fact. NSV is in rupees.",
                "// \"Stores Selling\" is per row: do not add it up across rows. Relate MonthStart -> Date Table[MonthStart].",
                "// =====================================================================",
                "let",
                "    Source = Csv.Document(File.Contents(pRootFolder & \"\\SeedData\\Store_Cuts\\sales_cuts_fy27.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {",
                "        {\"Month\", type text}, {\"FY Year\", type text}, {\"Zone\", type text}, {\"Brand\", type text}, {\"Category\", type text}, {\"Sub Category\", type text},",
                "        {\"Store Type\", type text}, {\"NSV Rs\", type number}, {\"Stores Selling\", type number}",
                "    }),",
                "    AddMonthStart = Table.AddColumn(Typed, \"MonthStart\", each",
                "        let",
                "            m = Text.BetweenDelimiters([Month], \"\", \"'\"),",
                "            yy = Text.AfterDelimiter([Month], \"'\"),",
                "            monthNum = Record.FieldOrDefault(",
                "                [Jan=1,Feb=2,Mar=3,Apr=4,May=5,Jun=6,Jul=7,Aug=8,Sep=9,Oct=10,Nov=11,Dec=12], m, null)",
                "        in if monthNum = null then null else #date(2000 + Number.FromText(yy), monthNum, 1),",
                "        type date)",
                "in",
                "    AddMonthStart"
              ]
            }
          }
        ]
      },
      {
        "name": "Fact Inhouse Distribution",
        "columns": [
          {
            "name": "MonthStart",
            "dataType": "dateTime",
            "sourceColumn": "MonthStart"
          },
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month"
          },
          {
            "name": "FY Year",
            "dataType": "string",
            "sourceColumn": "FY Year"
          },
          {
            "name": "Level",
            "dataType": "string",
            "sourceColumn": "Level"
          },
          {
            "name": "Name",
            "dataType": "string",
            "sourceColumn": "Name"
          },
          {
            "name": "Stores Selling",
            "dataType": "int64",
            "sourceColumn": "Stores Selling"
          },
          {
            "name": "SKUs Selling",
            "dataType": "int64",
            "sourceColumn": "SKUs Selling"
          },
          {
            "name": "SKU Listings",
            "dataType": "int64",
            "sourceColumn": "SKU Listings"
          },
          {
            "name": "Stores In Master",
            "dataType": "int64",
            "sourceColumn": "Stores In Master"
          },
          {
            "name": "NSV Rs",
            "dataType": "double",
            "sourceColumn": "NSV Rs"
          },
          {
            "name": "Basis",
            "dataType": "string",
            "sourceColumn": "Basis"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "Fact Inhouse Distribution",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// QUERY: Fact Inhouse Distribution  (grain = Month x Level x Name; Level = Total / Chain / State / Pack)",
                "// Source = SeedData\\Store_Cuts\\inhouse_distribution_fy27.csv (store-level data stays in SeedData, not RawDataFolders, per the restricted-source rule; rebuild with scripts/build_tdp_inhouse.py)",
                "// FROM OUR OFFTAKE, NOT TDP: no ACV % and no weighted distribution. Stores Selling = stores with offtake in the month; SKU Listings = distinct store x SKU pairs",
                "// (in-house distribution points); SKUs per store = listings / stores. \"Stores In Master\" is blank for Pack and where the state name does not match the master.",
                "// Filter the Level column on every visual (Total, Chain, State or Pack), because the rows of different levels must not be added together.",
                "// NSV is in rupees. Relate MonthStart -> Date Table[MonthStart]. Replace with 'Fact TDP' (query 14) when the real TDP file arrives.",
                "// =====================================================================",
                "let",
                "    Source = Csv.Document(File.Contents(pRootFolder & \"\\SeedData\\Store_Cuts\\inhouse_distribution_fy27.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {",
                "        {\"Month\", type text}, {\"FY Year\", type text}, {\"Level\", type text}, {\"Name\", type text}, {\"Stores Selling\", type number}, {\"SKUs Selling\", type number},",
                "        {\"SKU Listings\", type number}, {\"Stores In Master\", type number}, {\"NSV Rs\", type number}, {\"Basis\", type text}",
                "    }),",
                "    AddMonthStart = Table.AddColumn(Typed, \"MonthStart\", each",
                "        let",
                "            m = Text.BetweenDelimiters([Month], \"\", \"'\"),",
                "            yy = Text.AfterDelimiter([Month], \"'\"),",
                "            monthNum = Record.FieldOrDefault(",
                "                [Jan=1,Feb=2,Mar=3,Apr=4,May=5,Jun=6,Jul=7,Aug=8,Sep=9,Oct=10,Nov=11,Dec=12], m, null)",
                "        in if monthNum = null then null else #date(2000 + Number.FromText(yy), monthNum, 1),",
                "        type date)",
                "in",
                "    AddMonthStart"
              ]
            }
          }
        ]
      },
      {
        "name": "_Measures",
        "columns": [
          {
            "name": "Placeholder",
            "dataType": "string",
            "sourceColumn": "Placeholder",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "source": {
              "type": "calculated",
              "expression": [
                "ROW(\"Placeholder\", BLANK())"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Offtake NSV",
            "expression": [
              "SUM ( 'Fact Offtake Sales'[Offtake NSV] )"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Total Offtake Qty",
            "expression": [
              "SUM ( 'Fact Offtake Sales'[Offtake Qty] )",
              "// The monthly Article fact is loaded; the legacy weekly Primary Sales query is deferred.",
              "// Primary stays gross billing, including Reliance Brand Counter."
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Total Primary NSV",
            "expression": [
              "SUM ( 'Fact Primary Article'[Primary NSV] )"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Total Primary Qty",
            "expression": [
              "SUM ( 'Fact Primary Article'[Primary Qty] )"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Total MRP Sales",
            "expression": [
              "SUM ( 'Fact Offtake Sales'[MRP Sales] )",
              "",
              "// ---------- RELIANCE BRAND COUNTER (RBC) ISOLATION ----------"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Total MT NSV",
            "expression": [
              "CALCULATE (",
              "        [Total Offtake NSV],",
              "        'Chain Master'[Channel] = \"MT\"",
              "    )"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Total RBC NSV",
            "expression": [
              "CALCULATE (",
              "        [Total Offtake NSV],",
              "        'Chain Master'[Channel] = \"RBC\"",
              "    )"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "RBC % of Total",
            "expression": [
              "DIVIDE (",
              "        [Total RBC NSV],",
              "        [Total MT NSV] + [Total RBC NSV]",
              "    )"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Combined MT Total NSV",
            "expression": [
              "[Total MT NSV] + [Total RBC NSV]"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Is RBC",
            "expression": [
              "IF (",
              "        HASONEVALUE ( 'Chain Master'[Channel] ) && VALUES ( 'Chain Master'[Channel] ) = \"RBC\",",
              "        \"RBC (Brand Counter)\",",
              "        \"MT (Modern Trade)\"",
              "    )",
              "",
              "// Headline NSV used by most visuals (Offtake basis). Swap to Primary if needed."
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "NSV",
            "expression": [
              "[Total MT NSV]",
              "",
              "// ---------- INDIAN FORMAT HELPERS (display measures) ----------"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "NSV (Cr)",
            "expression": [
              "DIVIDE ( [NSV], 10000000 )"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "NSV (Lacs)",
            "expression": [
              "DIVIDE ( [NSV], 100000 )",
              "// Smart label: Cr if >= 1 Cr else Lacs"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "NSV Label",
            "expression": [
              "VAR v = [NSV]",
              "RETURN",
              "    IF (",
              "        ABS ( v ) >= 10000000,",
              "        FORMAT ( DIVIDE ( v, 10000000 ), \"0.00\" ) & \" Cr\",",
              "        FORMAT ( DIVIDE ( v, 100000 ), \"0.0\" ) & \" L\"",
              "    )",
              "",
              "// ---------- TIME INTELLIGENCE (Offtake basis) ----------"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Latest Month Sales",
            "expression": [
              "VAR _lastDate = MAX ( 'Date Table'[Date] )",
              "RETURN CALCULATE ( [NSV], 'Date Table'[Date] <= _lastDate )",
              "// In a month-grain visual [NSV] already = the selected month; the explicit",
              "// \"latest month\" KPI for cards:"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Latest Month NSV",
            "expression": [
              "VAR _lm = CALCULATE ( MAX ( 'Fact Offtake Sales'[MonthStart] ), ALL ( 'Date Table' ) )",
              "RETURN CALCULATE ( [NSV], 'Date Table'[MonthStart] = _lm )"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Previous Month NSV",
            "expression": [
              "CALCULATE ( [NSV], DATEADD ( 'Date Table'[Date], -1, MONTH ) )"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "MoM Growth %",
            "expression": [
              "VAR cur = [NSV]",
              "VAR prev = [Previous Month NSV]",
              "RETURN DIVIDE ( cur - prev, prev )"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Last Year Same Month NSV",
            "expression": [
              "CALCULATE ( [NSV], DATEADD ( 'Date Table'[Date], -12, MONTH ) )"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "YoY Growth %",
            "expression": [
              "DIVIDE ( [NSV] - [Last Year Same Month NSV], [Last Year Same Month NSV] )",
              "",
              "// ---------- ROLLING AVERAGES ----------",
              "// Averages over the months that have data: a month before the source starts is",
              "// missing, not zero, so it must not pull the average down. A month that sold 0",
              "// still counts (0 is not BLANK). tests/test_powerbi_rolling_average.py"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "L3M Average Sales",
            "expression": [
              "VAR _curMonth = MAX ( 'Date Table'[MonthStart] )",
              "RETURN",
              "    CALCULATE (",
              "        AVERAGEX ( FILTER ( VALUES ( 'Date Table'[MonthStart] ), NOT ISBLANK ( [NSV] ) ), [NSV] ),",
              "        DATESINPERIOD ( 'Date Table'[Date], EOMONTH ( _curMonth, -1 ), -3, MONTH )",
              "    )",
              "",
              "// Averages over the months that have data: a month before the source starts is",
              "// missing, not zero, so it must not pull the average down. A month that sold 0",
              "// still counts (0 is not BLANK). tests/test_powerbi_rolling_average.py"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "L6M Average Sales",
            "expression": [
              "VAR _curMonth = MAX ( 'Date Table'[MonthStart] )",
              "RETURN",
              "    CALCULATE (",
              "        AVERAGEX ( FILTER ( VALUES ( 'Date Table'[MonthStart] ), NOT ISBLANK ( [NSV] ) ), [NSV] ),",
              "        DATESINPERIOD ( 'Date Table'[Date], EOMONTH ( _curMonth, -1 ), -6, MONTH )",
              "    )"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Growth vs L3M %",
            "expression": [
              "DIVIDE ( [NSV] - [L3M Average Sales], [L3M Average Sales] )",
              "",
              "// ---------- CONTRIBUTION & RANK ----------"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Contribution %",
            "expression": [
              "DIVIDE (",
              "    [NSV],",
              "    CALCULATE ( [NSV], ALLSELECTED ( 'Chain Master'[Chain] ), ALLSELECTED ( 'Brand Master'[Brand] ),",
              "        ALLSELECTED ( 'Category Master'[Category] ) )",
              ")"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Rank by Sales",
            "expression": [
              "IF ( ISINSCOPE ( 'Chain Master'[Chain] ),",
              "    RANKX ( ALLSELECTED ( 'Chain Master'[Chain] ), [NSV],, DESC ),",
              "    RANKX ( ALLSELECTED ( 'Brand Master'[Brand] ), [NSV],, DESC )",
              ")",
              "",
              "// ---------- CHAIN CONCENTRATION & TOP MOVERS ----------"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Top 3 Concentration %",
            "expression": [
              "VAR top3Total =",
              "    SUMX (",
              "        TOPN ( 3, ALLSELECTED ( 'Chain Master'[Chain] ), [Total MT NSV], DESC ),",
              "        [Total MT NSV]",
              "    )",
              "RETURN",
              "    DIVIDE ( top3Total, [Total MT NSV] )"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Top Chain",
            "expression": [
              "CONCATENATEX (",
              "        TOPN ( 1, ALLSELECTED ( 'Chain Master'[Chain] ), [Total MT NSV], DESC ),",
              "        'Chain Master'[Chain],",
              "        \"\"",
              "    )"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Top 3 Chains",
            "expression": [
              "CONCATENATEX (",
              "        TOPN ( 3, ALLSELECTED ( 'Chain Master'[Chain] ), [Total MT NSV], DESC ),",
              "        'Chain Master'[Chain],",
              "        \", \"",
              "    )",
              "",
              "// ---------- PRIMARY vs OFFTAKE ----------"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Primary vs Offtake Gap",
            "expression": [
              "[Total Primary NSV] - [Total MT NSV]"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Primary vs Offtake Gap %",
            "expression": [
              "DIVIDE ( [Total Primary NSV] - [Total MT NSV], [Total MT NSV] )",
              "",
              "// ---------- GROWTH ARROW (for tables / cards) ----------"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "MoM Arrow",
            "expression": [
              "VAR g = [MoM Growth %]",
              "RETURN IF ( ISBLANK ( g ), \"\", IF ( g >= 0, \"▲ \", \"▼ \" ) ) & FORMAT ( g, \"0.0%\" )"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "YoY Arrow",
            "expression": [
              "VAR g = [YoY Growth %]",
              "RETURN IF ( ISBLANK ( g ), \"\", IF ( g >= 0, \"▲ \", \"▼ \" ) ) & FORMAT ( g, \"0.0%\" )",
              "",
              "// Conditional-format colour (use in \"Font color > fx > Field value\")"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Growth Colour",
            "expression": [
              "SWITCH ( TRUE (),",
              "    [MoM Growth %] > 0, \"#2D9B7F\",   // teal/green positive",
              "    [MoM Growth %] < 0, \"#C0392B\",   // red negative",
              "    \"#7F8C8D\"                        // grey neutral",
              ")",
              "",
              "// ---------- TOP / BOTTOM MOVERS (Executive Summary) ----------"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Top Growing Chain",
            "expression": [
              "VAR t = TOPN ( 1, ALLSELECTED ( 'Chain Master'[Chain] ), [MoM Growth %], DESC )",
              "RETURN CONCATENATEX ( t, 'Chain Master'[Chain], \", \" )"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Top Declining Chain",
            "expression": [
              "VAR t = TOPN ( 1, ALLSELECTED ( 'Chain Master'[Chain] ), [MoM Growth %], ASC )",
              "RETURN CONCATENATEX ( t, 'Chain Master'[Chain], \", \" )"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Top Growing Brand",
            "expression": [
              "VAR t = TOPN ( 1, ALLSELECTED ( 'Brand Master'[Brand] ), [MoM Growth %], DESC )",
              "RETURN CONCATENATEX ( t, 'Brand Master'[Brand], \", \" )"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Top Growing Category",
            "expression": [
              "VAR t = TOPN ( 1, ALLSELECTED ( 'Category Master'[Category] ), [MoM Growth %], DESC )",
              "RETURN CONCATENATEX ( t, 'Category Master'[Category], \", \" )",
              "",
              "// =====================================================================",
              "// TARGET / ACHIEVEMENT / RUN RATE",
              "// Mirrors scripts/build_dashboard_data.py targets_block() so the Power BI",
              "// report and the web dashboard state the same numbers from the same rules.",
              "// [TY Target] is defined in 03_Forecast_Measures.dax (Targets[Target NSV]).",
              "//",
              "// BASIS: the target file is NSV and does not name its measure. The Forecast",
              "// page compares it to OFFTAKE, so these default to offtake. Swap",
              "// [Total MT NSV] for [Total Primary NSV] below to move the basis --",
              "// change it in \"Actual (Basis)\" only; everything else follows.",
              "// ====================================================================="
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Actual (Basis)",
            "expression": [
              "[Total MT NSV]",
              "",
              "// ---------- PERIOD TO DATE (only months that actually have actuals) ----------",
              "// The PTD window is DERIVED from where actuals exist, so it widens on its own",
              "// as each new month lands -- no hardcoded month count to maintain."
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Last Actual Month",
            "expression": [
              "CALCULATE (",
              "        MAX ( 'Date Table'[MonthStart] ),",
              "        FILTER ( ALL ( 'Date Table' ), [Actual (Basis)] > 0 )",
              "    )"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Target PTD",
            "expression": [
              "CALCULATE (",
              "        [TY Target],",
              "        FILTER ( ALL ( 'Date Table' ), 'Date Table'[MonthStart] <= [Last Actual Month] )",
              "    )"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Actual PTD",
            "expression": [
              "CALCULATE (",
              "        [Actual (Basis)],",
              "        FILTER ( ALL ( 'Date Table' ), 'Date Table'[MonthStart] <= [Last Actual Month] )",
              "    )",
              "",
              "// ---------- ACHIEVEMENT ----------"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Achievement %",
            "expression": [
              "DIVIDE ( [Actual PTD], [Target PTD] )"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Gap to Target",
            "expression": [
              "[Actual PTD] - [Target PTD]"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Gap to Target %",
            "expression": [
              "DIVIDE ( [Gap to Target], [Target PTD] )"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Achievement Status",
            "expression": [
              "VAR _a = [Achievement %]",
              "    RETURN",
              "        SWITCH (",
              "            TRUE (),",
              "            ISBLANK ( _a ), \"No target\",",
              "            _a >= 1.00, \"Met\",",
              "            _a >= 0.90, \"Near\",",
              "            \"Missed\"",
              "        )",
              "",
              "// ---------- RUN RATE ----------"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Months Elapsed",
            "expression": [
              "CALCULATE (",
              "        DISTINCTCOUNT ( 'Date Table'[MonthStart] ),",
              "        FILTER ( ALL ( 'Date Table' ), 'Date Table'[MonthStart] <= [Last Actual Month] ),",
              "        FILTER ( ALL ( 'Date Table' ), NOT ISBLANK ( [TY Target] ) )",
              "    )"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Months In FY",
            "expression": [
              "CALCULATE ( DISTINCTCOUNT ( Targets[MonthStart] ), ALL ( 'Date Table' ) )"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Months Remaining",
            "expression": [
              "[Months In FY] - [Months Elapsed]"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Current Run Rate",
            "expression": [
              "DIVIDE ( [Actual PTD], [Months Elapsed] )",
              "",
              "// What the remaining months must average to still land the full-year target."
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Required Run Rate",
            "expression": [
              "DIVIDE (",
              "        CALCULATE ( [TY Target], ALL ( 'Date Table' ) ) - [Actual PTD],",
              "        [Months Remaining]",
              "    )"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Run Rate Status",
            "expression": [
              "VAR _req = [Required Run Rate]",
              "    VAR _cur = [Current Run Rate]",
              "    VAR _ratio = DIVIDE ( _req, _cur )",
              "    RETURN",
              "        SWITCH (",
              "            TRUE (),",
              "            _cur = 0 || ISBLANK ( _ratio ), \"No actuals\",",
              "            _ratio <= 1.00, \"Ahead\",",
              "            _ratio <= 1.05, \"On Track\",",
              "            _ratio <= 1.15, \"At Risk\",",
              "            \"Critical\"",
              "        )",
              "",
              "// ---------- LIKE-FOR-LIKE YoY ----------",
              "// A part-year FY against a full prior FY is not a YoY. Compare only the",
              "// months the current FY actually carries."
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "Actual LY Same Period",
            "expression": [
              "CALCULATE (",
              "        [Actual (Basis)],",
              "        FILTER (",
              "            ALL ( 'Date Table' ),",
              "            'Date Table'[MonthStart]",
              "                <= EDATE ( [Last Actual Month], -12 )",
              "                && 'Date Table'[FY Year]",
              "                    = CALCULATE ( MAX ( 'Date Table'[FY Year] ),",
              "                        FILTER ( ALL ( 'Date Table' ),",
              "                            'Date Table'[MonthStart] = EDATE ( [Last Actual Month], -12 ) ) )",
              "        )",
              "    )"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "YoY % (Like-for-Like)",
            "expression": [
              "DIVIDE ( [Actual PTD] - [Actual LY Same Period], [Actual LY Same Period] )"
            ],
            "description": "Source: 01_CoreMeasures.dax"
          },
          {
            "name": "_Assumption Available",
            "expression": [
              "VAR _m = SELECTEDVALUE ( 'Date Table'[Month] )",
              "RETURN",
              "    NOT ISBLANK ( _m )",
              "        && CALCULATE ( COUNTROWS ( 'Assumption Table' ),",
              "               FILTER ( ALL ( 'Assumption Table' ), 'Assumption Table'[Month] = _m ) ) > 0",
              "",
              "// Finance-facing QC status -- put this on a card in the P&L page so a",
              "// missing month is visibly flagged, not silently absorbed into \"0.0%\"."
            ],
            "description": "Source: 02_PnL_Measures.dax"
          },
          {
            "name": "Assumption Status",
            "expression": [
              "VAR _m = SELECTEDVALUE ( 'Date Table'[Month] )",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( _m ), \"NO MONTH SELECTED\",",
              "        [_Assumption Available], \"OK\",",
              "        \"ASSUMPTION_MISSING — FINANCE_INPUT_REQUIRED: \" & _m",
              "            & \" has no approved Assumption Table row. Gross Margin, Trade Spend, \"",
              "            & \"Contribution Margin and CM% for this month are BLANK, not estimated.\"",
              "    )",
              "",
              "// ---- Helper: resolve an assumption value with ALL-fallback ----",
              "// Returns the % / spend for the current Month x Chain x Brand x Category",
              "// context, preferring the most specific row, else the ALL row. Returns",
              "// BLANK() (not a hardcoded default) when the month itself has no row at",
              "// all -- MAX()/SUM() over an empty filtered table already returns BLANK(),",
              "// so removing the old COALESCE(...,default) is the entire fix here."
            ],
            "description": "Source: 02_PnL_Measures.dax"
          },
          {
            "name": "_Assumption Gross Margin %",
            "expression": [
              "VAR _m = SELECTEDVALUE ( 'Date Table'[Month] )",
              "VAR _ch = SELECTEDVALUE ( 'Chain Master'[Chain], \"ALL\" )",
              "VAR _br = SELECTEDVALUE ( 'Brand Master'[Brand], \"ALL\" )",
              "VAR _cat = SELECTEDVALUE ( 'Category Master'[Category], \"ALL\" )",
              "RETURN",
              "    CALCULATE ( MAX ( 'Assumption Table'[Gross Margin %] ),",
              "        FILTER ( ALL ( 'Assumption Table' ),",
              "            'Assumption Table'[Month] = _m",
              "            && ( 'Assumption Table'[Chain] = _ch || 'Assumption Table'[Chain] = \"ALL\" )",
              "            && ( 'Assumption Table'[Brand] = _br || 'Assumption Table'[Brand] = \"ALL\" )",
              "            && ( 'Assumption Table'[Category] = _cat || 'Assumption Table'[Category] = \"ALL\" ) ) )"
            ],
            "description": "Source: 02_PnL_Measures.dax"
          },
          {
            "name": "_Assumption Trade Spend %",
            "expression": [
              "VAR _m = SELECTEDVALUE ( 'Date Table'[Month] )",
              "RETURN",
              "    CALCULATE ( MAX ( 'Assumption Table'[Trade Spend %] ),",
              "        FILTER ( ALL ( 'Assumption Table' ), 'Assumption Table'[Month] = _m ) )"
            ],
            "description": "Source: 02_PnL_Measures.dax"
          },
          {
            "name": "_Assumption Visibility Spend",
            "expression": [
              "VAR _m = SELECTEDVALUE ( 'Date Table'[Month] )",
              "RETURN",
              "    CALCULATE ( SUM ( 'Assumption Table'[Visibility Spend] ),",
              "        FILTER ( ALL ( 'Assumption Table' ), 'Assumption Table'[Month] = _m ) )"
            ],
            "description": "Source: 02_PnL_Measures.dax"
          },
          {
            "name": "_Assumption Scheme Spend",
            "expression": [
              "VAR _m = SELECTEDVALUE ( 'Date Table'[Month] )",
              "RETURN",
              "    CALCULATE ( SUM ( 'Assumption Table'[Scheme Spend] ),",
              "        FILTER ( ALL ( 'Assumption Table' ), 'Assumption Table'[Month] = _m ) )",
              "",
              "// ---- P&L line items ----"
            ],
            "description": "Source: 02_PnL_Measures.dax"
          },
          {
            "name": "Net Sales",
            "expression": [
              "[NSV]                                   // NSV = Net Sales Value (offtake)"
            ],
            "description": "Source: 02_PnL_Measures.dax"
          },
          {
            "name": "Gross Sales",
            "expression": [
              "COALESCE ( [Total MRP Sales], DIVIDE ( [NSV], 1 - 0.0 ) )  // use MRP Sales as gross proxy",
              "",
              "// Explicit IF guards below (not just relying on DAX's number*BLANK=BLANK /",
              "// number-BLANK=number arithmetic quirks) so the fail-closed behavior is",
              "// stated plainly for a Finance/Power BI reviewer, not implied. The",
              "// subtraction/addition below would otherwise silently treat a genuinely",
              "// missing month as a real zero (BLANK acts as 0 under + and -, unlike *)."
            ],
            "description": "Source: 02_PnL_Measures.dax"
          },
          {
            "name": "Gross Margin",
            "expression": [
              "IF ( [_Assumption Available], [NSV] * [_Assumption Gross Margin %], BLANK () )"
            ],
            "description": "Source: 02_PnL_Measures.dax"
          },
          {
            "name": "Gross Margin %",
            "expression": [
              "DIVIDE ( [Gross Margin], [NSV] )"
            ],
            "description": "Source: 02_PnL_Measures.dax"
          },
          {
            "name": "Trade Spend",
            "expression": [
              "IF ( [_Assumption Available], [NSV] * [_Assumption Trade Spend %], BLANK () )"
            ],
            "description": "Source: 02_PnL_Measures.dax"
          },
          {
            "name": "Visibility Spend",
            "expression": [
              "[_Assumption Visibility Spend]"
            ],
            "description": "Source: 02_PnL_Measures.dax"
          },
          {
            "name": "Scheme Spend",
            "expression": [
              "[_Assumption Scheme Spend]"
            ],
            "description": "Source: 02_PnL_Measures.dax"
          },
          {
            "name": "Total Spend",
            "expression": [
              "IF ( [_Assumption Available], [Trade Spend] + [Visibility Spend] + [Scheme Spend], BLANK () )"
            ],
            "description": "Source: 02_PnL_Measures.dax"
          },
          {
            "name": "Spend % of NSV",
            "expression": [
              "DIVIDE ( [Total Spend], [NSV] )"
            ],
            "description": "Source: 02_PnL_Measures.dax"
          },
          {
            "name": "Contribution Margin",
            "expression": [
              "IF ( [_Assumption Available], [Gross Margin] - [Total Spend], BLANK () )"
            ],
            "description": "Source: 02_PnL_Measures.dax"
          },
          {
            "name": "CM %",
            "expression": [
              "DIVIDE ( [Contribution Margin], [NSV] )",
              "",
              "// ---- ranking helper for the profitability page ----"
            ],
            "description": "Source: 02_PnL_Measures.dax"
          },
          {
            "name": "Chain CM Rank",
            "expression": [
              "RANKX ( ALLSELECTED ( 'Chain Master'[Chain] ), [Contribution Margin],, DESC )",
              "",
              "// ---- \"growth profitable or only sales-led?\" flag ----",
              "// F21: cm blank (missing assumption month) must not fall through to the",
              "// generic \"Needs attention\" catch-all -- blank compares as 0 numerically,",
              "// so g>0 && cm>=0.25 would silently read as false and misclassify a",
              "// missing month as a real, bad one instead of a data gap."
            ],
            "description": "Source: 02_PnL_Measures.dax"
          },
          {
            "name": "Profitability Flag",
            "expression": [
              "VAR g = [MoM Growth %]",
              "VAR cm = [CM %]",
              "RETURN",
              "    SWITCH ( TRUE (),",
              "        ISBLANK ( cm ), \"ASSUMPTION_MISSING\",",
              "        g > 0 && cm >= 0.25, \"Profitable Growth\",",
              "        g > 0 && cm < 0.25,  \"Sales-led (watch margin)\",",
              "        g <= 0 && cm >= 0.25, \"Margin-protected decline\",",
              "        \"Needs attention\"",
              "    )"
            ],
            "description": "Source: 02_PnL_Measures.dax"
          },
          {
            "name": "TY Target",
            "expression": [
              "CALCULATE ( SUM ( Targets[Target NSV] ), Targets[FY Year] = \"26-27\" )"
            ],
            "description": "Source: 03_Forecast_Measures.dax"
          },
          {
            "name": "TY Target (Cr)",
            "expression": [
              "DIVIDE ( [TY Target], 10000000 )"
            ],
            "description": "Source: 03_Forecast_Measures.dax"
          },
          {
            "name": "FY26 Actual Offtake",
            "expression": [
              "CALCULATE ( [Total Offtake NSV], 'Date Table'[FY Year] = \"25-26\" )"
            ],
            "description": "Source: 03_Forecast_Measures.dax"
          },
          {
            "name": "FY26 Actual Offtake (Cr)",
            "expression": [
              "DIVIDE ( [FY26 Actual Offtake], 10000000 )",
              "",
              "// ---------- Allocation key = dimension share of FY26 offtake ----------",
              "// Denominator is the FY26 offtake of the *whole* visible selection, so the",
              "// shares across the axis sum to 1 and the target is fully distributed."
            ],
            "description": "Source: 03_Forecast_Measures.dax"
          },
          {
            "name": "_FY26 Total Offtake (All Dims)",
            "expression": [
              "CALCULATE (",
              "    [FY26 Actual Offtake],",
              "    ALLSELECTED ( 'Chain Master'[Chain] ),",
              "    ALLSELECTED ( 'Brand Master'[Brand] ),",
              "    ALLSELECTED ( 'Category Master'[Category] ),",
              "    ALLSELECTED ( 'Zone State Master'[Zone] ),",
              "    ALLSELECTED ( 'Sales Team Mapping'[Sales Person] )",
              ")"
            ],
            "description": "Source: 03_Forecast_Measures.dax"
          },
          {
            "name": "FY26 Allocation Share",
            "expression": [
              "DIVIDE ( [FY26 Actual Offtake], [_FY26 Total Offtake (All Dims)] )",
              "",
              "// ---------- FY27 Forecast (= allocated TY target) ----------",
              "// At grand total the share = 1 so Forecast = TY Target exactly."
            ],
            "description": "Source: 03_Forecast_Measures.dax"
          },
          {
            "name": "FY27 Forecast",
            "expression": [
              "SUMX (",
              "    VALUES ( 'Date Table'[MonthStart] ),",
              "    VAR _monthTarget = [TY Target]",
              "    VAR _share = [FY26 Allocation Share]",
              "    RETURN _monthTarget * _share",
              ")"
            ],
            "description": "Source: 03_Forecast_Measures.dax"
          },
          {
            "name": "FY27 Forecast (Cr)",
            "expression": [
              "DIVIDE ( [FY27 Forecast], 10000000 )",
              "",
              "// Final Forecast keeps the old name used elsewhere, now target-driven."
            ],
            "description": "Source: 03_Forecast_Measures.dax"
          },
          {
            "name": "Final Forecast",
            "expression": [
              "[FY27 Forecast]",
              "",
              "// ---------- Unmapped bucket (do NOT exclude) ----------",
              "// FY26 offtake whose Chain / Brand / Category is absent from the masters,",
              "// expressed as a share, so the target portion it represents shows as Unmapped."
            ],
            "description": "Source: 03_Forecast_Measures.dax"
          },
          {
            "name": "_FY26 Offtake Unmapped",
            "expression": [
              "CALCULATE (",
              "    [FY26 Actual Offtake],",
              "    FILTER ( 'Fact Offtake Sales',",
              "        NOT ( 'Fact Offtake Sales'[Chain]    IN VALUES ( 'Chain Master'[Chain] ) )",
              "        || NOT ( 'Fact Offtake Sales'[Brand]    IN VALUES ( 'Brand Master'[Brand] ) )",
              "        || NOT ( 'Fact Offtake Sales'[Category] IN VALUES ( 'Category Master'[Category] ) )",
              "    )",
              ")"
            ],
            "description": "Source: 03_Forecast_Measures.dax"
          },
          {
            "name": "Forecast - Unmapped",
            "expression": [
              "[TY Target] * DIVIDE ( [_FY26 Offtake Unmapped], [_FY26 Total Offtake (All Dims)] )",
              "",
              "// ---------- Sales-person ownership (via Sales Team Mapping x store offtake) ----------",
              "// SO FY26 offtake = Σ over their stores of store offtake × Cont%."
            ],
            "description": "Source: 03_Forecast_Measures.dax"
          },
          {
            "name": "SO FY26 Offtake",
            "expression": [
              "SUMX (",
              "    'Sales Team Mapping',",
              "    VAR _store = 'Sales Team Mapping'[Store Code]",
              "    VAR _w = 'Sales Team Mapping'[Cont%]",
              "    RETURN _w * CALCULATE ( [FY26 Actual Offtake],",
              "        'Fact Offtake Sales'[Store Code] = _store )",
              ")"
            ],
            "description": "Source: 03_Forecast_Measures.dax"
          },
          {
            "name": "SO Forecast (Owned Target)",
            "expression": [
              "[TY Target] * DIVIDE ( [SO FY26 Offtake],",
              "    CALCULATE ( [SO FY26 Offtake], ALLSELECTED ( 'Sales Team Mapping'[Sales Person] ) ) )",
              "",
              "// ---------- Gap vs FY26 & required growth ----------"
            ],
            "description": "Source: 03_Forecast_Measures.dax"
          },
          {
            "name": "Gap vs FY26",
            "expression": [
              "[FY27 Forecast] - [FY26 Actual Offtake]"
            ],
            "description": "Source: 03_Forecast_Measures.dax"
          },
          {
            "name": "Required Growth %",
            "expression": [
              "DIVIDE ( [FY27 Forecast] - [FY26 Actual Offtake], [FY26 Actual Offtake] )",
              "",
              "// ---------- Accuracy (once FY27 actuals start landing) ----------"
            ],
            "description": "Source: 03_Forecast_Measures.dax"
          },
          {
            "name": "Has Actual",
            "expression": [
              "IF ( [Total Offtake NSV] > 0, TRUE (), FALSE () )"
            ],
            "description": "Source: 03_Forecast_Measures.dax"
          },
          {
            "name": "Actual NSV",
            "expression": [
              "[Total Offtake NSV]"
            ],
            "description": "Source: 03_Forecast_Measures.dax"
          },
          {
            "name": "Forecast vs Actual",
            "expression": [
              "[Actual NSV] - [Final Forecast]"
            ],
            "description": "Source: 03_Forecast_Measures.dax"
          },
          {
            "name": "Forecast vs Actual %",
            "expression": [
              "DIVIDE ( [Actual NSV] - [Final Forecast], [Final Forecast] )"
            ],
            "description": "Source: 03_Forecast_Measures.dax"
          },
          {
            "name": "Forecast Accuracy %",
            "expression": [
              "IF ( [Has Actual],",
              "    1 - DIVIDE ( ABS ( [Actual NSV] - [Final Forecast] ), [Actual NSV] ),",
              "    BLANK () )",
              "",
              "// combined actual-or-forecast line for the trend chart"
            ],
            "description": "Source: 03_Forecast_Measures.dax"
          },
          {
            "name": "Actual or Forecast",
            "expression": [
              "IF ( [Has Actual], [Actual NSV], [Final Forecast] )"
            ],
            "description": "Source: 03_Forecast_Measures.dax"
          },
          {
            "name": "Market Value Sales",
            "expression": [
              "SUM ( 'Fact Nielsen'[Market Value Sales] )"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Our Brand Sales",
            "expression": [
              "SUM ( 'Fact Nielsen'[Our Brand Sales] )",
              "",
              "// Prefer supplied share %, else derive"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Market Share %",
            "expression": [
              "VAR _supplied = AVERAGE ( 'Fact Nielsen'[Value Market Share %] )",
              "RETURN COALESCE ( _supplied, DIVIDE ( [Our Brand Sales], [Market Value Sales] ) )"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Market Share Volume %",
            "expression": [
              "AVERAGE ( 'Fact Nielsen'[Volume Market Share %] )"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Prev Month Market Share %",
            "expression": [
              "CALCULATE ( [Market Share %], DATEADD ( 'Date Table'[Date], -1, MONTH ) )"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Last Year Market Share %",
            "expression": [
              "CALCULATE ( [Market Share %], DATEADD ( 'Date Table'[Date], -12, MONTH ) )"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Market Share MoM Change",
            "expression": [
              "[Market Share %] - [Prev Month Market Share %]"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Market Share YoY Change",
            "expression": [
              "[Market Share %] - [Last Year Market Share %]",
              "",
              "// basis points (1% = 100 bps)"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Market Share BPS Change",
            "expression": [
              "[Market Share MoM Change] * 10000"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Market Share YoY BPS",
            "expression": [
              "[Market Share YoY Change] * 10000"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "MS BPS Label",
            "expression": [
              "VAR b = [Market Share BPS Change]",
              "RETURN IF ( ISBLANK ( b ), \"\", IF ( b >= 0, \"▲ +\", \"▼ \" ) ) & FORMAT ( b, \"0\" ) & \" bps\"",
              "",
              "// category & competition movement"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Category Value Growth %",
            "expression": [
              "DIVIDE ( [Market Value Sales] - CALCULATE ( [Market Value Sales], DATEADD ( 'Date Table'[Date], -1, MONTH ) ),",
              "         CALCULATE ( [Market Value Sales], DATEADD ( 'Date Table'[Date], -1, MONTH ) ) )"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Our Brand Growth %",
            "expression": [
              "DIVIDE ( [Our Brand Sales] - CALCULATE ( [Our Brand Sales], DATEADD ( 'Date Table'[Date], -1, MONTH ) ),",
              "         CALCULATE ( [Our Brand Sales], DATEADD ( 'Date Table'[Date], -1, MONTH ) ) )",
              "",
              "// \"are we growing faster than the category?\" (share gain check)"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Share Gain Flag",
            "expression": [
              "IF ( [Our Brand Growth %] > [Category Value Growth %], \"Gaining Share\", \"Losing Share\" )",
              "",
              "// =====================================================================",
              "// NIELSEN PACK PRESENCE  (table: 'Fact Nielsen Pack')",
              "// Value basis (Rs Cr) for both categories; volume columns are there for price per ml and volume share.",
              "// Status: Not present = no Mamaearth sales in the pack; Under-indexed = our share in the pack is",
              "// below half of our overall share in the category; else Present.",
              "// ====================================================================="
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Pack Category Amount",
            "expression": [
              "SUM ( 'Fact Nielsen Pack'[Category Value Cr] )"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Pack Our Amount",
            "expression": [
              "SUM ( 'Fact Nielsen Pack'[Our Value Cr] )"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Pack Category Volume L",
            "expression": [
              "SUM ( 'Fact Nielsen Pack'[Category Volume L] )",
              "",
              "// Rs per ml = Rs Cr x 1e7 / (litres x 1000)"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Pack Price Per Ml",
            "expression": [
              "DIVIDE ( [Pack Category Amount] * 10000000, [Pack Category Volume L] * 1000 )"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Pack Volume Share %",
            "expression": [
              "DIVIDE (",
              "    [Pack Category Volume L],",
              "    CALCULATE ( [Pack Category Volume L],",
              "        ALLEXCEPT ( 'Fact Nielsen Pack', 'Fact Nielsen Pack'[MonthStart], 'Fact Nielsen Pack'[Nielsen Category] ) )",
              ")",
              "",
              "// the pack's share of Mamaearth's own value (our contribution)"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Pack Our Contribution %",
            "expression": [
              "DIVIDE (",
              "    [Pack Our Amount],",
              "    CALCULATE ( [Pack Our Amount],",
              "        ALLEXCEPT ( 'Fact Nielsen Pack', 'Fact Nielsen Pack'[MonthStart], 'Fact Nielsen Pack'[Nielsen Category] ) )",
              ")"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Pack Category Mix %",
            "expression": [
              "DIVIDE (",
              "    [Pack Category Amount],",
              "    CALCULATE ( [Pack Category Amount],",
              "        ALLEXCEPT ( 'Fact Nielsen Pack', 'Fact Nielsen Pack'[MonthStart], 'Fact Nielsen Pack'[Nielsen Category] ) )",
              ")"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Pack Our Share In Pack %",
            "expression": [
              "DIVIDE ( [Pack Our Amount], [Pack Category Amount] )"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Pack Our Overall Share %",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( [Pack Our Amount],",
              "        ALLEXCEPT ( 'Fact Nielsen Pack', 'Fact Nielsen Pack'[MonthStart], 'Fact Nielsen Pack'[Nielsen Category] ) ),",
              "    CALCULATE ( [Pack Category Amount],",
              "        ALLEXCEPT ( 'Fact Nielsen Pack', 'Fact Nielsen Pack'[MonthStart], 'Fact Nielsen Pack'[Nielsen Category] ) )",
              ")"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Pack Presence Status",
            "expression": [
              "VAR _cat = [Pack Category Amount]",
              "VAR _our = [Pack Our Amount]",
              "VAR _inPack = [Pack Our Share In Pack %]",
              "VAR _overall = [Pack Our Overall Share %]",
              "RETURN",
              "    IF ( ISBLANK ( _cat ) || _cat <= 0, BLANK (),",
              "        IF ( COALESCE ( _our, 0 ) <= 0, \"Not present\",",
              "            IF ( _inPack < _overall * 0.5, \"Under-indexed\", \"Present\" ) ) )",
              "",
              "// what we would sell if we held our overall share in a pack where we are not present / under-indexed"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Pack Gap Amount",
            "expression": [
              "VAR _gapShare = MAX ( [Pack Our Overall Share %] - COALESCE ( [Pack Our Share In Pack %], 0 ), 0 )",
              "RETURN IF ( [Pack Presence Status] = \"Present\", 0, [Pack Category Amount] * _gapShare )"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Packs Not Present",
            "expression": [
              "COUNTROWS ( FILTER ( VALUES ( 'Fact Nielsen Pack'[Pack Size ml] ), [Pack Presence Status] = \"Not present\" ) )",
              "",
              "// =====================================================================",
              "// CHAIN CONTRIBUTION TO GROWTH  (internal Offtake, MT basis: Reliance Brand Counter excluded)",
              "// Read as the internal driver of growth next to the Nielsen share gain; internal NSV is not",
              "// Nielsen consumer offtake, so this is direction, not a split of the share change.",
              "// ====================================================================="
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Chain NSV LY",
            "expression": [
              "CALCULATE ( [Total MT NSV], DATEADD ( 'Date Table'[Date], -12, MONTH ) )"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Chain NSV Growth",
            "expression": [
              "[Total MT NSV] - [Chain NSV LY]"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Chain Growth %",
            "expression": [
              "DIVIDE ( [Chain NSV Growth], [Chain NSV LY] )"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Chain Share of NSV %",
            "expression": [
              "DIVIDE ( [Total MT NSV], CALCULATE ( [Total MT NSV], ALL ( 'Chain Master'[Chain] ) ) )"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Chain Share of Growth %",
            "expression": [
              "DIVIDE ( [Chain NSV Growth], CALCULATE ( [Chain NSV Growth], ALL ( 'Chain Master'[Chain] ) ) )"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Chain Contribution To Growth pp",
            "expression": [
              "DIVIDE ( [Chain NSV Growth], CALCULATE ( [Chain NSV LY], ALL ( 'Chain Master'[Chain] ) ) ) * 100",
              "",
              "// =====================================================================",
              "// PACK-WISE BRANDS  (table: 'Fact Nielsen Pack Brand')",
              "// ====================================================================="
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Brand Pack Value Cr",
            "expression": [
              "SUM ( 'Fact Nielsen Pack Brand'[Value Cr] )"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Brand Share In Pack %",
            "expression": [
              "DIVIDE (",
              "    [Brand Pack Value Cr],",
              "    CALCULATE ( [Brand Pack Value Cr],",
              "        ALLEXCEPT ( 'Fact Nielsen Pack Brand', 'Fact Nielsen Pack Brand'[MonthStart],",
              "            'Fact Nielsen Pack Brand'[Nielsen Category], 'Fact Nielsen Pack Brand'[Pack Size ml] ) )",
              ")"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Brands Selling In Pack",
            "expression": [
              "COUNTROWS ( FILTER ( VALUES ( 'Fact Nielsen Pack Brand'[Brand] ), [Brand Pack Value Cr] > 0 ) )"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "Packs Brand Sells",
            "expression": [
              "COUNTROWS ( FILTER ( VALUES ( 'Fact Nielsen Pack Brand'[Pack Size ml] ), [Brand Pack Value Cr] > 0 ) )"
            ],
            "description": "Source: 04_Nielsen_Measures.dax"
          },
          {
            "name": "TDP",
            "expression": [
              "SUM ( 'Fact TDP'[ACV %] )                 // e.g. 3 SKUs @50% ACV => 150"
            ],
            "description": "Source: 05_TDP_Measures.dax"
          },
          {
            "name": "ACV %",
            "expression": [
              "AVERAGE ( 'Fact TDP'[ACV %] )            // average shelf reach of a SKU"
            ],
            "description": "Source: 05_TDP_Measures.dax"
          },
          {
            "name": "AIC",
            "expression": [
              "AVERAGE ( 'Fact TDP'[AIC] )                // Average Items Carried"
            ],
            "description": "Source: 05_TDP_Measures.dax"
          },
          {
            "name": "Numeric Distribution",
            "expression": [
              "AVERAGE ( 'Fact TDP'[Numeric Distribution] )"
            ],
            "description": "Source: 05_TDP_Measures.dax"
          },
          {
            "name": "Weighted Distribution",
            "expression": [
              "AVERAGE ( 'Fact TDP'[Weighted Distribution] )",
              "",
              "// Velocity"
            ],
            "description": "Source: 05_TDP_Measures.dax"
          },
          {
            "name": "Sales per TDP",
            "expression": [
              "DIVIDE ( [NSV], [TDP] )                 // offtake NSV per distribution point"
            ],
            "description": "Source: 05_TDP_Measures.dax"
          },
          {
            "name": "Offtake per TDP",
            "expression": [
              "DIVIDE ( [Total Offtake NSV], [TDP] )"
            ],
            "description": "Source: 05_TDP_Measures.dax"
          },
          {
            "name": "Primary per TDP",
            "expression": [
              "DIVIDE ( [Total Primary NSV], [TDP] )",
              "",
              "// Growth"
            ],
            "description": "Source: 05_TDP_Measures.dax"
          },
          {
            "name": "Prev Month TDP",
            "expression": [
              "CALCULATE ( [TDP], DATEADD ( 'Date Table'[Date], -1, MONTH ) )"
            ],
            "description": "Source: 05_TDP_Measures.dax"
          },
          {
            "name": "Last Year TDP",
            "expression": [
              "CALCULATE ( [TDP], DATEADD ( 'Date Table'[Date], -12, MONTH ) )"
            ],
            "description": "Source: 05_TDP_Measures.dax"
          },
          {
            "name": "TDP MoM Growth %",
            "expression": [
              "DIVIDE ( [TDP] - [Prev Month TDP], [Prev Month TDP] )"
            ],
            "description": "Source: 05_TDP_Measures.dax"
          },
          {
            "name": "TDP YoY Growth %",
            "expression": [
              "DIVIDE ( [TDP] - [Last Year TDP], [Last Year TDP] )"
            ],
            "description": "Source: 05_TDP_Measures.dax"
          },
          {
            "name": "TDP Contribution %",
            "expression": [
              "DIVIDE ( [TDP],",
              "    CALCULATE ( [TDP], ALLSELECTED ( 'Brand Master'[Brand] ), ALLSELECTED ( 'Article Master'[Article Code] ) ) )",
              "",
              "// ---- Distribution-led vs Velocity-led diagnosis ----",
              "// Compares Sales growth vs TDP growth to answer the leadership question:",
              "// \"is growth coming from better distribution or better velocity?\""
            ],
            "description": "Source: 05_TDP_Measures.dax"
          },
          {
            "name": "Sales Growth vs TDP Growth",
            "expression": [
              "[MoM Growth %] - [TDP MoM Growth %]"
            ],
            "description": "Source: 05_TDP_Measures.dax"
          },
          {
            "name": "Growth Driver",
            "expression": [
              "VAR sg = [MoM Growth %]",
              "VAR tg = [TDP MoM Growth %]",
              "RETURN",
              "    SWITCH ( TRUE (),",
              "        ISBLANK ( sg ), \"\",",
              "        sg > 0 && tg > 0 && tg >= sg, \"Distribution-led\",",
              "        sg > 0 && ( ISBLANK ( tg ) || sg > tg ), \"Velocity-led\",",
              "        sg > 0, \"Mixed\",",
              "        \"Declining\"",
              "    )",
              "",
              "// ---- Opportunity quadrants (use as a flag column in the article table) ----",
              "// Benchmarks = median across visible articles."
            ],
            "description": "Source: 05_TDP_Measures.dax"
          },
          {
            "name": "_Median Sales per TDP",
            "expression": [
              "MEDIANX ( ALLSELECTED ( 'Article Master'[Article Code] ), [Sales per TDP] )"
            ],
            "description": "Source: 05_TDP_Measures.dax"
          },
          {
            "name": "_Median TDP",
            "expression": [
              "MEDIANX ( ALLSELECTED ( 'Article Master'[Article Code] ), [TDP] )"
            ],
            "description": "Source: 05_TDP_Measures.dax"
          },
          {
            "name": "TDP Opportunity Quadrant",
            "expression": [
              "VAR spt = [Sales per TDP]",
              "VAR t = [TDP]",
              "VAR medSPT = [_Median Sales per TDP]",
              "VAR medTDP = [_Median TDP]",
              "RETURN",
              "    SWITCH ( TRUE (),",
              "        t < medTDP && spt >= medSPT, \"Low TDP / High Velocity — EXPAND\",",
              "        t >= medTDP && spt < medSPT, \"High TDP / Low Velocity — FIX PRODUCTIVITY\",",
              "        t >= medTDP && spt >= medSPT, \"Strong — PROTECT\",",
              "        \"Low / Low — REVIEW\"",
              "    )",
              "",
              "// Market share vs TDP link (uses Nielsen share at the matching grain)"
            ],
            "description": "Source: 05_TDP_Measures.dax"
          },
          {
            "name": "MS vs TDP Index",
            "expression": [
              "DIVIDE ( [Market Share %] * 100, [TDP] )"
            ],
            "description": "Source: 05_TDP_Measures.dax"
          },
          {
            "name": "Missing Month",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'Fact Offtake Sales' ), FILTER ( 'Fact Offtake Sales', ISBLANK ( [MonthStart] ) ) )"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Missing Chain",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'Fact Offtake Sales' ), FILTER ( 'Fact Offtake Sales', ISBLANK ( 'Fact Offtake Sales'[Chain] ) || 'Fact Offtake Sales'[Chain] = \"\" ) )"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Missing Zone",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'Fact Offtake Sales' ), FILTER ( 'Fact Offtake Sales', ISBLANK ( 'Fact Offtake Sales'[Zone] ) || 'Fact Offtake Sales'[Zone] = \"\" ) )"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Missing State",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'Fact Offtake Sales' ), FILTER ( 'Fact Offtake Sales', ISBLANK ( 'Fact Offtake Sales'[State] ) || 'Fact Offtake Sales'[State] = \"\" ) )"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Missing Brand",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'Fact Offtake Sales' ), FILTER ( 'Fact Offtake Sales', ISBLANK ( 'Fact Offtake Sales'[Brand] ) || 'Fact Offtake Sales'[Brand] = \"\" ) )"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Missing Category",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'Fact Offtake Sales' ), FILTER ( 'Fact Offtake Sales', ISBLANK ( 'Fact Offtake Sales'[Category] ) || 'Fact Offtake Sales'[Category] = \"\" ) )"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Missing Article Code",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'Fact Offtake Sales' ), FILTER ( 'Fact Offtake Sales', ISBLANK ( 'Fact Offtake Sales'[Article Code] ) || 'Fact Offtake Sales'[Article Code] = \"\" ) )"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Missing EAN",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'Fact Offtake Sales' ), FILTER ( 'Fact Offtake Sales', ISBLANK ( 'Fact Offtake Sales'[EAN Code] ) || 'Fact Offtake Sales'[EAN Code] = \"\" ) )",
              "",
              "// ---- Bad values ----"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Blank NSV Values",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'Fact Offtake Sales' ), FILTER ( 'Fact Offtake Sales', ISBLANK ( 'Fact Offtake Sales'[Offtake NSV] ) ) )"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Negative Sales Values",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'Fact Offtake Sales' ), FILTER ( 'Fact Offtake Sales', 'Fact Offtake Sales'[Offtake NSV] < 0 ) )",
              "",
              "// ---- Duplicates ----"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Duplicate Store Count",
            "expression": [
              "SUMX ( FILTER ( SUMMARIZE ( 'Store Master', 'Store Master'[Store Code], \"n\", COUNTROWS ( 'Store Master' ) ), [n] > 1 ), [n] - 1 )"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Duplicate Article Count",
            "expression": [
              "SUMX ( FILTER ( SUMMARIZE ( 'Article Master', 'Article Master'[Article Code], \"n\", COUNTROWS ( 'Article Master' ) ), [n] > 1 ), [n] - 1 )",
              "",
              "// ---- Unmapped keys (in fact but missing from master) ----"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Unmapped Chain",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'Fact Offtake Sales' ),",
              "    FILTER ( 'Fact Offtake Sales', NOT ( 'Fact Offtake Sales'[Chain] IN VALUES ( 'Chain Master'[Chain] ) ) ) )"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Unmapped Brand",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'Fact Offtake Sales' ),",
              "    FILTER ( 'Fact Offtake Sales', NOT ( 'Fact Offtake Sales'[Brand] IN VALUES ( 'Brand Master'[Brand] ) ) ) )"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Unmapped Category",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'Fact Offtake Sales' ),",
              "    FILTER ( 'Fact Offtake Sales', NOT ( 'Fact Offtake Sales'[Category] IN VALUES ( 'Category Master'[Category] ) ) ) )"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Unmapped Zone",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'Fact Offtake Sales' ),",
              "    FILTER ( 'Fact Offtake Sales', NOT ( 'Fact Offtake Sales'[Zone] IN VALUES ( 'Zone State Master'[Zone] ) ) ) )",
              "",
              "// ---- Coverage gaps in supporting facts ----"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Missing TDP",
            "expression": [
              "VAR _articlesWithSales = CALCULATE ( DISTINCTCOUNT ( 'Fact Offtake Sales'[Article Code] ) )",
              "VAR _articlesWithTDP   = CALCULATE ( DISTINCTCOUNT ( 'Fact TDP'[Article Code] ) )",
              "RETURN _articlesWithSales - _articlesWithTDP"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Missing Market Share",
            "expression": [
              "VAR _catsWithSales = CALCULATE ( DISTINCTCOUNT ( 'Category Master'[Nielsen Category] ) )",
              "VAR _catsWithMS    = CALCULATE ( DISTINCTCOUNT ( 'Fact Nielsen'[Nielsen Category] ) )",
              "RETURN _catsWithSales - _catsWithMS"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Missing PnL Assumptions",
            "expression": [
              "VAR _months = CALCULATE ( DISTINCTCOUNT ( 'Fact Offtake Sales'[Month] ) )",
              "VAR _assumMonths = CALCULATE ( DISTINCTCOUNT ( 'Assumption Table'[Month] ) )",
              "RETURN MAX ( _months - _assumMonths, 0 )",
              "",
              "// ---- Overall health score (share of clean rows) ----"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Total Fact Rows",
            "expression": [
              "COUNTROWS ( 'Fact Offtake Sales' )"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Total DQ Issues",
            "expression": [
              "[Missing Chain] + [Missing Zone] + [Missing State] + [Missing Brand]",
              "    + [Missing Category] + [Missing Article Code] + [Missing EAN]",
              "    + [Blank NSV Values] + [Negative Sales Values]",
              "    + [Unmapped Chain] + [Unmapped Brand] + [Unmapped Category] + [Unmapped Zone]"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Data Health %",
            "expression": [
              "1 - DIVIDE ( [Total DQ Issues], [Total Fact Rows] )",
              "",
              "// =====================================================================",
              "// PRIMARY ARTICLE — DATA QUALITY CHECKS  (Fact Primary Article)",
              "// =====================================================================",
              "",
              "// ---- Missing key fields on Primary Article fact ----"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Primary Missing Month",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'Fact Primary Article' ),",
              "    FILTER ( 'Fact Primary Article', ISBLANK ( 'Fact Primary Article'[MonthStart] ) ) )"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Primary Missing Chain",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'Fact Primary Article' ),",
              "    FILTER ( 'Fact Primary Article',",
              "        ISBLANK ( 'Fact Primary Article'[Chain] ) || 'Fact Primary Article'[Chain] = \"\" ) )"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Primary Missing Brand",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'Fact Primary Article' ),",
              "    FILTER ( 'Fact Primary Article',",
              "        ISBLANK ( 'Fact Primary Article'[Brand] ) || 'Fact Primary Article'[Brand] = \"\" ) )"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Primary Blank NSV",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'Fact Primary Article' ),",
              "    FILTER ( 'Fact Primary Article', ISBLANK ( 'Fact Primary Article'[Primary NSV] ) ) )"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Primary Negative NSV",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'Fact Primary Article' ),",
              "    FILTER ( 'Fact Primary Article', 'Fact Primary Article'[Primary NSV] < 0 ) )",
              "",
              "// ---- Distributor allocation quality ----",
              "// Unmapped Dist rows: PO Type = Dist. but no ShipTo match found in Q41"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Primary Unmapped Dist",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'Fact Primary Article' ),",
              "    'Fact Primary Article'[Allocation Status] = \"Unmapped\" )",
              "",
              "// Provisional rows: Jun'26 nearest-month fallback, awaiting Finance approval"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Primary Provisional Alloc",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'Fact Primary Article' ),",
              "    'Fact Primary Article'[Provisional Flag] = TRUE () )",
              "",
              "// Provisional NSV value exposed for the finance review disclosure"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Primary Provisional NSV",
            "expression": [
              "CALCULATE ( SUM ( 'Fact Primary Article'[Primary NSV] ),",
              "    'Fact Primary Article'[Provisional Flag] = TRUE () )",
              "",
              "// Coverage: share of Dist rows that received an approved allocation"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Primary Dist Coverage %",
            "expression": [
              "VAR _distRows =",
              "    CALCULATE ( COUNTROWS ( 'Fact Primary Article' ),",
              "        'Fact Primary Article'[Allocation Status] IN { \"Allocated\", \"Provisional\", \"Unmapped\" } )",
              "VAR _mapped =",
              "    CALCULATE ( COUNTROWS ( 'Fact Primary Article' ),",
              "        'Fact Primary Article'[Allocation Status] IN { \"Allocated\", \"Provisional\" } )",
              "RETURN DIVIDE ( _mapped, _distRows )",
              "",
              "// ---- Combined Primary DQ summary ----"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Primary Total DQ Issues",
            "expression": [
              "[Primary Missing Month] + [Primary Missing Chain] + [Primary Missing Brand]",
              "    + [Primary Blank NSV] + [Primary Unmapped Dist]"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Primary Article Total Rows",
            "expression": [
              "COUNTROWS ( 'Fact Primary Article' )"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Primary Data Health %",
            "expression": [
              "1 - DIVIDE ( [Primary Total DQ Issues], [Primary Article Total Rows] )",
              "",
              "// ---- Negative Frac QC (Source: ShipTo CSV correction/reversal entries) ----",
              "// 8 source rows have negative Cont% in the ShipTo CSV (reversal/credit entries).",
              "// These produce negative allocated NSV on 157 article-level rows across 4 distributors.",
              "// Total impact: approx -0.2093 L (0.0013% of total Dist NSV). Not a code defect —",
              "// the normalisation is mathematically valid (fracs still sum to 1 per group).",
              "// Finance must decide whether to zero-floor negatives or keep them for reconciliation."
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Primary Negative Frac Rows",
            "expression": [
              "CALCULATE (",
              "    COUNTROWS ( 'Fact Primary Article' ),",
              "    'Fact Primary Article'[Primary NSV] < 0,",
              "    'Fact Primary Article'[Allocation Status] IN { \"Allocated\", \"Provisional\" }",
              ")"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Primary Negative Frac NSV",
            "expression": [
              "CALCULATE (",
              "    SUM ( 'Fact Primary Article'[Primary NSV] ),",
              "    'Fact Primary Article'[Primary NSV] < 0,",
              "    'Fact Primary Article'[Allocation Status] IN { \"Allocated\", \"Provisional\" }",
              ")",
              "",
              "// Human-readable flag for the QC card"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Primary Negative Frac Flag",
            "expression": [
              "VAR _rows = [Primary Negative Frac Rows]",
              "RETURN",
              "    IF ( _rows > 0,",
              "        \"⚠ \" & _rows & \" rows with negative allocated NSV (reversal entries in ShipTo CSV – Finance review required)\",",
              "        \"No negative-frac rows\"",
              "    )",
              "",
              "// =====================================================================",
              "// FY26 RECONCILIATION & DATA QUALITY GATES",
              "// Validates Power BI offtake data against dashboard canonical reference",
              "// =====================================================================",
              "",
              "// Expected FY26 Offtake (from dashboard data_master.json)"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Expected FY26 Offtake",
            "expression": [
              "VAR expectedCr = 311.28  // ₹ Crore (43 chains, verified)",
              "RETURN expectedCr * 10000000  // Convert to base unit (smallest denomination)",
              "",
              "// Actual FY26 Offtake (from Power BI fact)"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Actual FY26 Offtake",
            "expression": [
              "CALCULATE (",
              "    [Total MT NSV],",
              "    'Date Table'[FY Year] = \"25-26\"",
              ")",
              "",
              "// Variance Alert (should be < ±0.05 Cr tolerance)"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "FY26 Offtake Variance",
            "expression": [
              "VAR actual = [Actual FY26 Offtake] / 10000000  // Convert to Crore",
              "VAR expected = [Expected FY26 Offtake] / 10000000",
              "RETURN actual - expected",
              "",
              "// Status Flag: Green/Red"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "FY26 Status",
            "expression": [
              "VAR variance = [FY26 Offtake Variance]",
              "RETURN",
              "    IF (",
              "        ABS ( variance ) < 0.05,",
              "        \"🟢 OK — Aligned with dashboard\",",
              "        \"🔴 MISMATCH — Variance: \" & FORMAT ( variance, \"+0.00;-0.00;0.00\" ) & \" Cr\"",
              "    )",
              "",
              "// Expected FY26 RBC (from dashboard)"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Expected FY26 RBC",
            "expression": [
              "VAR expectedCr = 45.62  // ₹ Crore (Reliance Brand Counter)",
              "RETURN expectedCr * 10000000",
              "",
              "// Actual FY26 RBC"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Actual FY26 RBC",
            "expression": [
              "CALCULATE (",
              "    [Total RBC NSV],",
              "    'Date Table'[FY Year] = \"25-26\"",
              ")",
              "",
              "// RBC Variance"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "FY26 RBC Variance",
            "expression": [
              "VAR actual = [Actual FY26 RBC] / 10000000",
              "VAR expected = [Expected FY26 RBC] / 10000000",
              "RETURN actual - expected",
              "",
              "// RBC Status"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "FY26 RBC Status",
            "expression": [
              "VAR variance = [FY26 RBC Variance]",
              "RETURN",
              "    IF (",
              "        ABS ( variance ) < 0.01,",
              "        \"🟢 OK — Aligned with dashboard\",",
              "        \"🔴 MISMATCH — Variance: \" & FORMAT ( variance, \"+0.00;-0.00;0.00\" ) & \" Cr\"",
              "    )",
              "",
              "// Combined total (MT + RBC)"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Expected FY26 Combined",
            "expression": [
              "[Expected FY26 Offtake] + [Expected FY26 RBC]"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Actual FY26 Combined",
            "expression": [
              "[Actual FY26 Offtake] + [Actual FY26 RBC]"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "FY26 Combined Variance",
            "expression": [
              "([Actual FY26 Combined] - [Expected FY26 Combined]) / 10000000"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "FY26 Combined Status",
            "expression": [
              "VAR variance = [FY26 Combined Variance]",
              "RETURN",
              "    IF (",
              "        ABS ( variance ) < 0.05,",
              "        \"🟢 OK — ₹356.90 Cr target\",",
              "        \"🔴 MISMATCH — Variance: \" & FORMAT ( variance, \"+0.00;-0.00;0.00\" ) & \" Cr\"",
              "    )"
            ],
            "description": "Source: 06_DataQuality_Measures.dax"
          },
          {
            "name": "Ship-to Primary NSV",
            "expression": [
              "SUM ( 'Fact Primary ShipTo'[Primary NSV] )"
            ],
            "description": "Source: 07_PrimaryAllocation_Measures.dax"
          },
          {
            "name": "Ship-to Primary MRP",
            "expression": [
              "SUM ( 'Fact Primary ShipTo'[MRP Value] )",
              "",
              "// ---------- Allocation contribution % (dynamic, month-wise) ----------",
              "// Override wins; else the secondary-derived map value; weighted by primary so",
              "// it aggregates sensibly above a single Ship-To x Chain x Brand cell."
            ],
            "description": "Source: 07_PrimaryAllocation_Measures.dax"
          },
          {
            "name": "Primary Allocation Cont%",
            "expression": [
              "VAR _override =",
              "    CALCULATE (",
              "        MAX ( 'Primary Allocation Override'[Override Cont%] ),",
              "        FILTER (",
              "            'Primary Allocation Override',",
              "            ( 'Primary Allocation Override'[Month] = SELECTEDVALUE ( 'Date Table'[Month] )",
              "                || 'Primary Allocation Override'[Month] = \"ALL\" )",
              "                && ( 'Primary Allocation Override'[Ship To Name] = SELECTEDVALUE ( 'Ship-To Master'[Ship To Name] )",
              "                    || 'Primary Allocation Override'[Ship To Name] = \"ALL\" )",
              "                && ( 'Primary Allocation Override'[Chain] = SELECTEDVALUE ( 'Chain Master'[Chain] )",
              "                    || 'Primary Allocation Override'[Chain] = \"ALL\" )",
              "                && ( 'Primary Allocation Override'[Brand] = SELECTEDVALUE ( 'Brand Master'[Brand] )",
              "                    || 'Primary Allocation Override'[Brand] = \"ALL\" )",
              "        )",
              "    )",
              "VAR _mapWeighted =",
              "    DIVIDE (",
              "        SUMX ( 'Primary Allocation Map', 'Primary Allocation Map'[Cont%] ),",
              "        COUNTROWS ( 'Primary Allocation Map' )",
              "    )",
              "RETURN",
              "    IF ( NOT ISBLANK ( _override ), DIVIDE ( _override, 100 ), _mapWeighted )",
              "",
              "// ---------- (B) Compute allocation from an un-split raw primary ----------",
              "// Point [Raw ShipTo Primary] at your un-split feed if/when one exists.",
              "// By default it falls back to the already-allocated NSV so the measure is safe."
            ],
            "description": "Source: 07_PrimaryAllocation_Measures.dax"
          },
          {
            "name": "Raw ShipTo Primary",
            "expression": [
              "COALESCE (",
              "    // <-- replace with SUM('Raw Primary'[Primary NSV]) when an un-split feed is added",
              "    BLANK (),",
              "    [Ship-to Primary NSV]",
              ")",
              "",
              "// !! Do not place this on a report page while [Raw ShipTo Primary] still",
              "// falls back to [Ship-to Primary NSV] (today's mode) -- see the",
              "// DOUBLE-ALLOCATION LANDMINE note at the top of this file. Use",
              "// [Ship-to Primary NSV] instead; that is what Page 2B actually uses today."
            ],
            "description": "Source: 07_PrimaryAllocation_Measures.dax"
          },
          {
            "name": "Allocated Primary (via Cont%)",
            "expression": [
              "SUMX (",
              "    SUMMARIZE (",
              "        'Primary Allocation Map',",
              "        'Primary Allocation Map'[Ship To Name],",
              "        'Primary Allocation Map'[Chain],",
              "        'Primary Allocation Map'[Brand]",
              "    ),",
              "    VAR _cont = [Primary Allocation Cont%]",
              "    VAR _raw =",
              "        CALCULATE (",
              "            [Raw ShipTo Primary],",
              "            ALL ( 'Chain Master'[Chain] )   // raw is at ship-to x brand (chain-agnostic)",
              "        )",
              "    RETURN _raw * _cont",
              ")",
              "",
              "// ---------- Secondary / Offtake at the same grain ----------"
            ],
            "description": "Source: 07_PrimaryAllocation_Measures.dax"
          },
          {
            "name": "Secondary Offtake NSV",
            "expression": [
              "[Total Offtake NSV]"
            ],
            "description": "Source: 07_PrimaryAllocation_Measures.dax"
          },
          {
            "name": "Secondary Offtake Qty",
            "expression": [
              "[Total Offtake Qty]",
              "",
              "// ---------- Article inclusion: offtake this month OR previous month ----------",
              "// Primary can lead/lag secondary by a month, so an article counts as \"active\"",
              "// if it had offtake in the selected month or the one before."
            ],
            "description": "Source: 07_PrimaryAllocation_Measures.dax"
          },
          {
            "name": "Article Has Offtake (Curr or Prev)",
            "expression": [
              "VAR _curr = [Total Offtake NSV]",
              "VAR _prev = CALCULATE ( [Total Offtake NSV], DATEADD ( 'Date Table'[Date], -1, MONTH ) )",
              "RETURN IF ( ( COALESCE ( _curr, 0 ) <> 0 ) || ( COALESCE ( _prev, 0 ) <> 0 ), 1, 0 )",
              "",
              "// Primary restricted to active articles (current or previous-month offtake)."
            ],
            "description": "Source: 07_PrimaryAllocation_Measures.dax"
          },
          {
            "name": "Ship-to Primary NSV (Active Articles)",
            "expression": [
              "CALCULATE (",
              "    [Ship-to Primary NSV],",
              "    FILTER (",
              "        VALUES ( 'Article Master'[Article Code] ),",
              "        [Article Has Offtake (Curr or Prev)] = 1",
              "    )",
              ")",
              "",
              "// ---------- Primary vs Offtake on the allocated basis ----------"
            ],
            "description": "Source: 07_PrimaryAllocation_Measures.dax"
          },
          {
            "name": "Allocated Primary vs Offtake Gap",
            "expression": [
              "[Ship-to Primary NSV] - [Secondary Offtake NSV]"
            ],
            "description": "Source: 07_PrimaryAllocation_Measures.dax"
          },
          {
            "name": "Allocated Primary vs Offtake Gap %",
            "expression": [
              "DIVIDE ( [Ship-to Primary NSV] - [Secondary Offtake NSV], [Secondary Offtake NSV] )"
            ],
            "description": "Source: 07_PrimaryAllocation_Measures.dax"
          },
          {
            "name": "Primary to Offtake Ratio",
            "expression": [
              "DIVIDE ( [Ship-to Primary NSV], [Secondary Offtake NSV] )",
              "",
              "// ---------- MoM movement on allocated primary ----------"
            ],
            "description": "Source: 07_PrimaryAllocation_Measures.dax"
          },
          {
            "name": "Ship-to Primary Prev Month",
            "expression": [
              "CALCULATE ( [Ship-to Primary NSV], DATEADD ( 'Date Table'[Date], -1, MONTH ) )"
            ],
            "description": "Source: 07_PrimaryAllocation_Measures.dax"
          },
          {
            "name": "Ship-to Primary MoM %",
            "expression": [
              "DIVIDE ( [Ship-to Primary NSV] - [Ship-to Primary Prev Month], [Ship-to Primary Prev Month] )"
            ],
            "description": "Source: 07_PrimaryAllocation_Measures.dax"
          },
          {
            "name": "Ship-to Primary YoY %",
            "expression": [
              "DIVIDE (",
              "    [Ship-to Primary NSV] - CALCULATE ( [Ship-to Primary NSV], DATEADD ( 'Date Table'[Date], -12, MONTH ) ),",
              "    CALCULATE ( [Ship-to Primary NSV], DATEADD ( 'Date Table'[Date], -12, MONTH ) )",
              ")",
              "",
              "// ---------- Display helpers ----------"
            ],
            "description": "Source: 07_PrimaryAllocation_Measures.dax"
          },
          {
            "name": "Ship-to Primary NSV Label",
            "expression": [
              "VAR v = [Ship-to Primary NSV]",
              "RETURN IF ( ABS ( v ) >= 10000000,",
              "    FORMAT ( DIVIDE ( v, 10000000 ), \"0.00\" ) & \" Cr\",",
              "    FORMAT ( DIVIDE ( v, 100000 ), \"0.0\" ) & \" L\" )"
            ],
            "description": "Source: 07_PrimaryAllocation_Measures.dax"
          },
          {
            "name": "Allocation Health Check",
            "expression": [
              "// distributor rows whose Cont% across chains does not sum to ~100% in a month",
              "VAR _bad =",
              "    COUNTROWS (",
              "        FILTER (",
              "            SUMMARIZE (",
              "                'Primary Allocation Map',",
              "                'Primary Allocation Map'[Month],",
              "                'Primary Allocation Map'[Ship To Name],",
              "                'Primary Allocation Map'[Brand],",
              "                \"tot\", SUM ( 'Primary Allocation Map'[Cont%] )",
              "            ),",
              "            [tot] < 0.99 || [tot] > 1.01",
              "        )",
              "    )",
              "RETURN COALESCE ( _bad, 0 )",
              "",
              "// =====================================================================",
              "// DIST ALLOCATION SOURCE BREAKDOWN  (Fact Primary Article)",
              "// Source Type column is populated by Query 41 and propagated via Query 16.",
              "// Use these measures on the QC page to monitor allocation coverage and",
              "// confirm the Jun'26 provisional rows are eventually replaced by a Finance-",
              "// approved DistCont patch.",
              "// =====================================================================",
              "",
              "// --- NSV by allocation source ---"
            ],
            "description": "Source: 07_PrimaryAllocation_Measures.dax"
          },
          {
            "name": "Dist NSV – Approved Patch",
            "expression": [
              "CALCULATE (",
              "    SUM ( 'Fact Primary Article'[Primary NSV] ),",
              "    'Fact Primary Article'[Source Type] = \"Approved Patch\"",
              ")"
            ],
            "description": "Source: 07_PrimaryAllocation_Measures.dax"
          },
          {
            "name": "Dist NSV – ShipTo CSV",
            "expression": [
              "CALCULATE (",
              "    SUM ( 'Fact Primary Article'[Primary NSV] ),",
              "    'Fact Primary Article'[Source Type] = \"ShipTo CSV\"",
              ")"
            ],
            "description": "Source: 07_PrimaryAllocation_Measures.dax"
          },
          {
            "name": "Dist NSV – Provisional Fallback",
            "expression": [
              "CALCULATE (",
              "    SUM ( 'Fact Primary Article'[Primary NSV] ),",
              "    'Fact Primary Article'[Source Type] = \"Nearest-Month Fallback\"",
              ")"
            ],
            "description": "Source: 07_PrimaryAllocation_Measures.dax"
          },
          {
            "name": "Dist NSV – Unmapped",
            "expression": [
              "CALCULATE (",
              "    SUM ( 'Fact Primary Article'[Primary NSV] ),",
              "    'Fact Primary Article'[Allocation Status] = \"Unmapped\"",
              ")",
              "",
              "// --- Coverage % (share of Dist NSV that has an approved allocation) ---"
            ],
            "description": "Source: 07_PrimaryAllocation_Measures.dax"
          },
          {
            "name": "Dist Allocation Coverage %",
            "expression": [
              "VAR _total =",
              "    CALCULATE (",
              "        SUM ( 'Fact Primary Article'[Primary NSV] ),",
              "        'Fact Primary Article'[Is Dist] = TRUE ()",
              "    )",
              "VAR _covered =",
              "    CALCULATE (",
              "        SUM ( 'Fact Primary Article'[Primary NSV] ),",
              "        'Fact Primary Article'[Allocation Status] IN { \"Allocated\", \"Provisional\" }",
              "    )",
              "RETURN DIVIDE ( _covered, _total )",
              "",
              "// --- Provisional row flag (for Jun'26 disclosure) ---"
            ],
            "description": "Source: 07_PrimaryAllocation_Measures.dax"
          },
          {
            "name": "Has Provisional Allocation",
            "expression": [
              "IF (",
              "    CALCULATE (",
              "        COUNTROWS ( 'Fact Primary Article' ),",
              "        'Fact Primary Article'[Provisional Flag] = TRUE ()",
              "    ) > 0,",
              "    \"⚠ Provisional allocation active – Finance approval pending\",",
              "    \"All allocations approved\"",
              ")",
              "",
              "// --- Unmapped Dist rows count (QC threshold: target = 0) ---"
            ],
            "description": "Source: 07_PrimaryAllocation_Measures.dax"
          },
          {
            "name": "Unmapped Dist Rows",
            "expression": [
              "CALCULATE (",
              "    COUNTROWS ( 'Fact Primary Article' ),",
              "    'Fact Primary Article'[Allocation Status] = \"Unmapped\"",
              ")",
              "",
              "// --- Is Dist flag (derived from PO Type; matches Query 16 logic) ---",
              "// Exposed as a measure for use in filters where the column isn't available."
            ],
            "description": "Source: 07_PrimaryAllocation_Measures.dax"
          },
          {
            "name": "Dist Row Count",
            "expression": [
              "CALCULATE (",
              "    COUNTROWS ( 'Fact Primary Article' ),",
              "    'Fact Primary Article'[Allocation Status] IN { \"Allocated\", \"Provisional\", \"Unmapped\" }",
              ")"
            ],
            "description": "Source: 07_PrimaryAllocation_Measures.dax"
          },
          {
            "name": "QC TY Target Total",
            "expression": [
              "[TY Target]"
            ],
            "description": "Source: 08_ForecastQC_Measures.dax"
          },
          {
            "name": "QC Dashboard Forecast Total",
            "expression": [
              "CALCULATE ( [FY27 Forecast],",
              "    ALLSELECTED ( 'Chain Master'[Chain] ), ALLSELECTED ( 'Brand Master'[Brand] ),",
              "    ALLSELECTED ( 'Category Master'[Category] ), ALLSELECTED ( 'Zone State Master'[Zone] ),",
              "    ALLSELECTED ( 'Sales Team Mapping'[Sales Person] ) )"
            ],
            "description": "Source: 08_ForecastQC_Measures.dax"
          },
          {
            "name": "QC Variance",
            "expression": [
              "[QC Dashboard Forecast Total] - [QC TY Target Total]"
            ],
            "description": "Source: 08_ForecastQC_Measures.dax"
          },
          {
            "name": "QC Variance %",
            "expression": [
              "DIVIDE ( [QC Variance], [QC TY Target Total] )"
            ],
            "description": "Source: 08_ForecastQC_Measures.dax"
          },
          {
            "name": "QC Tie-Out",
            "expression": [
              "IF ( ABS ( [QC Variance] ) < 1, \"OK - Matches TY Target\", \"Variance - investigate\" )",
              "",
              "// ---- Mapping coverage (FY26 offtake basis) ----"
            ],
            "description": "Source: 08_ForecastQC_Measures.dax"
          },
          {
            "name": "QC Mapped Offtake",
            "expression": [
              "[FY26 Actual Offtake] - [_FY26 Offtake Unmapped]"
            ],
            "description": "Source: 08_ForecastQC_Measures.dax"
          },
          {
            "name": "QC Mapping Coverage %",
            "expression": [
              "DIVIDE ( [QC Mapped Offtake], [FY26 Actual Offtake] )",
              "",
              "// SO coverage = offtake from stores that have a sales-person mapping"
            ],
            "description": "Source: 08_ForecastQC_Measures.dax"
          },
          {
            "name": "QC SO Mapped Offtake",
            "expression": [
              "CALCULATE ( [FY26 Actual Offtake],",
              "    FILTER ( 'Fact Offtake Sales',",
              "        'Fact Offtake Sales'[Store Code] IN VALUES ( 'Sales Team Mapping'[Store Code] ) ) )"
            ],
            "description": "Source: 08_ForecastQC_Measures.dax"
          },
          {
            "name": "QC SO Coverage %",
            "expression": [
              "DIVIDE ( [QC SO Mapped Offtake], [FY26 Actual Offtake] )",
              "",
              "// ---- Unmapped counts / lists ----"
            ],
            "description": "Source: 08_ForecastQC_Measures.dax"
          },
          {
            "name": "QC Unmapped Chains",
            "expression": [
              "CALCULATE ( DISTINCTCOUNT ( 'Fact Offtake Sales'[Chain] ),",
              "    FILTER ( 'Fact Offtake Sales',",
              "        NOT ( 'Fact Offtake Sales'[Chain] IN VALUES ( 'Chain Master'[Chain] ) ) ) )"
            ],
            "description": "Source: 08_ForecastQC_Measures.dax"
          },
          {
            "name": "QC Unmapped Chain Names",
            "expression": [
              "CALCULATE ( CONCATENATEX ( VALUES ( 'Fact Offtake Sales'[Chain] ), 'Fact Offtake Sales'[Chain], \", \" ),",
              "    FILTER ( 'Fact Offtake Sales',",
              "        NOT ( 'Fact Offtake Sales'[Chain] IN VALUES ( 'Chain Master'[Chain] ) ) ) )",
              "",
              "// Stores with offtake but no sales-team owner -> \"unmapped sales team\""
            ],
            "description": "Source: 08_ForecastQC_Measures.dax"
          },
          {
            "name": "QC Unmapped SO Stores",
            "expression": [
              "CALCULATE ( DISTINCTCOUNT ( 'Fact Offtake Sales'[Store Code] ),",
              "    FILTER ( 'Fact Offtake Sales',",
              "        NOT ( 'Fact Offtake Sales'[Store Code] IN VALUES ( 'Sales Team Mapping'[Store Code] ) ) ) )",
              "// Sales-person names present in mapping but with no FY26 offtake match (orphan owners)"
            ],
            "description": "Source: 08_ForecastQC_Measures.dax"
          },
          {
            "name": "QC Orphan Sales Persons",
            "expression": [
              "CALCULATE ( CONCATENATEX ( VALUES ( 'Sales Team Mapping'[Sales Person] ), 'Sales Team Mapping'[Sales Person], \", \" ),",
              "    FILTER ( 'Sales Team Mapping',",
              "        NOT ( 'Sales Team Mapping'[Store Code] IN VALUES ( 'Fact Offtake Sales'[Store Code] ) ) ) )",
              "",
              "// ---- Missing dimension mapping (months / brand / category) ----"
            ],
            "description": "Source: 08_ForecastQC_Measures.dax"
          },
          {
            "name": "QC Missing Month Mapping",
            "expression": [
              "VAR _tgtMonths = CALCULATE ( DISTINCTCOUNT ( Targets[Month] ), Targets[FY Year] = \"26-27\" )",
              "VAR _dateMonths = CALCULATE ( DISTINCTCOUNT ( 'Date Table'[Month] ), 'Date Table'[FY Year] = \"26-27\" )",
              "RETURN _dateMonths - _tgtMonths"
            ],
            "description": "Source: 08_ForecastQC_Measures.dax"
          },
          {
            "name": "QC Missing Brand Mapping",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'Fact Offtake Sales' ),",
              "    FILTER ( 'Fact Offtake Sales',",
              "        NOT ( 'Fact Offtake Sales'[Brand] IN VALUES ( 'Brand Master'[Brand] ) ) ) )"
            ],
            "description": "Source: 08_ForecastQC_Measures.dax"
          },
          {
            "name": "QC Missing Category Mapping",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'Fact Offtake Sales' ),",
              "    FILTER ( 'Fact Offtake Sales',",
              "        NOT ( 'Fact Offtake Sales'[Category] IN VALUES ( 'Category Master'[Category] ) ) ) )"
            ],
            "description": "Source: 08_ForecastQC_Measures.dax"
          },
          {
            "name": "Offtake NSV (CBA, M)",
            "expression": [
              "[Total Offtake NSV]   // current month, current C/B/A context"
            ],
            "description": "Source: 09_ArticleAllocation_Eligibility.dax"
          },
          {
            "name": "Offtake NSV (CBA, M+1)",
            "expression": [
              "CALCULATE ( [Total Offtake NSV], DATEADD ( 'Date Table'[Date], 1, MONTH ) )",
              "",
              "// brand-level evidence at the chain (to tell \"brand not listed\" from \"article not listed\")"
            ],
            "description": "Source: 09_ArticleAllocation_Eligibility.dax"
          },
          {
            "name": "Offtake NSV (Chain-Brand, M or M+1)",
            "expression": [
              "CALCULATE (",
              "    [Total Offtake NSV] + [Offtake NSV (CBA, M+1)],",
              "    ALL ( 'Article Master'[Article Code] ), ALL ( 'Article Master'[EAN Code] )",
              ")",
              "",
              "// first month this Chain x Brand x Article ever shows offtake (for new-article logic)"
            ],
            "description": "Source: 09_ArticleAllocation_Eligibility.dax"
          },
          {
            "name": "First Offtake Month (CBA)",
            "expression": [
              "CALCULATE (",
              "    MIN ( 'Fact Offtake Sales'[MonthStart] ),",
              "    ALLEXCEPT ( 'Fact Offtake Sales',",
              "        'Fact Offtake Sales'[Chain], 'Fact Offtake Sales'[Brand], 'Fact Offtake Sales'[Article Code] )",
              ")",
              "",
              "// ---------- Eligibility ----------"
            ],
            "description": "Source: 09_ArticleAllocation_Eligibility.dax"
          },
          {
            "name": "Article Eligible",
            "expression": [
              "VAR _m   = COALESCE ( [Offtake NSV (CBA, M)], 0 )",
              "VAR _m1  = COALESCE ( [Offtake NSV (CBA, M+1)], 0 )",
              "RETURN IF ( _m <> 0 || _m1 <> 0, 1, 0 )"
            ],
            "description": "Source: 09_ArticleAllocation_Eligibility.dax"
          },
          {
            "name": "Eligibility Status",
            "expression": [
              "VAR _m   = COALESCE ( [Offtake NSV (CBA, M)], 0 )",
              "VAR _m1  = COALESCE ( [Offtake NSV (CBA, M+1)], 0 )",
              "VAR _brand = COALESCE ( [Offtake NSV (Chain-Brand, M or M+1)], 0 )",
              "RETURN",
              "    SWITCH ( TRUE (),",
              "        _m  <> 0, \"Eligible\",                    // offtake in same month",
              "        _m1 <> 0, \"Eligible due to TAT\",         // offtake only next month",
              "        _brand = 0, \"Brand not listed\",          // chain has no offtake for this brand",
              "        \"Article not listed\"                     // brand listed at chain, this article not",
              "    )",
              "",
              "// New-article one-month-prior flag: offtake first appears in M+1 (so primary",
              "// allowed in M). True when current month has no offtake but M+1 does and M+1 is",
              "// the first offtake month."
            ],
            "description": "Source: 09_ArticleAllocation_Eligibility.dax"
          },
          {
            "name": "New Article Flag",
            "expression": [
              "VAR _m  = COALESCE ( [Offtake NSV (CBA, M)], 0 )",
              "VAR _m1 = COALESCE ( [Offtake NSV (CBA, M+1)], 0 )",
              "VAR _first = [First Offtake Month (CBA)]",
              "VAR _nextMonth = EOMONTH ( MAX ( 'Date Table'[MonthStart] ), 1 ) + 1",
              "RETURN IF ( _m = 0 && _m1 <> 0 && _first = _nextMonth, \"New Article - primary held 1 month prior\", \"\" )"
            ],
            "description": "Source: 09_ArticleAllocation_Eligibility.dax"
          },
          {
            "name": "Primary Month Maintained",
            "expression": [
              "IF ( [New Article Flag] <> \"\", FORMAT ( MAX ( 'Date Table'[MonthStart] ), \"mmm'yy\" ), \"\" )",
              "",
              "// ---------- Chain-allocated primary (Step 2 result, from Cont%) ----------",
              "// Distributor-brand primary split to chain by the secondary Cont% (built earlier)."
            ],
            "description": "Source: 09_ArticleAllocation_Eligibility.dax"
          },
          {
            "name": "Chain Allocated Primary NSV",
            "expression": [
              "[Ship-to Primary NSV]   // already chain-split in File 1",
              "",
              "// ---------- Article ratio among ELIGIBLE articles only ----------",
              "// Denominator = secondary of eligible articles in this Chain x Dist x Brand x Month,",
              "// so eligible articles absorb the chain primary; blocked ones get nothing."
            ],
            "description": "Source: 09_ArticleAllocation_Eligibility.dax"
          },
          {
            "name": "_Eligible Article Secondary (Chain-Brand)",
            "expression": [
              "CALCULATE (",
              "    [Total Offtake NSV] + [Offtake NSV (CBA, M+1)],",
              "    FILTER ( VALUES ( 'Article Master'[Article Code] ), [Article Eligible] = 1 ),",
              "    VALUES ( 'Chain Master'[Chain] ), VALUES ( 'Brand Master'[Brand] )",
              ")"
            ],
            "description": "Source: 09_ArticleAllocation_Eligibility.dax"
          },
          {
            "name": "Article Allocation Ratio %",
            "expression": [
              "IF ( [Article Eligible] = 1,",
              "    DIVIDE ( COALESCE ( [Offtake NSV (CBA, M)], 0 ) + COALESCE ( [Offtake NSV (CBA, M+1)], 0 ),",
              "             [_Eligible Article Secondary (Chain-Brand)] ),",
              "    0 )",
              "",
              "// ---------- Allocation outputs ----------"
            ],
            "description": "Source: 09_ArticleAllocation_Eligibility.dax"
          },
          {
            "name": "Allocated Article Primary NSV",
            "expression": [
              "IF ( [Article Eligible] = 1,",
              "    [Chain Allocated Primary NSV] * [Article Allocation Ratio %],",
              "    0 )",
              "",
              "// Allocated Qty / MRP follow the same ratio (need File 2 Qty/MRP)"
            ],
            "description": "Source: 09_ArticleAllocation_Eligibility.dax"
          },
          {
            "name": "Allocated Article Primary Qty",
            "expression": [
              "IF ( [Article Eligible] = 1,",
              "    CALCULATE ( SUM ( 'Fact Primary Article'[Primary Qty] ) ) * [Article Allocation Ratio %],",
              "    0 )",
              "",
              "// Primary that is NOT allocated because there is no offtake evidence at all",
              "// for the brand/article in this chain (the legitimate blocked bucket)."
            ],
            "description": "Source: 09_ArticleAllocation_Eligibility.dax"
          },
          {
            "name": "Blocked Primary NSV",
            "expression": [
              "VAR _hasEligible = [_Eligible Article Secondary (Chain-Brand)]",
              "RETURN IF ( COALESCE ( _hasEligible, 0 ) = 0, [Chain Allocated Primary NSV], 0 )"
            ],
            "description": "Source: 09_ArticleAllocation_Eligibility.dax"
          },
          {
            "name": "Allocation Status",
            "expression": [
              "SWITCH ( TRUE (),",
              "    [Article Eligible] = 1, \"Allocated\",",
              "    [Eligibility Status] = \"Brand not listed\",   \"Blocked - Brand Not Listed\",",
              "    [Eligibility Status] = \"Article not listed\", \"Blocked - Article Not Listed\",",
              "    \"Blocked - No Offtake Evidence\" )"
            ],
            "description": "Source: 09_ArticleAllocation_Eligibility.dax"
          },
          {
            "name": "Exception Reason",
            "expression": [
              "SWITCH ( TRUE (),",
              "    [Article Eligible] = 1, \"\",",
              "    [Eligibility Status] = \"Brand not listed\",   \"Brand has no offtake in this chain (M or M+1)\",",
              "    [Eligibility Status] = \"Article not listed\", \"Article has no offtake in this chain (M or M+1)\",",
              "    \"No secondary offtake found in M or M+1\" )",
              "",
              "// =====================================================================",
              "// QC — reconciliation separates VALID allocation from BLOCKED/UNALLOCATED",
              "// ====================================================================="
            ],
            "description": "Source: 09_ArticleAllocation_Eligibility.dax"
          },
          {
            "name": "QC Orig Primary (Dist-Brand)",
            "expression": [
              "CALCULATE ( [Ship-to Primary NSV],",
              "    ALLSELECTED ( 'Chain Master'[Chain] ), ALLSELECTED ( 'Article Master'[Article Code] ) )"
            ],
            "description": "Source: 09_ArticleAllocation_Eligibility.dax"
          },
          {
            "name": "QC Allocated Primary Total",
            "expression": [
              "[Allocated Article Primary NSV]"
            ],
            "description": "Source: 09_ArticleAllocation_Eligibility.dax"
          },
          {
            "name": "QC Blocked Primary Total",
            "expression": [
              "[Blocked Primary NSV]"
            ],
            "description": "Source: 09_ArticleAllocation_Eligibility.dax"
          },
          {
            "name": "QC Reconciliation Variance",
            "expression": [
              "[QC Orig Primary (Dist-Brand)] - ( [QC Allocated Primary Total] + [QC Blocked Primary Total] )",
              "// ^ MUST be 0:  Original = Allocated + Blocked  (no value lost, none forced)"
            ],
            "description": "Source: 09_ArticleAllocation_Eligibility.dax"
          },
          {
            "name": "QC Blocked Article Count",
            "expression": [
              "CALCULATE ( DISTINCTCOUNT ( 'Article Master'[Article Code] ),",
              "    FILTER ( VALUES ( 'Article Master'[Article Code] ), [Article Eligible] = 0 ) )"
            ],
            "description": "Source: 09_ArticleAllocation_Eligibility.dax"
          },
          {
            "name": "QC Allocated Article Count",
            "expression": [
              "CALCULATE ( DISTINCTCOUNT ( 'Article Master'[Article Code] ),",
              "    FILTER ( VALUES ( 'Article Master'[Article Code] ), [Article Eligible] = 1 ) )",
              "// Renamed from \"QC Mapping Coverage %\" (2026-10-01): 08_ForecastQC_Measures.dax already uses",
              "// that name for a different measure, so Power BI refused this one on install."
            ],
            "description": "Source: 09_ArticleAllocation_Eligibility.dax"
          },
          {
            "name": "QC Allocated Coverage %",
            "expression": [
              "DIVIDE ( [QC Allocated Primary Total], [QC Orig Primary (Dist-Brand)] )"
            ],
            "description": "Source: 09_ArticleAllocation_Eligibility.dax"
          },
          {
            "name": "QC Blocked Coverage %",
            "expression": [
              "DIVIDE ( [QC Blocked Primary Total], [QC Orig Primary (Dist-Brand)] )",
              "",
              "// ---------- Helpers for the New Article Tracker export ----------"
            ],
            "description": "Source: 09_ArticleAllocation_Eligibility.dax"
          },
          {
            "name": "Allowed Primary Month (date)",
            "expression": [
              "EOMONTH ( [First Offtake Month (CBA)], -1 ) + 1"
            ],
            "description": "Source: 09_ArticleAllocation_Eligibility.dax"
          },
          {
            "name": "First Offtake NSV",
            "expression": [
              "CALCULATE ( [Total Offtake NSV],",
              "    FILTER ( ALL ( 'Date Table' ),",
              "        'Date Table'[MonthStart] = [First Offtake Month (CBA)] ) )"
            ],
            "description": "Source: 09_ArticleAllocation_Eligibility.dax"
          },
          {
            "name": "Primary NSV in Allowed Month",
            "expression": [
              "CALCULATE ( [Chain Allocated Primary NSV],",
              "    FILTER ( ALL ( 'Date Table' ),",
              "        'Date Table'[MonthStart] = [Allowed Primary Month (date)] ) )"
            ],
            "description": "Source: 09_ArticleAllocation_Eligibility.dax"
          },
          {
            "name": "Offtake Channel",
            "expression": [
              "VAR _byStore =",
              "    LOOKUPVALUE ( 'Channel Map Store'[Channel],",
              "        'Channel Map Store'[Store Code], 'Fact Offtake Sales'[Store Code] )",
              "VAR _byChain =",
              "    LOOKUPVALUE ( 'Channel Map Chain'[Channel],",
              "        'Channel Map Chain'[Chain], 'Fact Offtake Sales'[Chain] )",
              "RETURN COALESCE ( _byStore, _byChain, \"Unmapped\" )",
              "",
              "// ---------- Channel splits ----------",
              "// PRIMARY (authoritative — explicit Channel from File 2 / Fact Primary Article)"
            ],
            "description": "Source: 10_SIS_Reconciliation.dax"
          },
          {
            "name": "Primary NSV (Article)",
            "expression": [
              "SUM ( 'Fact Primary Article'[Primary NSV] )"
            ],
            "description": "Source: 10_SIS_Reconciliation.dax"
          },
          {
            "name": "Primary SIS",
            "expression": [
              "CALCULATE ( [Primary NSV (Article)], 'Fact Primary Article'[Channel] = \"SIS\" )"
            ],
            "description": "Source: 10_SIS_Reconciliation.dax"
          },
          {
            "name": "Primary EB2B",
            "expression": [
              "CALCULATE ( [Primary NSV (Article)], 'Fact Primary Article'[Channel] = \"EB2B\" )"
            ],
            "description": "Source: 10_SIS_Reconciliation.dax"
          },
          {
            "name": "Primary MT",
            "expression": [
              "CALCULATE ( [Primary NSV (Article)], 'Fact Primary Article'[Channel] = \"MT\" )",
              "",
              "// OFFTAKE (derived Channel)"
            ],
            "description": "Source: 10_SIS_Reconciliation.dax"
          },
          {
            "name": "Offtake SIS",
            "expression": [
              "CALCULATE ( [Total Offtake NSV], 'Fact Offtake Sales'[Offtake Channel] = \"SIS\" )"
            ],
            "description": "Source: 10_SIS_Reconciliation.dax"
          },
          {
            "name": "Offtake EB2B",
            "expression": [
              "CALCULATE ( [Total Offtake NSV], 'Fact Offtake Sales'[Offtake Channel] = \"EB2B\" )"
            ],
            "description": "Source: 10_SIS_Reconciliation.dax"
          },
          {
            "name": "Offtake MT",
            "expression": [
              "CALCULATE ( [Total Offtake NSV], 'Fact Offtake Sales'[Offtake Channel] = \"MT\" )"
            ],
            "description": "Source: 10_SIS_Reconciliation.dax"
          },
          {
            "name": "Offtake Unmapped Channel",
            "expression": [
              "CALCULATE ( [Total Offtake NSV], 'Fact Offtake Sales'[Offtake Channel] = \"Unmapped\" )",
              "",
              "// ---------- Display in Cr (Indian) ----------"
            ],
            "description": "Source: 10_SIS_Reconciliation.dax"
          },
          {
            "name": "Primary SIS (Cr)",
            "expression": [
              "DIVIDE ( [Primary SIS], 10000000 )"
            ],
            "description": "Source: 10_SIS_Reconciliation.dax"
          },
          {
            "name": "Offtake SIS (Cr)",
            "expression": [
              "DIVIDE ( [Offtake SIS], 10000000 )",
              "",
              "// ---------- SIS reconciliation ----------"
            ],
            "description": "Source: 10_SIS_Reconciliation.dax"
          },
          {
            "name": "SIS Variance",
            "expression": [
              "[Primary SIS] - [Offtake SIS]"
            ],
            "description": "Source: 10_SIS_Reconciliation.dax"
          },
          {
            "name": "SIS Variance (Cr)",
            "expression": [
              "DIVIDE ( [SIS Variance], 10000000 )"
            ],
            "description": "Source: 10_SIS_Reconciliation.dax"
          },
          {
            "name": "SIS Variance (Lacs)",
            "expression": [
              "DIVIDE ( [SIS Variance], 100000 )"
            ],
            "description": "Source: 10_SIS_Reconciliation.dax"
          },
          {
            "name": "SIS Match",
            "expression": [
              "IF ( ABS ( [SIS Variance] ) < 100000, \"OK (< Rs 1 L)\", \"Gap - investigate\" )",
              "",
              "// Channel coverage: how much offtake resolved to a real channel (not Unmapped)"
            ],
            "description": "Source: 10_SIS_Reconciliation.dax"
          },
          {
            "name": "Offtake Channel Coverage %",
            "expression": [
              "1 - DIVIDE ( [Offtake Unmapped Channel], [Total Offtake NSV] )",
              "",
              "// Sanity note: Primary SIS must be sourced ONLY from File 2's explicit",
              "// Channel = \"SIS\" ([Primary SIS] above) — never derived from the ship-to",
              "// primary (File 1 is MT-only, no Channel). [Primary SIS] correctly nets to",
              "// ~Rs 2.50 Cr FY26 per the raw source — CONFIRMED correct by business",
              "// (2026-07-03). The Rs 2.36 Cr reference figure is confirmed NOT correct.",
              "",
              "// ---------- Reconciliation table helper ----------",
              "// Build a table visual: rows = Chain, values = [Primary SIS (Cr)],",
              "// [Offtake SIS (Cr)], [SIS Variance (Lacs)]. Sort by SIS Variance to see the",
              "// chains driving the ~Rs 14 L gap. Add 'Offtake Channel' = \"Unmapped\" as a",
              "// slicer to list stores whose channel didn't resolve."
            ],
            "description": "Source: 10_SIS_Reconciliation.dax"
          },
          {
            "name": "NSV Value Label",
            "expression": [
              "VAR v = [NSV]",
              "RETURN",
              "    IF (",
              "        ABS ( v ) >= 10000000,",
              "        \"₹\" & FORMAT ( DIVIDE ( v, 10000000 ), \"#,0.00\" ) & \" Cr\",",
              "        \"₹\" & FORMAT ( v, \"#,0.0\" ) & \" L\"",
              "    )"
            ],
            "description": "Source: 11_ExportDisplay_Measures.dax"
          },
          {
            "name": "Total Primary NSV Value Label",
            "expression": [
              "VAR v = [Total Primary NSV]",
              "RETURN",
              "    IF (",
              "        ABS ( v ) >= 10000000,",
              "        \"₹\" & FORMAT ( DIVIDE ( v, 10000000 ), \"#,0.00\" ) & \" Cr\",",
              "        \"₹\" & FORMAT ( v, \"#,0.0\" ) & \" L\"",
              "    )"
            ],
            "description": "Source: 11_ExportDisplay_Measures.dax"
          },
          {
            "name": "Total Offtake NSV Value Label",
            "expression": [
              "VAR v = [Total Offtake NSV]",
              "RETURN",
              "    IF (",
              "        ABS ( v ) >= 10000000,",
              "        \"₹\" & FORMAT ( DIVIDE ( v, 10000000 ), \"#,0.00\" ) & \" Cr\",",
              "        \"₹\" & FORMAT ( v, \"#,0.0\" ) & \" L\"",
              "    )"
            ],
            "description": "Source: 11_ExportDisplay_Measures.dax"
          },
          {
            "name": "Total MRP Sales Value Label",
            "expression": [
              "VAR v = [Total MRP Sales]",
              "RETURN",
              "    IF (",
              "        ABS ( v ) >= 10000000,",
              "        \"₹\" & FORMAT ( DIVIDE ( v, 10000000 ), \"#,0.00\" ) & \" Cr\",",
              "        \"₹\" & FORMAT ( v, \"#,0.0\" ) & \" L\"",
              "    )",
              "",
              "// P&L, Forecast pages: point this at whichever base measure the card uses",
              "// (e.g. [Total Trade Spend], [FY27 Forecast NSV]) by copying the pattern above.",
              "",
              "// ---------- QUANTITY LABELS (Qty Cr / Qty L — separate family from ₹) ----------"
            ],
            "description": "Source: 11_ExportDisplay_Measures.dax"
          },
          {
            "name": "Total Offtake Qty Label",
            "expression": [
              "VAR v = [Total Offtake Qty]",
              "VAR crv = DIVIDE ( v, 10000000 )",
              "RETURN",
              "    IF (",
              "        ABS ( crv ) >= 0.005,",
              "        FORMAT ( crv, \"#,0.00\" ) & \" Cr Qty\",",
              "        FORMAT ( DIVIDE ( v, 100000 ), \"#,0.00\" ) & \" L Qty\"",
              "    )"
            ],
            "description": "Source: 11_ExportDisplay_Measures.dax"
          },
          {
            "name": "Total Primary Qty Label",
            "expression": [
              "VAR v = [Total Primary Qty]",
              "VAR crv = DIVIDE ( v, 10000000 )",
              "RETURN",
              "    IF (",
              "        ABS ( crv ) >= 0.005,",
              "        FORMAT ( crv, \"#,0.00\" ) & \" Cr Qty\",",
              "        FORMAT ( DIVIDE ( v, 100000 ), \"#,0.00\" ) & \" L Qty\"",
              "    )",
              "",
              "// ---------- HOW TO USE ----------",
              "// Card visual: drag the *_Value Label / *_Qty Label measure straight into a",
              "// Card visual's \"Fields\" well — Power BI cards render text measures as-is,",
              "// so the ₹/Cr/L formatting shows exactly as typed, no Format-pane fiddling.",
              "//",
              "// Table/Matrix visual: add the Label measure as an extra column alongside the",
              "// raw numeric measure (keep the numeric one too — it's what \"Export data\"",
              "// should carry for anyone re-deriving totals in Excel; the Label column is",
              "// the human-readable display copy).",
              "//",
              "// Chart data labels: Format pane ▸ Data labels ▸ On ▸ \"Values\" dropdown will",
              "// only show a *_Value Label measure if that measure is the field actually",
              "// plotted; Power BI axis \"Display units\" (Auto/K/M/Bn) does NOT understand",
              "// Lakh/Crore, so for bar/column/line charts either (a) plot the raw numeric",
              "// measure and turn Display units OFF (Format ▸ Y-axis ▸ Display units ▸ None)",
              "// then rely on the tooltip showing the Label measure, or (b) add the Label",
              "// measure as a second field in the tooltip (\"Format ▸ Tooltips ▸ Fields\").",
              "// See docs/ExportAndVisualSettings.md for the full per-visual walkthrough."
            ],
            "description": "Source: 11_ExportDisplay_Measures.dax"
          },
          {
            "name": "GST Cutover Date",
            "expression": [
              "COALESCE ( MINX ( 'GST Config', 'GST Config'[GST_Cutover_Date] ), DATE ( 2025, 9, 22 ) )",
              "",
              "// ==========================================================================",
              "// SETUP STEP THAT DIFFERS FROM EVERY OTHER DAX FILE IN THIS KIT: the two",
              "// blocks below are CALCULATED COLUMNS, not measures. Add them directly on",
              "// 'Fact Primary Article' -- select that table ▸ Table tools ▸ New column --",
              "// NOT pasted into the \"_Measures\" table like everything else in DAX/01..12.",
              "// Every measure further down in this file depends on 'Fact Primary",
              "// Article'[TOT Method] / [TOT Pass-on Value] already existing as columns.",
              "// ==========================================================================",
              "",
              "// ---------- ROW-LEVEL CLASSIFICATION (calculated columns on Fact Primary Article) ----------",
              "// The 3-tier decision is a per-row fact, so a calculated column computes it",
              "// once at refresh instead of re-evaluating on every visual. The GST-rate",
              "// LOOKUPVALUE only actually runs for the (rare) gst_fallback branch --",
              "// SWITCH is lazy, so tiers 1/2 never pay for it.",
              "//",
              "// 'Fact Primary Article'[TOT Method] =",
              "// VAR _mrp = 'Fact Primary Article'[Primary MRP]",
              "// VAR _nsv = 'Fact Primary Article'[Primary NSV]",
              "// VAR _avgTot = 'Fact Primary Article'[Avg TOT]",
              "// VAR _tax = 'Fact Primary Article'[Primary Tax Amount]",
              "// RETURN",
              "//     IF ( ISBLANK ( _mrp ) || _mrp = 0, \"invalid\",",
              "//         IF ( NOT ISBLANK ( _avgTot ) && _avgTot >= -1.5 && _avgTot <= 1.5, \"avg_tot\",",
              "//             IF ( ISBLANK ( _nsv ), \"invalid\",",
              "//                 IF ( NOT ISBLANK ( _tax ), \"tax_calc\", \"gst_fallback\" )",
              "//             )",
              "//         )",
              "//     )",
              "//",
              "// 'Fact Primary Article'[TOT Pass-on Value] =",
              "// VAR _method = 'Fact Primary Article'[TOT Method]",
              "// VAR _mrp = 'Fact Primary Article'[Primary MRP]",
              "// VAR _nsv = 'Fact Primary Article'[Primary NSV]",
              "// VAR _avgTot = 'Fact Primary Article'[Avg TOT]",
              "// VAR _tax = 'Fact Primary Article'[Primary Tax Amount]",
              "// VAR _cat = 'Fact Primary Article'[Category]",
              "// RETURN",
              "//     SWITCH (",
              "//         _method,",
              "//         \"avg_tot\", _mrp * _avgTot,",
              "//         \"tax_calc\", _mrp - _nsv - _tax,",
              "//         \"gst_fallback\",",
              "//             VAR _preRate = LOOKUPVALUE ( 'GST Rate QC Table'[Pre_GST_Rate_Pct], 'GST Rate QC Table'[Category], _cat )",
              "//             VAR _postRate = LOOKUPVALUE ( 'GST Rate QC Table'[Post_GST_Rate_Pct], 'GST Rate QC Table'[Category], _cat )",
              "//             VAR _effFromTxt = LOOKUPVALUE ( 'GST Rate QC Table'[Effective_From], 'GST Rate QC Table'[Category], _cat )",
              "//             VAR _effFrom = IF ( TRIM ( COALESCE ( _effFromTxt, \"\" ) ) = \"\", BLANK(), DATEVALUE ( _effFromTxt ) )",
              "//             VAR _cutover = COALESCE ( _effFrom, [GST Cutover Date] )",
              "//             VAR _pre = COALESCE ( _preRate, 18 )",
              "//             VAR _post = COALESCE ( _postRate, 18 )",
              "//             VAR _rate = IF ( 'Fact Primary Article'[MonthStart] >= _cutover, _post, _pre )",
              "//             RETURN _mrp - _nsv - ( _nsv * _rate / 100 ),",
              "//         BLANK()",
              "//     )",
              "",
              "// ---------- BASE TOTALS (TOT-valid rows only -- excludes \"invalid\" so the",
              "// denominator never silently includes rows that couldn't be computed) ----------"
            ],
            "description": "Source: 12_TOT_Measures.dax"
          },
          {
            "name": "Total Primary Article MRP",
            "expression": [
              "CALCULATE ( SUM ( 'Fact Primary Article'[Primary MRP] ), 'Fact Primary Article'[TOT Method] <> \"invalid\" )"
            ],
            "description": "Source: 12_TOT_Measures.dax"
          },
          {
            "name": "Total Primary Article NSV",
            "expression": [
              "CALCULATE ( SUM ( 'Fact Primary Article'[Primary NSV] ), 'Fact Primary Article'[TOT Method] <> \"invalid\" )",
              "",
              "// ---------- TOT% AND PASS-ON VALUE ----------"
            ],
            "description": "Source: 12_TOT_Measures.dax"
          },
          {
            "name": "On-Invoice Margin Pass-on Value",
            "expression": [
              "SUM ( 'Fact Primary Article'[TOT Pass-on Value] )   // BLANK() rows (invalid) contribute nothing to SUM"
            ],
            "description": "Source: 12_TOT_Measures.dax"
          },
          {
            "name": "TOT %",
            "expression": [
              "VAR _mrp = [Total Primary Article MRP]",
              "RETURN IF ( _mrp = 0, BLANK(), DIVIDE ( [On-Invoice Margin Pass-on Value], _mrp ) )"
            ],
            "description": "Source: 12_TOT_Measures.dax"
          },
          {
            "name": "TOT % Label",
            "expression": [
              "VAR v = [TOT %]",
              "RETURN IF ( ISBLANK ( v ), \"–\", FORMAT ( v, \"0.0%\" ) )"
            ],
            "description": "Source: 12_TOT_Measures.dax"
          },
          {
            "name": "TOT Tax",
            "expression": [
              "// back-derived, consistent by construction with whichever tier drove Pass-on Value",
              "[Total Primary Article MRP] - [Total Primary Article NSV] - [On-Invoice Margin Pass-on Value]"
            ],
            "description": "Source: 12_TOT_Measures.dax"
          },
          {
            "name": "On-Invoice Margin Pass-on Value Label",
            "expression": [
              "VAR v = [On-Invoice Margin Pass-on Value]",
              "RETURN",
              "    IF ( ABS ( v ) >= 10000000,",
              "        \"₹\" & FORMAT ( DIVIDE ( v, 10000000 ), \"#,0.00\" ) & \" Cr\",",
              "        \"₹\" & FORMAT ( v, \"#,0.0\" ) & \" L\"",
              "    )",
              "",
              "// ---------- MoM MOVEMENT (needs the Date Table -> Fact Primary Article relationship) ----------"
            ],
            "description": "Source: 12_TOT_Measures.dax"
          },
          {
            "name": "MoM TOT Delta pp",
            "expression": [
              "VAR _cur = [TOT %]",
              "VAR _prev = CALCULATE ( [TOT %], DATEADD ( 'Date Table'[Date], -1, MONTH ) )",
              "RETURN IF ( ISBLANK ( _cur ) || ISBLANK ( _prev ), BLANK(), ( _cur - _prev ) * 100 )"
            ],
            "description": "Source: 12_TOT_Measures.dax"
          },
          {
            "name": "Incremental Pass-on Impact",
            "expression": [
              "VAR _cur = [On-Invoice Margin Pass-on Value]",
              "VAR _prev = CALCULATE ( [On-Invoice Margin Pass-on Value], DATEADD ( 'Date Table'[Date], -1, MONTH ) )",
              "RETURN IF ( ISBLANK ( _prev ), BLANK(), _cur - _prev )",
              "",
              "// ---------- TOT% SOURCE QC SUMMARY (same 6 metrics as the HTML dashboard's",
              "// P&L tab QC panel — drop these on a card/table on Page 4) ----------"
            ],
            "description": "Source: 12_TOT_Measures.dax"
          },
          {
            "name": "TOT Rows Avg Tot",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'Fact Primary Article' ), 'Fact Primary Article'[TOT Method] = \"avg_tot\" )"
            ],
            "description": "Source: 12_TOT_Measures.dax"
          },
          {
            "name": "TOT Rows Tax Calc",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'Fact Primary Article' ), 'Fact Primary Article'[TOT Method] = \"tax_calc\" )"
            ],
            "description": "Source: 12_TOT_Measures.dax"
          },
          {
            "name": "TOT Rows GST Fallback",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'Fact Primary Article' ), 'Fact Primary Article'[TOT Method] = \"gst_fallback\" )"
            ],
            "description": "Source: 12_TOT_Measures.dax"
          },
          {
            "name": "TOT Rows Invalid",
            "expression": [
              "CALCULATE ( COUNTROWS ( 'Fact Primary Article' ), 'Fact Primary Article'[TOT Method] = \"invalid\" )"
            ],
            "description": "Source: 12_TOT_Measures.dax"
          },
          {
            "name": "TOT Fallback MRP",
            "expression": [
              "CALCULATE ( SUM ( 'Fact Primary Article'[Primary MRP] ), 'Fact Primary Article'[TOT Method] = \"gst_fallback\" )"
            ],
            "description": "Source: 12_TOT_Measures.dax"
          },
          {
            "name": "TOT Fallback Pct of MRP",
            "expression": [
              "DIVIDE ( [TOT Fallback MRP], [Total Primary Article MRP] ) * 100",
              "",
              "// ---------- FINANCE SIGN-OFF ROLLUP (surface provisional status on-report) ----------"
            ],
            "description": "Source: 12_TOT_Measures.dax"
          },
          {
            "name": "Finance Approved Count",
            "expression": [
              "COUNTROWS ( FILTER ( 'GST Rate QC Table', 'GST Rate QC Table'[Finance_Approved] = \"Yes\" ) )"
            ],
            "description": "Source: 12_TOT_Measures.dax"
          },
          {
            "name": "Finance Approved Total",
            "expression": [
              "COUNTROWS ( 'GST Rate QC Table' )"
            ],
            "description": "Source: 12_TOT_Measures.dax"
          },
          {
            "name": "TOT Status Banner",
            "expression": [
              "VAR _fbPct = [TOT Fallback Pct of MRP]",
              "RETURN",
              "    IF ( ISBLANK ( _fbPct ) || _fbPct < 0.05,",
              "        \"TOT% sourced from actual Primary file data — the GST rate table fallback was not needed.\",",
              "        \"Partially provisional: \" & FORMAT ( _fbPct, \"0.0\" ) & \"% of MRP relies on the GST rate table \"",
              "            & \"fallback, pending Finance/Tax sign-off (\" & [Finance Approved Count] & \" of \"",
              "            & [Finance Approved Total] & \" categories confirmed).\"",
              "    )",
              "",
              "// ---------- WEIGHTED TOT% BY DIMENSION (for the Pack Size / Chain / Category export tables) ----------",
              "// [TOT %] already aggregates correctly (weighted by MRP, not a simple row",
              "// average) whenever it's dropped into a Chain/Category/Pack Size matrix or",
              "// table visual, since DIVIDE(sum,sum) at whatever grain the visual groups by",
              "// IS the weighted figure -- no separate \"Weighted TOT%\" measure is needed.",
              "// Rename the column header to \"Weighted TOT%\" in that visual if you want the",
              "// label to match the HTML dashboard's Pack Size export column name exactly.",
              "",
              "// ---------- IMPACT ON TOT% (materiality, for prioritising QC review) ----------",
              "// 'GST Rate QC Table'[Impact_on_TOT_pct] is auto-computed by",
              "// build_dashboard_data.py on every --detail-only rebuild (how much blended",
              "// TOT% would move, in pp, if that category's Post_GST_Rate_Pct were flipped",
              "// to the alternate slab, scoped to that category's OWN gst_fallback-tier",
              "// rows only). Power BI reads the same CSV, so drop that column straight into",
              "// the QC table visual (Page 4) -- no separate DAX measure needed; refresh",
              "// the CSV via the HTML dashboard's Python rebuild to update it."
            ],
            "description": "Source: 12_TOT_Measures.dax"
          },
          {
            "name": "Total Expense Amount Loaded",
            "expression": [
              "SUM ( 'PL Expense Input'[Expense Amount (INR Lakh)] )   // everything loaded, mapped or not",
              "",
              "// KEEPFILTERS: intersect with any filter already on [Resolved Chain] (e.g. the",
              "// chain filter in Total P&L Expense (by Chain)) instead of replacing it."
            ],
            "description": "Source: 13_CM2_Measures.dax"
          },
          {
            "name": "Total P&L Expense (Mapped)",
            "expression": [
              "CALCULATE ( [Total Expense Amount Loaded], KEEPFILTERS ( NOT ISBLANK ( 'PL Expense Input'[Resolved Chain] ) ) )"
            ],
            "description": "Source: 13_CM2_Measures.dax"
          },
          {
            "name": "Total P&L Expense (Unmapped)",
            "expression": [
              "[Total Expense Amount Loaded] - [Total P&L Expense (Mapped)]"
            ],
            "description": "Source: 13_CM2_Measures.dax"
          },
          {
            "name": "Total P&L Expense",
            "expression": [
              "[Total P&L Expense (Mapped)]   // headline KPI -- matches the HTML dashboard's cm2D.total_expense",
              "",
              "// ---------- CM2 (overall / KPI cards) ----------",
              "// [Total Primary Article NSV] comes from DAX/12_TOT_Measures.dax (already",
              "// scoped to TOT-valid FY26/FY27 rows).",
              "// Comparability gate: CM2 only means something when the expense covers the same",
              "// financial years as the NSV it is subtracted from. 1 = every FY that has NSV in the",
              "// current filter also has mapped expense rows; 0 = at least one FY has NSV but no",
              "// expense rows (e.g. no FY filter: FY26 NSV + FY27-only expense). Missing expense is",
              "// NOT zero expense, so the margin is withheld (BLANK) rather than shown. Month-level",
              "// and single-FY selections with expense stay comparable and are unchanged."
            ],
            "description": "Source: 13_CM2_Measures.dax"
          },
          {
            "name": "CM2 Comparable",
            "expression": [
              "VAR _missingFY =",
              "    COUNTROWS (",
              "        FILTER (",
              "            VALUES ( 'Date Table'[FY Year] ),",
              "            NOT ISBLANK ( [Total Primary Article NSV] ) && ISBLANK ( [Total P&L Expense] )",
              "        )",
              "    )",
              "RETURN IF ( _missingFY = 0, 1, 0 )"
            ],
            "description": "Source: 13_CM2_Measures.dax"
          },
          {
            "name": "Expense % of NSV",
            "expression": [
              "VAR _cmp = [CM2 Comparable]",
              "RETURN IF ( _cmp = 0, BLANK (), DIVIDE ( [Total P&L Expense], [Total Primary Article NSV] ) * 100 )",
              "",
              "// Availability gate (FM-33): [Total P&L Expense] is BLANK when no mapped expense",
              "// row exists in the current filter context. CM2 is then BLANK (shown as \"–\"),",
              "// never NSV read as a 100% margin -- missing expense is not zero expense.",
              "// Also BLANK when [CM2 Comparable] = 0 (see above): this is CM2 on LOADED costs only,",
              "// not full contribution margin -- COGS/logistics, distributor claims, field force and",
              "// provisions are not in PL_Expense_Input yet."
            ],
            "description": "Source: 13_CM2_Measures.dax"
          },
          {
            "name": "CM2 Value",
            "expression": [
              "VAR _exp = [Total P&L Expense]",
              "RETURN IF ( ISBLANK ( _exp ), BLANK (),",
              "    IF ( [CM2 Comparable] = 0, BLANK (), [Total Primary Article NSV] - _exp ) )"
            ],
            "description": "Source: 13_CM2_Measures.dax"
          },
          {
            "name": "CM2 %",
            "expression": [
              "DIVIDE ( [CM2 Value], [Total Primary Article NSV] ) * 100",
              "",
              "// ---------- MoM MOVEMENT (needs the Date Table -> PL Expense Input relationship) ----------"
            ],
            "description": "Source: 13_CM2_Measures.dax"
          },
          {
            "name": "MoM Expense Change",
            "expression": [
              "VAR _cur = [Total P&L Expense]",
              "VAR _prev = CALCULATE ( [Total P&L Expense], DATEADD ( 'Date Table'[Date], -1, MONTH ) )",
              "RETURN IF ( ISBLANK ( _cur ) || ISBLANK ( _prev ), BLANK(), _cur - _prev )"
            ],
            "description": "Source: 13_CM2_Measures.dax"
          },
          {
            "name": "MoM CM2 Change",
            "expression": [
              "VAR _cur = [CM2 Value]",
              "VAR _prev = CALCULATE ( [CM2 Value], DATEADD ( 'Date Table'[Date], -1, MONTH ) )",
              "RETURN IF ( ISBLANK ( _cur ) || ISBLANK ( _prev ), BLANK(), _cur - _prev )",
              "",
              "// ---------- CHAIN / BRAND / CATEGORY-WISE CM2 ----------",
              "// 'PL Expense Input' has NO modelled relationship to 'Fact Primary Article'",
              "// (the matching is fallback-priority logic, not a clean 1:many key) -- these",
              "// measures bridge the two tables explicitly via SELECTEDVALUE + TREATAS, one",
              "// per dimension, matching how the request names them as separate items.",
              "// Only the resolved-dimension column is filtered, and KEEPFILTERS intersects it",
              "// with the current context: Month/FY filters arriving through the Date Table",
              "// relationship stay active. (FILTER(ALL('PL Expense Input'), ...) cleared them,",
              "// so one month's CM2 could deduct a chain's expense from every month -- FM-33.)"
            ],
            "description": "Source: 13_CM2_Measures.dax"
          },
          {
            "name": "Total P&L Expense (by Chain)",
            "expression": [
              "VAR _chain = SELECTEDVALUE ( 'Fact Primary Article'[Chain] )",
              "RETURN",
              "    IF ( ISBLANK ( _chain ), [Total P&L Expense],",
              "        CALCULATE ( [Total P&L Expense], KEEPFILTERS ( TREATAS ( { _chain }, 'PL Expense Input'[Resolved Chain] ) ) )",
              "    )"
            ],
            "description": "Source: 13_CM2_Measures.dax"
          },
          {
            "name": "Chain-wise CM2",
            "expression": [
              "// BLANK for a chain with no mapped expense rows (not its NSV)",
              "VAR _exp = [Total P&L Expense (by Chain)]",
              "RETURN IF ( ISBLANK ( _exp ), BLANK (),",
              "    IF ( [CM2 Comparable] = 0, BLANK (), [Total Primary Article NSV] - _exp ) )"
            ],
            "description": "Source: 13_CM2_Measures.dax"
          },
          {
            "name": "Chain-wise CM2 %",
            "expression": [
              "DIVIDE ( [Chain-wise CM2], [Total Primary Article NSV] ) * 100"
            ],
            "description": "Source: 13_CM2_Measures.dax"
          },
          {
            "name": "Total P&L Expense (by Brand)",
            "expression": [
              "VAR _brand = SELECTEDVALUE ( 'Fact Primary Article'[Brand] )",
              "RETURN",
              "    IF ( ISBLANK ( _brand ), [Total P&L Expense],",
              "        CALCULATE ( [Total P&L Expense], KEEPFILTERS ( TREATAS ( { _brand }, 'PL Expense Input'[Resolved Brand] ) ) )",
              "    )"
            ],
            "description": "Source: 13_CM2_Measures.dax"
          },
          {
            "name": "Brand-wise CM2",
            "expression": [
              "// BLANK for a brand with no mapped expense rows (not its NSV)",
              "VAR _exp = [Total P&L Expense (by Brand)]",
              "RETURN IF ( ISBLANK ( _exp ), BLANK (),",
              "    IF ( [CM2 Comparable] = 0, BLANK (), [Total Primary Article NSV] - _exp ) )"
            ],
            "description": "Source: 13_CM2_Measures.dax"
          },
          {
            "name": "Brand-wise CM2 %",
            "expression": [
              "DIVIDE ( [Brand-wise CM2], [Total Primary Article NSV] ) * 100"
            ],
            "description": "Source: 13_CM2_Measures.dax"
          },
          {
            "name": "Total P&L Expense (by Category)",
            "expression": [
              "VAR _cat = SELECTEDVALUE ( 'Fact Primary Article'[Category] )",
              "RETURN",
              "    IF ( ISBLANK ( _cat ), [Total P&L Expense],",
              "        CALCULATE ( [Total P&L Expense], KEEPFILTERS ( TREATAS ( { _cat }, 'PL Expense Input'[Resolved Category] ) ) )",
              "    )"
            ],
            "description": "Source: 13_CM2_Measures.dax"
          },
          {
            "name": "Category-wise CM2",
            "expression": [
              "// BLANK for a category with no mapped expense rows (not its NSV)",
              "VAR _exp = [Total P&L Expense (by Category)]",
              "RETURN IF ( ISBLANK ( _exp ), BLANK (),",
              "    IF ( [CM2 Comparable] = 0, BLANK (), [Total Primary Article NSV] - _exp ) )"
            ],
            "description": "Source: 13_CM2_Measures.dax"
          },
          {
            "name": "Category-wise CM2 %",
            "expression": [
              "DIVIDE ( [Category-wise CM2], [Total Primary Article NSV] ) * 100",
              "",
              "// ---------- EXPENSE HEAD-WISE BREAKUP ----------",
              "// Drop 'PL Expense Input'[Expense Head] on a table/matrix row with this",
              "// measure -- ordinary row-context filtering on the SAME table applies",
              "// automatically, no bridging needed (unlike Chain/Brand/Category above,",
              "// which live on the OTHER table)."
            ],
            "description": "Source: 13_CM2_Measures.dax"
          },
          {
            "name": "Expense Head Amount",
            "expression": [
              "SUM ( 'PL Expense Input'[Expense Amount (INR Lakh)] )",
              "",
              "// ---------- QC SUMMARY (same metrics as the HTML dashboard's P&L tab QC panel) ----------"
            ],
            "description": "Source: 13_CM2_Measures.dax"
          },
          {
            "name": "Unmapped Chain Or Customer Rows",
            "expression": [
              "COUNTROWS ( FILTER ( 'PL Expense Input', ISBLANK ( 'PL Expense Input'[Resolved Chain] ) ) )"
            ],
            "description": "Source: 13_CM2_Measures.dax"
          },
          {
            "name": "Unmapped Brand Or Category Rows",
            "expression": [
              "COUNTROWS ( FILTER ( 'PL Expense Input', 'PL Expense Input'[Bad Brand Or Category] = TRUE() ) )"
            ],
            "description": "Source: 13_CM2_Measures.dax"
          },
          {
            "name": "Blank Month Rows",
            "expression": [
              "COUNTROWS ( FILTER ( 'PL Expense Input', ISBLANK ( 'PL Expense Input'[MonthStart] ) ) )"
            ],
            "description": "Source: 13_CM2_Measures.dax"
          },
          {
            "name": "Blank Expense Head Rows",
            "expression": [
              "COUNTROWS ( FILTER ( 'PL Expense Input',",
              "    ISBLANK ( 'PL Expense Input'[Expense Head] ) || TRIM ( 'PL Expense Input'[Expense Head] ) = \"\" ) )"
            ],
            "description": "Source: 13_CM2_Measures.dax"
          },
          {
            "name": "Duplicate Expense Rows",
            "expression": [
              "VAR _grouped =",
              "    SUMMARIZE (",
              "        'PL Expense Input',",
              "        'PL Expense Input'[Month], 'PL Expense Input'[FY], 'PL Expense Input'[Chain],",
              "        'PL Expense Input'[Customer Code], 'PL Expense Input'[Customer Name],",
              "        'PL Expense Input'[Brand], 'PL Expense Input'[Category], 'PL Expense Input'[Sub Category],",
              "        'PL Expense Input'[Expense Head], 'PL Expense Input'[Expense Type],",
              "        'PL Expense Input'[Expense Amount (INR Lakh)],",
              "        \"RowCount\", COUNTROWS ( 'PL Expense Input' )",
              "    )",
              "RETURN SUMX ( FILTER ( _grouped, [RowCount] > 1 ), [RowCount] - 1 )"
            ],
            "description": "Source: 13_CM2_Measures.dax"
          },
          {
            "name": "Secondary NSV Lakh",
            "expression": [
              "SUMX (",
              "    FILTER (",
              "        'Fact Secondary Sales',",
              "        'Fact Secondary Sales'[Is_Provisional] = FALSE()",
              "    ),",
              "    'Fact Secondary Sales'[NSV_Lakh]",
              ")"
            ],
            "description": "Source: 14_SecondarySales_Measures.dax"
          },
          {
            "name": "Secondary NSV Lakh (Incl Provisional)",
            "expression": [
              "SUM ( 'Fact Secondary Sales'[NSV_Lakh] )"
            ],
            "description": "Source: 14_SecondarySales_Measures.dax"
          },
          {
            "name": "Secondary NSV Cr",
            "expression": [
              "DIVIDE ( [Secondary NSV Lakh], 100 )"
            ],
            "description": "Source: 14_SecondarySales_Measures.dax"
          },
          {
            "name": "Secondary Distributor Count",
            "expression": [
              "DISTINCTCOUNT ( 'Fact Secondary Sales'[Distributor] )",
              "",
              "",
              "// ── Month-over-Month ───────────────────────────────────────────────────────"
            ],
            "description": "Source: 14_SecondarySales_Measures.dax"
          },
          {
            "name": "Secondary NSV MoM Δ Lakh",
            "expression": [
              "VAR _cur  = [Secondary NSV Lakh]",
              "VAR _prev =",
              "    CALCULATE (",
              "        [Secondary NSV Lakh],",
              "        DATEADD ( 'Date Table'[Date], -1, MONTH )",
              "    )",
              "RETURN",
              "    IF ( ISBLANK ( _prev ), BLANK (), _cur - _prev )"
            ],
            "description": "Source: 14_SecondarySales_Measures.dax"
          },
          {
            "name": "Secondary NSV MoM % Δ",
            "expression": [
              "VAR _cur  = [Secondary NSV Lakh]",
              "VAR _prev =",
              "    CALCULATE (",
              "        [Secondary NSV Lakh],",
              "        DATEADD ( 'Date Table'[Date], -1, MONTH )",
              "    )",
              "RETURN",
              "    DIVIDE ( _cur - _prev, _prev )",
              "",
              "",
              "// ── Sell-Through (Secondary ÷ Primary) ────────────────────────────────────",
              "// \"Sell-through\" = what proportion of primary dispatched was sold through",
              "// by the distributor to the MT store. Healthy range: 75–110%.",
              "// Values > 110% indicate pipeline drawdown; < 75% = under-liquidation."
            ],
            "description": "Source: 14_SecondarySales_Measures.dax"
          },
          {
            "name": "Sell-Through %",
            "expression": [
              "VAR _secondary = [Secondary NSV Lakh]",
              "VAR _primary   = DIVIDE ( [Total Primary Article NSV], 100000 )  // model rupees -> lakh",
              "RETURN",
              "    DIVIDE ( _secondary, _primary )"
            ],
            "description": "Source: 14_SecondarySales_Measures.dax"
          },
          {
            "name": "Sell-Through % (Capped 200)",
            "expression": [
              "VAR _raw = [Sell-Through %]",
              "RETURN",
              "    IF ( _raw > 2, 2, _raw )"
            ],
            "description": "Source: 14_SecondarySales_Measures.dax"
          },
          {
            "name": "Sell-Through Signal",
            "expression": [
              "VAR _st = [Sell-Through %]",
              "RETURN",
              "    IF (",
              "        ISBLANK ( _st ), \"–\",",
              "        IF ( _st >= 1.10, \"Pipeline Drawdown\",",
              "        IF ( _st >= 0.75, \"On-Track\",",
              "             \"Under-Liquidation\" ))",
              "    )",
              "",
              "",
              "// ── Distributor-level ranking ──────────────────────────────────────────────"
            ],
            "description": "Source: 14_SecondarySales_Measures.dax"
          },
          {
            "name": "Secondary NSV Rank",
            "expression": [
              "RANKX (",
              "    ALLSELECTED ( 'Fact Secondary Sales'[Distributor] ),",
              "    [Secondary NSV Lakh],",
              "    ,",
              "    DESC,",
              "    DENSE",
              ")"
            ],
            "description": "Source: 14_SecondarySales_Measures.dax"
          },
          {
            "name": "Secondary NSV Distributor Share %",
            "expression": [
              "DIVIDE (",
              "    [Secondary NSV Lakh],",
              "    CALCULATE ( [Secondary NSV Lakh], ALLSELECTED ( 'Fact Secondary Sales'[Distributor] ) )",
              ")",
              "",
              "",
              "// ── Q1 FY27 aggregates (period-fixed, for scorecards) ─────────────────────"
            ],
            "description": "Source: 14_SecondarySales_Measures.dax"
          },
          {
            "name": "Q1 FY27 Secondary NSV Lakh",
            "expression": [
              "CALCULATE (",
              "    [Secondary NSV Lakh],",
              "    'Date Table'[FY Year] = \"26-27\",",
              "    'Date Table'[Quarter] = \"Q1\"",
              ")"
            ],
            "description": "Source: 14_SecondarySales_Measures.dax"
          },
          {
            "name": "Q1 FY27 Secondary NSV Cr",
            "expression": [
              "DIVIDE ( [Q1 FY27 Secondary NSV Lakh], 100 )",
              "",
              "",
              "// ── Claim context (from Fact Claim Master) ────────────────────────────────",
              "// Claim as % of secondary sell-out NSV (a different ratio to the",
              "// claim-as-%-of-primary-NSV computed in 13_CM2_Measures.dax)."
            ],
            "description": "Source: 14_SecondarySales_Measures.dax"
          },
          {
            "name": "Claim % of Secondary NSV",
            "expression": [
              "VAR _claim    = SUM ( 'Fact Claim Master'[Amount_Lakh] )",
              "VAR _secondary = [Secondary NSV Lakh]",
              "RETURN",
              "    DIVIDE ( _claim, _secondary )",
              "",
              "",
              "// ── Display labels ────────────────────────────────────────────────────────"
            ],
            "description": "Source: 14_SecondarySales_Measures.dax"
          },
          {
            "name": "Secondary NSV Label",
            "expression": [
              "VAR _val = [Secondary NSV Lakh]",
              "RETURN",
              "    IF (",
              "        ISBLANK ( _val ), \"–\",",
              "        IF ( _val >= 100,",
              "            \"₹\" & FORMAT ( DIVIDE ( _val, 100 ), \"0.0\" ) & \" Cr\",",
              "            \"₹\" & FORMAT ( _val, \"0.0\" ) & \" L\"",
              "        )",
              "    )"
            ],
            "description": "Source: 14_SecondarySales_Measures.dax"
          },
          {
            "name": "Sell-Through Label",
            "expression": [
              "VAR _st = [Sell-Through %]",
              "RETURN",
              "    IF ( ISBLANK ( _st ), \"–\", FORMAT ( _st, \"0.0%\" ) )"
            ],
            "description": "Source: 14_SecondarySales_Measures.dax"
          },
          {
            "name": "Actual NSV Lakh",
            "expression": [
              "SUM('Fact Secondary TOT Hierarchy'[NSV_Lakh])"
            ],
            "description": "Source: 15_Promo_Measures.dax"
          },
          {
            "name": "Actual Promoted NSV Lakh",
            "expression": [
              "CALCULATE(",
              "    [Actual NSV Lakh],",
              "    KEEPFILTERS(NOT(ISBLANK('Dim Promo Calendar'[EAN Code])))",
              ")"
            ],
            "description": "Source: 15_Promo_Measures.dax"
          },
          {
            "name": "Baseline Non-Promoted NSV Lakh",
            "expression": [
              "[Actual NSV Lakh] - [Actual Promoted NSV Lakh]"
            ],
            "description": "Source: 15_Promo_Measures.dax"
          },
          {
            "name": "Active Promo Offer Count",
            "expression": [
              "DISTINCTCOUNT('Dim Promo Calendar'[Promo_Key])"
            ],
            "description": "Source: 15_Promo_Measures.dax"
          },
          {
            "name": "Promoted NSV Share %",
            "expression": [
              "DIVIDE(",
              "    [Actual Promoted NSV Lakh],",
              "    [Actual NSV Lakh],",
              "    0",
              ")"
            ],
            "description": "Source: 15_Promo_Measures.dax"
          },
          {
            "name": "Promoted SKU Breadth %",
            "expression": [
              "VAR PromotedSKUs =",
              "    CALCULATE(",
              "        DISTINCTCOUNT('Fact Secondary TOT Hierarchy'[EAN]),",
              "        KEEPFILTERS(NOT(ISBLANK('Dim Promo Calendar'[EAN Code])))",
              "    )",
              "VAR TotalSKUs =",
              "    DISTINCTCOUNT('Fact Secondary TOT Hierarchy'[EAN])",
              "RETURN",
              "    DIVIDE(PromotedSKUs, TotalSKUs, 0)",
              "",
              "// --- SECTION 2: PLANNED PROMOTIONAL MECHANICS & SPEND ---"
            ],
            "description": "Source: 15_Promo_Measures.dax"
          },
          {
            "name": "Planned Promo Discount %",
            "expression": [
              "VAR WeightedDiscount =",
              "    SUMX(",
              "        'Dim Promo Calendar',",
              "        IFERROR(VALUE('Dim Promo Calendar'[Offer to consumer]), BLANK())  // text offers such as \"BOGO\" have no % discount",
              "    )",
              "VAR OfferCount =",
              "    COUNTX(",
              "        'Dim Promo Calendar',",
              "        IFERROR(VALUE('Dim Promo Calendar'[Offer to consumer]), BLANK())",
              "    )",
              "RETURN",
              "    DIVIDE(WeightedDiscount, OfferCount)   // blank, not 0, when no row has a numeric offer"
            ],
            "description": "Source: 15_Promo_Measures.dax"
          },
          {
            "name": "Planned Company Trade Spend %",
            "expression": [
              "VAR WeightedCompanyShare =",
              "    SUMX(",
              "        'Dim Promo Calendar',",
              "        'Dim Promo Calendar'[ME_Contribution_Pct]",
              "    )",
              "VAR OfferCount = COUNTROWS('Dim Promo Calendar')",
              "RETURN",
              "    DIVIDE(WeightedCompanyShare, OfferCount, 0)"
            ],
            "description": "Source: 15_Promo_Measures.dax"
          },
          {
            "name": "Planned Trade Spend Value Lakh",
            "expression": [
              "SUMX(",
              "    VALUES('Dim Promo Calendar'[EAN Code]),",
              "    VAR EAN_NSV = CALCULATE([Actual Promoted NSV Lakh])",
              "    VAR EAN_Company_Discount =",
              "        CALCULATE(",
              "            AVERAGE('Dim Promo Calendar'[ME_Contribution_Pct])",
              "        )",
              "    RETURN",
              "        EAN_NSV * EAN_Company_Discount / 100",
              ")",
              "",
              "// --- SECTION 3: SPEND VARIANCE (PLANNED VS ACTUAL) ---"
            ],
            "description": "Source: 15_Promo_Measures.dax"
          },
          {
            "name": "Actual Claim Expense Lakh",
            "expression": [
              "CALCULATE(",
              "    SUM('Fact Claim Master'[Amount_Lakh]),",
              "    REMOVEFILTERS('Dim Promo Calendar'),",
              "    REMOVEFILTERS('Fact Secondary TOT Hierarchy')",
              ")"
            ],
            "description": "Source: 15_Promo_Measures.dax"
          },
          {
            "name": "Promo Spend Variance Lakh",
            "expression": [
              "[Planned Trade Spend Value Lakh] - [Actual Claim Expense Lakh]"
            ],
            "description": "Source: 15_Promo_Measures.dax"
          },
          {
            "name": "Promo Spend Variance %",
            "expression": [
              "DIVIDE(",
              "    [Promo Spend Variance Lakh],",
              "    [Planned Trade Spend Value Lakh],",
              "    0",
              ")"
            ],
            "description": "Source: 15_Promo_Measures.dax"
          },
          {
            "name": "Promo Execution Status",
            "expression": [
              "VAR VariancePct = [Promo Spend Variance %]",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        ISBLANK([Actual Promoted NSV Lakh]), \"No Actual Offtake\",",
              "        VariancePct < -0.15, \"Over-Spent vs Plan (High Risk)\",",
              "        VariancePct > 0.15, \"Under-Utilized Plan\",",
              "        \"On-Plan (Within ±15%)\"",
              "    )",
              "",
              "// --- SECTION 4: INCREMENTAL LIFT & ROI ---"
            ],
            "description": "Source: 15_Promo_Measures.dax"
          },
          {
            "name": "Historical Baseline Velocity Lakh",
            "expression": [
              "VAR CurrentDate = MAX('Date Table'[Date])",
              "RETURN",
              "    CALCULATE(",
              "        AVERAGEX(",
              "            VALUES('Date Table'[Month]),",
              "            [Actual NSV Lakh]",
              "        ),",
              "        DATESINPERIOD(",
              "            'Date Table'[Date],",
              "            EDATE(CurrentDate, -1),",
              "            -3,",
              "            MONTH",
              "        ),",
              "        REMOVEFILTERS('Dim Promo Calendar')",
              "    )"
            ],
            "description": "Source: 15_Promo_Measures.dax"
          },
          {
            "name": "Incremental Promo NSV Lakh",
            "expression": [
              "VAR Baseline = [Historical Baseline Velocity Lakh]",
              "VAR Actuals = [Actual Promoted NSV Lakh]",
              "VAR Lift = Actuals - Baseline",
              "RETURN",
              "    IF(",
              "        ISBLANK(Actuals),",
              "        BLANK(),",
              "        MAX(0, Lift)",
              "    )"
            ],
            "description": "Source: 15_Promo_Measures.dax"
          },
          {
            "name": "Promo Volume Lift %",
            "expression": [
              "DIVIDE(",
              "    [Incremental Promo NSV Lakh],",
              "    [Historical Baseline Velocity Lakh],",
              "    0",
              ")"
            ],
            "description": "Source: 15_Promo_Measures.dax"
          },
          {
            "name": "Promo Trade Spend ROI",
            "expression": [
              "DIVIDE(",
              "    [Incremental Promo NSV Lakh],",
              "    [Actual Claim Expense Lakh],",
              "    0",
              ")"
            ],
            "description": "Source: 15_Promo_Measures.dax"
          },
          {
            "name": "Promo Net Margin ROI",
            "expression": [
              "VAR BaseGrossMarginPct = 0.40",
              "VAR IncrementalGrossProfit = [Incremental Promo NSV Lakh] * BaseGrossMarginPct",
              "VAR TotalPromoCost = [Actual Claim Expense Lakh]",
              "VAR NetGain = IncrementalGrossProfit - TotalPromoCost",
              "RETURN",
              "    DIVIDE(NetGain, TotalPromoCost, 0)"
            ],
            "description": "Source: 15_Promo_Measures.dax"
          },
          {
            "name": "Promo ROI Performance Band",
            "expression": [
              "VAR ROI = [Promo Trade Spend ROI]",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        ISBLANK([Actual Promoted NSV Lakh]), \"No Activity\",",
              "        [Actual Claim Expense Lakh] = 0 && [Actual Promoted NSV Lakh] > 0, \"Self-Liquidating\",",
              "        ROI >= 3.0, \"🟢 High ROI (≥3.0x)\",",
              "        ROI >= 1.5, \"🟡 Moderate ROI (1.5-3.0x)\",",
              "        ROI >= 1.0, \"🟠 Break-even (1.0-1.5x)\",",
              "        \"🔴 Value Destroying (<1.0x)\"",
              "    )",
              "",
              "// ==============================================================================",
              "// USAGE NOTES:",
              "// ==============================================================================",
              "// 1. Relationships required:",
              "//    - 'Dim Promo Calendar'[EAN Code] → 'Fact Secondary TOT Hierarchy'[EAN]",
              "//    - 'Date Table'[MonthStart] → 'Fact Secondary TOT Hierarchy'[MonthStart]  (in model.bim)",
              "//    - No Brand relationship is built. Brand names differ in case between the files; use the Brand slicer on the fact.",
              "//    - The promo file is Sep-26 and the sell-out file is Apr-Aug-26, so \"promoted NSV\" means sell-out of EANs promoted in September.",
              "//",
              "// 2. Slicers recommended:",
              "//    - 'Date Table'[Month] (Sep-26)",
              "//    - 'Brand Master'[Brand]",
              "//    - 'Chain Master'[Chain]",
              "//    - 'Dim Promo Calendar'[Promo_Type] (Consumer Promotion, etc.)",
              "//",
              "// 3. Conditional formatting:",
              "//    - [Promo Spend Variance %]: <-15% = Red, -15% to +15% = Green, >15% = Amber",
              "//    - [Promo Trade Spend ROI]: >3.0x = Green, 1.5-3.0x = Yellow, <1.0x = Red",
              "//",
              "// 4. Interpretation:",
              "//    - Positive [Promo Spend Variance Lakh] = Planned spend not fully utilized",
              "//    - Positive [Incremental Promo NSV Lakh] = Promo drove incremental sales",
              "//    - [Promo Trade Spend ROI] = Incremental NSV ÷ Claim Spend ratio",
              "//    - [Promo Net Margin ROI] = (Margin Profit - Cost) ÷ Cost (gauges true profitability)",
              "//",
              "// =============================================================================="
            ],
            "description": "Source: 15_Promo_Measures.dax"
          },
          {
            "name": "MT Offtake Qty",
            "expression": [
              "CALCULATE ( [Total Offtake Qty], 'Chain Master'[Channel] = \"MT\" )"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "MT MRP Sales",
            "expression": [
              "CALCULATE ( [Total MRP Sales],   'Chain Master'[Channel] = \"MT\" )"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "MT ASP",
            "expression": [
              "DIVIDE ( [Total MT NSV], [MT Offtake Qty] )",
              "",
              "// NSV as a share of MRP sales: how much of the shelf price we keep"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "MT Realisation %",
            "expression": [
              "DIVIDE ( [Total MT NSV], [MT MRP Sales] )"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "MT Offtake Qty PM",
            "expression": [
              "CALCULATE ( [MT Offtake Qty], DATEADD ( 'Date Table'[Date], -1, MONTH ) )"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "MT ASP PM",
            "expression": [
              "CALCULATE ( [MT ASP],         DATEADD ( 'Date Table'[Date], -1, MONTH ) )"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "MT Volume Effect MoM",
            "expression": [
              "IF ( ISBLANK ( [MT ASP PM] ), BLANK (), [MT ASP PM] * ( [MT Offtake Qty] - [MT Offtake Qty PM] ) )"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "MT Price Mix Effect MoM",
            "expression": [
              "IF ( ISBLANK ( [MT ASP PM] ), BLANK (), [MT Offtake Qty] * ( [MT ASP] - [MT ASP PM] ) )"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "MT Price Volume Check MoM",
            "expression": [
              "[MT Volume Effect MoM] + [MT Price Mix Effect MoM] - ( [Total MT NSV] - CALCULATE ( [Total MT NSV], DATEADD ( 'Date Table'[Date], -1, MONTH ) ) )"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "MT Volume Effect YoY",
            "expression": [
              "VAR _asp = CALCULATE ( [MT ASP], DATEADD ( 'Date Table'[Date], -12, MONTH ) )",
              "VAR _qty = CALCULATE ( [MT Offtake Qty], DATEADD ( 'Date Table'[Date], -12, MONTH ) )",
              "RETURN IF ( ISBLANK ( _asp ), BLANK (), _asp * ( [MT Offtake Qty] - _qty ) )"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "MT Price Mix Effect YoY",
            "expression": [
              "VAR _asp = CALCULATE ( [MT ASP], DATEADD ( 'Date Table'[Date], -12, MONTH ) )",
              "RETURN IF ( ISBLANK ( _asp ), BLANK (), [MT Offtake Qty] * ( [MT ASP] - _asp ) )",
              "",
              "// zone (or chain / brand) ASP against the MT average, 100 = average"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "Zone Price Index",
            "expression": [
              "DIVIDE ( [MT ASP], CALCULATE ( [MT ASP], ALL ( 'Fact Offtake Sales'[Zone] ) ) ) * 100"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "Chain Price Index",
            "expression": [
              "DIVIDE ( [MT ASP], CALCULATE ( [MT ASP], ALL ( 'Chain Master'[Chain] ) ) ) * 100",
              "",
              "// ---------- NIELSEN (consumer offtake, IN URB MT) ----------",
              "// Fact Nielsen[Volume 000 L] and [Price Per Ml] are loaded when the drop file carries them."
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "Nielsen Volume 000 L",
            "expression": [
              "SUM ( 'Fact Nielsen'[Volume 000 L] )",
              "",
              "// Rs per ml = Rs / ( thousand litres x 1000 x 1000 )"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "Nielsen Price Per Ml",
            "expression": [
              "DIVIDE ( [Our Brand Sales], [Nielsen Volume 000 L] * 1000000 )"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "Nielsen Volume Effect YoY",
            "expression": [
              "VAR _vol = CALCULATE ( [Nielsen Volume 000 L], DATEADD ( 'Date Table'[Date], -12, MONTH ) )",
              "VAR _ppml = CALCULATE ( [Nielsen Price Per Ml], DATEADD ( 'Date Table'[Date], -12, MONTH ) )",
              "RETURN IF ( ISBLANK ( _ppml ), BLANK (), ( [Nielsen Volume 000 L] - _vol ) * _ppml * 1000000 )"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "Nielsen Price Mix Effect YoY",
            "expression": [
              "VAR _ppml = CALCULATE ( [Nielsen Price Per Ml], DATEADD ( 'Date Table'[Date], -12, MONTH ) )",
              "RETURN IF ( ISBLANK ( _ppml ), BLANK (), [Nielsen Volume 000 L] * ( [Nielsen Price Per Ml] - _ppml ) * 1000000 )",
              "",
              "// ---------- CATEGORY PRESENCE (our own mix; Nielsen sizes only Facewash and Shampoo) ----------",
              "// A sub-category that earns a real share of our NSV in all chains but little in one chain is a",
              "// presence gap. Market size by category needs a Nielsen export for that category."
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "Subcat Share In Chain %",
            "expression": [
              "DIVIDE ( [Total MT NSV], CALCULATE ( [Total MT NSV], ALL ( 'Fact Offtake Sales'[Sub-category] ) ) )"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "Subcat Share All Chains %",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( [Total MT NSV], ALL ( 'Chain Master'[Chain] ) ),",
              "    CALCULATE ( [Total MT NSV], ALL ( 'Chain Master'[Chain] ), ALL ( 'Fact Offtake Sales'[Sub-category] ) )",
              ")"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "Subcat Presence Status",
            "expression": [
              "VAR _all = [Subcat Share All Chains %]",
              "VAR _in = COALESCE ( [Subcat Share In Chain %], 0 )",
              "RETURN",
              "    IF ( ISBLANK ( _all ) || _all < 0.02, BLANK (),",
              "        IF ( _in <= 0, \"Absent\", IF ( _in < _all * 0.6, \"Under-weight\", \"Present\" ) ) )"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "Subcat Gap NSV",
            "expression": [
              "VAR _gap = MAX ( [Subcat Share All Chains %] - COALESCE ( [Subcat Share In Chain %], 0 ), 0 )",
              "RETURN IF ( [Subcat Presence Status] IN { \"Absent\", \"Under-weight\" },",
              "    _gap * CALCULATE ( [Total MT NSV], ALL ( 'Fact Offtake Sales'[Sub-category] ) ) )",
              "",
              "// ---------- CORPORATE-VISIT CITIES (tables: 'Store City Master', 'Visit City List') ----------",
              "// Needs 'Fact Offtake Sales'[Match Key] (calculated column, see 49_Store_City_Master.pq) related to 'Store City Master'[Match Key]."
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "Visit Stores",
            "expression": [
              "DISTINCTCOUNT ( 'Store City Master'[Store Key] )"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "Visit City NSV",
            "expression": [
              "CALCULATE ( [Total MT NSV], 'Store City Master'[Visit Status] = \"Considered\" )"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "Near Listed NSV",
            "expression": [
              "CALCULATE ( [Total MT NSV], 'Store City Master'[Visit Status] = \"Near listed city\" )",
              "",
              "// share of MT NSV that is attached to a store in the master (should be close to 100%)"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "Visit Master Match %",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( [Total MT NSV], NOT ISBLANK ( 'Store City Master'[Store Key] ) ),",
              "    [Total MT NSV]",
              ")"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "Visit City NSV MoM %",
            "expression": [
              "VAR _pm = CALCULATE ( [Visit City NSV], DATEADD ( 'Date Table'[Date], -1, MONTH ) )",
              "RETURN DIVIDE ( [Visit City NSV] - _pm, _pm )",
              "",
              "// ---------- ONE STORE UNIVERSE (Executive Cockpit and Inventory & Supply Health use the same count) ----------",
              "// POS stores = distinct Store Code selling in the selected month(s). Chains in 'Store Universe Overrides' are taken from that table",
              "// instead: TENTATIVE counts are added, NA chains (Nykaa / FSN) are not counted."
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "Universe POS Stores",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( 'Fact Offtake Sales'[Store Code] ),",
              "    NOT ( 'Fact Offtake Sales'[Chain] IN VALUES ( 'Store Universe Overrides'[Offtake Chain] ) )",
              ")"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "Universe Tentative Stores",
            "expression": [
              "CALCULATE ( SUM ( 'Store Universe Overrides'[Store Count] ), 'Store Universe Overrides'[Status] = \"TENTATIVE\" )"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "Universe Stores",
            "expression": [
              "[Universe POS Stores] + COALESCE ( [Universe Tentative Stores], 0 )"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "Universe Stores Note",
            "expression": [
              "\"Includes ~\" & FORMAT ( COALESCE ( [Universe Tentative Stores], 0 ), \"#,0\" ) & \" tentative stores (Reliance Retail, More Retail); Nykaa / FSN is NA\"",
              "",
              "// actual universe (stores in the maintained store master, Brand Counter counters left out) against the stores counted as available"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "Universe Master Stores",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( 'Store City Master'[Store Key] ),",
              "    NOT ( CONTAINSSTRING ( 'Store City Master'[Store Key], \"|NO-CITY\" ) ),",
              "    'Store City Master'[Chain Name] <> \"Reliance Brand Counter\"",
              ")"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "Universe Availability %",
            "expression": [
              "DIVIDE ( [Universe Stores], [Universe Master Stores] )"
            ],
            "description": "Source: 16_PriceVolume_Measures.dax"
          },
          {
            "name": "Account Sales Lakh",
            "expression": [
              "CALCULATE ( SUM ( 'Fact Account Category'[Account Sales Rs L] ), 'Fact Account Category'[Level] = \"Category\" )"
            ],
            "description": "Source: 17_Account_Share_Measures.dax"
          },
          {
            "name": "Our Account Sales Lakh",
            "expression": [
              "CALCULATE ( SUM ( 'Fact Account Category'[Honasa Sales Rs L] ), 'Fact Account Category'[Level] = \"Category\" )"
            ],
            "description": "Source: 17_Account_Share_Measures.dax"
          },
          {
            "name": "Account Share %",
            "expression": [
              "DIVIDE ( [Our Account Sales Lakh], [Account Sales Lakh] )"
            ],
            "description": "Source: 17_Account_Share_Measures.dax"
          },
          {
            "name": "Account Sales MoM %",
            "expression": [
              "VAR _pm = CALCULATE ( [Account Sales Lakh], DATEADD ( 'Date Table'[Date], -1, MONTH ) )",
              "RETURN DIVIDE ( [Account Sales Lakh] - _pm, _pm )"
            ],
            "description": "Source: 17_Account_Share_Measures.dax"
          },
          {
            "name": "Our Account Sales MoM %",
            "expression": [
              "VAR _pm = CALCULATE ( [Our Account Sales Lakh], DATEADD ( 'Date Table'[Date], -1, MONTH ) )",
              "RETURN DIVIDE ( [Our Account Sales Lakh] - _pm, _pm )"
            ],
            "description": "Source: 17_Account_Share_Measures.dax"
          },
          {
            "name": "Account Share Change pp",
            "expression": [
              "( [Account Share %] - CALCULATE ( [Account Share %], DATEADD ( 'Date Table'[Date], -1, MONTH ) ) ) * 100"
            ],
            "description": "Source: 17_Account_Share_Measures.dax"
          },
          {
            "name": "Account Face Wash Share %",
            "expression": [
              "CALCULATE ( [Account Share %], 'Fact Account Category'[Common Category] = \"Face Wash & Cleanser\" )",
              "",
              "// the category's weight in the chain's category sales, and our chain-wide share (all categories in the same chain and month)"
            ],
            "description": "Source: 17_Account_Share_Measures.dax"
          },
          {
            "name": "Account Category % Of Chain",
            "expression": [
              "DIVIDE ( [Account Sales Lakh], CALCULATE ( [Account Sales Lakh], ALL ( 'Fact Account Category'[Category], 'Fact Account Category'[Common Category] ) ) )"
            ],
            "description": "Source: 17_Account_Share_Measures.dax"
          },
          {
            "name": "Account Chain Share %",
            "expression": [
              "CALCULATE ( [Account Share %], ALL ( 'Fact Account Category'[Category], 'Fact Account Category'[Common Category] ) )"
            ],
            "description": "Source: 17_Account_Share_Measures.dax"
          },
          {
            "name": "Our Articles In Category",
            "expression": [
              "MAX ( 'Fact Account Assortment'[Articles] )",
              "",
              "// white space: category is 2% or more of the chain and our share is under 0.5%; low assortment: 3 or fewer articles and below the chain share",
              "// only categories that matter to us (at least 0.5% of our own sales across the chains, not \"Other\") are ever flagged: [Relevant For Us] = \"No\" gives a blank"
            ],
            "description": "Source: 17_Account_Share_Measures.dax"
          },
          {
            "name": "Account White Space Flag",
            "expression": [
              "VAR _rel = SELECTEDVALUE ( 'Fact Account Category'[Relevant For Us], \"Yes\" )",
              "VAR _pct = [Account Category % Of Chain]",
              "VAR _share = COALESCE ( [Account Share %], 0 )",
              "VAR _chain = [Account Chain Share %]",
              "VAR _art = [Our Articles In Category]",
              "RETURN",
              "    IF ( _rel = \"No\" || ISBLANK ( _pct ) || _pct < 0.02, BLANK (),",
              "        IF ( _share < 0.005, \"White space\",",
              "            IF ( NOT ISBLANK ( _art ) && _art <= 3 && _share < _chain, \"Low assortment\",",
              "                IF ( _share < _chain * 0.5, \"Below chain average\",",
              "                    IF ( _share >= _chain * 1.5, \"Strong\", BLANK () ) ) ) ) )",
              "",
              "// our share in the rest of our range (without Face Wash and Shampoo): the realistic target for a thin category"
            ],
            "description": "Source: 17_Account_Share_Measures.dax"
          },
          {
            "name": "Account Rest Of Range Share %",
            "expression": [
              "CALCULATE ( [Account Share %], ALL ( 'Fact Account Category'[Category], 'Fact Account Category'[Common Category] ),",
              "    NOT ( 'Fact Account Category'[Common Category] IN { \"Face Wash & Cleanser\", \"Shampoo\" } ) )",
              "",
              "// gap to that target, Rs lakh a month, for white space / low assortment / below average rows (Face Wash and Shampoo use the chain-wide share)"
            ],
            "description": "Source: 17_Account_Share_Measures.dax"
          },
          {
            "name": "Account Share Gap Lakh",
            "expression": [
              "VAR _c = SELECTEDVALUE ( 'Fact Account Category'[Common Category] )",
              "VAR _target = IF ( _c IN { \"Face Wash & Cleanser\", \"Shampoo\" }, [Account Chain Share %], [Account Rest Of Range Share %] )",
              "RETURN",
              "IF ( [Account White Space Flag] IN { \"White space\", \"Low assortment\", \"Below chain average\" },",
              "    MAX ( _target - COALESCE ( [Account Share %], 0 ), 0 ) * [Account Sales Lakh] )"
            ],
            "description": "Source: 17_Account_Share_Measures.dax"
          },
          {
            "name": "Account Scope Note",
            "expression": [
              "SELECTEDVALUE ( 'Fact Account Category'[Scope], \"More than one scope selected\" )",
              "",
              "// zone / state / city cuts (Lulu, More Retail and Reliance; Wellness Forever has category level only)"
            ],
            "description": "Source: 17_Account_Share_Measures.dax"
          },
          {
            "name": "Account Geo Sales Lakh",
            "expression": [
              "SUM ( 'Fact Account Category Geo'[Account Sales Rs L] )"
            ],
            "description": "Source: 17_Account_Share_Measures.dax"
          },
          {
            "name": "Our Geo Sales Lakh",
            "expression": [
              "SUM ( 'Fact Account Category Geo'[Honasa Sales Rs L] )"
            ],
            "description": "Source: 17_Account_Share_Measures.dax"
          },
          {
            "name": "Account Geo Share %",
            "expression": [
              "DIVIDE ( [Our Geo Sales Lakh], [Account Geo Sales Lakh] )"
            ],
            "description": "Source: 17_Account_Share_Measures.dax"
          },
          {
            "name": "Cut Brand Value Cr",
            "expression": [
              "CALCULATE ( SUM ( 'Fact Nielsen Brand Cut'[Value Cr] ), 'Fact Nielsen Brand Cut'[Is Category Row] = \"No\" )"
            ],
            "description": "Source: 18_Nielsen_Brand_Cut_Measures.dax"
          },
          {
            "name": "Cut Category Value Cr",
            "expression": [
              "CALCULATE ( SUM ( 'Fact Nielsen Brand Cut'[Value Cr] ), 'Fact Nielsen Brand Cut'[Is Category Row] = \"Yes\", REMOVEFILTERS ( 'Fact Nielsen Brand Cut'[Brand] ) )"
            ],
            "description": "Source: 18_Nielsen_Brand_Cut_Measures.dax"
          },
          {
            "name": "Cut Value Share %",
            "expression": [
              "CALCULATE ( AVERAGE ( 'Fact Nielsen Brand Cut'[Value Share %] ), 'Fact Nielsen Brand Cut'[Is Category Row] = \"No\" )"
            ],
            "description": "Source: 18_Nielsen_Brand_Cut_Measures.dax"
          },
          {
            "name": "Cut Volume Share %",
            "expression": [
              "CALCULATE ( AVERAGE ( 'Fact Nielsen Brand Cut'[Volume Share %] ), 'Fact Nielsen Brand Cut'[Is Category Row] = \"No\" )",
              "// value share above volume share = the brand sells at a price above the category average"
            ],
            "description": "Source: 18_Nielsen_Brand_Cut_Measures.dax"
          },
          {
            "name": "Cut Value Less Volume Share pp",
            "expression": [
              "( [Cut Value Share %] - [Cut Volume Share %] ) * 100"
            ],
            "description": "Source: 18_Nielsen_Brand_Cut_Measures.dax"
          },
          {
            "name": "Cut Brand Price Per Ml",
            "expression": [
              "CALCULATE ( AVERAGE ( 'Fact Nielsen Brand Cut'[Price Per Ml] ), 'Fact Nielsen Brand Cut'[Is Category Row] = \"No\" )"
            ],
            "description": "Source: 18_Nielsen_Brand_Cut_Measures.dax"
          },
          {
            "name": "Cut Category Price Per Ml",
            "expression": [
              "CALCULATE ( AVERAGE ( 'Fact Nielsen Brand Cut'[Price Per Ml] ), 'Fact Nielsen Brand Cut'[Is Category Row] = \"Yes\", REMOVEFILTERS ( 'Fact Nielsen Brand Cut'[Brand] ) )",
              "// 100 = the category price per ml"
            ],
            "description": "Source: 18_Nielsen_Brand_Cut_Measures.dax"
          },
          {
            "name": "Cut Price Index",
            "expression": [
              "DIVIDE ( [Cut Brand Price Per Ml], [Cut Category Price Per Ml] ) * 100"
            ],
            "description": "Source: 18_Nielsen_Brand_Cut_Measures.dax"
          },
          {
            "name": "Cut Price Per Ml YoY %",
            "expression": [
              "VAR _ly = CALCULATE ( [Cut Brand Price Per Ml], DATEADD ( 'Date Table'[Date], -12, MONTH ) )",
              "RETURN DIVIDE ( [Cut Brand Price Per Ml] - _ly, _ly )"
            ],
            "description": "Source: 18_Nielsen_Brand_Cut_Measures.dax"
          },
          {
            "name": "Cut WD %",
            "expression": [
              "CALCULATE ( AVERAGE ( 'Fact Nielsen Brand Cut'[WD %] ), 'Fact Nielsen Brand Cut'[Is Category Row] = \"No\" )"
            ],
            "description": "Source: 18_Nielsen_Brand_Cut_Measures.dax"
          },
          {
            "name": "Cut ND %",
            "expression": [
              "CALCULATE ( AVERAGE ( 'Fact Nielsen Brand Cut'[ND %] ), 'Fact Nielsen Brand Cut'[Is Category Row] = \"No\" )"
            ],
            "description": "Source: 18_Nielsen_Brand_Cut_Measures.dax"
          },
          {
            "name": "Cut WD Change pp",
            "expression": [
              "[Cut WD %] - CALCULATE ( [Cut WD %], DATEADD ( 'Date Table'[Date], -12, MONTH ) )",
              "// weighted above numeric distribution = in the larger stores first; the gap is the smaller stores still open"
            ],
            "description": "Source: 18_Nielsen_Brand_Cut_Measures.dax"
          },
          {
            "name": "Cut WD Less ND pp",
            "expression": [
              "[Cut WD %] - [Cut ND %]"
            ],
            "description": "Source: 18_Nielsen_Brand_Cut_Measures.dax"
          },
          {
            "name": "Cut Stores",
            "expression": [
              "CALCULATE ( SUM ( 'Fact Nielsen Brand Cut'[Stores] ), 'Fact Nielsen Brand Cut'[Is Category Row] = \"No\" )"
            ],
            "description": "Source: 18_Nielsen_Brand_Cut_Measures.dax"
          },
          {
            "name": "Cut Sales Per Store Rs",
            "expression": [
              "CALCULATE ( AVERAGE ( 'Fact Nielsen Brand Cut'[Sales Per Store Rs] ), 'Fact Nielsen Brand Cut'[Is Category Row] = \"No\" )"
            ],
            "description": "Source: 18_Nielsen_Brand_Cut_Measures.dax"
          },
          {
            "name": "Cut SAH %",
            "expression": [
              "CALCULATE ( AVERAGE ( 'Fact Nielsen Brand Cut'[SAH %] ), 'Fact Nielsen Brand Cut'[Is Category Row] = \"No\" )",
              "",
              "// share earned per point of weighted distribution (percentage points of share per WD point)"
            ],
            "description": "Source: 18_Nielsen_Brand_Cut_Measures.dax"
          },
          {
            "name": "Cut Share Per WD Point",
            "expression": [
              "DIVIDE ( [Cut Value Share %] * 100, [Cut WD %] )",
              "// ceiling for the distribution lever: where we are listed we hold SAH; at 95% WD the share would be about SAH x 0.95 (only when WD is below 95)"
            ],
            "description": "Source: 18_Nielsen_Brand_Cut_Measures.dax"
          },
          {
            "name": "Cut Share At 95 WD %",
            "expression": [
              "IF ( [Cut WD %] < 95, [Cut SAH %] / 100 * 0.95 )"
            ],
            "description": "Source: 18_Nielsen_Brand_Cut_Measures.dax"
          },
          {
            "name": "Cut Share Headroom pp",
            "expression": [
              "IF ( ISBLANK ( [Cut Share At 95 WD %] ), BLANK (), ( [Cut Share At 95 WD %] - [Cut Value Share %] ) * 100 )",
              "// rupee value of one share point in this category, Rs Cr a month"
            ],
            "description": "Source: 18_Nielsen_Brand_Cut_Measures.dax"
          },
          {
            "name": "Cut Value Of One Share Point Cr",
            "expression": [
              "DIVIDE ( [Cut Category Value Cr], 100 )"
            ],
            "description": "Source: 18_Nielsen_Brand_Cut_Measures.dax"
          },
          {
            "name": "Drill NSV Cr",
            "expression": [
              "DIVIDE ( [Total MT NSV], 10000000 )"
            ],
            "description": "Source: 19_Dynamic_Drill_Measures.dax"
          },
          {
            "name": "Drill Stores Selling",
            "expression": [
              "DISTINCTCOUNT ( 'Fact Offtake Sales'[Store Code] )",
              "",
              "// share of everything currently selected (the parent level when you drill down): 100% at the top, the slice of the parent one level down"
            ],
            "description": "Source: 19_Dynamic_Drill_Measures.dax"
          },
          {
            "name": "Drill Share Of Selection %",
            "expression": [
              "DIVIDE ( [Total MT NSV], CALCULATE ( [Total MT NSV], ALLSELECTED () ) )",
              "",
              "// growth in rupees against the same month last year, and the part of the whole selection's growth this slice carries"
            ],
            "description": "Source: 19_Dynamic_Drill_Measures.dax"
          },
          {
            "name": "Drill YoY Change Cr",
            "expression": [
              "DIVIDE ( [Total MT NSV] - [Last Year Same Month NSV], 10000000 )"
            ],
            "description": "Source: 19_Dynamic_Drill_Measures.dax"
          },
          {
            "name": "Drill Share Of Growth %",
            "expression": [
              "VAR _all = CALCULATE ( [Total MT NSV] - [Last Year Same Month NSV], ALLSELECTED () )",
              "RETURN DIVIDE ( [Total MT NSV] - [Last Year Same Month NSV], _all )",
              "",
              "// one line per head, for tooltip pages and card visuals (text measures)"
            ],
            "description": "Source: 19_Dynamic_Drill_Measures.dax"
          },
          {
            "name": "Drill Head Sales",
            "expression": [
              "\"NSV Rs \" & FORMAT ( [Drill NSV Cr], \"#,##0.00\" ) & \" Cr · MoM \" & FORMAT ( [MoM Growth %], \"+0.0%;-0.0%;0.0%\" ) & \" · YoY \" & FORMAT ( [YoY Growth %], \"+0.0%;-0.0%;0.0%\" )"
            ],
            "description": "Source: 19_Dynamic_Drill_Measures.dax"
          },
          {
            "name": "Drill Head Mix",
            "expression": [
              "FORMAT ( [Drill Share Of Selection %], \"0.0%\" ) & \" of the selection · carries \" & FORMAT ( [Drill Share Of Growth %], \"0%\" ) & \" of the YoY growth\""
            ],
            "description": "Source: 19_Dynamic_Drill_Measures.dax"
          },
          {
            "name": "Drill Head Price",
            "expression": [
              "\"ASP Rs \" & FORMAT ( [MT ASP], \"#,##0.0\" ) & \" per unit · realisation \" & FORMAT ( [MT Realisation %], \"0%\" ) & \" of MRP\""
            ],
            "description": "Source: 19_Dynamic_Drill_Measures.dax"
          },
          {
            "name": "Drill Head Reach",
            "expression": [
              "FORMAT ( [Drill Stores Selling], \"#,##0\" ) & \" stores selling · Rs \" & FORMAT ( DIVIDE ( [Total MT NSV], [Drill Stores Selling] ) / 100000, \"#,##0.00\" ) & \" L per store\"",
              "",
              "// the verdict word on the tooltip: growing faster or slower than the selection as a whole"
            ],
            "description": "Source: 19_Dynamic_Drill_Measures.dax"
          },
          {
            "name": "Drill Pace Flag",
            "expression": [
              "VAR _ours = [YoY Growth %]",
              "VAR _all = CALCULATE ( [YoY Growth %], ALLSELECTED () )",
              "RETURN IF ( ISBLANK ( _ours ) || ISBLANK ( _all ), BLANK (), IF ( _ours >= _all, \"Growing faster than the selection\", \"Growing slower than the selection\" ) )"
            ],
            "description": "Source: 19_Dynamic_Drill_Measures.dax"
          },
          {
            "name": "LFL NSV Cr",
            "expression": [
              "DIVIDE ( CALCULATE ( SUM ( 'Fact Store Type'[NSV This Year Rs] ), 'Fact Store Type'[Store Type] = \"LFL\" ), 10000000 )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "LFL NSV LY Cr",
            "expression": [
              "DIVIDE ( CALCULATE ( SUM ( 'Fact Store Type'[NSV Last Year Same Months Rs] ), 'Fact Store Type'[Store Type] = \"LFL\" ), 10000000 )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "LFL Growth %",
            "expression": [
              "DIVIDE ( [LFL NSV Cr] - [LFL NSV LY Cr], [LFL NSV LY Cr] )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "NFL NSV Cr",
            "expression": [
              "DIVIDE ( CALCULATE ( SUM ( 'Fact Store Type'[NSV This Year Rs] ), 'Fact Store Type'[Store Type] = \"NFL\" ), 10000000 )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "New Stores NSV Cr",
            "expression": [
              "DIVIDE ( CALCULATE ( SUM ( 'Fact Store Type'[NSV This Year Rs] ), 'Fact Store Type'[NFL Kind] = \"New\" ), 10000000 )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "Restarted Stores NSV Cr",
            "expression": [
              "DIVIDE ( CALCULATE ( SUM ( 'Fact Store Type'[NSV This Year Rs] ), 'Fact Store Type'[NFL Kind] = \"Restarted\" ), 10000000 )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "New Stores",
            "expression": [
              "CALCULATE ( DISTINCTCOUNT ( 'Fact Store Type'[Store Key] ), 'Fact Store Type'[NFL Kind] = \"New\" )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "Restarted Stores",
            "expression": [
              "CALCULATE ( DISTINCTCOUNT ( 'Fact Store Type'[Store Key] ), 'Fact Store Type'[NFL Kind] = \"Restarted\" )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "No LY Store Data NSV Cr",
            "expression": [
              "DIVIDE ( CALCULATE ( SUM ( 'Fact Store Type'[NSV This Year Rs] ), 'Fact Store Type'[Store Type] = \"No LY store data\" ), 10000000 )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "Lost Stores LY NSV Cr",
            "expression": [
              "DIVIDE ( CALCULATE ( SUM ( 'Fact Store Type'[NSV Last Year Same Months Rs] ), 'Fact Store Type'[Store Type] = \"Lost\" ), 10000000 )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "Store Type NSV This Year Cr",
            "expression": [
              "DIVIDE ( SUM ( 'Fact Store Type'[NSV This Year Rs] ), 10000000 )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "LFL Stores",
            "expression": [
              "CALCULATE ( DISTINCTCOUNT ( 'Fact Store Type'[Store Key] ), 'Fact Store Type'[Store Type] = \"LFL\" )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "NFL Stores",
            "expression": [
              "CALCULATE ( DISTINCTCOUNT ( 'Fact Store Type'[Store Key] ), 'Fact Store Type'[Store Type] = \"NFL\" )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "Lost Stores",
            "expression": [
              "CALCULATE ( DISTINCTCOUNT ( 'Fact Store Type'[Store Key] ), 'Fact Store Type'[Store Type] = \"Lost\" )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "NFL Share Of NSV %",
            "expression": [
              "DIVIDE ( [NFL NSV Cr], [Store Type NSV This Year Cr] )",
              "",
              "// Same-store growth in rupees: how much of the growth the old stores gave (the rest comes from new stores)",
              "// Store-level growth rule: only stores with 3 or more months of sales last year (Growth Basis = \"Enough history\"). Use these on store lists and rankings."
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "LFL NSV (3+ months) Cr",
            "expression": [
              "DIVIDE ( CALCULATE ( SUM ( 'Fact Store Type'[NSV This Year Rs] ), 'Fact Store Type'[Store Type] = \"LFL\", 'Fact Store Type'[Growth Basis] = \"Enough history\" ), 10000000 )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "LFL NSV LY (3+ months) Cr",
            "expression": [
              "DIVIDE ( CALCULATE ( SUM ( 'Fact Store Type'[NSV Last Year Same Months Rs] ), 'Fact Store Type'[Store Type] = \"LFL\", 'Fact Store Type'[Growth Basis] = \"Enough history\" ), 10000000 )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "LFL Growth % (3+ months)",
            "expression": [
              "DIVIDE ( [LFL NSV (3+ months) Cr] - [LFL NSV LY (3+ months) Cr], [LFL NSV LY (3+ months) Cr] )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "Store Growth % (3+ months)",
            "expression": [
              "IF (",
              "        SELECTEDVALUE ( 'Fact Store Type'[Growth Basis] ) = \"Thin history\",",
              "        BLANK (),",
              "        DIVIDE ( SUM ( 'Fact Store Type'[NSV This Year Rs] ) - SUM ( 'Fact Store Type'[NSV Last Year Same Months Rs] ), SUM ( 'Fact Store Type'[NSV Last Year Same Months Rs] ) )",
              "    )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "LFL Growth Cr",
            "expression": [
              "[LFL NSV Cr] - [LFL NSV LY Cr]"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "Store Type Insight",
            "expression": [
              "IF (",
              "        ISBLANK ( [LFL NSV LY Cr] ),",
              "        \"No like-for-like base for this selection (Reliance Retail has no store-level last year)\",",
              "        \"Same stores \" & FORMAT ( [LFL Growth %], \"+0%;-0%\" ) & \" · \" & FORMAT ( [New Stores], \"#,0\" ) & \" new stores add Rs \" & FORMAT ( [New Stores NSV Cr], \"0.0\" ) & \" Cr, \" & FORMAT ( [Restarted Stores], \"#,0\" ) & \" restarted add Rs \" & FORMAT ( [Restarted Stores NSV Cr], \"0.0\" ) & \" Cr · \"",
              "            & FORMAT ( [Lost Stores], \"#,0\" ) & \" stores sold last year, nothing this year\"",
              "    )",
              "",
              "// ---------- PACK SIZE ----------"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "Pack NSV Cr",
            "expression": [
              "DIVIDE ( SUM ( 'Fact Pack Size'[NSV Rs] ), 10000000 )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "Pack Share %",
            "expression": [
              "DIVIDE ( [Pack NSV Cr], CALCULATE ( [Pack NSV Cr], ALL ( 'Fact Pack Size'[Pack] ) ) )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "Pack NSV Last Month Cr",
            "expression": [
              "VAR _m = MAX ( 'Fact Pack Size'[MonthStart] )",
              "    RETURN CALCULATE ( [Pack NSV Cr], ALL ( 'Fact Pack Size'[MonthStart], 'Fact Pack Size'[Month] ), 'Fact Pack Size'[MonthStart] = EDATE ( _m, -1 ) )",
              "",
              "// Only meaningful when one month is selected; with the full period it shows blank rather than a wrong number"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "Pack MoM %",
            "expression": [
              "IF ( DISTINCTCOUNT ( 'Fact Pack Size'[MonthStart] ) = 1, DIVIDE ( [Pack NSV Cr] - [Pack NSV Last Month Cr], [Pack NSV Last Month Cr] ) )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "Pack Insight",
            "expression": [
              "VAR _top = TOPN ( 1, VALUES ( 'Fact Pack Size'[Pack] ), [Pack NSV Cr], DESC )",
              "    RETURN \"Biggest pack: \" & MAXX ( _top, 'Fact Pack Size'[Pack] ) & \" g/ml · \" & FORMAT ( MAXX ( _top, [Pack Share %] ), \"0%\" ) & \" of NSV\"",
              "",
              "// ---------- SALES CUTS (zone, brand, sub-category) : table 'Fact Sales Cuts' (query 60) ----------"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "Cut NSV Cr",
            "expression": [
              "DIVIDE ( SUM ( 'Fact Sales Cuts'[NSV Rs] ), 10000000 )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "Cut Share %",
            "expression": [
              "DIVIDE ( [Cut NSV Cr], CALCULATE ( [Cut NSV Cr], ALLSELECTED ( 'Fact Sales Cuts'[Zone], 'Fact Sales Cuts'[Brand], 'Fact Sales Cuts'[Sub Category] ) ) )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "Cut LFL NSV Cr",
            "expression": [
              "DIVIDE ( CALCULATE ( SUM ( 'Fact Sales Cuts'[NSV Rs] ), 'Fact Sales Cuts'[Store Type] = \"LFL\" ), 10000000 )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "Cut Last Month NSV Cr",
            "expression": [
              "VAR _m = MAX ( 'Fact Sales Cuts'[MonthStart] )",
              "    RETURN CALCULATE ( [Cut NSV Cr], ALL ( 'Fact Sales Cuts'[MonthStart], 'Fact Sales Cuts'[Month] ), 'Fact Sales Cuts'[MonthStart] = EDATE ( _m, -1 ) )",
              "",
              "// Only meaningful for one month; blank for the full period rather than a wrong number"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "Cut MoM %",
            "expression": [
              "IF ( DISTINCTCOUNT ( 'Fact Sales Cuts'[MonthStart] ) = 1, DIVIDE ( [Cut NSV Cr] - [Cut Last Month NSV Cr], [Cut Last Month NSV Cr] ) )",
              "",
              "// ---------- IN-HOUSE DISTRIBUTION (not TDP) : table 'Fact Inhouse Distribution' (query 61). Always filter Level to one value. ----------"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "Inhouse Stores Selling",
            "expression": [
              "SUM ( 'Fact Inhouse Distribution'[Stores Selling] )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "Inhouse SKUs Selling",
            "expression": [
              "SUM ( 'Fact Inhouse Distribution'[SKUs Selling] )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "Inhouse SKU Listings",
            "expression": [
              "SUM ( 'Fact Inhouse Distribution'[SKU Listings] )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "Inhouse SKUs Per Store",
            "expression": [
              "DIVIDE ( [Inhouse SKU Listings], [Inhouse Stores Selling] )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          },
          {
            "name": "Inhouse Store Reach %",
            "expression": [
              "DIVIDE ( [Inhouse Stores Selling], SUM ( 'Fact Inhouse Distribution'[Stores In Master] ) )"
            ],
            "description": "Source: 20_Store_Type_Pack_Measures.dax"
          }
        ]
      }
    ],
