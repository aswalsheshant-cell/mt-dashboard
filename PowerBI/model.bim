            "sourceColumn": "Chain"
          },
          {
            "name": "Brand",
            "dataType": "string",
            "sourceColumn": "Brand"
          },
          {
            "name": "Cont%",
            "dataType": "double",
            "sourceColumn": "Cont%"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "Primary Allocation Map",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// QUERY: Primary Allocation Map   (the dynamic, month-wise Cont% table)",
                "// =====================================================================",
                "// This is the \"separate mapping / assumption table\" the business asked for.",
                "// It is DERIVED from the monthly ship-to primary feed, so it updates itself",
                "// every month with no formula changes:",
                "//",
                "//   Cont%(Month, Ship-To, Chain, Brand)",
                "//",
                "// Use it to allocate ANY raw, un-split primary that arrives at Ship-To x",
                "// Brand level: Allocated Primary = raw ship-to primary * Cont% for the chain.",
                "// (When the feed already arrives pre-split - as today - 'Fact Primary ShipTo'",
                "//  already carries the allocated NSV and this table is the audit/driver view.)",
                "//",
                "// To override an allocation manually, add the same Month/Ship-To/Chain/Brand",
                "// key to 'Primary Allocation Override' (query 35) - DAX prefers the override.",
                "// =====================================================================",
                "let",
                "    Source = #\"Fact Primary ShipTo\",",
                "    Keep = Table.SelectColumns(Source,",
                "        {\"Month\",\"MonthStartCalc\",\"FY Year\",\"Ship To Name\",\"Direct/Distributor\",\"Chain\",\"Brand\",\"Cont%\"}),",
                "    Renamed = Table.RenameColumns(Keep, {{\"MonthStartCalc\",\"MonthStart\"}}),",
                "    // one row per Month x Ship-To x Chain x Brand (Cont% is constant within the group)",
                "    Grouped = Table.Group(Renamed,",
                "        {\"Month\",\"MonthStart\",\"FY Year\",\"Ship To Name\",\"Direct/Distributor\",\"Chain\",\"Brand\"},",
                "        {{\"Cont%\", each List.Max([Cont%]), type number}})",
                "in",
                "    Grouped"
              ]
            }
          }
        ]
      },
      {
        "name": "Primary Allocation Override",
        "columns": [
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month"
          },
          {
            "name": "Ship To Name",
            "dataType": "string",
            "sourceColumn": "Ship To Name"
          },
          {
            "name": "Chain",
            "dataType": "string",
            "sourceColumn": "Chain"
          },
          {
            "name": "Brand",
            "dataType": "string",
            "sourceColumn": "Brand"
          },
          {
            "name": "Override Cont%",
            "dataType": "double",
            "sourceColumn": "Override Cont%"
          },
          {
            "name": "Remarks",
            "dataType": "string",
            "sourceColumn": "Remarks"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "Primary Allocation Override",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// QUERY: Primary Allocation Override  (manual, editable - optional)",
                "// Type a Cont% here to override the secondary-derived allocation for a",
                "// specific Month x Ship-To x Chain x Brand. Use \"ALL\" wildcards as needed.",
                "// DAX prefers this value when a matching row exists. Never hardcoded in",
                "// measures - it lives in this editable table.",
                "// =====================================================================",
                "let",
                "    Source = Csv.Document(File.Contents(pRootFolder & \"\\SeedData\\Masters\\PrimaryAllocationOverride.csv\"),",
                "        [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {",
                "        {\"Month\", type text},{\"Ship To Name\", type text},{\"Chain\", type text},",
                "        {\"Brand\", type text},{\"Override Cont%\", type number},{\"Remarks\", type text}})",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "Sales Team Mapping",
        "columns": [
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month"
          },
          {
            "name": "Store Code",
            "dataType": "string",
            "sourceColumn": "Store Code"
          },
          {
            "name": "Employee ID",
            "dataType": "string",
            "sourceColumn": "Employee ID"
          },
          {
            "name": "Sales Person",
            "dataType": "double",
            "sourceColumn": "Sales Person"
          },
          {
            "name": "Cont%",
            "dataType": "double",
            "sourceColumn": "Cont%"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "Sales Team Mapping",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// QUERY: Sales Team Mapping  (one row per Month x Store x Sales Person)",
                "// Unpivots Store-SO Mapping (SO1/SO2/SO3 + Cont%1/2/3) so a store split",
                "// across officers becomes multiple rows carrying the Cont% weight.",
                "// Used by the Forecast page to attribute TY target ownership to a Sales",
                "// Person (via the store's Chain/Zone in the offtake/primary facts).",
                "// =====================================================================",
                "let",
                "    Source = #\"Store SO Mapping\",   // from query 32",
                "    // build 3 candidate SO rows, then keep the non-blank ones",
                "    R1 = Table.SelectColumns(Source, {\"Month\",\"Store Code\",\"Employee ID 1\",\"SO Name 1\",\"Cont% 1\"}),",
                "    R1r = Table.RenameColumns(R1, {{\"Employee ID 1\",\"Employee ID\"},{\"SO Name 1\",\"Sales Person\"},{\"Cont% 1\",\"Cont%\"}}),",
                "    R2 = Table.SelectColumns(Source, {\"Month\",\"Store Code\",\"Employee ID 2\",\"SO Name 2\",\"Cont% 2\"}),",
                "    R2r = Table.RenameColumns(R2, {{\"Employee ID 2\",\"Employee ID\"},{\"SO Name 2\",\"Sales Person\"},{\"Cont% 2\",\"Cont%\"}}),",
                "    R3 = Table.SelectColumns(Source, {\"Month\",\"Store Code\",\"Employee ID 3\",\"SO Name 3\",\"Cont% 3\"}),",
                "    R3r = Table.RenameColumns(R3, {{\"Employee ID 3\",\"Employee ID\"},{\"SO Name 3\",\"Sales Person\"},{\"Cont% 3\",\"Cont%\"}}),",
                "    Combined = Table.Combine({R1r, R2r, R3r}),",
                "    Clean = Table.SelectRows(Combined, each",
                "        [Sales Person] <> null and Text.Trim(Text.From([Sales Person])) <> \"\" and ([Cont%] ?? 0) > 0),",
                "    Trimmed = Table.TransformColumns(Clean, {",
                "        {\"Store Code\", each Text.Trim(Text.From(_)), type text},",
                "        {\"Sales Person\", each Text.Trim(Text.From(_)), type text}}),",
                "    Typed = Table.TransformColumnTypes(Trimmed, {",
                "        {\"Month\", type text},{\"Store Code\", type text},{\"Employee ID\", type text},",
                "        {\"Sales Person\", type text},{\"Cont%\", type number}})",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "GST Rate QC Table",
        "columns": [
          {
            "name": "Category",
            "dataType": "string",
            "sourceColumn": "Category"
          },
          {
            "name": "HSN_Code",
            "dataType": "string",
            "sourceColumn": "HSN_Code"
          },
          {
            "name": "Pre_GST_Rate_Pct",
            "dataType": "double",
            "sourceColumn": "Pre_GST_Rate_Pct"
          },
          {
            "name": "Post_GST_Rate_Pct",
            "dataType": "double",
            "sourceColumn": "Post_GST_Rate_Pct"
          },
          {
            "name": "Effective_From",
            "dataType": "dateTime",
            "sourceColumn": "Effective_From"
          },
          {
            "name": "Confidence",
            "dataType": "string",
            "sourceColumn": "Confidence"
          },
          {
            "name": "Finance_Approved",
            "dataType": "boolean",
            "sourceColumn": "Finance_Approved"
          },
          {
            "name": "Impact_on_TOT_pct",
            "dataType": "double",
            "sourceColumn": "Impact_on_TOT_pct"
          },
          {
            "name": "Note",
            "dataType": "string",
            "sourceColumn": "Note"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "GST Rate QC Table",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// QUERY: GST Rate QC Table",
                "// Source: SeedData\\Masters\\GST_Rate_QC_Table.csv  (repo-relative to pRootFolder)",
                "// Role: the Finance/Tax sign-off sheet for TOT% (Trade Offer Terms % /",
                "// On-Invoice Margin Pass-on %) — Category, HSN Code, Pre/Post-GST rate,",
                "// per-category cutover override, Confidence, Finance approval status, and",
                "// the auto-computed Impact_on_TOT_pct sensitivity. Read by the TOT%",
                "// measures in DAX/12_TOT_Measures.dax. Kept DISCONNECTED (no modelled",
                "// relationship) -- read via LOOKUPVALUE() so it stays a simple,",
                "// hand-editable table with no relationship to wire up.",
                "//",
                "// EVERY row starts Finance_Approved = \"Pending\" and several are marked",
                "// Confidence = \"Low\" (no official HSN-code-level source was available for",
                "// the post-GST-2.0 category classification) -- verify against Honasa's",
                "// Finance/Tax records and fill in HSN_Code + flip Finance_Approved to \"Yes\"",
                "// per row as confirmed. TOT% still computes off whatever is in this file",
                "// regardless of approval status -- Finance_Approved is an audit/tracking",
                "// field, not a computational gate.",
                "//",
                "// Effective_From (optional, per-category): if blank, that category's",
                "// cutover uses the GLOBAL default date from 'GST Config' (query 38). Fill",
                "// this in only if Finance confirms a SPECIFIC category transitioned on a",
                "// different date than the rest.",
                "// =====================================================================",
                "let",
                "    Source = Csv.Document(",
                "        File.Contents(pRootFolder & \"\\SeedData\\Masters\\GST_Rate_QC_Table.csv\"),",
                "        [Delimiter=\",\", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.Csv]",
                "    ),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {",
                "        {\"Category\", type text},",
                "        {\"HSN_Code\", type text},",
                "        {\"Pre_GST_Rate_Pct\", type number},",
                "        {\"Post_GST_Rate_Pct\", type number},",
                "        {\"Effective_From\", type text},   // kept text: often blank (\"use global default\") -- parse to date only where non-blank, see DAX",
                "        {\"Confidence\", type text},",
                "        {\"Finance_Approved\", type text},",
                "        {\"Impact_on_TOT_pct\", type number},",
                "        {\"Note\", type text}",
                "    })",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "GST Config",
        "columns": [
          {
            "name": "GST_Cutover_Date",
            "dataType": "dateTime",
            "sourceColumn": "GST_Cutover_Date"
          },
          {
            "name": "Note",
            "dataType": "string",
            "sourceColumn": "Note"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "GST Config",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// QUERY: GST Config",
                "// Source: SeedData\\Masters\\GST_Config.csv  (repo-relative to pRootFolder)",
                "// Role: single-row, single-editable-cell GST cutover date used by TOT%",
                "// (DAX/12_TOT_Measures.dax) as the DEFAULT cutover for any category whose",
                "// own Effective_From (in GST Rate QC Table, query 37) is blank.",
                "//",
                "// Default = 2025-09-22 (GST Council's confirmed GST 2.0 rate-rationalisation",
                "// effective date). Edit the single GST_Cutover_Date cell in the CSV if",
                "// Honasa's internal billing/invoicing system actually reflected the new",
                "// rates on a different date -- TOT% recomputes from whatever date is here",
                "// on the next refresh. Kept DISCONNECTED (no modelled relationship).",
                "// =====================================================================",
                "let",
                "    Source = Csv.Document(",
                "        File.Contents(pRootFolder & \"\\SeedData\\Masters\\GST_Config.csv\"),",
                "        [Delimiter=\",\", Columns=2, Encoding=65001, QuoteStyle=QuoteStyle.Csv]",
                "    ),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {",
                "        {\"GST_Cutover_Date\", type date},",
                "        {\"Note\", type text}",
                "    })",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "PL Expense Input",
        "columns": [
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month"
          },
          {
            "name": "FY",
            "dataType": "string",
            "sourceColumn": "FY"
          },
          {
            "name": "Chain",
            "dataType": "string",
            "sourceColumn": "Chain"
          },
          {
            "name": "Customer Code",
            "dataType": "string",
            "sourceColumn": "Customer Code"
          },
          {
            "name": "Customer Name",
            "dataType": "string",
            "sourceColumn": "Customer Name"
          },
          {
            "name": "Zone",
            "dataType": "string",
            "sourceColumn": "Zone"
          },
          {
            "name": "State",
            "dataType": "string",
            "sourceColumn": "State"
          },
          {
            "name": "Brand",
            "dataType": "string",
            "sourceColumn": "Brand"
          },
          {
            "name": "Category",
            "dataType": "string",
            "sourceColumn": "Category"
          },
          {
            "name": "Sub Category",
            "dataType": "string",
            "sourceColumn": "Sub Category"
          },
          {
            "name": "Expense Head",
            "dataType": "double",
            "sourceColumn": "Expense Head"
          },
          {
            "name": "Expense Type",
            "dataType": "double",
            "sourceColumn": "Expense Type"
          },
          {
            "name": "Expense Amount (INR Lakh)",
            "dataType": "double",
            "sourceColumn": "Expense Amount (INR Lakh)"
          },
          {
            "name": "Remarks",
            "dataType": "string",
            "sourceColumn": "Remarks"
          },
          {
            "name": "Source",
            "dataType": "string",
            "sourceColumn": "Source"
          },
          {
            "name": "Updated By",
            "dataType": "string",
            "sourceColumn": "Updated By"
          },
          {
            "name": "Updated Date",
            "dataType": "dateTime",
            "sourceColumn": "Updated Date"
          },
          {
            "name": "MonthStart",
            "dataType": "dateTime",
            "sourceColumn": "MonthStart"
          },
          {
            "name": "Resolved Chain",
            "dataType": "string",
            "type": "calculated",
            "expression": "VAR _custCode = TRIM ( 'PL Expense Input'[Customer Code] )\nVAR _chainIn = TRIM ( 'PL Expense Input'[Chain] )\nVAR _viaCode = IF ( _custCode <> \"\", LOOKUPVALUE ( 'CustCode Chain Map'[Chain], 'CustCode Chain Map'[Customer Code], _custCode ) )\nVAR _viaChain = IF ( _chainIn <> \"\" && CONTAINS ( VALUES ( 'Fact Primary Article'[Chain] ), 'Fact Primary Article'[Chain], _chainIn ), _chainIn )\nRETURN COALESCE ( _viaCode, _viaChain )",
            "isDataTypeInferred": true
          },
          {
            "name": "Resolved Brand",
            "dataType": "string",
            "type": "calculated",
            "expression": "VAR _brandIn = TRIM ( 'PL Expense Input'[Brand] )\nRETURN IF ( _brandIn = \"\", BLANK(),\n    IF ( CONTAINS ( VALUES ( 'Fact Primary Article'[Brand] ), 'Fact Primary Article'[Brand], _brandIn ), _brandIn, BLANK() ) )",
            "isDataTypeInferred": true
          },
          {
            "name": "Resolved Category",
            "dataType": "string",
            "type": "calculated",
            "expression": "VAR _catIn = TRIM ( 'PL Expense Input'[Category] )\nRETURN IF ( _catIn = \"\", BLANK(),\n    IF ( CONTAINS ( VALUES ( 'Fact Primary Article'[Category] ), 'Fact Primary Article'[Category], _catIn ), _catIn, BLANK() ) )",
            "isDataTypeInferred": true
          },
          {
            "name": "Bad Brand Or Category",
            "dataType": "string",
            "type": "calculated",
            "expression": "VAR _brandIn = TRIM ( 'PL Expense Input'[Brand] )\nVAR _catIn = TRIM ( 'PL Expense Input'[Category] )\nRETURN ( _brandIn <> \"\" && ISBLANK ( 'PL Expense Input'[Resolved Brand] ) )\n    || ( _catIn <> \"\" && ISBLANK ( 'PL Expense Input'[Resolved Category] ) )",
            "isDataTypeInferred": true
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "PL Expense Input",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// QUERY: PL Expense Input",
                "// Source: SeedData\\Masters\\PL_Expense_Input.csv  (repo-relative to pRootFolder)",
                "// Role: month-on-month P&L expense input for CM2 (Contribution Margin 2)",
                "// tracking. Editable by Finance/Ops -- NEVER hardcoded in this model or in",
                "// the HTML dashboard. Matched to 'Fact Primary Article' by",
                "// DAX/13_CM2_Measures.dax: Customer Code first (via query 40's",
                "// CustCode-Chain map), Chain name fallback.",
                "//",
                "// Expense Amount is in INR LAKH (named explicitly in the column header to",
                "// avoid unit-mismatch bugs) -- same unit convention as every other reporting",
                "// measure in this model (values divided down to Lakh/Cr for display).",
                "//",
                "// MonthStart is parsed here (not left as free text) using the SAME two-step",
                "// text -> FY-tag -> start-year logic as",
                "// dashboard/scripts/build_dashboard_data.py's _fylabel()/_mlabel(), so this",
                "// table relates to Date Table[MonthStart] exactly like every other",
                "// fact/input table in the model (see docs/DataModel.md). Both \"FYyy-yy\"",
                "// (e.g. \"FY25-26\", matches the SAP-exported source files) and the",
                "// dashboard's own short form (\"FY26\") are accepted, since this file is",
                "// manually typed and a Finance user is more likely to reach for the short",
                "// form than the SAP export's hyphenated convention.",
                "// =====================================================================",
                "let",
                "    Source = Csv.Document(",
                "        File.Contents(pRootFolder & \"\\SeedData\\Masters\\PL_Expense_Input.csv\"),",
                "        [Delimiter=\",\", Columns=17, Encoding=65001, QuoteStyle=QuoteStyle.Csv]",
                "    ),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {",
                "        {\"Month\", type text}, {\"FY\", type text}, {\"Chain\", type text},",
                "        {\"Customer Code\", type text}, {\"Customer Name\", type text},",
                "        {\"Zone\", type text}, {\"State\", type text}, {\"Brand\", type text},",
                "        {\"Category\", type text}, {\"Sub Category\", type text},",
                "        {\"Expense Head\", type text}, {\"Expense Type\", type text},",
                "        {\"Expense Amount (INR Lakh)\", type number},",
                "        {\"Remarks\", type text}, {\"Source\", type text},",
                "        {\"Updated By\", type text}, {\"Updated Date\", type text}",
                "    }),",
                "",
                "    // FY text -> internal tag -> start calendar year, mirroring",
                "    // build_dashboard_data.py's _fylabel() + fy_start_year() step for step",
                "    // (THE ONE FY RULE): arithmetic, no list of years, so FY28, FY29, ...",
                "    // work without a code change. Two separate forms -- do NOT collapse into",
                "    // a single digit-counting heuristic: \"FY26\" (short) names the FY ending",
                "    // in 2026, and so does \"FY25-26\" (span, named by its END year).",
                "    //   span:  first \"dd-dd\" anywhere, second = first + 1 -> \"FY\" & second",
                "    //          (\"FY25-26\", \"FY'25-26\", \"FY_25-26\", \"2025-26\")",
                "    //   short: whole text (spaces removed) is \"FY\" + optional 0 + 2 digits",
                "    //          (\"FY26\", \"FY 26\", \"FY026\")",
                "    //   anything else (including a missing FY) -> null.",
                "    // tests/powerbi/pq39_fy_parser_cases.pq runs this exact function over",
                "    // tests/powerbi/fy_parser_cases.csv in Desktop (text kept identical by",
                "    // tests/test_pq39_fy_parser.py).",
                "    fnFyTag = (fy as any) as nullable text =>",
                "        let",
                "            _s = if fy = null then \"\" else Text.Remove(Text.Upper(Text.Trim(Text.From(fy))), {\" \"}),",
                "            _isDD = (t as text) as logical =>",
                "                Text.Length(t) = 2 and List.AllTrue(List.Transform(Text.ToList(t), each Text.Contains(\"0123456789\", _))),",
                "            _spans = List.Select(Text.PositionOf(_s, \"-\", Occurrence.All), each",
                "                _ >= 2 and _ + 3 <= Text.Length(_s)",
                "                and _isDD(Text.Middle(_s, _ - 2, 2)) and _isDD(Text.Middle(_s, _ + 1, 2))),",
                "            _p = List.First(_spans, null),",
                "            _a = if _p = null then null else Number.FromText(Text.Middle(_s, _p - 2, 2)),",
                "            _b = if _p = null then null else Number.FromText(Text.Middle(_s, _p + 1, 2)),",
                "            _span = if _p <> null and _b = Number.Mod(_a + 1, 100) then \"FY\" & Text.PadStart(Text.From(_b), 2, \"0\") else null,",
                "            _body = if Text.StartsWith(_s, \"FY\") then Text.Middle(_s, 2) else null,",
                "            _digits = if _body <> null and Text.Length(_body) = 3 and Text.StartsWith(_body, \"0\") then Text.Middle(_body, 1) else _body,",
                "            _short = if _digits <> null and _isDD(_digits) then \"FY\" & _digits else null",
                "        in",
                "            if _span <> null then _span else _short,",
                "    AddFyTag = Table.AddColumn(Typed, \"_FyTag\", each fnFyTag([FY]), type text),",
                "    AddFyStartYear = Table.AddColumn(AddFyTag, \"_FyStartYear\", each",
                "        if [_FyTag] = null then null",
                "        else 2000 + Number.FromText(Text.Middle([_FyTag], 2)) - 1,",
                "        Int64.Type),",
                "    AddMonthNum = Table.AddColumn(AddFyStartYear, \"_MonthNum\", each",
                "        Record.FieldOrDefault(",
                "            [Apr=4, April=4, May=5, Jun=6, June=6, Jul=7, July=7,",
                "             Aug=8, August=8, Sep=9, Sept=9, September=9,",
                "             Oct=10, October=10, Nov=11, November=11, Dec=12, December=12,",
                "             Jan=1, January=1, Feb=2, February=2, Mar=3, March=3],",
                "            Text.Proper(Text.Trim(Text.From([Month]))), null),",
                "        Int64.Type),",
                "    AddMonthStart = Table.AddColumn(AddMonthNum, \"MonthStart\", each",
                "        if [_FyStartYear] = null or [_MonthNum] = null then null",
                "        else #date(if [_MonthNum] >= 4 then [_FyStartYear] else [_FyStartYear] + 1, [_MonthNum], 1),",
                "        type date),",
                "    RemoveHelpers = Table.RemoveColumns(AddMonthStart, {\"_FyTag\", \"_FyStartYear\", \"_MonthNum\"}),",
                "",
                "    // The seed file ships 3 template rows marked \"EXAMPLE ROW\" in Remarks to show",
                "    // Finance the schema. They are never real expense -- same rule as the HTML",
                "    // loader's load_pl_expense_input() (FM-01, FM-33). Real rows are untouched.",
                "    NoTemplateRows = Table.SelectRows(RemoveHelpers, each",
                "        [Remarks] = null or not Text.Contains(Text.Upper([Remarks]), \"EXAMPLE ROW\")),",
                "    Cleaned = Table.SelectRows(NoTemplateRows, each [Expense Amount (INR Lakh)] <> null)",
                "in",
                "    Cleaned"
              ]
            }
          }
        ]
      },
      {
        "name": "CustCode Chain Map",
        "columns": [
          {
            "name": "Customer Code",
            "dataType": "string",
            "sourceColumn": "Customer Code"
          },
          {
            "name": "Chain",
            "dataType": "string",
            "sourceColumn": "Chain"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "CustCode Chain Map",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// QUERY: CustCode Chain Map",
                "// Source: 'Fact Primary Article' (query 16) -- DEPENDS ON IT. Add this query",
                "// AFTER 16_Fact_PrimaryArticle.pq exists in your Power BI file (Home ▸",
                "// Transform data ▸ this query references that one by name, same as",
                "// referencing any other already-loaded query).",
                "//",
                "// Role: Customer Code -> most-common Chain, so a PL_Expense_Input.csv row",
                "// that only gives a Customer Code (no Chain) can still resolve to a chain",
                "// for CM2 (mirrors dashboard/scripts/build_dashboard_data.py's",
                "// _build_custcode_chain_lookup() exactly -- same List.Mode / value_counts-",
                "// idxmax \"most frequent\" resolution, not just \"first seen\").",
                "//",
                "// Kept DISCONNECTED (no modelled relationship) -- read via LOOKUPVALUE by",
                "// DAX/13_CM2_Measures.dax.",
                "// =====================================================================",
                "let",
                "    Source = #\"Fact Primary Article\",",
                "    Filtered = Table.SelectRows(Source, each [Customer Code] <> null and Text.Trim(Text.From([Customer Code])) <> \"\"),",
                "    Grouped = Table.Group(Filtered, {\"Customer Code\"}, {",
                "        {\"Chain\", each List.Mode(List.RemoveNulls(Table.Column(_, \"Chain\"))), type text}",
                "    })",
                "in",
                "    Grouped"
              ]
            }
          }
        ]
      },
      {
        "name": "Dist Cont Weights",
        "columns": [
          {
            "name": "ShipTo Key",
            "dataType": "string",
            "sourceColumn": "ShipTo Key"
          },
          {
            "name": "Brand Key",
            "dataType": "string",
            "sourceColumn": "Brand Key"
          },
          {
            "name": "MonthStart",
            "dataType": "dateTime",
            "sourceColumn": "MonthStart"
          },
          {
            "name": "Ship To Name",
            "dataType": "string",
            "sourceColumn": "Ship To Name"
          },
          {
            "name": "Chain Name",
            "dataType": "string",
            "sourceColumn": "Chain Name"
          },
          {
            "name": "Brand",
            "dataType": "string",
            "sourceColumn": "Brand"
          },
          {
            "name": "Frac",
            "dataType": "double",
            "sourceColumn": "Frac"
          },
          {
            "name": "Raw Pct Sum",
            "dataType": "double",
            "sourceColumn": "Raw Pct Sum"
          },
          {
            "name": "Source File",
            "dataType": "string",
            "sourceColumn": "Source File"
          },
          {
            "name": "Source Type",
            "dataType": "string",
            "sourceColumn": "Source Type"
          },
          {
            "name": "Approval Status",
            "dataType": "string",
            "sourceColumn": "Approval Status"
          },
          {
            "name": "Allocation Method",
            "dataType": "string",
            "sourceColumn": "Allocation Method"
          },
          {
            "name": "Provisional Flag",
            "dataType": "boolean",
            "sourceColumn": "Provisional Flag"
          },
          {
            "name": "Fallback Flag",
            "dataType": "boolean",
            "sourceColumn": "Fallback Flag"
          },
          {
            "name": "Fallback Source Month",
            "dataType": "string",
            "sourceColumn": "Fallback Source Month"
          },
          {
            "name": "Load Timestamp",
            "dataType": "string",
            "sourceColumn": "Load Timestamp"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "Dist Cont Weights",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// QUERY: Dist Cont Weights  v2.0",
                "// Source priority chain:",
                "//   P1 = SeedData\\Mapping\\DistCont_Patch_Approved_2026-07-04.csv",
                "//        Finance-approved exact overrides (Secondary contribution % in 0-100 format)",
                "//   P2 = RawDataFolders\\Primary_ShipTo_Monthly\\Primary_ShipTo_FY25-26_to_May26.csv",
                "//        Dist. rows only; Cont% already 0-1 fractions; covers May'25 – May'26",
                "//   P3 = Jun'26 nearest-month fallback (May'26 data promoted to Jun'26)",
                "//        PROVISIONAL – awaiting Finance approval of Jun'26 DistCont patch",
                "//   P4 = \"Unmapped Chain\" emitted by Query 16 for any key not covered here",
                "//",
                "// For an exact (ShipTo Key × Brand Key × MonthStart) match, P1 overrides P2.",
                "// Fractions are normalised to sum = 1 per group (same guarantee as the old query).",
                "// Governance columns (Source Type, Approval Status, Provisional Flag, etc.) are",
                "// propagated into 'Fact Primary Article' (query 16) and surfaced on the QC page.",
                "//",
                "// REPLACED: Dist_primary_cont_based_on_secondary_MOM.xlsx (gitignored, never",
                "// committed). The two CSV sources above are checked into the repo and are the",
                "// authoritative allocation inputs going forward.",
                "// =====================================================================",
                "let",
                "    // ── Load Timestamp (shared across all rows this refresh) ──────────────",
                "    LoadTs = DateTime.ToText(DateTime.LocalNow(), \"yyyy-MM-dd HH:mm\"),",
                "",
                "    // ── CONSTANT: Jun'26 and May'26 month starts ──────────────────────────",
                "    Jun26Start = #date(2026, 6, 1),",
                "    May26Start = #date(2026, 5, 1),",
                "",
                "    // ======================================================================",
                "    // P1: Finance-Approved Patch",
                "    //     Secondary contribution % is in 0-100 format → divide by 100",
                "    // ======================================================================",
                "    PatchRaw = Csv.Document(",
                "        File.Contents(pRootFolder & \"\\SeedData\\Mapping\\DistCont_Patch_Approved_2026-07-04.csv\"),",
                "        [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    PatchHeaders = Table.PromoteHeaders(PatchRaw, [PromoteAllScalars = true]),",
                "    PatchPicked = Table.SelectColumns(PatchHeaders, {",
                "        \"Ship To Name\", \"Chain Name\", \"Brand\", \"Revised month\", \"Secondary contribution %\"",
                "    }, MissingField.UseNull),",
                "    PatchTyped = Table.TransformColumnTypes(PatchPicked, {",
                "        {\"Ship To Name\",               type text},",
                "        {\"Chain Name\",                 type text},",
                "        {\"Brand\",                      type text},",
                "        {\"Revised month\",              type date},",
                "        {\"Secondary contribution %\",   type number}",
                "    }),",
                "    PatchCleaned = Table.SelectRows(PatchTyped,",
                "        each [Ship To Name] <> null and [Chain Name] <> null",
                "          and [#\"Secondary contribution %\"] <> null",
                "          and [#\"Secondary contribution %\"] <> 0),",
                "    PatchAddShipToKey = Table.AddColumn(PatchCleaned, \"ShipTo Key\",",
                "        each Text.Lower(Text.Trim([Ship To Name])), type text),",
                "    PatchAddBrandKey = Table.AddColumn(PatchAddShipToKey, \"Brand Key\",",
                "        each Text.Lower(Text.Trim([Brand])), type text),",
                "    PatchAddMonthStart = Table.AddColumn(PatchAddBrandKey, \"MonthStart\",",
                "        each Date.StartOfMonth([Revised month]), type date),",
                "    // Divide by 100 to get raw 0-1 contribution for normalisation",
                "    PatchRawCont = Table.AddColumn(PatchAddMonthStart, \"RawCont\",",
                "        each [#\"Secondary contribution %\"] / 100, type number),",
                "    // Governance",
                "    PatchGov1 = Table.AddColumn(PatchRawCont,",
                "        \"Source File\", each \"DistCont_Patch_Approved_2026-07-04.csv\", type text),",
                "    PatchGov2 = Table.AddColumn(PatchGov1,",
                "        \"Source Type\", each \"Approved Patch\", type text),",
                "    PatchGov3 = Table.AddColumn(PatchGov2,",
                "        \"Approval Status\", each \"Approved\", type text),",
                "    PatchGov4 = Table.AddColumn(PatchGov3,",
                "        \"Allocation Method\", each \"Exact Match – Approved Patch\", type text),",
                "    PatchGov5 = Table.AddColumn(PatchGov4,",
                "        \"Provisional Flag\", each false, type logical),",
                "    PatchGov6 = Table.AddColumn(PatchGov5,",
                "        \"Fallback Flag\", each false, type logical),",
                "    PatchGov7 = Table.AddColumn(PatchGov6,",
                "        \"Fallback Source Month\", each null, type date),",
                "    PatchFinal = Table.SelectColumns(PatchGov7, {",
                "        \"ShipTo Key\", \"Brand Key\", \"MonthStart\",",
                "        \"Ship To Name\", \"Chain Name\", \"Brand\", \"RawCont\",",
                "        \"Source File\", \"Source Type\", \"Approval Status\",",
                "        \"Allocation Method\", \"Provisional Flag\", \"Fallback Flag\", \"Fallback Source Month\"",
                "    }),",
                "",
                "    // ======================================================================",
                "    // P2: ShipTo CSV — Dist. rows only",
                "    //     Cont% is already in 0-1 fraction form; Chain column = Chain Name",
                "    // ======================================================================",
                "    ShipToRaw = Csv.Document(",
                "        File.Contents(pRootFolder & \"\\RawDataFolders\\Primary_ShipTo_Monthly\\Primary_ShipTo_FY25-26_to_May26.csv\"),",
                "        [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    ShipToHeaders = Table.PromoteHeaders(ShipToRaw, [PromoteAllScalars = true]),",
                "    ShipToPicked = Table.SelectColumns(ShipToHeaders, {",
                "        \"Ship To Name\", \"Direct/Distributor\", \"Chain\", \"Brand\", \"MonthStart\", \"Cont%\"",
                "    }, MissingField.UseNull),",
                "    ShipToTyped = Table.TransformColumnTypes(ShipToPicked, {",
                "        {\"Ship To Name\",         type text},",
                "        {\"Direct/Distributor\",   type text},",
                "        {\"Chain\",                type text},",
                "        {\"Brand\",                type text},",
                "        {\"MonthStart\",           type date},",
                "        {\"Cont%\",                type number}",
                "    }),",
                "    // Keep only Distributor rows with a valid chain and non-zero contribution",
                "    ShipToDistOnly = Table.SelectRows(ShipToTyped,",
                "        each [Direct/Distributor] <> null",
                "          and Text.Lower(Text.Trim([Direct/Distributor])) = \"dist.\"",
                "          and [Chain] <> null",
                "          and [#\"Cont%\"] <> null and [#\"Cont%\"] <> 0),",
                "    ShipToRenChain = Table.RenameColumns(ShipToDistOnly, {{\"Chain\", \"Chain Name\"}}),",
                "    ShipToAddShipToKey = Table.AddColumn(ShipToRenChain, \"ShipTo Key\",",
                "        each Text.Lower(Text.Trim([Ship To Name])), type text),",
                "    ShipToAddBrandKey = Table.AddColumn(ShipToAddShipToKey, \"Brand Key\",",
                "        each Text.Lower(Text.Trim([Brand])), type text),",
                "    // Rename Cont% to RawCont (already 0-1 fraction, no scaling needed)",
                "    ShipToRawCont = Table.RenameColumns(ShipToAddBrandKey, {{\"Cont%\", \"RawCont\"}}),",
                "    // Governance",
                "    ShipToGov1 = Table.AddColumn(ShipToRawCont,",
                "        \"Source File\", each \"Primary_ShipTo_FY25-26_to_May26.csv\", type text),",
                "    ShipToGov2 = Table.AddColumn(ShipToGov1,",
                "        \"Source Type\", each \"ShipTo CSV\", type text),",
                "    ShipToGov3 = Table.AddColumn(ShipToGov2,",
                "        \"Approval Status\", each \"Approved\", type text),",
                "    ShipToGov4 = Table.AddColumn(ShipToGov3,",
                "        \"Allocation Method\", each \"Exact Match – ShipTo CSV\", type text),",
                "    ShipToGov5 = Table.AddColumn(ShipToGov4,",
                "        \"Provisional Flag\", each false, type logical),",
                "    ShipToGov6 = Table.AddColumn(ShipToGov5,",
                "        \"Fallback Flag\", each false, type logical),",
                "    ShipToGov7 = Table.AddColumn(ShipToGov6,",
                "        \"Fallback Source Month\", each null, type date),",
                "    ShipToFinal = Table.SelectColumns(ShipToGov7, {",
                "        \"ShipTo Key\", \"Brand Key\", \"MonthStart\",",
                "        \"Ship To Name\", \"Chain Name\", \"Brand\", \"RawCont\",",
                "        \"Source File\", \"Source Type\", \"Approval Status\",",
                "        \"Allocation Method\", \"Provisional Flag\", \"Fallback Flag\", \"Fallback Source Month\"",
                "    }),",
                "",
                "    // ======================================================================",
                "    // PRIORITY MERGE: P1 overrides P2 for exact (ShipTo Key × Brand Key × MonthStart)",
                "    // Remove ShipTo rows whose group key is entirely covered by the Approved Patch",
                "    // ======================================================================",
                "    PatchKeyGroups = Table.Distinct(Table.SelectColumns(PatchFinal,",
                "        {\"ShipTo Key\", \"Brand Key\", \"MonthStart\"})),",
                "    ShipToNotOverridden = Table.Join(",
                "        ShipToFinal,  {\"ShipTo Key\", \"Brand Key\", \"MonthStart\"},",
                "        PatchKeyGroups, {\"ShipTo Key\", \"Brand Key\", \"MonthStart\"},",
                "        JoinKind.LeftAnti),",
                "    CombinedBase = Table.Combine({PatchFinal, ShipToNotOverridden}),",
                "",
                "    // ======================================================================",
                "    // P3: Jun'26 nearest-month fallback",
                "    // The ShipTo CSV ends May'26. For any (ShipTo Key × Brand Key) with May'26 data",
                "    // but no Jun'26 data, copy May'26 rows to Jun'26 and mark as Provisional.",
                "    // These rows must be superseded by a Finance-approved DistCont patch for Jun'26.",
                "    // ======================================================================",
                "    May26Rows = Table.SelectRows(CombinedBase, each [MonthStart] = May26Start),",
                "    Jun26Rows = Table.SelectRows(CombinedBase, each [MonthStart] = Jun26Start),",
                "    // Keys already covered for Jun'26 (from Approved Patch, if any)",
                "    Jun26Keys = Table.Distinct(Table.SelectColumns(Jun26Rows, {\"ShipTo Key\", \"Brand Key\"})),",
                "    // May'26 rows whose ShipTo+Brand key has no Jun'26 coverage",
                "    May26ForFallback = Table.Join(",
                "        May26Rows,  {\"ShipTo Key\", \"Brand Key\"},",
                "        Jun26Keys,  {\"ShipTo Key\", \"Brand Key\"},",
                "        JoinKind.LeftAnti),",
                "    Jun26Fallback = Table.TransformColumns(May26ForFallback, {",
                "        {\"MonthStart\",        each Jun26Start,",
                "            type date},",
                "        {\"Source File\",       each \"Primary_ShipTo_FY25-26_to_May26.csv (Jun'26 fallback from May'26)\",",
                "            type text},",
                "        {\"Source Type\",       each \"Nearest-Month Fallback\",",
                "            type text},",
                "        {\"Approval Status\",   each \"Provisional – Jun'26 gap; awaiting Finance approval\",",
                "            type text},",
                "        {\"Allocation Method\", each \"Nearest-Month Fallback – May'26 applied to Jun'26\",",
                "            type text},",
                "        {\"Provisional Flag\",  each true,",
                "            type logical},",
                "        {\"Fallback Flag\",     each true,",
                "            type logical},",
                "        {\"Fallback Source Month\", each May26Start,",
                "            type date}",
                "    }),",
                "",
                "    // ======================================================================",
                "    // COMBINE all sources; normalise fractions per group",
                "    // ======================================================================",
                "    AllRows = Table.Combine({CombinedBase, Jun26Fallback}),",
                "",
                "    Grouped = Table.Group(AllRows, {\"ShipTo Key\", \"Brand Key\", \"MonthStart\"}, {",
                "        {\"Raw Pct Sum\", each List.Sum([RawCont]), type number},",
                "        {\"Rows\",        each _, type table}",
                "    }),",
                "    Expanded = Table.ExpandTableColumn(Grouped, \"Rows\", {",
                "        \"Ship To Name\", \"Chain Name\", \"Brand\", \"RawCont\",",
                "        \"Source File\", \"Source Type\", \"Approval Status\",",
                "        \"Allocation Method\", \"Provisional Flag\", \"Fallback Flag\", \"Fallback Source Month\"",
                "    }),",
                "    // Normalised fraction: sums to 1 per group by construction",
                "    AddFrac = Table.AddColumn(Expanded, \"Frac\",",
                "        each [RawCont] / [Raw Pct Sum], type number),",
                "",
                "    AddLoadTs = Table.AddColumn(AddFrac, \"Load Timestamp\", each LoadTs, type text),",
                "",
                "    Final = Table.SelectColumns(AddLoadTs, {",
                "        \"ShipTo Key\", \"Brand Key\", \"MonthStart\",",
                "        \"Ship To Name\", \"Chain Name\", \"Brand\",",
                "        \"Frac\", \"Raw Pct Sum\",",
                "        \"Source File\", \"Source Type\", \"Approval Status\",",
                "        \"Allocation Method\", \"Provisional Flag\", \"Fallback Flag\",",
                "        \"Fallback Source Month\", \"Load Timestamp\"",
                "    })",
                "in",
                "    Final"
              ]
            }
          }
        ]
      },
      {
        "name": "Pack Size Buckets",
        "columns": [
          {
            "name": "Pack Size Raw",
            "dataType": "string",
            "sourceColumn": "Pack Size Raw"
          },
          {
            "name": "Pack ML",
            "dataType": "double",
            "sourceColumn": "Pack ML"
          },
          {
            "name": "Pack Bucket",
            "dataType": "string",
            "sourceColumn": "Pack Bucket"
          },
          {
            "name": "Bucket Sort",
            "dataType": "int64",
            "sourceColumn": "Bucket Sort"
          },
          {
            "name": "Bucket Label",
            "dataType": "string",
            "sourceColumn": "Bucket Label"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "Pack Size Buckets",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// QUERY: Pack Size Buckets  (Dimension helper)",
                "// Joins to Fact Primary Article and Fact Offtake Sales on [Pack Size]",
                "// Classifies articles into standard ML-bucket tiers used by Category &",
                "// Pack tab. Works for BOTH primary (net_content column) and offtake",
                "// (Net Weight column) — both are renamed to [Pack Size] in their facts.",
                "//",
                "// Bucket tiers (business-confirmed, keep in sync with dashboard logic):",
                "//   Micro   : ≤  50 ml/g          (travel, trial, sachets)",
                "//   Small   : 51 – 150 ml/g",
                "//   Standard: 151 – 300 ml/g",
                "//   Large   : 301 – 500 ml/g",
                "//   XL      : > 500 ml/g          (value packs, combos)",
                "//   Unknown : blank / non-numeric  (kits, bundles, unit ambiguous)",
                "//",
                "// Usage: Home > Manage Relationships — link [Pack Size] here to",
                "//   Fact Primary Article [net_content] and Fact Offtake Sales [Pack Size].",
                "// =====================================================================",
                "let",
                "    // ---- 1. Collect every distinct Pack Size string from both facts ----",
                "    //   (this ensures the dimension covers all values, even those without",
                "    //    a counterpart in one of the fact tables)",
                "    PrimaryPS = Table.SelectColumns(#\"Fact Primary Article\", {\"net_content\"}),",
                "    PrimaryPS2 = Table.RenameColumns(PrimaryPS, {{\"net_content\", \"Pack Size Raw\"}}),",
                "",
                "    OfftakePS = Table.SelectColumns(#\"Fact Offtake Sales\", {\"Pack Size\"}),",
                "    OfftakePS2 = Table.RenameColumns(OfftakePS, {{\"Pack Size\", \"Pack Size Raw\"}}),",
                "",
                "    AllPS = Table.Distinct(Table.Combine({PrimaryPS2, OfftakePS2})),",
                "",
                "    // ---- 2. Extract numeric value (strip units: \"150ml\", \"150 g\", \"150\", …) ----",
                "    AddNumeric = Table.AddColumn(AllPS, \"Pack ML\", each",
                "        let raw = Text.Trim(Text.From([Pack Size Raw] ?? \"\")),",
                "            digits = Text.Select(raw, {\"0\"..\"9\", \".\"}),   // keep digits and decimal",
                "            n = if digits = \"\" then null else Number.FromText(digits)",
                "        in n,",
                "        type number),",
                "",
                "    // ---- 3. Assign bucket ----",
                "    AddBucket = Table.AddColumn(AddNumeric, \"Pack Bucket\", each",
                "        if [Pack ML] = null              then \"Unknown\"",
                "        else if [Pack ML] <= 50          then \"Micro\"",
                "        else if [Pack ML] <= 150         then \"Small\"",
                "        else if [Pack ML] <= 300         then \"Standard\"",
                "        else if [Pack ML] <= 500         then \"Large\"",
                "        else                                  \"XL\",",
                "        type text),",
                "",
                "    // ---- 4. Sort order for slicers and charts ----",
                "    AddSortOrder = Table.AddColumn(AddBucket, \"Bucket Sort\", each",
                "        Record.FieldOrDefault(",
                "            [Unknown=0, Micro=1, Small=2, Standard=3, Large=4, XL=5],",
                "            [Pack Bucket], 0),",
                "        type number),",
                "",
                "    // ---- 5. Range label for tooltips (\"≤ 50 ml\", \"51–150 ml\", …) ----",
                "    AddLabel = Table.AddColumn(AddSortOrder, \"Bucket Label\", each",
                "        Record.FieldOrDefault(",
                "            [Unknown  = \"Unknown / Bundle\",",
                "             Micro    = \"≤ 50 ml/g\",",
                "             Small    = \"51–150 ml/g\",",
                "             Standard = \"151–300 ml/g\",",
                "             Large    = \"301–500 ml/g\",",
                "             XL       = \"> 500 ml/g\"],",
                "            [Pack Bucket], \"\"),",
                "        type text),",
                "",
                "    // ---- 6. Final column order ----",
                "    Final = Table.SelectColumns(AddLabel, {",
                "        \"Pack Size Raw\", \"Pack ML\", \"Pack Bucket\", \"Bucket Sort\", \"Bucket Label\"",
                "    }),",
                "",
                "    Typed = Table.TransformColumnTypes(Final, {",
                "        {\"Pack Size Raw\", type text},",
                "        {\"Pack ML\", type number},",
                "        {\"Pack Bucket\", type text},",
                "        {\"Bucket Sort\", Int64.Type},",
                "        {\"Bucket Label\", type text}",
                "    })",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "Secondary Sales Efficiency",
        "columns": [
          {
            "name": "FY Year",
            "dataType": "string",
            "sourceColumn": "FY Year"
          },
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month"
          },
          {
            "name": "MonthStart",
            "dataType": "dateTime",
            "sourceColumn": "MonthStart"
          },
          {
            "name": "Chain",
            "dataType": "string",
            "sourceColumn": "Chain"
          },
          {
            "name": "Brand",
            "dataType": "string",
            "sourceColumn": "Brand"
          },
          {
            "name": "Primary NSV",
            "dataType": "double",
            "sourceColumn": "Primary NSV"
          },
          {
            "name": "Offtake NSV",
            "dataType": "double",
            "sourceColumn": "Offtake NSV"
          },
          {
            "name": "Sell-Through Pct",
            "dataType": "double",
            "sourceColumn": "Sell-Through Pct"
          },
          {
            "name": "Sell-Through Raw",
            "dataType": "string",
            "sourceColumn": "Sell-Through Raw"
          },
          {
            "name": "Sell-Through Capped",
            "dataType": "string",
            "sourceColumn": "Sell-Through Capped"
          },
          {
            "name": "Coverage Gap Pct",
            "dataType": "double",
            "sourceColumn": "Coverage Gap Pct"
          },
          {
            "name": "Inventory Signal",
            "dataType": "string",
            "sourceColumn": "Inventory Signal"
          },
          {
            "name": "Signal Sort",
            "dataType": "int64",
            "sourceColumn": "Signal Sort"
          },
          {
            "name": "Outlier Flag",
            "dataType": "boolean",
            "sourceColumn": "Outlier Flag"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "Secondary Sales Efficiency",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// QUERY: Secondary Sales Efficiency  (pre-aggregated helper table)",
                "// Grain: FY Year x Month x Chain x Brand",
                "// Computes sell-through (offtake / primary) at chain x brand x month level,",
                "// returning the core efficiency metrics for the Distribution tab's",
                "// \"Offtake Efficiency\" sub-section and the Chain-wise Performance page.",
                "//",
                "// Columns:",
                "//   FY Year, Month, MonthStart, Chain, Brand",
                "//   Primary NSV      — Rupees, from Fact Primary Article (DIST-allocated)",
                "//   Offtake NSV      — Rupees, from Fact Offtake Sales (source lakh scaled at import)",
                "//   Sell-Through Pct — Offtake NSV / Primary NSV (null-safe, capped at 200%",
                "//                      to exclude months where primary = 0 but offtake > 0",
                "//                      due to pipeline stock; un-capped rows surfaced in",
                "//                      Sell-Through Outlier flag)",
                "//   Coverage Gap Pct — 1 − Sell-Through (positive = under-liquidation)",
                "//   Inventory Signal  — \"Over-stocked\" / \"On-track\" / \"Under-liquidation\"",
                "//                      thresholds: ≥ 120% over-stocked, 80–120% on-track,",
                "//                      < 80% under-liquidation (adjust in Assumption Table)",
                "//   Outlier Flag     — true when Primary NSV is missing/zero and Offtake NSV > 0",
                "//                      (pipeline / opening-stock liquidation — exclude from",
                "//                      efficiency KPIs, review in Distribution Gap page)",
                "//",
                "// Join: this query aggregates both facts separately then merges — it does NOT",
                "// require a shared row-level key between primary and offtake. Chain and Brand",
                "// are the natural join keys; \"Reliance Retail\" / \"Reliance Retail Limited\"",
                "// divergence is resolved by the canonical Chain names established in",
                "// Fact Primary Article ([Chain]) and Fact Offtake Sales ([Chain]).",
                "// =====================================================================",
                "let",
                "    // ---- 1. Aggregate Primary to Chain x Brand x Month ----",
                "    PrimSrc = Table.SelectColumns(",
                "        #\"Fact Primary Article\",",
                "        {\"FY Year\", \"Month\", \"MonthStart\", \"Chain\", \"Brand\", \"Primary NSV\"}),",
                "",
                "    PrimAgg = Table.Group(PrimSrc,",
                "        {\"FY Year\", \"Month\", \"MonthStart\", \"Chain\", \"Brand\"},",
                "        {{\"Primary NSV\", each List.Sum([Primary NSV]), type number}}),",
                "",
                "    // ---- 2. Aggregate Offtake to Chain x Brand x Month ----",
                "    OftSrc = Table.SelectColumns(",
                "        #\"Fact Offtake Sales\",",
                "        {\"FY Year\", \"Month\", \"MonthStart\", \"Chain\", \"Brand\", \"Offtake NSV\"}),",
                "",
                "    OftAgg = Table.Group(OftSrc,",
                "        {\"FY Year\", \"Month\", \"MonthStart\", \"Chain\", \"Brand\"},",
                "        {{\"Offtake NSV\", each List.Sum([Offtake NSV]), type number}}),",
                "",
                "    // ---- 3. Full outer join (keep rows present in either fact) ----",
                "    Joined = Table.NestedJoin(",
                "        PrimAgg, {\"FY Year\", \"Month\", \"MonthStart\", \"Chain\", \"Brand\"},",
                "        OftAgg,  {\"FY Year\", \"Month\", \"MonthStart\", \"Chain\", \"Brand\"},",
                "        \"Oft\", JoinKind.FullOuter),",
                "",
                "    Expanded = Table.ExpandTableColumn(Joined, \"Oft\", {\"Offtake NSV\"}),",
                "",
                "    // ---- 4. Outlier flag: offtake from pipeline stock (Primary = 0) ----",
                "    AddOutlier = Table.AddColumn(Expanded, \"Outlier Flag\", each",
                "        if [Offtake NSV] = null then false",
                "        else ([Primary NSV] = null or [Primary NSV] = 0) and [Offtake NSV] > 0,",
                "        type logical),",
                "",
                "    // ---- 5. Sell-Through Pct (null when Primary=0 to avoid ÷0 distortion) ----",
                "    AddST = Table.AddColumn(AddOutlier, \"Sell-Through Pct\", each",
                "        if [Primary NSV] = null or [Offtake NSV] = null or [Primary NSV] = 0 then null",
                "        else Number.Round([Offtake NSV] / [Primary NSV] * 100, 1),",
                "        type number),",
                "",
                "    // ---- 6. Raw (uncapped) for outlier review ----",
                "    AddSTRaw = Table.AddColumn(AddST, \"Sell-Through Raw\", each",
                "        if [Primary NSV] = null or [Offtake NSV] = null or [Primary NSV] = 0 then null",
                "        else [Offtake NSV] / [Primary NSV] * 100,",
                "        type number),",
                "",
                "    // ---- 7. Capped Sell-Through (≤ 200%) for efficiency KPI visuals ----",
                "    AddSTCapped = Table.AddColumn(AddSTRaw, \"Sell-Through Capped\", each",
                "        if [Sell-Through Raw] = null then null",
                "        else Number.Min([Sell-Through Raw], 200),",
                "        type number),",
                "",
                "    // ---- 8. Coverage Gap ----",
                "    AddGap = Table.AddColumn(AddSTCapped, \"Coverage Gap Pct\", each",
                "        if [Sell-Through Pct] = null then null",
                "        else Number.Round(100 - [Sell-Through Pct], 1),",
                "        type number),",
                "",
                "    // ---- 9. Inventory Signal (thresholds sourced from Assumption Table) ----",
                "    //   Over-stocked      : ST ≥ 120%  (high offtake vs. primary = inventory clearing)",
                "    //   On-track          : 80% ≤ ST < 120%",
                "    //   Under-liquidation : ST < 80%   (slow sell-through = excess stock risk)",
                "    //   No Primary        : Primary = 0 (outlier/pipeline — review separately)",
                "    AddSignal = Table.AddColumn(AddGap, \"Inventory Signal\", each",
                "        if [Offtake NSV] = null          then \"No Offtake Data\"",
                "        else if [Outlier Flag]          then \"No Primary Data\"",
                "        else if [Sell-Through Pct] = null then \"No Primary Data\"",
                "        else if [Sell-Through Pct] >= 120 then \"Over-stocked\"",
                "        else if [Sell-Through Pct] >= 80  then \"On-track\"",
                "        else                                   \"Under-liquidation\",",
                "        type text),",
                "",
                "    // ---- 10. Signal Sort (for consistent legend ordering) ----",
                "    AddSignalSort = Table.AddColumn(AddSignal, \"Signal Sort\", each",
                "        Record.FieldOrDefault(",
                "            [#\"On-track\"=1, #\"Under-liquidation\"=2, #\"Over-stocked\"=3,",
                "             #\"No Primary Data\"=4, #\"No Offtake Data\"=5],",
                "            [Inventory Signal], 5),",
                "        type number),",
                "",
                "    // ---- 11. Final select and type ----",
                "    Final = Table.SelectColumns(AddSignalSort, {",
                "        \"FY Year\", \"Month\", \"MonthStart\", \"Chain\", \"Brand\",",
                "        \"Primary NSV\", \"Offtake NSV\",",
                "        \"Sell-Through Pct\", \"Sell-Through Raw\", \"Sell-Through Capped\",",
                "        \"Coverage Gap Pct\", \"Inventory Signal\", \"Signal Sort\", \"Outlier Flag\"",
                "    }),",
                "",
                "    Typed = Table.TransformColumnTypes(Final, {",
                "        {\"FY Year\", type text}, {\"Month\", type text}, {\"MonthStart\", type date},",
                "        {\"Chain\", type text}, {\"Brand\", type text},",
                "        {\"Primary NSV\", type number}, {\"Offtake NSV\", type number},",
                "        {\"Sell-Through Pct\", type number}, {\"Sell-Through Raw\", type number},",
                "        {\"Sell-Through Capped\", type number}, {\"Coverage Gap Pct\", type number},",
                "        {\"Inventory Signal\", type text}, {\"Signal Sort\", Int64.Type},",
                "        {\"Outlier Flag\", type logical}",
                "    })",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "Fact Secondary Sales",
        "columns": [
          {
            "name": "Source_Month",
            "dataType": "string",
            "sourceColumn": "Source_Month"
          },
          {
            "name": "Month_Label",
            "dataType": "string",
            "sourceColumn": "Month_Label"
          },
          {
            "name": "MonthStart",
            "dataType": "dateTime",
            "sourceColumn": "MonthStart"
          },
          {
            "name": "FY_Year",
            "dataType": "string",
            "sourceColumn": "FY_Year"
          },
          {
            "name": "FY_Derived",
            "dataType": "string",
            "sourceColumn": "FY_Derived"
          },
          {
            "name": "Distributor",
            "dataType": "string",
            "sourceColumn": "Distributor"
          },
          {
            "name": "NSV_Lakh",
            "dataType": "double",
            "sourceColumn": "NSV_Lakh"
          },
          {
            "name": "NSV_Cr",
            "dataType": "double",
            "sourceColumn": "NSV_Cr"
          },
          {
            "name": "Is_Provisional",
            "dataType": "boolean",
            "sourceColumn": "Is_Provisional"
          },
          {
            "name": "Data_Source",
            "dataType": "string",
            "sourceColumn": "Data_Source"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "Fact Secondary Sales",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// QUERY: Fact Secondary Sales  (Distributor sell-out registers)",
                "// Grain: Source_Month × Distributor × NSV_Lakh",
                "//",
                "// Source: PowerBI/RawDataFolders/SecondarySales_Monthly/",
                "//         Files: secondary_sales_distributor_*.csv ONLY",
                "//                (today: _Q1_FY27.csv = Apr-Jun'26, _Jul_Aug_FY27.csv = Jul-Aug'26)",
                "//",
                "// Why the name filter: the same folder also holds the chain and brand",
                "// registers and two tot_hierarchy files that repeat Apr-Aug'26 at article",
                "// grain with Distributor/NSV_Lakh columns. Combining the whole folder would",
                "// count the same sales two or three times. Only distributor register files",
                "// are read. (Defect fix 2026-09-27: the query previously passed a column list",
                "// as fnCombineFolder's HeaderRow number argument, and used a",
                "// \"\\PowerBI\\RawDataFolders\" path under pRootFolder, which already points at",
                "// the PowerBI folder - see 00_Parameters.pq.)",
                "//",
                "// Required columns (exact headers — do not rename in source files):",
                "//   Source_Month  — YYYY-MM  (e.g. 2026-04)",
                "//   Month_Label   — Apr-2026",
                "//   FY_Year       — FY27",
                "//   Distributor   — canonical name matching Fact Primary Article[Distributor]",
                "//   NSV_Lakh      — secondary sell-out NSV in Lakh (ex-GST where confirmed)",
                "//   Data_Source   — free-text source tag",
                "//   Notes         — any provisional flag",
                "//",
                "// Refresh: drop a new secondary_sales_distributor_<period>.csv into",
                "//          SecondarySales_Monthly/ and click Refresh — no query edits needed.",
                "//",
                "// Note: North distributor registers not yet available (Q1 FY27).",
                "//       Rows will appear automatically once included in the export.",
                "// =====================================================================",
                "let",
                "    RequiredColumns = {\"Source_Month\", \"Month_Label\", \"FY_Year\", \"Distributor\",",
                "                       \"NSV_Lakh\", \"Data_Source\", \"Notes\"},",
                "",
                "    // ── Distributor register files only (name filter before parsing) ─",
                "    Files = Folder.Files(pRootFolder & \"\\RawDataFolders\\SecondarySales_Monthly\"),",
                "    DistributorFiles = Table.SelectRows(Files, each",
                "        Text.StartsWith(Text.Lower([Name]), \"secondary_sales_distributor_\")",
                "        and Text.Lower([Extension]) = \".csv\"),",
                "",
                "    Parsed = Table.AddColumn(DistributorFiles, \"Data\", each",
                "        let",
                "            t = Table.PromoteHeaders(",
                "                    Csv.Document([Content], [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "                    [PromoteAllScalars=true]),",
                "            // a renamed/missing header fails the refresh instead of loading nulls",
                "            cols = Table.SelectColumns(t, RequiredColumns, MissingField.Error)",
                "        in",
                "            Table.AddColumn(cols, \"Data Source File\", (r) => [Name], type text)),",
                "",
                "    Source =",
                "        if Table.RowCount(Parsed) = 0 then",
                "            #table(RequiredColumns & {\"Data Source File\"}, {})",
                "        else",
                "            Table.Combine(Parsed[Data]),",
                "",
                "    // ── Type coercions ─────────────────────────────────────────────",
                "    Typed = Table.TransformColumnTypes(Source, {",
                "        {\"Source_Month\",  type text},",
                "        {\"Month_Label\",   type text},",
                "        {\"FY_Year\",       type text},",
                "        {\"Distributor\",   type text},",
                "        {\"NSV_Lakh\",      type number},",
                "        {\"Data_Source\",   type text},",
                "        {\"Notes\",         type text}",
                "    }),",
                "",
                "    // ── Derive date fields from YYYY-MM ────────────────────────────",
                "    WithMonth = Table.AddColumn(Typed, \"MonthStart\", each",
                "        try Date.FromText([Source_Month] & \"-01\") otherwise null,",
                "        type date),",
                "",
                "    WithFY = Table.AddColumn(WithMonth, \"FY_Derived\", each",
                "        let m = Date.Month([MonthStart])",
                "        in if m >= 4 then \"FY\" & Text.From(Date.Year([MonthStart]) + 1)",
                "                     else \"FY\" & Text.From(Date.Year([MonthStart])),",
                "        type text),",
                "",
                "    // ── Provisional flag ───────────────────────────────────────────",
                "    WithProvisional = Table.AddColumn(WithFY, \"Is_Provisional\", each",
                "        Text.Contains([Notes], \"provisional\") or Text.Contains([Notes], \"GST\"),",
                "        type logical),",
                "",
                "    // ── NSV in Crore (for cross-table consistency) ─────────────────",
                "    WithCr = Table.AddColumn(WithProvisional, \"NSV_Cr\", each",
                "        [NSV_Lakh] / 100, type number),",
                "",
                "    // ── Remove helper columns not needed in the model ──────────────",
                "    Final = Table.SelectColumns(WithCr, {",
                "        \"Source_Month\", \"Month_Label\", \"MonthStart\",",
                "        \"FY_Year\", \"FY_Derived\",",
                "        \"Distributor\", \"NSV_Lakh\", \"NSV_Cr\",",
                "        \"Is_Provisional\", \"Data_Source\"",
                "    })",
                "in",
                "    Final"
              ]
            }
          }
        ]
      },
      {
        "name": "Fact Claim Master",
        "columns": [
          {
            "name": "Period",
            "dataType": "dateTime",
            "sourceColumn": "Period"
          },
          {
            "name": "FY_Year",
            "dataType": "string",
            "sourceColumn": "FY_Year"
          },
          {
            "name": "Quarter",
            "dataType": "string",
            "sourceColumn": "Quarter"
          },
          {
            "name": "Chain",
            "dataType": "string",
            "sourceColumn": "Chain"
          },
          {
            "name": "Source_Chain",
            "dataType": "string",
            "sourceColumn": "Source_Chain"
          },
          {
            "name": "Expense_Category",
            "dataType": "double",
            "sourceColumn": "Expense_Category"
          },
          {
            "name": "Amount_Lakh",
            "dataType": "double",
            "sourceColumn": "Amount_Lakh"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "Fact Claim Master",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// QUERY: Fact Claim Master  (Chain-level Q1 FY27 expense)",
                "// Grain: Quarter × Chain × Expense Category",
                "//",
                "// Source: PowerBI/RawDataFolders/ClaimMaster_Quarterly/",
                "//         Files: claim_master_chain_AprJun_2026.csv  (and future quarters)",
                "//",
                "// Required columns:",
                "//   Period           — e.g. \"Apr-Jun 2026\"",
                "//   FY_Year          — FY27",
                "//   Quarter          — Q1",
                "//   Chain            — canonical chain name",
                "//   Chain_Promo_Lakh — on-invoice promo passed to chain",
                "//   Rate_Diff_Lakh   — extra margin / rate difference",
                "//   Freight_Lakh     — freight / transportation",
                "//   Incentive_Lakh   — incentive",
                "//   Off_Invoice_Lakh — off-invoice / debit note promo",
                "//   Visibility_Lakh  — visibility spend",
                "//   Total_Claim_Lakh — sum of all above",
                "//",
                "// Only claim_master_chain_*.csv is read. The same folder also holds the brand",
                "// and distributor claim files; combining the whole folder would add their",
                "// totals to this chain fact. Only the six components are unpivoted:",
                "// Total_Claim_Lakh is their sum, and the chain CSV's extra Entity /",
                "// Amount_Lakh columns repeat it, so unpivoting them would count every claim",
                "// twice in SUM('Fact Claim Master'[Amount_Lakh]).",
                "// (Defect fix 2026-09-27, sibling of the #261 fix to 44_Fact_SecondarySales:",
                "// the query previously passed a column list as fnCombineFolder's HeaderRow",
                "// number argument and used a \"\\PowerBI\\RawDataFolders\" path under",
                "// pRootFolder, which already points at the PowerBI folder - see 00_Parameters.pq.)",
                "//",
                "// The brand file has a commented example query below; no distributor-claim",
                "// query exists in this kit.",
                "//",
                "// Refresh: drop a new claim_master_chain_<period>.csv into ClaimMaster_Quarterly/ → Refresh.",
                "// =====================================================================",
                "let",
                "    IdColumns = {\"Period\", \"FY_Year\", \"Quarter\", \"Chain\", \"Source_Chain\"},",
                "    ExpenseComponents = {\"Chain_Promo_Lakh\", \"Rate_Diff_Lakh\", \"Freight_Lakh\",",
                "                         \"Incentive_Lakh\", \"Off_Invoice_Lakh\", \"Visibility_Lakh\"},",
                "    RequiredColumns = IdColumns & ExpenseComponents & {\"Total_Claim_Lakh\"},",
                "",
                "    // ── Chain claim files only (name filter before parsing) ─────────",
                "    Files = Folder.Files(pRootFolder & \"\\RawDataFolders\\ClaimMaster_Quarterly\"),",
                "    ChainFiles = Table.SelectRows(Files, each",
                "        Text.StartsWith(Text.Lower([Name]), \"claim_master_chain_\")",
                "        and Text.Lower([Extension]) = \".csv\"),",
                "",
                "    Parsed = Table.AddColumn(ChainFiles, \"Data\", each",
                "        let",
                "            t = Table.PromoteHeaders(",
                "                    Csv.Document([Content], [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "                    [PromoteAllScalars=true])",
                "        in",
                "            // drops Entity / Amount_Lakh; a renamed header fails the refresh",
                "            Table.SelectColumns(t, RequiredColumns, MissingField.Error)),",
                "",
                "    Source =",
                "        if Table.RowCount(Parsed) = 0 then",
                "            #table(RequiredColumns, {})",
                "        else",
                "            Table.Combine(Parsed[Data]),",
                "",
                "    Typed = Table.TransformColumnTypes(Source, {",
                "        {\"Period\",            type text},",
                "        {\"FY_Year\",           type text},",
                "        {\"Quarter\",           type text},",
                "        {\"Chain\",             type text},",
                "        {\"Source_Chain\",      type text},",
                "        {\"Chain_Promo_Lakh\",  type number},",
                "        {\"Rate_Diff_Lakh\",    type number},",
                "        {\"Freight_Lakh\",      type number},",
                "        {\"Incentive_Lakh\",    type number},",
                "        {\"Off_Invoice_Lakh\",  type number},",
                "        {\"Visibility_Lakh\",   type number},",
                "        {\"Total_Claim_Lakh\",  type number}",
                "    }),",
                "",
                "    // ── Unpivot the six components only (never Total_Claim_Lakh) ──",
                "    Unpivoted = Table.Unpivot(Typed, ExpenseComponents,",
                "        \"Expense_Category_Raw\", \"Amount_Lakh\"),",
                "",
                "    // ── Clean category names (strip \"_Lakh\" suffix) ─────────────────",
                "    WithCatClean = Table.AddColumn(Unpivoted, \"Expense_Category\", each",
                "        let raw = [Expense_Category_Raw]",
                "        in  if raw = \"Chain_Promo_Lakh\"  then \"Chain Promo (On Invoice)\"",
                "            else if raw = \"Rate_Diff_Lakh\"   then \"Extra Margin / Rate Difference\"",
                "            else if raw = \"Freight_Lakh\"     then \"Freight / Transportation\"",
                "            else if raw = \"Incentive_Lakh\"   then \"Incentive\"",
                "            else if raw = \"Off_Invoice_Lakh\" then \"Off Invoice / Debit Note Promo\"",
                "            else if raw = \"Visibility_Lakh\"  then \"Visibility\"",
                "            else raw,",
                "        type text),",
                "",
                "    // ── Exclude zero rows (cleaner model) ──────────────────────────",
                "    NonZero = Table.SelectRows(WithCatClean, each [Amount_Lakh] <> 0),",
                "",
                "    Final = Table.SelectColumns(NonZero, {",
                "        \"Period\", \"FY_Year\", \"Quarter\",",
                "        \"Chain\", \"Source_Chain\",",
                "        \"Expense_Category\", \"Amount_Lakh\"",
                "    })",
                "in",
                "    Final",
                "",
                "",
                "// ─────────────────────────────────────────────────────────────────────",
                "// COMPANION QUERY — paste as a SEPARATE Blank Query named:",
                "//   45b_ClaimBrand",
                "// ─────────────────────────────────────────────────────────────────────",
                "// let",
                "//     Files = Folder.Files(pRootFolder & \"\\RawDataFolders\\ClaimMaster_Quarterly\"),",
                "//     BrandFiles = Table.SelectRows(Files, each",
                "//         Text.StartsWith(Text.Lower([Name]), \"claim_master_brand_\")",
                "//         and Text.Lower([Extension]) = \".csv\"),",
                "//     Source = Table.Combine(List.Transform(BrandFiles[Content], each",
                "//         Table.SelectColumns(Table.PromoteHeaders(Csv.Document(_,",
                "//             [Delimiter=\",\", Encoding=65001]), [PromoteAllScalars=true]),",
                "//             {\"Period\",\"FY_Year\",\"Quarter\",\"Brand\",",
                "//              \"Apr_Lakh\",\"May_Lakh\",\"Jun_Lakh\",\"Total_Lakh\"}, MissingField.Error))),",
                "//     Typed = Table.TransformColumnTypes(Source,{",
                "//         {\"Period\",type text},{\"FY_Year\",type text},{\"Quarter\",type text},",
                "//         {\"Brand\",type text},{\"Apr_Lakh\",type number},",
                "//         {\"May_Lakh\",type number},{\"Jun_Lakh\",type number},",
                "//         {\"Total_Lakh\",type number}",
                "//     }),",
                "//     Unpivoted = Table.Unpivot(Typed,        // months only, never Total_Lakh",
                "//         {\"Apr_Lakh\",\"May_Lakh\",\"Jun_Lakh\"},\"Month_Key\",\"Amount_Lakh\"),",
                "//     WithMonth = Table.AddColumn(Unpivoted,\"Month_Label\", each",
                "//         if [Month_Key]=\"Apr_Lakh\" then \"Apr-2026\"",
                "//         else if [Month_Key]=\"May_Lakh\" then \"May-2026\"",
                "//         else if [Month_Key]=\"Jun_Lakh\" then \"Jun-2026\"",
                "//         else [Month_Key], type text),",
                "//     Final = Table.SelectColumns(WithMonth,",
                "//         {\"Period\",\"FY_Year\",\"Quarter\",\"Brand\",\"Month_Label\",\"Amount_Lakh\"})",
                "// in  Final"
              ]
            }
          }
        ]
      },
      {
        "name": "Fact Secondary TOT Hierarchy",
        "columns": [
          {
            "name": "Source_Month",
            "dataType": "string",
            "sourceColumn": "Source_Month"
          },
          {
            "name": "Month_Label",
            "dataType": "string",
            "sourceColumn": "Month_Label"
          },
          {
            "name": "Distributor",
            "dataType": "string",
            "sourceColumn": "Distributor"
          },
          {
            "name": "Dist_Monthly_Total",
            "dataType": "double",
            "sourceColumn": "Dist_Monthly_Total"
          },
          {
            "name": "Chain",
            "dataType": "string",
            "sourceColumn": "Chain"
          },
          {
            "name": "Chain_Monthly_Total",
            "dataType": "double",
            "sourceColumn": "Chain_Monthly_Total"
          },
          {
            "name": "Chain_TOT_Pct",
            "dataType": "double",
            "sourceColumn": "Chain_TOT_Pct"
          },
          {
            "name": "Brand",
            "dataType": "string",
            "sourceColumn": "Brand"
          },
          {
            "name": "Brand_Monthly_Total",
            "dataType": "double",
            "sourceColumn": "Brand_Monthly_Total"
          },
          {
            "name": "Brand_TOT_Pct",
            "dataType": "double",
            "sourceColumn": "Brand_TOT_Pct"
          },
          {
            "name": "EAN",
            "dataType": "string",
            "sourceColumn": "EAN"
          },
          {
            "name": "Article",
            "dataType": "string",
            "sourceColumn": "Article"
          },
          {
            "name": "NSV_Value",
            "dataType": "double",
            "sourceColumn": "NSV_Value"
          },
          {
            "name": "NSV_Lakh",
            "dataType": "double",
            "sourceColumn": "NSV_Lakh"
          },
          {
            "name": "Data Source File",
            "dataType": "string",
            "sourceColumn": "Data Source File"
          },
          {
            "name": "MonthStart",
            "dataType": "dateTime",
            "sourceColumn": "MonthStart"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "Fact Secondary TOT Hierarchy",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// QUERY: Fact Secondary TOT Hierarchy   (article-grain distributor sell-out with TOT %)",
                "// Grain: Source_Month x Distributor x Chain x Brand x EAN",
                "//",
                "// Source: PowerBI/RawDataFolders/SecondarySales_Monthly/",
                "//         Files: secondary_sales_tot_hierarchy_*.csv ONLY",
                "//                (today: secondary_sales_tot_hierarchy_Apr_Aug_2026.csv = Apr-Aug'26)",
                "//",
                "// Why the name filter: 44_Fact_SecondarySales.pq reads the distributor register",
                "// files from the same folder, and these files repeat the same sales at article",
                "// grain. Keeping them in their own table stops the same sales being counted twice.",
                "// Promo measures (DAX/15_Promo_Measures.dax) read this table.",
                "//",
                "// Amounts: NSV_Value is rupees, NSV_Lakh is the same value in lakh.",
                "// EAN arrives with a leading apostrophe (Excel text marker); it is removed.",
                "//",
                "// Refresh: a new period file named secondary_sales_tot_hierarchy_<period>.csv is",
                "// picked up on Refresh. Do not leave two files that cover the same months.",
                "// =====================================================================",
                "let",
                "    RequiredColumns = {\"Source_Month\", \"Month_Label\", \"Distributor\", \"Dist_Monthly_Total\",",
                "                       \"Chain\", \"Chain_Monthly_Total\", \"Chain_TOT_Pct\", \"Brand\",",
                "                       \"Brand_Monthly_Total\", \"Brand_TOT_Pct\", \"EAN\", \"Article\",",
                "                       \"NSV_Value\", \"NSV_Lakh\"},",
                "",
                "    Files = Folder.Files(pRootFolder & \"\\RawDataFolders\\SecondarySales_Monthly\"),",
                "    TotFiles = Table.SelectRows(Files, each",
                "        Text.StartsWith(Text.Lower([Name]), \"secondary_sales_tot_hierarchy_\")",
                "        and Text.Lower([Extension]) = \".csv\"),",
                "",
                "    Parsed = Table.AddColumn(TotFiles, \"Data\", each",
                "        let",
                "            t = Table.PromoteHeaders(",
                "                    Csv.Document([Content], [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "                    [PromoteAllScalars=true]),",
                "            // a renamed or missing header fails the refresh instead of loading blanks",
                "            cols = Table.SelectColumns(t, RequiredColumns, MissingField.Error)",
                "        in",
                "            Table.AddColumn(cols, \"Data Source File\", (r) => [Name], type text)),",
                "",
                "    Source =",
                "        if Table.RowCount(Parsed) = 0 then",
                "            #table(RequiredColumns & {\"Data Source File\"}, {})",
                "        else",
                "            Table.Combine(Parsed[Data]),",
                "",
                "    Typed = Table.TransformColumnTypes(Source, {",
                "        {\"Source_Month\", type text}, {\"Month_Label\", type text},",
                "        {\"Distributor\", type text}, {\"Chain\", type text}, {\"Brand\", type text},",
                "        {\"EAN\", type text}, {\"Article\", type text},",
                "        {\"Dist_Monthly_Total\", type number}, {\"Chain_Monthly_Total\", type number},",
                "        {\"Chain_TOT_Pct\", type number}, {\"Brand_Monthly_Total\", type number},",
                "        {\"Brand_TOT_Pct\", type number}, {\"NSV_Value\", type number}, {\"NSV_Lakh\", type number}",
                "    }),",
                "",
                "    CleanEAN = Table.TransformColumns(Typed, {{\"EAN\", each",
                "        if _ = null then null else Text.Trim(Text.TrimStart(_, \"'\")), type text}}),",
                "",
                "    AddMonthStart = Table.AddColumn(CleanEAN, \"MonthStart\", each",
                "        try Date.FromText([Source_Month] & \"-01\") otherwise null, type date)",
                "in",
                "    AddMonthStart"
              ]
            }
          }
        ]
      },
      {
        "name": "Dim Promo Calendar",
        "columns": [
          {
            "name": "Source_Month",
            "dataType": "string",
            "sourceColumn": "Source_Month"
          },
          {
            "name": "Promo_Month",
            "dataType": "string",
            "sourceColumn": "Promo_Month"
          },
          {
            "name": "Promo_Year",
            "dataType": "int64",
            "sourceColumn": "Promo_Year"
          },
          {
            "name": "From",
            "dataType": "dateTime",
            "sourceColumn": "From"
          },
          {
            "name": "To",
            "dataType": "dateTime",
            "sourceColumn": "To"
          },
          {
            "name": "Duration_Days",
            "dataType": "int64",
            "sourceColumn": "Duration_Days"
          },
          {
            "name": "Chain Name",
            "dataType": "string",
            "sourceColumn": "Chain Name"
          },
          {
            "name": "Brand",
            "dataType": "string",
            "sourceColumn": "Brand"
          },
          {
            "name": "Category",
            "dataType": "string",
            "sourceColumn": "Category"
          },
          {
            "name": "Sub_Category",
            "dataType": "string",
            "sourceColumn": "Sub_Category"
          },
          {
            "name": "Range",
            "dataType": "string",
            "sourceColumn": "Range"
          },
          {
            "name": "EAN Code",
            "dataType": "string",
            "sourceColumn": "EAN Code"
          },
          {
            "name": "Article Code",
            "dataType": "string",
            "sourceColumn": "Article Code"
          },
          {
            "name": "Description",
            "dataType": "string",
            "sourceColumn": "Description"
          },
          {
            "name": "MRP",
            "dataType": "double",
            "sourceColumn": "MRP"
          },
          {
            "name": "Offer to consumer",
            "dataType": "string",
            "sourceColumn": "Offer to consumer"
          },
          {
            "name": "ME_Contribution_Pct",
            "dataType": "double",
            "sourceColumn": "ME_Contribution_Pct"
          },
          {
            "name": "Chain_Contribution_Pct",
            "dataType": "double",
            "sourceColumn": "Chain_Contribution_Pct"
          },
          {
            "name": "Total_Contribution_Pct",
            "dataType": "double",
            "sourceColumn": "Total_Contribution_Pct"
          },
          {
            "name": "Locations",
            "dataType": "string",
            "sourceColumn": "Locations"
          },
          {
            "name": "Promo_Type",
            "dataType": "string",
            "sourceColumn": "Promo_Type"
          },
          {
            "name": "Promo_Key",
            "dataType": "string",
            "sourceColumn": "Promo_Key"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "Dim Promo Calendar",
            "source": {
              "type": "m",
              "expression": [
                "// ============================================================================",
                "// Power Query: Promo Calendar Dimension (Sep 2026+)",
                "// Purpose: Reference dimension for promotional mechanics",
                "// Input: PowerBI/RawDataFolders/Promo_Calendar/promo_mechanics_Sep_YYYY.csv",
                "// Output: Dim_PromoCalendar table (linked to Dim_Brand, Dim_Calendar)",
                "// ============================================================================",
                "",
                "let",
                "    // Step 1: Read source CSV from watch folder",
                "    Source = Csv.Document(",
                "        File.Contents(pRootFolder & \"\\RawDataFolders\\Promo_Calendar\\promo_mechanics_Sep_2026.csv\"),",
                "        [Delimiter = \",\", Columns = 18, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]",
                "    ),",
                "",
                "    // Step 2: Promote first row as headers",
                "    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "",
                "    // Step 3: Standardize column names and types",
                "    TypedColumns = Table.TransformColumnTypes(",
                "        PromotedHeaders,",
                "        {",
                "            {\"Source_Month\", type text},           // \"2026-09\"",
                "            {\"Chain Name\", type text},              // Retail channel name",
                "            {\"Brand\", type text},                   // Mamaearth, The Derma Co, etc.",
                "            {\"Category\", type text},                // Product category",
                "            {\"Sub_Category\", type text},            // Product sub-category",
                "            {\"Range\", type text},                   // Product range/line",
                "            {\"EAN Code\", type text},                // EAN (may contain decimals)",
                "            {\"Article Code\", type text},            // Article/SKU code",
                "            {\"Description\", type text},             // Full product description",
                "            {\"MRP\", type number},                   // Maximum Retail Price (INR)",
                "            {\"Offer to consumer\", type any},        // Offer value/discount, or text such as \"BOGO\"",
                "            {\"ME_Contribution_Pct\", type number},   // Mamaearth contribution %",
                "            {\"Chain_Contribution_Pct\", type number}, // Chain contribution %",
                "            {\"Total_Contribution_Pct\", type number}, // Total trade spend allocation %",
                "            {\"Locations\", type text},               // Location scope, e.g. \"PAN India\" or a list of cities",
                "            {\"From \", type date},                   // Promotion start date",
                "            {\"To\", type date},                      // Promotion end date",
                "            {\"Promo_Type\", type text}               // Promotion type classification",
                "        }",
                "    ),",
                "",
                "    // Step 3b: the source writes -9.22e18 (int64 minimum) where a contribution is",
                "    // not set. It parses as a number but would wreck any SUM, so treat it as blank.",
                "    ClearSentinels = Table.TransformColumns(",
                "        TypedColumns,",
                "        {",
                "            {\"Chain_Contribution_Pct\", each if _ <> null and _ < -1000000000 then null else _, type number},",
                "            {\"Total_Contribution_Pct\", each if _ <> null and _ < -1000000000 then null else _, type number},",
                "            // the source writes EAN as a float string (\"8904417322422.0\"); drop the \".0\" so it matches the sell-out EAN",
                "            {\"EAN Code\", each if _ = null then null else (if Text.EndsWith(Text.Trim(_), \".0\") then Text.BeforeDelimiter(Text.Trim(_), \".\", {0, RelativePosition.FromEnd}) else Text.Trim(_)), type text}",
                "        }",
                "    ),",
                "",
                "    // Step 4: Add derived columns for Power BI slicing",
                "    AddDerivedColumns = Table.AddColumn(",
                "        ClearSentinels,",
                "        \"Promo_Month\",",
                "        each Date.Month(",
                "            Date.FromText([Source_Month] & \"-01\")",
                "        ),",
                "        Int64.Type",
                "    ),",
                "",
                "    AddPromoYear = Table.AddColumn(",
                "        AddDerivedColumns,",
                "        \"Promo_Year\",",
                "        each Date.Year(",
                "            Date.FromText([Source_Month] & \"-01\")",
                "        ),",
                "        Int64.Type",
                "    ),",
                "",
                "    AddPromoDuration = Table.AddColumn(",
                "        AddPromoYear,",
                "        \"Duration_Days\",",
                "        each Duration.Days([To] - [From ]) + 1,",
                "        Int64.Type",
                "    ),",
                "",
                "    // Step 5: Clean chain name (standardize to match Dim_Chain canonical names)",
                "    StandardizeChain = Table.ReplaceValue(",
                "        AddPromoDuration,",
                "        each [Chain Name],",
                "        each",
                "            if Text.Contains([Chain Name], \"Dmart\", Comparer.OrdinalIgnoreCase) then \"D-Mart\"",
                "            else if Text.Contains([Chain Name], \"VMM\", Comparer.OrdinalIgnoreCase) or",
                "                    Text.Contains([Chain Name], \"Vishal\", Comparer.OrdinalIgnoreCase) then \"Vishal Mega Mart\"",
                "            else if Text.Contains([Chain Name], \"Reliance\", Comparer.OrdinalIgnoreCase) then \"Reliance Retail\"",
                "            else if Text.Contains([Chain Name], \"Apollo\", Comparer.OrdinalIgnoreCase) then \"Apollo\"",
                "            else if Text.Contains([Chain Name], \"More\", Comparer.OrdinalIgnoreCase) then \"More Retail\"",
                "            else if Text.Contains([Chain Name], \"H&G\", Comparer.OrdinalIgnoreCase) or",
                "                    Text.Contains([Chain Name], \"Health\", Comparer.OrdinalIgnoreCase) then \"Health & Glow\"",
                "            else if Text.Contains([Chain Name], \"Metro\", Comparer.OrdinalIgnoreCase) then \"Metro\"",
                "            else if Text.Contains([Chain Name], \"Lulu\", Comparer.OrdinalIgnoreCase) then \"Lulu Hypermarket\"",
                "            else [Chain Name],",
                "        Replacer.ReplaceText,",
                "        [{\"Chain Name\"}]",
                "    ),",
                "",
                "    // Step 6: Add Promo Key for fact table joins",
                "    AddPromoKey = Table.AddColumn(",
                "        StandardizeChain,",
                "        \"Promo_Key\",",
                "        each [Source_Month] & \"|\" & [Chain Name] & \"|\" & [EAN Code],",
                "        type text",
                "    ),",
                "",
                "    // Step 7: Remove nulls (EAN codes may be empty for bundle/promotion-only SKUs)",
                "    RemoveNulls = Table.SelectRows(",
                "        AddPromoKey,",
                "        each [EAN Code] <> null and [EAN Code] <> \"\"",
                "    ),",
                "",
                "    // Step 8: Remove duplicates (in case of file consolidation)",
                "    RemoveDuplicates = Table.Distinct(",
                "        RemoveNulls,",
                "        {\"Promo_Key\"}",
                "    ),",
                "",
                "    // Step 9: Reorder columns for readability",
                "    ReorderedColumns = Table.ReorderColumns(",
                "        RemoveDuplicates,",
                "        {",
                "            \"Source_Month\", \"Promo_Month\", \"Promo_Year\", \"From \", \"To\", \"Duration_Days\",",
                "            \"Chain Name\", \"Brand\", \"Category\", \"Sub_Category\", \"Range\",",
                "            \"EAN Code\", \"Article Code\", \"Description\", \"MRP\", \"Offer to consumer\",",
                "            \"ME_Contribution_Pct\", \"Chain_Contribution_Pct\", \"Total_Contribution_Pct\",",
                "            \"Locations\", \"Promo_Type\", \"Promo_Key\"",
                "        }",
                "    )",
                "",
                "in",
                "    ReorderedColumns",
                "",
                "// ============================================================================",
                "// RELATIONSHIP SETUP (Manual in Model View):",
                "// ============================================================================",
                "// 1. Dim_PromoCalendar[Chain Name] → Dim_Chain[Chain_Name] (One-to-Many)",
                "//    Direction: Single (1 → *)",
                "//    Cross-Filter: Single",
                "//",
                "// 2. Dim_PromoCalendar[From ] → Dim_Calendar[Date] (One-to-Many, period slice)",
                "//    Direction: Single (1 → *)",
                "//    Cross-Filter: Single",
                "//",
                "// 3. Dim_PromoCalendar[Brand] → Dim_Brand[Brand_Name] (One-to-Many)",
                "//    Direction: Single (1 → *)",
                "//    Cross-Filter: Single",
                "//",
                "// ============================================================================",
                "// MEASUREMENT GUIDANCE (DAX):",
                "// ============================================================================",
                "// Planned Trade Spend Allocation:",
                "// [Planned_ME_Contribution] = SUM(Dim_PromoCalendar[ME_Contribution_Pct])",
                "//",
                "// Planned Chain Investment:",
                "// [Planned_Chain_Contribution] = SUM(Dim_PromoCalendar[Chain_Contribution_Pct])",
                "//",
                "// Planned vs. Actual Variance (once Sep billing data arrives):",
                "// [Trade_Spend_Variance] = [Actual_ME_Contribution] - [Planned_ME_Contribution]",
                "//",
                "// Promo Penetration Rate:",
                "// [SKU_Penetration_Rate] = DISTINCTCOUNT(Dim_PromoCalendar[EAN Code]) / DISTINCTCOUNT(Dim_Brand[EAN])",
                "//",
                "// ============================================================================"
              ]
            }
          }
        ]
      },
      {
        "name": "Fact Nielsen Pack",
        "columns": [
          {
            "name": "MonthStart",
            "dataType": "dateTime",
            "sourceColumn": "MonthStart"
          },
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month"
          },
          {
            "name": "FY Year",
            "dataType": "string",
            "sourceColumn": "FY Year"
          },
          {
            "name": "Nielsen Category",
            "dataType": "string",
            "sourceColumn": "Nielsen Category"
          },
          {
            "name": "Pack Size ml",
            "dataType": "string",
            "sourceColumn": "Pack Size ml"
          },
          {
            "name": "Category Value Cr",
            "dataType": "double",
            "sourceColumn": "Category Value Cr"
          },
          {
            "name": "Our Value Cr",
            "dataType": "double",
            "sourceColumn": "Our Value Cr"
          },
          {
            "name": "Category Volume L",
            "dataType": "double",
            "sourceColumn": "Category Volume L"
          },
          {
            "name": "Our Volume L",
            "dataType": "double",
            "sourceColumn": "Our Volume L"
          },
          {
            "name": "Category WD %",
            "dataType": "string",
            "sourceColumn": "Category WD %"
          },
          {
            "name": "Data Source Name",
            "dataType": "string",
            "sourceColumn": "Data Source Name"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "Fact Nielsen Pack",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// QUERY: Fact Nielsen Pack  (grain = Month x Nielsen Category x Pack Size)",
                "// Source = RawDataFolders\\Nielsen_Pack_Monthly",
                "// Written by scripts/build_nielsen_powerbi_seed.py from the Nielsen pack sheets",
                "// (Category x Basepack and Brand x Basepack, Mamaearth only).",
                "//   Category Value Cr / Our Value Cr   : pack value (Rs Crore), category and Mamaearth",
                "//   Category Volume L / Our Volume L   : pack volume in litres",
                "//   Category WD %                      : weighted distribution of the pack",
                "// Relate Date Table[MonthStart] -> [MonthStart]; Nielsen Category -> Category Master[Nielsen Category].",
                "// =====================================================================",
                "let",
                "    Source = fnCombineFolder(pRootFolder & \"\\RawDataFolders\\Nielsen_Pack_Monthly\", null, {\"Month\", \"FY Year\", \"Nielsen Category\", \"Pack Size ml\", \"Category Value Cr\", \"Our Value Cr\", \"Category Volume L\", \"Our Volume L\", \"Category WD %\", \"Data Source Name\"}),",
                "    Typed = Table.TransformColumnTypes(Source, {",
                "        {\"Month\", type text},",
                "        {\"FY Year\", type text},",
                "        {\"Nielsen Category\", type text},",
                "        {\"Pack Size ml\", type number},",
                "        {\"Category Value Cr\", type number},",
                "        {\"Our Value Cr\", type number},",
                "        {\"Category Volume L\", type number},",
                "        {\"Our Volume L\", type number},",
                "        {\"Category WD %\", type number},",
                "        {\"Data Source Name\", type text}",
                "    }),",
                "    AddMonthStart = Table.AddColumn(Typed, \"MonthStart\", each",
                "        let",
                "            m = Text.BetweenDelimiters([Month], \"\", \"'\"),",
                "            yy = Text.AfterDelimiter([Month], \"'\"),",
                "            monthNum = Record.FieldOrDefault(",
                "                [Jan=1,Feb=2,Mar=3,Apr=4,May=5,Jun=6,Jul=7,Aug=8,Sep=9,Oct=10,Nov=11,Dec=12], m, null)",
                "        in if monthNum = null then null else #date(2000 + Number.FromText(yy), monthNum, 1),",
                "        type date)",
                "in",
                "    AddMonthStart"
              ]
            }
          }
        ]
      },
      {
        "name": "Nielsen Deck State Exposure",
        "columns": [
          {
            "name": "State",
            "dataType": "string",
            "sourceColumn": "State"
          },
          {
            "name": "Market FW Cr",
            "dataType": "double",
            "sourceColumn": "Market FW Cr"
          },
          {
            "name": "Market SH Cr",
            "dataType": "double",
            "sourceColumn": "Market SH Cr"
          },
          {
            "name": "ME Share FW %",
