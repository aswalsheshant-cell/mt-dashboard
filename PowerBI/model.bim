        "measures": [],
        "partitions": [
          {
            "name": "Fact Offtake Sales",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// QUERY: Fact Offtake Sales   (grain = Month x Store(Site) x Article)",
                "// Source = every file in RawDataFolders\\Offtake_Monthly",
                "//   (month-wise CSVs from \"FY-24-26 Chain offtake Store Wise File till May.xlsb\",",
                "//    produced by scripts/split_offtake_store_article_xlsb.py)",
                "//",
                "// MAPPING LOCKED to the confirmed store x article offtake headers:",
                "//   Unique, Zone, State, City, SO/ASE Emp Code, SO/ASE Name, Chain Name,",
                "//   Store Type, DC Code, DC Name, Internal Code, Site Code, Site Name,",
                "//   Article, Article_1, EAN, Chain Article Description, Net Weight,",
                "//   Description as per Fountain, Brand, Category, Sub_category, Range, MRP,",
                "//   Sales Qty, MRP Sales Value, NSV, Per pc, With Tax, Margin, Revised Month,",
                "//   Month, Year, PPT Category",
                "//",
                "// Offtake is maintained MONTHLY (store x article). Source NSV is in lakh;",
                "// convert it to the model's absolute-rupee contract at import. MRP Sales Value",
                "// already arrives in rupees. This is the secondary/offtake validation base for the article",
                "// eligibility gate (DAX 09) — no allocation logic changed here.",
                "// =====================================================================",
                "let",
                "    // Workflow A: drop the splitter's month CSVs (clean header on row 0).",
                "    // (If instead you drop the RAW offtake workbook — blank first row — pass 1.)",
                "    Source = fnCombineFolder(pRootFolder & \"\\RawDataFolders\\Offtake_Monthly\", 0),",
                "",
                "    // keep the columns the model needs (renaming only where required to hit the",
                "    // canonical Fact Offtake Sales fields used by relationships & measures)",
                "    Picked = Table.SelectColumns(Source, {",
                "        \"Month\", \"Year\", \"Revised Month\",",
                "        \"Chain Name\", \"Zone\", \"State\", \"City\",",
                "        \"Site Code\", \"Site Name\", \"Store Type\", \"DC Name\",",
                "        \"Brand\", \"Category\", \"Sub_category\", \"Range\", \"Net Weight\",",
                "        \"Article\", \"Article_1\", \"EAN\",",
                "        \"Description as per Fountain\", \"Chain Article Description\",",
                "        \"Sales Qty\", \"NSV\", \"MRP Sales Value\", \"MRP\", \"Margin\",",
                "        \"SO/ASE Emp Code\", \"SO/ASE Name\", \"PPT Category\"",
                "    }, MissingField.UseNull),",
                "",
                "    Renamed = Table.RenameColumns(Picked, {",
                "        {\"Month\", \"Month\"},",
                "        {\"Year\", \"FY Year\"},",
                "        {\"Chain Name\", \"Chain\"},",
                "        {\"Zone\", \"Zone\"},",
                "        {\"State\", \"State\"},",
                "        {\"City\", \"City\"},",
                "        {\"Site Code\", \"Store Code\"},",
                "        {\"Site Name\", \"Store Name\"},",
                "        {\"Store Type\", \"Store Type\"},",
                "        {\"DC Name\", \"DC Name\"},",
                "        {\"Brand\", \"Brand\"},",
                "        {\"Category\", \"Category\"},",
                "        {\"Sub_category\", \"Sub-category\"},",
                "        {\"Range\", \"Range\"},",
                "        {\"Net Weight\", \"Pack Size\"},",
                "        {\"Article\", \"Article Code\"},",
                "        {\"Article_1\", \"Article Code Alt\"},",
                "        {\"EAN\", \"EAN Code\"},",
                "        {\"Description as per Fountain\", \"Article Description\"},",
                "        {\"Chain Article Description\", \"Chain Article Description\"},",
                "        {\"Sales Qty\", \"Offtake Qty\"},",
                "        {\"NSV\", \"Offtake NSV\"},",
                "        {\"MRP Sales Value\", \"MRP Sales\"},",
                "        {\"MRP\", \"MRP Rate\"},",
                "        {\"Margin\", \"Margin\"},",
                "        {\"SO/ASE Emp Code\", \"SO Emp Code\"},",
                "        {\"SO/ASE Name\", \"Sales Person\"},",
                "        {\"PPT Category\", \"PPT Category\"}",
                "    }),",
                "",
                "    Typed = Table.TransformColumnTypes(Renamed, {",
                "        {\"Month\", type text}, {\"FY Year\", type text},",
                "        {\"Chain\", type text}, {\"Zone\", type text}, {\"State\", type text}, {\"City\", type text},",
                "        {\"Store Code\", type text}, {\"Store Name\", type text}, {\"Store Type\", type text}, {\"DC Name\", type text},",
                "        {\"Brand\", type text}, {\"Category\", type text}, {\"Sub-category\", type text},",
                "        {\"Range\", type text}, {\"Pack Size\", type text},",
                "        {\"Article Code\", type text}, {\"Article Code Alt\", type text}, {\"EAN Code\", type text},",
                "        {\"Article Description\", type text}, {\"Chain Article Description\", type text},",
                "        {\"Offtake Qty\", type number}, {\"Offtake NSV\", type number}, {\"MRP Sales\", type number},",
                "        {\"MRP Rate\", type number}, {\"Margin\", type number},",
                "        {\"SO Emp Code\", type text}, {\"Sales Person\", type text}, {\"PPT Category\", type text}",
                "    }),",
                "",
                "    // Source NSV is lakh (docs/DATA_LINEAGE.md); model currency is absolute rupees.",
                "    // Keep negative returns signed and nulls null. MRP Sales is already rupees.",
                "    Scaled = Table.TransformColumns(Typed, {",
                "        {\"Offtake NSV\", each if _ = null then null else _ * 100000, type number}",
                "    }),",
                "",
                "    Trimmed = Table.TransformColumns(Scaled, {",
                "        {\"Store Code\", each Text.Trim(Text.From(_)), type text},",
                "        {\"Article Code\", each Text.Trim(Text.From(_)), type text},",
                "        {\"EAN Code\", each Text.Trim(Text.From(_)), type text},",
                "        {\"Chain\", each Text.Trim(Text.From(_)), type text},",
                "        {\"Brand\", each Text.Trim(Text.From(_)), type text}",
                "    }),",
                "",
                "    // Chain spellings in the offtake CSVs that differ from Chain Master (case, spacing,",
                "    // short forms). Without this the rows have no Chain Master match and drop out of",
                "    // [Total MT NSV]. Each pair is lowercase alias -> Chain Master name. Checked against",
                "    // build_dashboard_data.py CHAIN_ALIASES for the same entity. FSN/Fsn maps to Nykaa (FSN),",
                "    // a Chain Master row with Channel EB2B (owner decision 2026-10-10), so it stays out of MT.",
                "    ChainAliases = {",
                "        {\"dmart\", \"D-Mart\"}, {\"h&g\", \"Health & Glow\"}, {\"metro cnc\", \"Metro CNC\"},",
                "        {\"sancus(rmt)\", \"RMT-Sancus\"}, {\"vmm\", \"Vishal Mega Mart\"}, {\"spencer\", \"Spencers\"},",
                "        {\"frankros\", \"Frank Ross\"}, {\"arambagh\", \"Arambagh\"}, {\"ratnadeep\", \"Ratnadeep\"},",
                "        {\"ratandeep\", \"Ratnadeep\"}, {\"ratanadeep\", \"Ratnadeep\"}, {\"sasta sundar\", \"SastaSundar\"},",
                "        {\"ssl\", \"SastaSundar\"}, {\"beauty & nutrie\", \"B&N\"}, {\"wh-smith\", \"WH-Smith\"},",
                "        {\"shoppers stop\", \"Shoppers Stop\"}, {\"azorte\", \"Azorte\"}, {\"trends\", \"Trent\"},",
                "        {\"fsn\", \"Nykaa (FSN)\"}",
                "    },",
                "    AliasChain = Table.TransformColumns(Trimmed, {{\"Chain\", each",
                "        let k = Text.Lower(Text.Trim(Text.From(_ ?? \"\"))),",
                "            hit = List.First(List.Select(ChainAliases, (a) => a{0} = k))",
                "        in if hit = null then _ else hit{1}, type text}}),",
                "",
                "    // The early FY27 CSVs call both Reliance streams \"Reliance\"; later files",
                "    // name the Brand Counter stream explicitly. Keep every row and map them to",
                "    // separate Chain Master members so MT excludes only the duplicate breakout.",
                "    AddGovernedChain = Table.AddColumn(AliasChain, \"Governed Chain\", each",
                "        if Text.Contains(Text.Lower([Chain] ?? \"\"), \"reliance\") then",
                "            if Text.Lower(Text.Trim([Store Type] ?? \"\")) = \"brand counter\"",
                "            then \"Reliance Brand Counter\" else \"Reliance Retail\"",
                "        else [Chain], type text),",
                "    RemoveOldChain = Table.RemoveColumns(AddGovernedChain, {\"Chain\"}),",
                "    RenameChain = Table.RenameColumns(RemoveOldChain, {{\"Governed Chain\", \"Chain\"}}),",
                "",
                "    // brand spelling normalisation (keep in sync with Brand Master)",
                "    FixBrand = Table.ReplaceValue(RenameChain, \"BBLUNT\", \"BBlunt\", Replacer.ReplaceText, {\"Brand\"}),",
                "",
                "    // constant audit column",
                "    AddSource = Table.AddColumn(FixBrand, \"Data Source Name\", each \"Chain Offtake Store Wise\", type text),",
                "",
                "    // article key: EAN -> Article Code -> cleaned Description (matches File 2 side)",
                "    AddKey = Table.AddColumn(AddSource, \"Article Key\", each",
                "        if [EAN Code] <> null and Text.Trim([EAN Code]) <> \"\" then \"EAN:\" & [EAN Code]",
                "        else if [Article Code] <> null and Text.Trim([Article Code]) <> \"\" then \"CODE:\" & [Article Code]",
                "        else \"DESC:\" & Text.Upper(Text.Trim(Text.From([Article Description]))), type text),",
                "",
                "    // Month has quoted labels, bare names and Excel serials across these CSVs.",
                "    // The monthly file name supplies a year for bare names; disagreement or",
                "    // missing period fails refresh rather than silently orphaning the row.",
                "    AddMonthStart = Table.AddColumn(AddKey, \"MonthStart\", each",
                "        let",
                "            v = [Month],",
                "            label = if v = null then \"\" else Text.Trim(Text.From(v)),",
                "            serial = try Number.FromText(label) otherwise null,",
                "            labelMonth = if Text.Contains(label, \"'\") then",
                "                Record.FieldOrDefault([Jan=1,Feb=2,Mar=3,Apr=4,May=5,Jun=6,Jul=7,Aug=8,Sep=9,Oct=10,Nov=11,Dec=12],",
                "                    Text.Proper(Text.Start(label, 3)), null) else null,",
                "            labelYear = if labelMonth = null then null",
                "                else try Number.FromText(Text.Trim(Text.AfterDelimiter(label, \"'\"))) otherwise null,",
                "            fromLabel = if Value.Is(v, type date) then Date.StartOfMonth(v)",
                "                else if serial <> null then try Date.StartOfMonth(Date.From(serial)) otherwise null",
                "                else if labelMonth <> null and labelYear <> null then #date(2000 + labelYear, labelMonth, 1)",
                "                else null,",
                "            file = Text.From([Data Source File] ?? \"\"),",
                "            filePeriod = try Text.BetweenDelimiters(file, \"offtake_store_article_\", \".csv\") otherwise null,",
                "            parts = if filePeriod = null then {} else Text.Split(filePeriod, \"_\"),",
                "            fileMonth = if List.Count(parts) = 2 then",
                "                Record.FieldOrDefault([Jan=1,Feb=2,Mar=3,Apr=4,May=5,Jun=6,Jul=7,Aug=8,Sep=9,Oct=10,Nov=11,Dec=12],",
                "                    Text.Proper(parts{0}), null) else null,",
                "            fileYear = if List.Count(parts) = 2 then try Number.FromText(parts{1}) otherwise null else null,",
                "            fromFile = if fileMonth <> null and fileYear <> null then #date(2000 + fileYear, fileMonth, 1) else null,",
                "            result = if fromLabel <> null then fromLabel else fromFile",
                "        in",
                "            if result = null then error Error.Record(\"OfftakeMonth\", \"Unparseable source month\", [File=file, Month=label])",
                "            else if fromFile <> null and result <> fromFile then",
                "                error Error.Record(\"OfftakeMonth\", \"Source month disagrees with file name\", [File=file, Month=label])",
                "            else result,",
                "        type date),",
                "",
                "    Cleaned = Table.SelectRows(AddMonthStart, each [Offtake NSV] <> null or [Offtake Qty] <> null),",
                "",
                "    // Derive FY from the parsed month, as in the Date Table; do not trust the",
                "    // inconsistent source FY text after a month was recovered from the file.",
                "    FYNew = Table.AddColumn(Cleaned, \"FY Year New\", each fnFYLabel([MonthStart]), type text),",
                "    FYDropOld = Table.RemoveColumns(FYNew, {\"FY Year\"}),",
                "    FYDerived = Table.RenameColumns(FYDropOld, {{\"FY Year New\", \"FY Year\"}})",
                "in",
                "    FYDerived"
              ]
            }
          }
        ]
      },
      {
        "name": "Fact P&L",
        "columns": [
          {
            "name": "MonthStart",
            "dataType": "dateTime",
            "sourceColumn": "MonthStart"
          },
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month"
          },
          {
            "name": "FY Year",
            "dataType": "string",
            "sourceColumn": "FY Year"
          },
          {
            "name": "Chain",
            "dataType": "string",
            "sourceColumn": "Chain"
          },
          {
            "name": "Brand",
            "dataType": "string",
            "sourceColumn": "Brand"
          },
          {
            "name": "Category",
            "dataType": "string",
            "sourceColumn": "Category"
          },
          {
            "name": "Offtake NSV",
            "dataType": "double",
            "sourceColumn": "Offtake NSV"
          },
          {
            "name": "Offtake Qty",
            "dataType": "double",
            "sourceColumn": "Offtake Qty"
          },
          {
            "name": "MRP Sales",
            "dataType": "double",
            "sourceColumn": "MRP Sales"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "Fact P&L",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// QUERY: Fact P&L  (built, not hardcoded)",
                "// P&L is DERIVED at refresh time from Offtake NSV + the Assumption Table.",
                "// If a future raw P&L file with actual cost/spend exists, drop it into a",
                "// RawDataFolders\\PnL_Monthly folder and union it here; otherwise the model",
                "// computes P&L from assumptions via DAX (see 02_PnL_Measures.dax).",
                "//",
                "// This query produces an Offtake-NSV-by-Chain/Brand/Category/Month base",
                "// that the P&L DAX measures sit on top of. No spend is hardcoded here.",
                "// =====================================================================",
                "let",
                "    Source = #\"Fact Offtake Sales\",",
                "    Grouped = Table.Group(",
                "        Source,",
                "        {\"MonthStart\", \"Month\", \"FY Year\", \"Chain\", \"Brand\", \"Category\"},",
                "        {",
                "            {\"Offtake NSV\", each List.Sum([Offtake NSV]), type number},",
                "            {\"Offtake Qty\", each List.Sum([Offtake Qty]), type number},",
                "            {\"MRP Sales\",   each List.Sum([MRP Sales]),   type number}",
                "        }",
                "    )",
                "in",
                "    Grouped"
              ]
            }
          }
        ]
      },
      {
        "name": "Fact Nielsen",
        "columns": [
          {
            "name": "MonthStart",
            "dataType": "dateTime",
            "sourceColumn": "MonthStart"
          },
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month"
          },
          {
            "name": "FY Year",
            "dataType": "string",
            "sourceColumn": "FY Year"
          },
          {
            "name": "Nielsen Category",
            "dataType": "string",
            "sourceColumn": "Nielsen Category"
          },
          {
            "name": "Brand",
            "dataType": "string",
            "sourceColumn": "Brand"
          },
          {
            "name": "Zone",
            "dataType": "string",
            "sourceColumn": "Zone"
          },
          {
            "name": "Market Value Sales",
            "dataType": "double",
            "sourceColumn": "Market Value Sales"
          },
          {
            "name": "Our Brand Sales",
            "dataType": "double",
            "sourceColumn": "Our Brand Sales"
          },
          {
            "name": "Value Market Share %",
            "dataType": "double",
            "sourceColumn": "Value Market Share %"
          },
          {
            "name": "Volume Market Share %",
            "dataType": "double",
            "sourceColumn": "Volume Market Share %"
          },
          {
            "name": "Data Source Name",
            "dataType": "string",
            "sourceColumn": "Data Source Name"
          },
          {
            "name": "Volume 000 L",
            "dataType": "double",
            "sourceColumn": "Volume 000 L"
          },
          {
            "name": "Price Per Ml",
            "dataType": "double",
            "sourceColumn": "Price Per Ml"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "Fact Nielsen",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// QUERY: Fact Nielsen Market Share  (grain = Month x Nielsen Category x Brand x Zone)",
                "// Source = RawDataFolders\\Nielsen_Monthly",
                "// =====================================================================",
                "let",
                "    Source = fnCombineFolder(pRootFolder & \"\\RawDataFolders\\Nielsen_Monthly\", null, {\"Month\", \"FY Year\", \"Nielsen Category\", \"Brand\", \"Zone\", \"Market Value Sales\", \"Our Brand Sales\", \"Value Market Share %\", \"Volume Market Share %\", \"Data Source Name\", \"Volume 000 L\", \"Price Per Ml\"}),",
                "    // Volume 000 L and Price Per Ml are optional (older drops lack them); add them as null when missing",
                "    WithOptional = List.Accumulate({\"Volume 000 L\", \"Price Per Ml\"}, Source,",
                "        (tbl, col) => if Table.HasColumns(tbl, col) then tbl else Table.AddColumn(tbl, col, each null, type number)),",
                "    Typed = Table.TransformColumnTypes(WithOptional, {",
                "        {\"Month\", type text},",
                "        {\"FY Year\", type text},",
                "        {\"Nielsen Category\", type text},",
                "        {\"Brand\", type text},",
                "        {\"Zone\", type text},",
                "        {\"Market Value Sales\", type number},",
                "        {\"Our Brand Sales\", type number},",
                "        {\"Value Market Share %\", type number},",
                "        {\"Volume Market Share %\", type number},",
                "        {\"Data Source Name\", type text},",
                "        {\"Volume 000 L\", type number},",
                "        {\"Price Per Ml\", type number}",
                "    }),",
                "    AddMonthStart = Table.AddColumn(Typed, \"MonthStart\", each",
                "        let",
                "            m = Text.BetweenDelimiters([Month], \"\", \"'\"),",
                "            yy = Text.AfterDelimiter([Month], \"'\"),",
                "            monthNum = Record.FieldOrDefault(",
                "                [Jan=1,Feb=2,Mar=3,Apr=4,May=5,Jun=6,Jul=7,Aug=8,Sep=9,Oct=10,Nov=11,Dec=12], m, null)",
                "        in if monthNum = null then null else #date(2000 + Number.FromText(yy), monthNum, 1),",
                "        type date)",
                "in",
                "    AddMonthStart"
              ]
            }
          }
        ]
      },
      {
        "name": "Fact TDP",
        "columns": [
          {
            "name": "MonthStart",
            "dataType": "dateTime",
            "sourceColumn": "MonthStart"
          },
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month"
          },
          {
            "name": "FY Year",
            "dataType": "string",
            "sourceColumn": "FY Year"
          },
          {
            "name": "Chain",
            "dataType": "string",
            "sourceColumn": "Chain"
          },
          {
            "name": "Zone",
            "dataType": "string",
            "sourceColumn": "Zone"
          },
          {
            "name": "State",
            "dataType": "string",
            "sourceColumn": "State"
          },
          {
            "name": "Brand",
            "dataType": "string",
            "sourceColumn": "Brand"
          },
          {
            "name": "Category",
            "dataType": "string",
            "sourceColumn": "Category"
          },
          {
            "name": "Sub-category",
            "dataType": "string",
            "sourceColumn": "Sub-category"
          },
          {
            "name": "Pack Size",
            "dataType": "string",
            "sourceColumn": "Pack Size"
          },
          {
            "name": "Article Code",
            "dataType": "string",
            "sourceColumn": "Article Code"
          },
          {
            "name": "Article Description",
            "dataType": "double",
            "sourceColumn": "Article Description"
          },
          {
            "name": "ACV %",
            "dataType": "double",
            "sourceColumn": "ACV %"
          },
          {
            "name": "AIC",
            "dataType": "double",
            "sourceColumn": "AIC"
          },
          {
            "name": "Numeric Distribution",
            "dataType": "string",
            "sourceColumn": "Numeric Distribution"
          },
          {
            "name": "Weighted Distribution",
            "dataType": "double",
            "sourceColumn": "Weighted Distribution"
          },
          {
            "name": "Data Source Name",
            "dataType": "string",
            "sourceColumn": "Data Source Name"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "Fact TDP",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// QUERY: Fact TDP / Distribution  (grain = Month x Chain x Article ...)",
                "// Source = RawDataFolders\\TDP_Monthly",
                "// TDP (Total Distribution Points) = SUM of ACV % across SKUs. The SUM is",
                "// done in DAX so it rolls up correctly at Brand / Category / Chain / Zone /",
                "// Article / Pack-size level. This query just lands the per-SKU ACV %.",
                "// =====================================================================",
                "let",
                "    Source = fnCombineFolder(pRootFolder & \"\\RawDataFolders\\TDP_Monthly\", null, {\"Month\", \"FY Year\", \"Chain\", \"Zone\", \"State\", \"Brand\", \"Category\", \"Sub-category\", \"Pack Size\", \"Article Code\", \"Article Description\", \"ACV %\", \"AIC\", \"Numeric Distribution\", \"Weighted Distribution\", \"Data Source Name\"}),",
                "    Typed = Table.TransformColumnTypes(Source, {",
                "        {\"Month\", type text},",
                "        {\"FY Year\", type text},",
                "        {\"Chain\", type text},",
                "        {\"Zone\", type text},",
                "        {\"State\", type text},",
                "        {\"Brand\", type text},",
                "        {\"Category\", type text},",
                "        {\"Sub-category\", type text},",
                "        {\"Pack Size\", type text},",
                "        {\"Article Code\", type text},",
                "        {\"Article Description\", type text},",
                "        {\"ACV %\", type number},",
                "        {\"AIC\", type number},",
                "        {\"Numeric Distribution\", type number},",
                "        {\"Weighted Distribution\", type number},",
                "        {\"Data Source Name\", type text}",
                "    }),",
                "    Trimmed = Table.TransformColumns(Typed, {",
                "        {\"Article Code\", each Text.Trim(Text.From(_)), type text},",
                "        {\"Chain\", each Text.Trim(Text.From(_)), type text},",
                "        {\"Brand\", each Text.Trim(Text.From(_)), type text}",
                "    }),",
                "    AddMonthStart = Table.AddColumn(Trimmed, \"MonthStart\", each",
                "        let",
                "            m = Text.BetweenDelimiters([Month], \"\", \"'\"),",
                "            yy = Text.AfterDelimiter([Month], \"'\"),",
                "            monthNum = Record.FieldOrDefault(",
                "                [Jan=1,Feb=2,Mar=3,Apr=4,May=5,Jun=6,Jul=7,Aug=8,Sep=9,Oct=10,Nov=11,Dec=12], m, null)",
                "        in if monthNum = null then null else #date(2000 + Number.FromText(yy), monthNum, 1),",
                "        type date)",
                "in",
                "    AddMonthStart"
              ]
            }
          }
        ]
      },
      {
        "name": "Fact Primary ShipTo",
        "columns": [
          {
            "name": "MonthStart",
            "dataType": "dateTime",
            "sourceColumn": "MonthStart"
          },
          {
            "name": "MonthStartCalc",
            "dataType": "dateTime",
            "sourceColumn": "MonthStartCalc"
          },
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month"
          },
          {
            "name": "FY Year",
            "dataType": "string",
            "sourceColumn": "FY Year"
          },
          {
            "name": "Ship To Name",
            "dataType": "string",
            "sourceColumn": "Ship To Name"
          },
          {
            "name": "Direct/Distributor",
            "dataType": "string",
            "sourceColumn": "Direct/Distributor"
          },
          {
            "name": "Chain",
            "dataType": "string",
            "sourceColumn": "Chain"
          },
          {
            "name": "Zone",
            "dataType": "string",
            "sourceColumn": "Zone"
          },
          {
            "name": "State",
            "dataType": "string",
            "sourceColumn": "State"
          },
          {
            "name": "Brand",
            "dataType": "string",
            "sourceColumn": "Brand"
          },
          {
            "name": "Primary NSV",
            "dataType": "double",
            "sourceColumn": "Primary NSV"
          },
          {
            "name": "MRP Value",
            "dataType": "double",
            "sourceColumn": "MRP Value"
          },
          {
            "name": "Cont%",
            "dataType": "double",
            "sourceColumn": "Cont%"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "Fact Primary ShipTo",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// QUERY: Fact Primary ShipTo   (grain = Month x Ship-To x Chain x Brand)",
                "// Source = RawDataFolders\\Primary_ShipTo_Monthly",
                "//",
                "// This is the ship-to-party primary feed where primary NSV is ALREADY",
                "// allocated to Chain based on the secondary/offtake contribution % that",
                "// month. (Direct ship-tos => one chain, Cont% = 100%. Distributor ship-tos",
                "// => split across chains by Cont%.)",
                "//",
                "// The Cont% column is the dynamic, month-wise allocation driver (the",
                "// \"separate mapping table\"). It is NOT hardcoded - it arrives in the monthly",
                "// file and is also projected out as 'Primary Allocation Map' (query 34).",
                "//",
                "// Cleaning here is reproducible every month: brand/chain spellings are",
                "// normalised and NSV (received in Lacs) is converted to absolute rupees so",
                "// it lines up with Fact Offtake Sales.",
                "// =====================================================================",
                "let",
                "    Combined = fnCombineFolder(pRootFolder & \"\\RawDataFolders\\Primary_ShipTo_Monthly\"),",
                "",
                "    // Primary_ShipTo_FY24-25.csv and Primary_ShipTo_FY25-26_to_May26.csv are exact",
                "    // subsets of Primary_ShipTo_FY24-26_Composite.csv on Month, Ship To Name, Brand,",
                "    // NSV and MRP (every row found, same totals). Their Chain labels differ (the",
                "    // composite uses the normalised names). Loading all three counted those",
                "    // months two times.",
                "    // New monthly files are still picked up. 41_DistContWeights.pq reads the",
                "    // FY25-26 file by name, so the files stay in the folder.",
                "    Source = Table.SelectRows(Combined, each not List.Contains(",
                "        {\"Primary_ShipTo_FY24-25.csv\", \"Primary_ShipTo_FY25-26_to_May26.csv\"}, [Data Source File])),",
                "",
                "    Typed = Table.TransformColumnTypes(Source, {",
                "        {\"Month\", type text},",
                "        {\"MonthStart\", type date},",
                "        {\"FY Year\", type text},",
                "        {\"Ship To Name\", type text},",
                "        {\"Direct/Distributor\", type text},",
                "        {\"Chain\", type text},",
                "        {\"Zone\", type text},",
                "        {\"State\", type text},",
                "        {\"Brand\", type text},",
                "        {\"Primary NSV\", type number},",
                "        {\"MRP Value\", type number},",
                "        {\"Cont%\", type number}",
                "    }),",
                "",
                "    Trimmed = Table.TransformColumns(Typed, {",
                "        {\"Ship To Name\", each Text.Trim(Text.From(_)), type text},",
                "        {\"Chain\", each Text.Trim(Text.From(_)), type text},",
                "        {\"Brand\", each Text.Trim(Text.From(_)), type text}",
                "    }),",
                "",
                "    // --- normalise brand spellings (keep in sync with Brand Master) ---",
                "    FixBrand = Table.ReplaceValue(Trimmed, \"BBLUNT\", \"BBlunt\", Replacer.ReplaceText, {\"Brand\"}),",
                "",
                "    // --- normalise chain spellings (keep in sync with Chain Master) ---",
                "    FixChain1 = Table.ReplaceValue(FixBrand, \"Vmm\",       \"Vishal Mega Mart\", Replacer.ReplaceValue, {\"Chain\"}),",
                "    FixChain2 = Table.ReplaceValue(FixChain1,\"VMM\",       \"Vishal Mega Mart\", Replacer.ReplaceValue, {\"Chain\"}),",
                "    FixChain3 = Table.ReplaceValue(FixChain2,\"ARAMBAGH\",  \"Arambagh\",         Replacer.ReplaceValue, {\"Chain\"}),",
                "    FixChain4 = Table.ReplaceValue(FixChain3,\"Reliance\",  \"Reliance Retail\",  Replacer.ReplaceValue, {\"Chain\"}),",
                "    FixChain5 = Table.ReplaceValue(FixChain4,\"Dmart\",     \"D-Mart\",           Replacer.ReplaceValue, {\"Chain\"}),",
                "    FixChain6 = Table.ReplaceValue(FixChain5,\"Spencer\",   \"Spencers\",         Replacer.ReplaceValue, {\"Chain\"}),",
                "    FixChain7 = Table.ReplaceValue(FixChain6,\"H&G\",       \"Health & Glow\",    Replacer.ReplaceValue, {\"Chain\"}),",
                "",
                "    // If the file ever arrives in Lacs again instead of absolute rupees,",
                "    // flip this flag. The seed already stores absolute rupees, so default = false.",
                "    ConvertFromLacs = false,",
                "    Scaled = if ConvertFromLacs",
                "        then Table.TransformColumns(FixChain7, {",
                "                {\"Primary NSV\", each _ * 100000, type number},",
                "                {\"MRP Value\",  each _ * 100000, type number}})",
                "        else FixChain7,",
                "",
                "    // Direct rows may have blank Cont% -> treat as 100%",
                "    FillCont = Table.ReplaceValue(Scaled, null, 1.0, Replacer.ReplaceValue, {\"Cont%\"}),",
                "",
                "    // rebuild MonthStart if the source only had the text label",
                "    AddMonthStart = Table.AddColumn(FillCont, \"MonthStartCalc\", each",
                "        if [MonthStart] <> null then [MonthStart]",
                "        else",
                "            let m = Text.Start(Text.BeforeDelimiter([Month], \"'\"), 3),",
                "                yy = Text.AfterDelimiter([Month], \"'\"),",
                "                mn = Record.FieldOrDefault([Jan=1,Feb=2,Mar=3,Apr=4,May=5,Jun=6,Jul=7,Aug=8,Sep=9,Oct=10,Nov=11,Dec=12], m, null)",
                "            in if mn = null then null else #date(2000 + Number.FromText(yy), mn, 1),",
                "        type date),",
                "",
                "    Cleaned = Table.SelectRows(AddMonthStart, each [Primary NSV] <> null)",
                "in",
                "    Cleaned"
              ]
            }
          }
        ]
      },
      {
        "name": "Fact Primary Article",
        "columns": [
          {
            "name": "MonthStart",
            "dataType": "dateTime",
            "sourceColumn": "MonthStart"
          },
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month"
          },
          {
            "name": "FY Year",
            "dataType": "string",
            "sourceColumn": "FY Year"
          },
          {
            "name": "Channel",
            "dataType": "string",
            "sourceColumn": "Channel"
          },
          {
            "name": "Customer Code",
            "dataType": "string",
            "sourceColumn": "Customer Code"
          },
          {
            "name": "Ship To Name",
