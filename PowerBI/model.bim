      {
        "name": "Store Key Alias",
        "columns": [
          {
            "name": "Alias Store Key",
            "dataType": "string",
            "sourceColumn": "Alias Store Key"
          },
          {
            "name": "Alias Match Key",
            "dataType": "string",
            "sourceColumn": "Alias Match Key"
