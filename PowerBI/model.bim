{
  "name": "MT_Dashboard",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "expressions": [
      {
        "name": "pRootFolder",
        "kind": "m",
        "expression": "\"C:\\MT-Dashboard\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ]
      },
      {
        "name": "pPrimaryChannel",
        "kind": "m",
        "expression": "\"MT\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ]
      },
      {
        "name": "fnCombineFolder",
        "kind": "m",
        "expression": [
          "let",
          "    fnCombineFolder = (FolderPath as text, optional HeaderRow as nullable number, optional ExpectedColumns as nullable list) as table =>",
          "        let",
          "            Source = Folder.Files(FolderPath),",
          "            HeaderIndex = if HeaderRow = null then 0 else Number.RoundDown(Number.From(HeaderRow)),",
          "",
          "            OnlyData = Table.SelectRows(",
          "                Source,",
          "                each ([Attributes]?[Hidden]? <> true)",
          "                    and (Text.StartsWith([Name], \"_\") = false)",
          "                    and (",
          "                        Text.EndsWith(Text.Lower([Extension]), \".csv\")",
          "                        or Text.EndsWith(Text.Lower([Extension]), \".xlsx\")",
          "                        or Text.EndsWith(Text.Lower([Extension]), \".xlsb\")",
          "                    )",
          "            ),",
          "",
          "            AddParsed = Table.AddColumn(OnlyData, \"Parsed\", each",
          "                let",
          "                    ext = Text.Lower([Extension]),",
          "                    bin = [Content],",
          "                    asTable =",
          "                        if ext = \".csv\" then",
          "                            Csv.Document(bin, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv])",
          "                        else",
          "                            let",
          "                                wb = Excel.Workbook(bin, null, true),",
          "                                firstSheet = wb{0}[Data]",
          "                            in firstSheet,",
          "                    promoted =",
          "                        if HeaderIndex = 0 then",
          "                            Table.PromoteHeaders(asTable, [PromoteAllScalars=true])",
          "                        else",
          "                            let",
          "                                skipped = Table.Skip(asTable, HeaderIndex),",
          "                                promotedHeaders = Table.PromoteHeaders(skipped, [PromoteAllScalars=true])",
          "                            in",
          "                                promotedHeaders",
          "                in",
          "                    promoted",
          "            ),",
          "",
          "            AddMeta = Table.AddColumn(AddParsed, \"WithMeta\", each",
          "                Table.AddColumn(",
          "                    Table.AddColumn([Parsed], \"Data Source File\", (r) => [Name], type text),",
          "                    \"Refresh Date\", (r) => DateTime.LocalNow(), type datetime",
          "                )",
          "            ),",
          "",
          "            Combined =",
          "                if Table.RowCount(AddMeta) = 0 then",
          "                    #table(",
          "                        List.Combine({if ExpectedColumns = null then {} else ExpectedColumns, {\"Data Source File\",\"Refresh Date\"}}),",
          "                        {})",
          "                else",
          "                    Table.Combine(AddMeta[WithMeta])",
          "        in",
          "            Combined",
          "in",
          "    fnCombineFolder"
        ]
      },
      {
        "name": "fnFYLabel",
        "kind": "m",
        "expression": [
          "let",
          "    fnFYLabel = (d as nullable date) as nullable text =>",
          "        if d = null then null",
          "        else",
          "            let",
          "                y = Date.Year(d),",
          "                m = Date.Month(d),",
          "                startYear = if m >= 4 then y else y - 1",
          "            in",
          "                Text.PadStart(Text.From(Number.Mod(startYear, 100)), 2, \"0\") & \"-\" &",
          "                Text.PadStart(Text.From(Number.Mod(startYear + 1, 100)), 2, \"0\")",
          "in",
          "    fnFYLabel"
        ]
      }
    ],
    "tables": [
      {
        "name": "Date Table",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date"
          },
          {
            "name": "MonthStart",
            "dataType": "dateTime",
            "sourceColumn": "MonthStart"
          },
          {
            "name": "Year",
            "dataType": "int64",
            "sourceColumn": "Year"
          },
          {
            "name": "Month No",
            "dataType": "int64",
            "sourceColumn": "Month No"
          },
          {
            "name": "Month Name",
            "dataType": "string",
            "sourceColumn": "Month Name",
            "sortByColumn": "Month No"
          },
          {
            "name": "FY Month No",
            "dataType": "int64",
            "sourceColumn": "FY Month No"
          },
          {
            "name": "FY Year",
            "dataType": "string",
            "sourceColumn": "FY Year"
          },
          {
            "name": "Quarter",
            "dataType": "string",
            "sourceColumn": "Quarter",
            "sortByColumn": "FY Month No"
          },
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month",
            "sortByColumn": "Month Year Sort"
          },
          {
            "name": "Month Year Sort",
            "dataType": "int64",
            "sourceColumn": "Month Year Sort"
          },
          {
            "name": "Is Future",
            "dataType": "boolean",
            "sourceColumn": "Is Future"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "Date Table",
            "source": {
              "type": "calculated",
              "expression": [
                "VAR _Start = DATE(2024, 4, 1)        // first day of earliest FY you report",
                "VAR _End   = DATE(2028, 3, 31)       // last day of the latest FY you forecast",
                "RETURN",
                "ADDCOLUMNS(",
                "    CALENDAR(_Start, _End),",
                "    \"MonthStart\",      EOMONTH([Date], -1) + 1,",
                "    \"Year\",            YEAR([Date]),",
                "    \"Month No\",        MONTH([Date]),",
                "    \"Month Name\",      FORMAT([Date], \"mmm\"),",
                "    // Indian FY: Apr=1 ... Mar=12",
                "    \"FY Month No\",     IF(MONTH([Date]) >= 4, MONTH([Date]) - 3, MONTH([Date]) + 9),",
                "    \"FY Year\",",
                "        VAR y = YEAR([Date])",
                "        RETURN IF(MONTH([Date]) >= 4,",
                "                 FORMAT(MOD(y, 100), \"00\") & \"-\" & FORMAT(MOD(y + 1, 100), \"00\"),",
                "                 FORMAT(MOD(y - 1, 100), \"00\") & \"-\" & FORMAT(MOD(y, 100), \"00\")),",
                "    \"Quarter\",",
                "        VAR fm = IF(MONTH([Date]) >= 4, MONTH([Date]) - 3, MONTH([Date]) + 9)",
                "        RETURN \"Q\" & ROUNDUP(fm / 3, 0),",
                "    // label used everywhere in the deck, e.g. May'26",
                "    \"Month\",           FORMAT([Date], \"mmm\") & \"'\" & FORMAT([Date], \"yy\"),",
                "    \"Month Year Sort\", YEAR([Date]) * 100 + MONTH([Date]),",
                "    \"Is Future\",       IF([Date] > TODAY(), TRUE(), FALSE())",
                ")"
              ]
            }
          }
        ],
        "dataCategory": "Time",
        "hierarchies": [
          {
            "name": "Time (FY)",
            "levels": [
              {
                "name": "FY Year",
                "ordinal": 0,
                "column": "FY Year"
              },
              {
                "name": "Quarter",
                "ordinal": 1,
                "column": "Quarter"
              },
              {
                "name": "Month Name",
                "ordinal": 2,
                "column": "Month Name"
              }
            ]
          }
        ]
      },
