          {
            "name": "TOT Method",
            "dataType": "double",
            "type": "calculated",
            "expression": "VAR _mrp = 'Fact Primary Article'[Primary MRP]\nVAR _nsv = 'Fact Primary Article'[Primary NSV]\nVAR _avgTot = 'Fact Primary Article'[Avg TOT]\nVAR _tax = 'Fact Primary Article'[Primary Tax Amount]\nRETURN\n    IF ( ISBLANK ( _mrp ) || _mrp = 0, \"invalid\",\n        IF ( NOT ISBLANK ( _avgTot ) && _avgTot >= -1.5 && _avgTot <= 1.5, \"avg_tot\",\n            IF ( ISBLANK ( _nsv ), \"invalid\",\n                IF ( NOT ISBLANK ( _tax ), \"tax_calc\", \"gst_fallback\" )\n            )\n        )\n    )",
            "isDataTypeInferred": true
          },
          {
            "name": "TOT Pass-on Value",
            "dataType": "double",
            "type": "calculated",
            "expression": "VAR _method = 'Fact Primary Article'[TOT Method]\nVAR _mrp = 'Fact Primary Article'[Primary MRP]\nVAR _nsv = 'Fact Primary Article'[Primary NSV]\nVAR _avgTot = 'Fact Primary Article'[Avg TOT]\nVAR _tax = 'Fact Primary Article'[Primary Tax Amount]\nVAR _cat = 'Fact Primary Article'[Category]\nRETURN\n    SWITCH (\n        _method,\n        \"avg_tot\", _mrp * _avgTot,\n        \"tax_calc\", _mrp - _nsv - _tax,\n        \"gst_fallback\",\n            VAR _preRate = LOOKUPVALUE ( 'GST Rate QC Table'[Pre_GST_Rate_Pct], 'GST Rate QC Table'[Category], _cat )\n            VAR _postRate = LOOKUPVALUE ( 'GST Rate QC Table'[Post_GST_Rate_Pct], 'GST Rate QC Table'[Category], _cat )\n            VAR _effFromTxt = LOOKUPVALUE ( 'GST Rate QC Table'[Effective_From], 'GST Rate QC Table'[Category], _cat )\n            VAR _effFrom = IF ( TRIM ( COALESCE ( _effFromTxt, \"\" ) ) = \"\", BLANK(), DATEVALUE ( _effFromTxt ) )\n            VAR _cutover = COALESCE ( _effFrom, [GST Cutover Date] )\n            VAR _pre = COALESCE ( _preRate, 18 )\n            VAR _post = COALESCE ( _postRate, 18 )\n            VAR _rate = IF ( 'Fact Primary Article'[MonthStart] >= _cutover, _post, _pre )\n            RETURN _mrp - _nsv - ( _nsv * _rate / 100 ),\n        BLANK()\n    )",
            "isDataTypeInferred": true
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "Fact Primary Article",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// QUERY: Fact Primary Article  (File 2 — article-wise primary, DIST-allocated)",
                "// Source: RawDataFolders\\Primary_Article_Monthly\\",
                "//   (month-wise CSVs from the article-wise primary .xlsb, produced by",
                "//    scripts/split_primary_article_xlsb.py — pass --header-row 1: the current",
                "//    business format has a reference/annotation row ABOVE the real header)",
                "// Grain: Month x Customer(Ship-to) x Chain x Brand x Article — after the",
                "//   DIST allocation below, one source Dist. row becomes one row PER CHAIN.",
                "//",
                "// MAPPING LOCKED to the CURRENT business headers (per the maintained file --",
                "// do not assume old names):",
                "//   FY, Month, Channel, Inv. Date, Cust-SAP Code, Ship To Name, EAN No.,",
                "//   net_content, brand, PPT Category, category, sub_category, range,",
                "//   Description, MRP (article MRP), Inv Qty, Inv. Net value(LOC),",
                "//   Inv. Tax Amount(LOC), Total MRP sales, Avg Tot, MTD-Sale type, PO Type,",
                "//   \"Chain name for Dashboard\" (one header cell containing a line break --",
                "//   normalised to a single space below), Zone, State",
                "//",
                "// DIST ALLOCATION (mirrors allocate_dist_primary() in",
                "// scripts/build_dashboard_data.py exactly):",
                "//   * PO Type = 'Dist.' rows have a BLANK \"Chain name for Dashboard\" -- they",
                "//     are exploded across chains by 'Dist Cont Weights' (query 41), joined on",
                "//     Ship To Name x Brand x Month. Inv Qty / Total MRP sales / NSV / Tax are",
                "//     scaled by the normalised cont% (sums to exactly 1 per key, so totals",
                "//     reconcile to the input by construction). Article MRP is per-unit and is",
                "//     NOT scaled. Avg Tot is a ratio, invariant under the split.",
                "//   * Direct rows keep their own \"Chain name for Dashboard\".",
                "//   * Dist. rows with no cont-sheet entry get Chain = \"Unmapped Chain\" --",
                "//     never blank, never the distributor's Ship To Name.",
                "//   * Ship To Name stays a CUSTOMER/distributor field; the dashboard chain",
                "//     field is always [Chain].",
                "// NOTE the flag lives in **PO Type** (Direct / Dist.), NOT in MTD-Sale type",
                "// (which holds Sales / MRN / Cancel Invoice / FOC).",
                "// =====================================================================",
                "let",
                "    Source = fnCombineFolder(pRootFolder & \"\\RawDataFolders\\Primary_Article_Monthly\"),",
                "",
                "    // normalise headers: collapse the embedded line break in",
                "    // \"Chain name(lf)for Dashboard\" and squeeze doubled spaces",
                "    FixedNames = Table.TransformColumnNames(Source, each",
                "        Text.Trim(Text.Replace(Text.Replace(Text.Replace(_, \"#(lf)\", \" \"), \"#(cr)\", \" \"), \"  \", \" \"))),",
                "",
                "    // Apr'25-May'26 files call these columns \"Chain name\" and \"MRP Rate\"; Jun'26+",
                "    // files use \"Chain name for Dashboard\" and \"MRP\". Same meaning (checked:",
                "    // Qty x MRP = Total MRP sales on both). Without this, MissingField.UseNull",
                "    // left Chain Dash and Article MRP blank for 14 months.",
                "    fnAlias = (t as table, newName as text, oldName as text) as table =>",
                "        if not Table.HasColumns(t, oldName) then t",
                "        else if not Table.HasColumns(t, newName) then Table.RenameColumns(t, {{oldName, newName}})",
                "        else Table.RenameColumns(",
                "            Table.RemoveColumns(",
                "                Table.AddColumn(t, \"__merged\", each Record.Field(_, newName) ?? Record.Field(_, oldName)),",
                "                {newName, oldName}),",
                "            {{\"__merged\", newName}}),",
                "    AliasChain = fnAlias(FixedNames, \"Chain name for Dashboard\", \"Chain name\"),",
                "    AliasNames = fnAlias(AliasChain, \"MRP\", \"MRP Rate\"),",
                "",
                "    Picked = Table.SelectColumns(AliasNames, {",
                "        \"FY\", \"Month\", \"Channel\", \"Inv. Date\", \"Cust-SAP Code\", \"Ship To Name\",",
                "        \"EAN No.\", \"net_content\", \"brand\", \"PPT Category\",",
                "        \"category\", \"sub_category\", \"range\", \"Description\", \"MRP\",",
                "        \"Inv Qty\", \"Inv. Net value(LOC)\", \"Inv. Tax Amount(LOC)\", \"Total MRP sales\", \"Avg Tot\",",
                "        \"MTD-Sale type\", \"PO Type\", \"Chain name for Dashboard\", \"Zone\", \"State\"",
                "    }, MissingField.UseNull),",
                "",
                "    Renamed = Table.RenameColumns(Picked, {",
                "        {\"FY\", \"FY Year\"},",
                "        {\"Cust-SAP Code\", \"Customer Code\"},",
                "        {\"EAN No.\", \"EAN Code\"},",
                "        {\"Description\", \"Article Description\"},",
                "        {\"brand\", \"Brand\"},",
                "        {\"PPT Category\", \"PPT Category\"},",
                "        {\"category\", \"Category\"},",
                "        {\"sub_category\", \"Sub-category\"},",
                "        {\"range\", \"Range\"},",
                "        {\"MRP\", \"Article MRP\"},",
                "        {\"Inv Qty\", \"Primary Qty\"},",
                "        {\"Inv. Net value(LOC)\", \"Primary NSV\"},",
                "        {\"Inv. Tax Amount(LOC)\", \"Primary Tax Amount\"},",
                "        {\"Total MRP sales\", \"Primary MRP\"},",
                "        {\"Avg Tot\", \"Avg TOT\"},",
                "        {\"Chain name for Dashboard\", \"Chain Dash\"}",
                "    }),",
                "",
                "    Typed = Table.TransformColumnTypes(Renamed, {",
                "        {\"FY Year\", type text}, {\"Month\", type text}, {\"Channel\", type text},",
                "        {\"Customer Code\", type text}, {\"Ship To Name\", type text},",
                "        {\"EAN Code\", type text}, {\"net_content\", type text}, {\"Brand\", type text},",
                "        {\"PPT Category\", type text}, {\"Category\", type text}, {\"Sub-category\", type text},",
                "        {\"Range\", type text}, {\"Article Description\", type text},",
                "        {\"Article MRP\", type number}, {\"Primary Qty\", type number},",
                "        {\"Primary NSV\", type number}, {\"Primary Tax Amount\", type number},",
                "        {\"Primary MRP\", type number}, {\"Avg TOT\", type number},",
                "        {\"MTD-Sale type\", type text}, {\"PO Type\", type text},",
                "        {\"Chain Dash\", type text}, {\"Zone\", type text}, {\"State\", type text}",
                "    }),",
                "",
                "    // Channel scope (parameter pPrimaryChannel). Spelling is folded first because the",
                "    // files hold both \"EB2B\" and \"Eb2b\". \"MT\" drops EB2B and SIS rows only; every MT chain,",
                "    // Reliance included, stays. \"ALL\" keeps everything.",
                "    ChannelNorm = Table.TransformColumns(Typed, {{\"Channel\", each Text.Upper(Text.Trim(Text.From(_ ?? \"\"))), type text}}),",
                "    ChannelScoped = if Text.Upper(pPrimaryChannel) = \"ALL\" then ChannelNorm",
                "        else Table.SelectRows(ChannelNorm, each [Channel] = Text.Upper(Text.Trim(pPrimaryChannel))),",
                "",
                "    // MonthStart from \"April'24\"/\"Apr'24\" text, a date value, or an Excel serial",
                "    AddMonthStart = Table.AddColumn(ChannelScoped, \"MonthStart\", each",
                "        let v = [Month]",
                "        in  if v = null then null",
                "            else if Value.Is(v, type date) then Date.StartOfMonth(v)",
                "            else if Value.Is(v, type number) then Date.StartOfMonth(Date.From(v))",
                "            else",
                "                let m = Text.Start(Text.BeforeDelimiter(Text.From(v), \"'\"), 3),",
                "                    yy = Text.AfterDelimiter(Text.From(v), \"'\"),",
                "                    mn = Record.FieldOrDefault([Jan=1,Feb=2,Mar=3,Apr=4,May=5,Jun=6,Jul=7,Aug=8,Sep=9,Oct=10,Nov=11,Dec=12], m, null)",
                "                in if mn = null or yy = \"\" then null else #date(2000 + Number.FromText(yy), mn, 1),",
                "        type date),",
                "",
                "    Cleaned = Table.SelectRows(AddMonthStart, each [Primary NSV] <> null or [Primary Qty] <> null),",
                "",
                "    // ---------- DIST -> Chain allocation ----------",
                "    AddIsDist = Table.AddColumn(Cleaned, \"Is Dist\", each",
                "        Text.Lower(Text.Trim(Text.From([PO Type] ?? \"\"))) = \"dist.\"",
                "        or Text.Lower(Text.Trim(Text.From([PO Type] ?? \"\"))) = \"dist\", type logical),",
                "",
                "    DirectRows = Table.SelectRows(AddIsDist, each not [Is Dist]),",
                "    DirectFinal = Table.AddColumn(DirectRows, \"Chain\", each [Chain Dash], type text),",
                "",
                "    DistRows = Table.SelectRows(AddIsDist, each [Is Dist]),",
                "    DistKeys1 = Table.AddColumn(DistRows, \"ShipTo Key\", each Text.Lower(Text.Trim([Ship To Name] ?? \"\")), type text),",
                "    DistKeys2 = Table.AddColumn(DistKeys1, \"Brand Key\", each Text.Lower(Text.Trim([Brand] ?? \"\")), type text),",
                "    Merged = Table.NestedJoin(DistKeys2, {\"ShipTo Key\", \"Brand Key\", \"MonthStart\"},",
                "        #\"Dist Cont Weights\", {\"ShipTo Key\", \"Brand Key\", \"MonthStart\"},",
                "        \"W\", JoinKind.LeftOuter),",
                "    ExpandedW = Table.ExpandTableColumn(Merged, \"W\",",
                "        {\"Chain Name\", \"Frac\", \"Source Type\", \"Approval Status\", \"Provisional Flag\"}),",
                "    // scale measures by cont% (unmatched rows keep Frac=1 and go to \"Unmapped Chain\")",
                "    FillFrac      = Table.ReplaceValue(ExpandedW, null, 1,       Replacer.ReplaceValue, {\"Frac\"}),",
                "    FillSrcType   = Table.ReplaceValue(FillFrac,  null, \"Unmapped (no ShipTo data)\",",
                "                        Replacer.ReplaceValue, {\"Source Type\"}),",
                "    FillApproval  = Table.ReplaceValue(FillSrcType, null, \"Unmapped\",",
                "                        Replacer.ReplaceValue, {\"Approval Status\"}),",
                "    FillProv      = Table.ReplaceValue(FillApproval, null, false, Replacer.ReplaceValue, {\"Provisional Flag\"}),",
                "    Alloc1 = Table.AddColumn(FillProv, \"Primary Qty Alloc\", each ([Primary Qty] ?? 0) * [Frac], type number),",
                "    Alloc2 = Table.AddColumn(Alloc1, \"Primary NSV Alloc\", each ([Primary NSV] ?? 0) * [Frac], type number),",
                "    Alloc3 = Table.AddColumn(Alloc2, \"Primary MRP Alloc\", each ([Primary MRP] ?? 0) * [Frac], type number),",
                "    Alloc4 = Table.AddColumn(Alloc3, \"Primary Tax Alloc\", each",
                "        if [Primary Tax Amount] = null then null else [Primary Tax Amount] * [Frac], type number),",
                "    DistChain = Table.AddColumn(Alloc4, \"Chain\", each",
                "        if [Chain Name] <> null then [Chain Name] else \"Unmapped Chain\", type text),",
                "    // Allocation Status: readable label for the QC page and DAX measures",
                "    DistAllocStatus = Table.AddColumn(DistChain, \"Allocation Status\", each",
                "        if [Chain Name] = null        then \"Unmapped\"",
                "        else if [Provisional Flag]    then \"Provisional\"",
                "        else \"Allocated\", type text),",
                "    DistSwap = Table.RemoveColumns(",
                "        Table.RenameColumns(",
                "            Table.RemoveColumns(DistAllocStatus, {\"Primary Qty\", \"Primary NSV\", \"Primary MRP\", \"Primary Tax Amount\"}),",
                "            {{\"Primary Qty Alloc\", \"Primary Qty\"}, {\"Primary NSV Alloc\", \"Primary NSV\"},",
                "             {\"Primary MRP Alloc\", \"Primary MRP\"}, {\"Primary Tax Alloc\", \"Primary Tax Amount\"}}),",
                "        {\"ShipTo Key\", \"Brand Key\", \"Chain Name\", \"Frac\", \"Approval Status\"}),",
                "",
                "    // Add matching governance columns to Direct rows (no allocation applied)",
                "    DirectWithGov = Table.AddColumn(",
                "        Table.AddColumn(",
                "          Table.AddColumn(DirectFinal,",
                "            \"Source Type\", each null, type text),",
                "          \"Provisional Flag\", each false, type logical),",
                "        \"Allocation Status\", each \"Direct\", type text),",
                "",
                "    // \"Is Dist\" stays: [Dist Allocation Coverage %] in DAX/07 filters on it.",
                "    Combined = Table.Combine({DirectWithGov, DistSwap}),",
                "",
                "    // article key: EAN -> cleaned Description (the current format has no Article Code)",
                "    AddKey = Table.AddColumn(Combined, \"Article Key\", each",
                "        if [EAN Code] <> null and Text.Trim([EAN Code]) <> \"\" then \"EAN:\" & [EAN Code]",
                "        else \"DESC:\" & Text.Upper(Text.Trim(Text.From([Article Description]))), type text),",
                "",
                "    // brand spelling normalisation (keep in sync with Brand Master)",
                "    FixBrand = Table.ReplaceValue(AddKey, \"BBLUNT\", \"BBlunt\", Replacer.ReplaceText, {\"Brand\"})",
                "in",
                "    FixBrand"
              ]
            }
          }
        ]
      },
      {
        "name": "Chain Master",
        "columns": [
          {
            "name": "Chain",
            "dataType": "string",
            "sourceColumn": "Chain"
          },
          {
            "name": "Account",
            "dataType": "string",
            "sourceColumn": "Account"
          },
          {
            "name": "Chain Type",
            "dataType": "string",
            "sourceColumn": "Chain Type"
          },
          {
            "name": "Primary Zone",
            "dataType": "string",
            "sourceColumn": "Primary Zone"
          },
          {
            "name": "Channel",
            "dataType": "string",
            "sourceColumn": "Channel"
          },
          {
            "name": "Active",
            "dataType": "boolean",
            "sourceColumn": "Active"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "Chain Master",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// DIMENSION / MASTER QUERIES",
                "// Each master loads a single CSV from SeedData\\Masters. These are slowly",
                "// changing reference tables you edit by hand (add a chain, a brand, an SKU).",
                "// Create ONE query per block below (split into separate queries in Power BI).",
                "// =====================================================================",
                "",
                "// ---------- Chain Master ----------",
                "let",
                "    Source = Csv.Document(File.Contents(pRootFolder & \"\\SeedData\\Masters\\ChainMaster.csv\"),",
                "        [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {",
                "        {\"Chain\", type text},{\"Account\", type text},{\"Chain Type\", type text},",
                "        {\"Primary Zone\", type text},{\"Active\", type text}})",
                "in Typed",
                "",
                "// ---------- Brand Master ----------",
                "// let Source = Csv.Document(File.Contents(pRootFolder & \"\\SeedData\\Masters\\BrandMaster.csv\"),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                "//     H=Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                "//     T=Table.TransformColumnTypes(H,{{\"Brand\",type text},{\"Brand Group\",type text},{\"Brand Sort Order\",Int64.Type},{\"Active\",type text}})",
                "// in T",
                "",
                "// ---------- Category Master ----------",
                "// let Source = Csv.Document(File.Contents(pRootFolder & \"\\SeedData\\Masters\\CategoryMaster.csv\"),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                "//     H=Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                "//     T=Table.TransformColumnTypes(H,{{\"Category\",type text},{\"Sub-category\",type text},{\"Nielsen Category\",type text},{\"Category Sort Order\",Int64.Type}})",
                "// in T",
                "",
                "// ---------- SKU / Article Master ----------",
                "// let Source = Csv.Document(File.Contents(pRootFolder & \"\\SeedData\\Masters\\ArticleMaster.csv\"),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                "//     H=Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                "//     T=Table.TransformColumnTypes(H,{{\"Article Code\",type text},{\"Article Description\",type text},{\"EAN Code\",type text},{\"Brand\",type text},{\"Category\",type text},{\"Sub-category\",type text},{\"Range\",type text},{\"Pack Size\",type text}})",
                "// in T",
                "",
                "// ---------- Zone / State Master ----------",
                "// let Source = Csv.Document(File.Contents(pRootFolder & \"\\SeedData\\Masters\\ZoneStateMaster.csv\"),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                "//     H=Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                "//     T=Table.TransformColumnTypes(H,{{\"Zone\",type text},{\"Zone Sort Order\",Int64.Type},{\"State\",type text},{\"Region\",type text}})",
                "// in T",
                "",
                "// ---------- Store Master ----------",
                "// let Source = Csv.Document(File.Contents(pRootFolder & \"\\SeedData\\Masters\\StoreMaster.csv\"),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                "//     H=Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                "//     T=Table.TransformColumns(Table.TransformColumnTypes(H,{{\"Store Code\",type text},{\"Store Name\",type text},{\"Chain\",type text},{\"Account\",type text},{\"Zone\",type text},{\"State\",type text},{\"City\",type text}}),{{\"Store Code\",each Text.Trim(_),type text}})",
                "// in T",
                "",
                "// ---------- Nielsen Competitor Master ----------",
                "// let Source = Csv.Document(File.Contents(pRootFolder & \"\\SeedData\\Masters\\NielsenCompetitorMaster.csv\"),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                "//     H=Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                "//     T=Table.TransformColumnTypes(H,{{\"Nielsen Category\",type text},{\"Brand\",type text},{\"Is Honasa\",type text},{\"Competitor Sort Order\",Int64.Type}})",
                "// in T"
              ]
            }
          }
        ]
      },
      {
        "name": "Brand Master",
        "columns": [
          {
            "name": "Brand",
            "dataType": "string",
            "sourceColumn": "Brand",
            "sortByColumn": "Brand Sort Order"
          },
          {
            "name": "Brand Group",
            "dataType": "string",
            "sourceColumn": "Brand Group"
          },
          {
            "name": "Brand Sort Order",
            "dataType": "int64",
            "sourceColumn": "Brand Sort Order"
          },
          {
            "name": "Active",
            "dataType": "boolean",
            "sourceColumn": "Active"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "Brand Master",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// DIMENSION / MASTER QUERIES",
                "// Each master loads a single CSV from SeedData\\Masters. These are slowly",
                "// changing reference tables you edit by hand (add a chain, a brand, an SKU).",
                "// Create ONE query per block below (split into separate queries in Power BI).",
                "// =====================================================================",
                "",
                "// ---------- Chain Master ----------",
                "let",
                "    Source = Csv.Document(File.Contents(pRootFolder & \"\\SeedData\\Masters\\ChainMaster.csv\"),",
                "        [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {",
                "        {\"Chain\", type text},{\"Account\", type text},{\"Chain Type\", type text},",
                "        {\"Primary Zone\", type text},{\"Active\", type text}})",
                "in Typed",
                "",
                "// ---------- Brand Master ----------",
                "// let Source = Csv.Document(File.Contents(pRootFolder & \"\\SeedData\\Masters\\BrandMaster.csv\"),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                "//     H=Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                "//     T=Table.TransformColumnTypes(H,{{\"Brand\",type text},{\"Brand Group\",type text},{\"Brand Sort Order\",Int64.Type},{\"Active\",type text}})",
                "// in T",
