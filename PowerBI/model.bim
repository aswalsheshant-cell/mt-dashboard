          },
          {
            "name": "Reliance FW %",
            "dataType": "string",
            "sourceColumn": "Reliance FW %"
          },
          {
            "name": "Reliance SH %",
            "dataType": "string",
            "sourceColumn": "Reliance SH %"
          },
          {
            "name": "Apollo FW %",
            "dataType": "string",
            "sourceColumn": "Apollo FW %"
          },
          {
            "name": "Apollo SH %",
            "dataType": "string",
            "sourceColumn": "Apollo SH %"
          },
          {
            "name": "Main Lever",
            "dataType": "string",
            "sourceColumn": "Main Lever"
          },
          {
            "name": "Source",
            "dataType": "string",
            "sourceColumn": "Source"
          },
          {
            "name": "Period",
            "dataType": "dateTime",
            "sourceColumn": "Period"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "Nielsen Deck State Exposure",
            "source": {
              "type": "m",
              "expression": [
                "// =====================================================================",
                "// QUERY: Nielsen Deck State Exposure  (state x chain exposure from MT_Review_Big3_v3_1.pptx)",
                "// Typed from the review deck (Nielsen Jun'26 state cut + internal MT sell-out). It is NOT in",
                "// the Aug-26 Nielsen workbooks, which carry IN URB MT only. Read it as the deck's own figures.",
                "// Source = SeedData\\Masters\\Nielsen_Deck_StateExposure.csv (blank = not applicable in the deck)",
                "// =====================================================================",
                "let",
                "    Source = Csv.Document(File.Contents(pRootFolder & \"\\SeedData\\Masters\\Nielsen_Deck_StateExposure.csv\"),",
                "        [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {",
                "        {\"State\", type text},",
                "        {\"Market FW Cr\", type number}, {\"Market SH Cr\", type number},",
                "        {\"ME Share FW %\", type number}, {\"ME Share SH %\", type number},",
                "        {\"Dmart FW %\", type number}, {\"Dmart SH %\", type number},",
                "        {\"Reliance FW %\", type number}, {\"Reliance SH %\", type number},",
                "        {\"Apollo FW %\", type number}, {\"Apollo SH %\", type number},",
                "        {\"Main Lever\", type text}, {\"Source\", type text}, {\"Period\", type text}",
                "    })",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "Store City Master",
        "columns": [
          {
            "name": "Store Key",
            "dataType": "string",
            "sourceColumn": "Store Key"
          },
          {
            "name": "Chain Name",
            "dataType": "string",
            "sourceColumn": "Chain Name"
          },
          {
            "name": "Site Code",
            "dataType": "string",
            "sourceColumn": "Site Code"
          },
          {
            "name": "Store Name",
            "dataType": "string",
            "sourceColumn": "Store Name"
          },
          {
            "name": "Zone",
            "dataType": "string",
            "sourceColumn": "Zone"
          },
          {
            "name": "State",
            "dataType": "string",
            "sourceColumn": "State"
          },
          {
            "name": "City Final",
            "dataType": "string",
            "sourceColumn": "City Final"
          },
          {
            "name": "City Source",
            "dataType": "string",
            "sourceColumn": "City Source"
          },
          {
            "name": "Visit City",
            "dataType": "string",
