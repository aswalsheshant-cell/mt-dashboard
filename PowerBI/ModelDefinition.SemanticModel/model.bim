        "partitions": [
          {
            "name": "Date Table",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "VAR _Start = DATE(2024, 4, 1)        // first day of earliest FY you report\nVAR _End   = DATE(2028, 3, 31)       // last day of the latest FY you forecast\nRETURN\nADDCOLUMNS(\n    CALENDAR(_Start, _End),\n    \"MonthStart\",      EOMONTH([Date], -1) + 1,\n    \"Year\",            YEAR([Date]),\n    \"Month No\",        MONTH([Date]),\n    \"Month Name\",      FORMAT([Date], \"mmm\"),\n    // Indian FY: Apr=1 ... Mar=12\n    \"FY Month No\",     IF(MONTH([Date]) >= 4, MONTH([Date]) - 3, MONTH([Date]) + 9),\n    \"FY Year\",\n        VAR y = YEAR([Date])\n        RETURN IF(MONTH([Date]) >= 4,\n                 FORMAT(y, \"00\") & \"-\" & FORMAT(y + 1 - 2000, \"00\"),\n                 FORMAT(y - 1, \"00\") & \"-\" & FORMAT(y - 2000, \"00\")),\n    \"Quarter\",\n        VAR fm = IF(MONTH([Date]) >= 4, MONTH([Date]) - 3, MONTH([Date]) + 9)\n        RETURN \"Q\" & ROUNDUP(fm / 3, 0),\n    // label used everywhere in the deck, e.g. May'26\n    \"Month\",           FORMAT([Date], \"mmm\") & \"'\" & FORMAT([Date], \"yy\"),\n    \"Month Year Sort\", YEAR([Date]) * 100 + MONTH([Date]),\n    \"Is Future\",       IF([Date] > TODAY(), TRUE(), FALSE())\n)"
            }
          }
        ]
