// ============================================================================
// QC & VALIDATION MEASURES (FOR QC PAGES ONLY)
// ============================================================================

// 18. Negative Return Row Count (valid returns/credit notes)
[Negative Return Rows] =
CALCULATE(
  [Row Count],
  Fact_Offtake_Safe[Is_Negative_Return] = TRUE()
)

// 19. June'26 Partial Row Count
[June26 Partial Row Count] =
CALCULATE(
  [Row Count],
  Fact_Offtake_Safe[Is_June26_Partial] = TRUE()
)

// 20. Total Distinct Chains
[Distinct Chains] =
DISTINCTCOUNT(
  Fact_Offtake_Safe[Chain_Name]
)

// 21. Total Distinct Zones
[Distinct Zones] =
DISTINCTCOUNT(
  Fact_Offtake_Safe[Zone]
)

// 22. Total Distinct Categories
[Distinct Categories] =
DISTINCTCOUNT(
  Fact_Offtake_Safe[Category]
)

// ============================================================================
// HELPER MEASURES (INTERNAL USE ONLY, NOT FOR REPORTS)
// ============================================================================

// 23. Report Watermark: NSV Unit Pending
[Watermark NSV Pending] =
"⚠ NSV unit pending | Interim MRP basis only"

// 24. Report Watermark: Interim Only
[Watermark Interim Only] =
"Interim only: NSV unit pending. Not for final profitability review."

