// ============================================================================
// HELPER MEASURES (INTERNAL USE ONLY, NOT FOR REPORTS)
// ============================================================================

// 33. Report Watermark: NSV Converted from Lakhs
[Watermark NSV Converted] =
"NSV converted from source Lakhs to ₹ Crores (÷100). MRP in actual rupees (÷10,000,000 for Cr display)."

// 34. Report Watermark: Interim View
[Watermark Interim View] =
"Interim view. NSV converted from Lakhs to ₹Cr. June'26 Partial. Not for final profitability review (cost structure pending)."

