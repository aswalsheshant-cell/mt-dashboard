// DAX Measures — Safe-to-Build Only (MRP Basis, NSV Blocked)
// Branch: claude/safe-powerbi-blocks
// Generated: 2026-07-11

// ============================================================================
// SAFE BASE MEASURES (MRP SALES VALUE BASIS ONLY)
// ============================================================================

// 1. Total MRP Sales Value (in rupees, verified basis)
[MRP Sales Value] =
SUMX(
  Fact_Offtake_Safe,
  Fact_Offtake_Safe[MRP_Sales_Value]
)

// 2. Total Sales Quantity (units)
[Sales Qty] =
SUMX(
  Fact_Offtake_Safe,
  Fact_Offtake_Safe[Sales_Qty]
)

// 3. Row Count (number of transactions)
[Row Count] =
COUNTROWS(
  Fact_Offtake_Safe
)

// 4. MRP Sales Value in Crore (rupees ÷ 10,000,000)
[MRP Sales Value Cr] =
DIVIDE(
  [MRP Sales Value],
  10000000
)

// 5. Average MRP per Month (across selected months)
[Avg MRP Per Month] =
IFERROR(
  AVERAGEX(
    VALUES(Dim_Month[Month_Sort]),
    [MRP Sales Value]
  ),
  BLANK()
)

// 6. Average MRP per Chain (across selected chains)
[Avg MRP Per Chain] =
IFERROR(
  AVERAGEX(
    VALUES(Dim_Chain_Raw[Chain_Name]),
    [MRP Sales Value]
  ),
  BLANK()
)

// ============================================================================
// SAFE CONTRIBUTION & SHARE MEASURES (MRP BASIS ONLY)
// ============================================================================

// 7. MRP Contribution % (within current filter context)
[MRP Contribution %] =
IFERROR(
  DIVIDE(
    [MRP Sales Value],
    CALCULATE(
      [MRP Sales Value],
      REMOVEFILTERS(Dim_Chain_Raw, Dim_Zone, Dim_Category)
    )
  ) * 100,
  BLANK()
)

// 8. Qty Contribution % (within current filter context)
[Qty Contribution %] =
IFERROR(
  DIVIDE(
    [Sales Qty],
    CALCULATE(
      [Sales Qty],
      REMOVEFILTERS(Dim_Chain_Raw, Dim_Zone, Dim_Category)
    )
  ) * 100,
  BLANK()
)

// 9. MRP Share of Total (all data, ignoring filters)
[MRP Share of Total] =
IFERROR(
  DIVIDE(
    [MRP Sales Value],
    CALCULATE(
      [MRP Sales Value],
      REMOVEFILTERS()
    )
  ) * 100,
  BLANK()
)

// ============================================================================
// SAFE TREND MEASURES (MRP BASIS ONLY)
// ============================================================================

// 10. Previous Month MRP Sales Value (for MoM comparison)
[Previous Month MRP] =
IFERROR(
  CALCULATE(
    [MRP Sales Value],
    PREVIOUSMONTH(Dim_Month[Date])  // Assumes Dim_Month has a Date column
  ),
  BLANK()
)

// 11. MRP MoM Absolute Change (current month vs previous month)
[MRP MoM Abs Change] =
IFERROR(
  [MRP Sales Value] - [Previous Month MRP],
  BLANK()
)

// 12. MRP MoM % Change (current month vs previous month, MRP basis only)
[MRP MoM % Change] =
IFERROR(
  DIVIDE(
    [MRP MoM Abs Change],
    [Previous Month MRP]
  ) * 100,
  BLANK()
)

// 13. Qty MoM Absolute Change (current month vs previous month)
[Qty MoM Abs Change] =
IFERROR(
  [Sales Qty] -
  CALCULATE(
    [Sales Qty],
    PREVIOUSMONTH(Dim_Month[Date])
  ),
  BLANK()
)

// 14. Row Count Trend (current month vs previous month)
[Row Count Prev Month] =
IFERROR(
  CALCULATE(
    [Row Count],
    PREVIOUSMONTH(Dim_Month[Date])
  ),
  BLANK()
)

[Row Count Change] =
[Row Count] - [Row Count Prev Month]

// ============================================================================
// SAFE FILTER/FLAG MEASURES
// ============================================================================

// 15. Is June'26 Partial (TRUE if current selection includes June'26)
[Has June26 Partial] =
IFERROR(
  IF(
    COUNTROWS(
      FILTER(
        Dim_Month,
        Dim_Month[Is_June26_Partial] = TRUE()
      )
    ) > 0,
    TRUE(),
    FALSE()
  ),
  FALSE()
)

// 16. June'26 Partial Warning (returns warning text if June'26 is in filter)
[June26 Partial Warning] =
IF(
  [Has June26 Partial],
  "⚠ June'26 is PARTIAL: 78,111 rows from 16 chains only. Some accounts pending.",
  ""
)

// 17. Safe Reporting Flag (all measures in this set are safe)
[Reporting Basis] =
"MRP Sales Value (verified basis)"

// ============================================================================
// SAFE BA AVAILABILITY MEASURES (COVERAGE ONLY, NOT PROFITABILITY)
// ============================================================================
// Brand Counter = BA Availability for Reliance context
// These measures show BA coverage, not BA profitability
// BA profitability remains blocked pending BA Headcount + NSV unit

// 18. BA Available Row Count (transactions where Brand Counter = Yes)
[BA Available Row Count] =
CALCULATE(
  [Row Count],
  Fact_Offtake_Safe[BA_Available] = "Yes"
)

// 19. BA Available MRP Sales Value (MRP for Brand Counter rows)
[BA Available MRP Sales Value] =
CALCULATE(
  [MRP Sales Value],
  Fact_Offtake_Safe[BA_Available] = "Yes"
)

// 20. BA Available MRP Sales Value in Crore
[BA Available MRP Sales Value Cr] =
DIVIDE(
  [BA Available MRP Sales Value],
  10000000
)

// 21. BA Availability Mix % (BA rows as % of total MRP)
[BA Availability Mix %] =
IFERROR(
  DIVIDE(
    [BA Available MRP Sales Value],
    [MRP Sales Value]
  ) * 100,
  BLANK()
)

// 22. BA Availability Note (display-only message)
[BA Availability Note] =
"BA Availability view only. Shows Reliance Brand Counter coverage. BA profitability is blocked until BA cost structure and NSV unit are confirmed."

