// DAX Measures — Safe-to-Build Only (MRP Basis, NSV Blocked)
// Branch: claude/safe-powerbi-blocks
// Generated: 2026-07-11

// ============================================================================
// SAFE BASE MEASURES (MRP SALES VALUE BASIS ONLY)
// ============================================================================

// 1. Total MRP Sales Value (in actual rupees, verified basis)
[MRP Sales Value] =
SUMX(
  Fact_Offtake_Safe,
  Fact_Offtake_Safe[MRP_Sales_Value]
)

// 2. Total MRP Sales Value in Crore (rupees ÷ 10,000,000)
[MRP Sales Value Cr] =
DIVIDE(
  [MRP Sales Value],
  10000000
)

// 3. Total Source NSV (in Lakhs, confirmed unit)
[Source NSV Lacs] =
SUMX(
  Fact_Offtake_Safe,
  Fact_Offtake_Safe[Source_NSV_Lacs]
)

// 4. Total NSV Actual Value (Lakhs × 100,000 = rupees)
[NSV Actual Value] =
SUMX(
  Fact_Offtake_Safe,
  Fact_Offtake_Safe[NSV_Actual_Value]
)

// 5. Total NSV in Crore (Lakhs ÷ 100 = Crores)
[NSV Cr] =
DIVIDE(
  [Source NSV Lacs],
  100
)

// 6. Total Sales Quantity (units)
[Sales Qty] =
SUMX(
  Fact_Offtake_Safe,
  Fact_Offtake_Safe[Sales_Qty]
)

// 7. Total Sales Qty in Crore (Qty ÷ 10,000,000 for display)
[Sales Qty Cr] =
DIVIDE(
  [Sales Qty],
  10000000
)

// 8. Row Count (number of transactions)
[Row Count] =
COUNTROWS(
  Fact_Offtake_Safe
)

// 5. Average MRP per Month (across selected months)
[Avg MRP Per Month] =
IFERROR(
  AVERAGEX(
    VALUES(Dim_Month[Month_Sort]),
    [MRP Sales Value]
  ),
  BLANK()
)

// 6. Average MRP per Chain (across selected chains)
[Avg MRP Per Chain] =
IFERROR(
  AVERAGEX(
    VALUES(Dim_Chain_Raw[Chain_Name]),
    [MRP Sales Value]
  ),
  BLANK()
)

// ============================================================================
// SAFE CONTRIBUTION & SHARE MEASURES (MRP, NSV, QTY BASIS)
// ============================================================================

// 9. MRP Contribution % (within current filter context)
[MRP Contribution %] =
IFERROR(
  DIVIDE(
    [MRP Sales Value Cr],
    CALCULATE(
      [MRP Sales Value Cr],
      REMOVEFILTERS(Dim_Chain_Raw, Dim_Zone, Dim_Category)
    )
  ) * 100,
  BLANK()
)

// 10. NSV Contribution % (within current filter context, Crore basis)
[NSV Contribution %] =
IFERROR(
  DIVIDE(
    [NSV Cr],
    CALCULATE(
      [NSV Cr],
      REMOVEFILTERS(Dim_Chain_Raw, Dim_Zone, Dim_Category)
    )
  ) * 100,
  BLANK()
)

// 11. Qty Contribution % (within current filter context)
[Qty Contribution %] =
IFERROR(
  DIVIDE(
    [Sales Qty],
    CALCULATE(
      [Sales Qty],
      REMOVEFILTERS(Dim_Chain_Raw, Dim_Zone, Dim_Category)
    )
  ) * 100,
  BLANK()
)

// 12. MRP Share of Total (all data, ignoring filters)
[MRP Share of Total] =
IFERROR(
  DIVIDE(
    [MRP Sales Value Cr],
    CALCULATE(
      [MRP Sales Value Cr],
      REMOVEFILTERS()
    )
  ) * 100,
  BLANK()
)

// 13. NSV Share of Total (all data, ignoring filters)
[NSV Share of Total] =
IFERROR(
  DIVIDE(
    [NSV Cr],
    CALCULATE(
      [NSV Cr],
      REMOVEFILTERS()
    )
  ) * 100,
  BLANK()
)

// ============================================================================
// SAFE TREND MEASURES (MRP, NSV, QTY BASIS)
// ============================================================================

// 14. Previous Month MRP Sales Value Cr (for MoM comparison)
[Previous Month MRP Cr] =
IFERROR(
  CALCULATE(
    [MRP Sales Value Cr],
    PREVIOUSMONTH(Dim_Month[Date])
  ),
  BLANK()
)

// 15. MRP MoM Absolute Change Cr (current month vs previous month)
[MRP MoM Abs Change Cr] =
IFERROR(
  [MRP Sales Value Cr] - [Previous Month MRP Cr],
  BLANK()
)

// 16. MRP MoM % Change (current month vs previous month)
[MRP MoM % Change] =
IFERROR(
  DIVIDE(
    [MRP MoM Abs Change Cr],
    [Previous Month MRP Cr]
  ) * 100,
  BLANK()
)

// 17. Previous Month NSV Cr (for MoM comparison)
[Previous Month NSV Cr] =
IFERROR(
  CALCULATE(
    [NSV Cr],
    PREVIOUSMONTH(Dim_Month[Date])
  ),
  BLANK()
)

// 18. NSV MoM Absolute Change Cr (current month vs previous month)
[NSV MoM Abs Change Cr] =
IFERROR(
  [NSV Cr] - [Previous Month NSV Cr],
  BLANK()
)

// 19. NSV MoM % Change (current month vs previous month)
[NSV MoM % Change] =
IFERROR(
  DIVIDE(
    [NSV MoM Abs Change Cr],
    [Previous Month NSV Cr]
  ) * 100,
  BLANK()
)

// 20. Previous Month Qty (for MoM comparison)
[Previous Month Qty] =
IFERROR(
  CALCULATE(
    [Sales Qty],
    PREVIOUSMONTH(Dim_Month[Date])
  ),
  BLANK()
)

// 21. Qty MoM Absolute Change (current month vs previous month)
[Qty MoM Abs Change] =
IFERROR(
  [Sales Qty] - [Previous Month Qty],
  BLANK()
)

// 22. Qty MoM % Change (current month vs previous month)
[Qty MoM % Change] =
IFERROR(
  DIVIDE(
    [Qty MoM Abs Change],
    [Previous Month Qty]
  ) * 100,
  BLANK()
)

// 23. Row Count Trend (current month vs previous month)
[Row Count Prev Month] =
IFERROR(
  CALCULATE(
    [Row Count],
    PREVIOUSMONTH(Dim_Month[Date])
  ),
  BLANK()
)

// 24. Row Count Change
[Row Count Change] =
[Row Count] - [Row Count Prev Month]

// ============================================================================
// SAFE FILTER/FLAG MEASURES
// ============================================================================

// 25. Is June'26 Partial (TRUE if current selection includes June'26)
[Has June26 Partial] =
IFERROR(
  IF(
    COUNTROWS(
      FILTER(
        Dim_Month,
        Dim_Month[Is_June26_Partial] = TRUE()
      )
    ) > 0,
    TRUE(),
    FALSE()
  ),
  FALSE()
)

// 26. June'26 Partial Warning (returns warning text if June'26 is in filter)
[June26 Partial Warning] =
IF(
  [Has June26 Partial],
  "⚠ June'26 is PARTIAL: 78,111 rows from 16 chains only. Some accounts pending.",
  ""
)

// 27. Reporting Basis (updated with NSV unit confirmed)
[Reporting Basis] =
"MRP (verified ₹), NSV (converted from Lakhs to ₹Cr), Qty"

// 28. MRP vs NSV Ratio (MRP Cr ÷ NSV Cr; shows relationship)
[MRP to NSV Ratio] =
IFERROR(
  DIVIDE(
    [MRP Sales Value Cr],
    [NSV Cr]
  ),
  BLANK()
)

// ============================================================================
// SAFE BA AVAILABILITY MEASURES (COVERAGE ONLY, NOT PROFITABILITY)
// ============================================================================
// Brand Counter = BA Availability for Reliance context
// These measures show BA coverage, not BA profitability
// BA profitability remains blocked pending BA Headcount + NSV unit

// 18. BA Available Row Count (transactions where Brand Counter = Yes)
[BA Available Row Count] =
CALCULATE(
  [Row Count],
  Fact_Offtake_Safe[BA_Available] = "Yes"
)

// 19. BA Available MRP Sales Value (MRP for Brand Counter rows)
[BA Available MRP Sales Value] =
CALCULATE(
  [MRP Sales Value],
  Fact_Offtake_Safe[BA_Available] = "Yes"
)

// 20. BA Available MRP Sales Value in Crore
[BA Available MRP Sales Value Cr] =
DIVIDE(
  [BA Available MRP Sales Value],
  10000000
)

// 21. BA Availability Mix % (BA rows as % of total MRP)
[BA Availability Mix %] =
IFERROR(
  DIVIDE(
    [BA Available MRP Sales Value],
    [MRP Sales Value]
  ) * 100,
  BLANK()
)

// 22. BA Availability Note (display-only message)
[BA Availability Note] =
"BA Availability view only. Shows Reliance Brand Counter coverage. BA profitability is blocked until BA cost structure and NSV unit are confirmed."

// 23. BA Available NSV Cr (NSV for Brand Counter rows)
[BA Available NSV Cr] =
CALCULATE(
  [NSV Cr],
  Fact_Offtake_Safe[BA_Available] = "Yes"
)

// 24. BA Available Sales Qty (Qty for Brand Counter rows)
[BA Available Sales Qty] =
CALCULATE(
  [Sales Qty],
  Fact_Offtake_Safe[BA_Available] = "Yes"
)

// 25. BA Availability Mix % (NSV basis) (BA rows as % of total NSV)
[BA Availability Mix % NSV] =
IFERROR(
  DIVIDE(
    [BA Available NSV Cr],
    [NSV Cr]
  ) * 100,
  BLANK()
)

// 26. BA Availability Mix % (Qty basis) (BA rows as % of total Qty)
[BA Availability Mix % Qty] =
IFERROR(
  DIVIDE(
    [BA Available Sales Qty],
    [Sales Qty]
  ) * 100,
  BLANK()
)

// ============================================================================
// QC & VALIDATION MEASURES (FOR QC PAGES)
// ============================================================================

// 27. Negative MRP Return Row Count (valid returns/credit notes)
[Negative MRP Return Rows] =
CALCULATE(
  [Row Count],
  Fact_Offtake_Safe[Is_Negative_Return] = TRUE()
)

// 28. Negative NSV Return Row Count (valid returns/credit notes)
[Negative NSV Return Rows] =
CALCULATE(
  [Row Count],
  Fact_Offtake_Safe[Is_Negative_NSV] = TRUE()
)

// 29. June'26 Partial Row Count
[June26 Partial Row Count] =
CALCULATE(
  [Row Count],
  Fact_Offtake_Safe[Is_June26_Partial] = TRUE()
)

// 30. Total Distinct Chains
[Distinct Chains] =
DISTINCTCOUNT(
  Fact_Offtake_Safe[Chain_Name]
)

// 31. Total Distinct Zones
[Distinct Zones] =
DISTINCTCOUNT(
  Fact_Offtake_Safe[Zone]
)

// 32. Total Distinct Categories
[Distinct Categories] =
DISTINCTCOUNT(
  Fact_Offtake_Safe[Category]
)

