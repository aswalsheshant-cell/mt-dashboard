table _Measures

	measure NSV_L3M_Actuals = ```
		CALCULATE(
		    [NSV_Actual_INR],
		    DATESBETWEEN(
		        'Dim_Date'[Date],
		        DATE(2026, 3, 1),
		        DATE(2026, 5, 31)
		    ),
		    'Fact_Financials'[Scenario] = "Actual"
		)
		```
		formatString: #,##0.00
		displayFolder: GAP-01 Allocation

	measure NSV_L3M_AllChannel_Total = ```
		CALCULATE(
		    [NSV_L3M_Actuals],
		    ALLSELECTED('Dim_Chain'),
		    ALLSELECTED('Dim_Category')
		)
		```
		formatString: #,##0.00
		displayFolder: GAP-01 Allocation

	measure Allocation_Weight_L3M = ```
		DIVIDE(
		    [NSV_L3M_Actuals],
		    [NSV_L3M_AllChannel_Total],
		    0
		)
		```
		formatString: 0.0000%
		displayFolder: GAP-01 Allocation

	measure NSV_Jun26_Allocated = ```
		VAR Unallocated_Jun26_Pool =
		    CALCULATE(
		        [NSV_Pool_INR],
		        'Dim_Date'[YearMonth] = 202606,
		        'Fact_Financials'[Scenario] = "Forecast_Unallocated",
		        ALL('Dim_Chain'),
		        ALL('Dim_Category')
		    )
		VAR CurrentRowActual =
		    CALCULATE(
		        [NSV_Actual_INR],
		        'Dim_Date'[YearMonth] = 202606
		    )
		RETURN
		    IF(
		        ISBLANK(CurrentRowActual) || CurrentRowActual = 0,
		        Unallocated_Jun26_Pool * [Allocation_Weight_L3M],
		        CurrentRowActual
		    )
		```
		formatString: #,##0.00
		displayFolder: GAP-01 Allocation

	measure Contribution_Margin_INR = ```
		[NSV_Actual_INR] - [COGS_INR] - [Variable_Trade_Spend_INR] - [Freight_Logistics_INR]
		```
		formatString: #,##0.00
		displayFolder: GAP-02 Contribution Margin

	measure Cont_Margin_Pct = ```
		DIVIDE(
		    [Contribution_Margin_INR],
		    [NSV_Actual_INR],
		    BLANK()
		)
		```
		formatString: 0.0%
		displayFolder: GAP-02 Contribution Margin

	measure Cont_Margin_Status = ```
		VAR Pct = [Cont_Margin_Pct]
		RETURN
		    SWITCH(
		        TRUE(),
		        ISBLANK(Pct), "No Data",
		        Pct < 0, "Loss-Making (< 0%)",
		        Pct < 0.10, "At-Risk (0-10%)",
		        Pct < 0.20, "Target (10-20%)",
		        "High Margin (> 20%)"
		    )
		```
		displayFolder: GAP-02 Contribution Margin

	measure Cont_Margin_Color = ```
		VAR Pct = [Cont_Margin_Pct]
		RETURN
		    SWITCH(
		        TRUE(),
		        ISBLANK(Pct), "#9E9E9E",
		        Pct < 0, "#D32F2F",
		        Pct < 0.10, "#F57C00",
		        Pct < 0.20, "#388E3C",
		        "#1B5E20"
		    )
		```
		displayFolder: GAP-02 Contribution Margin

	measure Cont_Margin_Badge = ```
		VAR Pct = [Cont_Margin_Pct]
		VAR FormattedPct = FORMAT(Pct, "0.0%")
		RETURN
		    SWITCH(
		        TRUE(),
		        ISBLANK(Pct), "—",
		        Pct < 0, "⚠️ " & FormattedPct & " [LOSS]",
		        Pct < 0.10, "⚡ " & FormattedPct & " [COMPRESSED]",
		        FormattedPct
		    )
		```
		displayFolder: GAP-02 Contribution Margin

	measure 'CM2 Provision Claim' =
			CALCULATE(SUM(Fact_CM2[claim_amount]), KEEPFILTERS(Fact_CM2[view] = "provision"))
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 Recorded DN Claim' =
			CALCULATE(SUM(Fact_CM2[claim_amount]), KEEPFILTERS(Fact_CM2[view] = "recorded_dn"))
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 Provision BA' =
			CALCULATE(SUM(Fact_CM2[ba_amount]), KEEPFILTERS(Fact_CM2[view] = "provision"))
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 NSV' =
			IF(HASONEVALUE(Fact_CM2[view]), CALCULATE(SUM(Fact_CM2[nsv]), Fact_CM2[record_type] = "SALES"))
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 Covered NSV' =
			IF(HASONEVALUE(Fact_CM2[view]), CALCULATE(SUM(Fact_CM2[covered_nsv]), Fact_CM2[record_type] = "SALES"))
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 Coverage Pct' =
			DIVIDE([CM2 Covered NSV], [CM2 NSV])
		formatString: 0.00%
		displayFolder: Governed CM2 Draft

	measure 'CM2 Source Tax' =
			IF(HASONEVALUE(Fact_CM2[view]), CALCULATE(SUM(Fact_CM2[tax]), Fact_CM2[record_type] = "SALES"))
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 GST QC' =
			CONCATENATEX(VALUES(Fact_CM2[gst_qc_status]), Fact_CM2[gst_qc_status], ", ")
		displayFolder: Governed CM2 Draft

	measure 'CM2 Source Status' =
			CONCATENATEX(VALUES(Fact_CM2[source_status]), Fact_CM2[source_status], ", ")
		displayFolder: Governed CM2 Draft

	measure 'CM2 Status' =
			"NOT_AVAILABLE | COGS basis unresolved | PENDING_FINANCE"
		displayFolder: Governed CM2 Draft

	measure 'CM2 Scope' =
			"MT | INR lakh | Brand: NSV-share allocated estimate | Category unsupported"
		displayFolder: Governed CM2 Draft

	measure 'CM2 Modeled' =
			BLANK()
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 Effective GST Pct' =
			IF(HASONEVALUE(Fact_CM2[view]) && CALCULATE(COUNTROWS(Fact_CM2), Fact_CM2[record_type] = "SALES", Fact_CM2[effective_gst_pct_status] = "NOT_AVAILABLE") = 0, DIVIDE([CM2 Source Tax], [CM2 NSV]))
		formatString: 0.00%
		displayFolder: Governed CM2 Draft

	measure 'CM2 Unallocated Claim' =
			IF(HASONEVALUE(Fact_CM2[view]), CALCULATE(SUM(Fact_CM2[claim_amount]), KEEPFILTERS(Fact_CM2[record_type] = "UNALLOCATED_CLAIM"), REMOVEFILTERS(Fact_CM2[brand])))
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 Unallocated BA' =
			CALCULATE(SUM(Fact_CM2[ba_amount]), KEEPFILTERS(Fact_CM2[view] = "provision"), KEEPFILTERS(Fact_CM2[record_type] = "UNALLOCATED_BA"), REMOVEFILTERS(Fact_CM2[brand]))
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 Matched NSV' =
			VAR ProvisionKeys = CALCULATETABLE(SUMMARIZE(Fact_CM2, Fact_CM2[fy], Fact_CM2[month], Fact_CM2[chain]), REMOVEFILTERS(Fact_CM2[view]), Fact_CM2[view] = "provision", Fact_CM2[record_type] = "SALES", Fact_CM2[source_status] <> "NOT_AVAILABLE")
			VAR DNKeys = CALCULATETABLE(SUMMARIZE(Fact_CM2, Fact_CM2[fy], Fact_CM2[month], Fact_CM2[chain]), REMOVEFILTERS(Fact_CM2[view]), Fact_CM2[view] = "recorded_dn", Fact_CM2[record_type] = "SALES", Fact_CM2[source_status] <> "NOT_AVAILABLE")
			VAR Matched = INTERSECT(ProvisionKeys, DNKeys)
			RETURN CALCULATE(SUM(Fact_CM2[nsv]), REMOVEFILTERS(Fact_CM2[view]), Fact_CM2[view] = "provision", Fact_CM2[record_type] = "SALES", KEEPFILTERS(Matched))
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 Matched Claim Gap' =
			VAR ProvisionKeys = CALCULATETABLE(SUMMARIZE(Fact_CM2, Fact_CM2[fy], Fact_CM2[month], Fact_CM2[chain]), REMOVEFILTERS(Fact_CM2[view]), Fact_CM2[view] = "provision", Fact_CM2[record_type] = "SALES", Fact_CM2[source_status] <> "NOT_AVAILABLE")
			VAR DNKeys = CALCULATETABLE(SUMMARIZE(Fact_CM2, Fact_CM2[fy], Fact_CM2[month], Fact_CM2[chain]), REMOVEFILTERS(Fact_CM2[view]), Fact_CM2[view] = "recorded_dn", Fact_CM2[record_type] = "SALES", Fact_CM2[source_status] <> "NOT_AVAILABLE")
			VAR Matched = INTERSECT(ProvisionKeys, DNKeys)
			VAR P = CALCULATE([CM2 Provision Claim], REMOVEFILTERS(Fact_CM2[view]), Fact_CM2[record_type] = "SALES", KEEPFILTERS(Matched))
			VAR D = CALCULATE([CM2 Recorded DN Claim], REMOVEFILTERS(Fact_CM2[view]), Fact_CM2[record_type] = "SALES", KEEPFILTERS(Matched))
			RETURN IF(COUNTROWS(Matched) > 0, D - P)
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 Matched Claim Gap Pct' =
			DIVIDE([CM2 Matched Claim Gap], [CM2 Matched NSV])
		formatString: 0.00%
		displayFolder: Governed CM2 Draft

	measure NSV_Actual_INR = SUM(Fact_Financials[NSV_Actual_INR])
		displayFolder: Finance sample

	measure NSV_Pool_INR = SUM(Fact_Financials[NSV_Pool_INR])
		displayFolder: Finance sample

	measure COGS_INR = SUM(Fact_Financials[COGS_INR])
		displayFolder: Finance sample

	measure Variable_Trade_Spend_INR = SUM(Fact_Financials[Variable_Trade_Spend_INR])
		displayFolder: Finance sample

	measure Freight_Logistics_INR = SUM(Fact_Financials[Freight_Logistics_INR])
		displayFolder: Finance sample

	measure 'CM2 Reviewed Amount' =
			IF(HASONEVALUE(Fact_CM2[view]), CALCULATE(SUM(Fact_CM2[reviewed_amount]), KEEPFILTERS(Fact_CM2[record_type] = "SALES")))
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 Reviewed NSV' =
			IF(HASONEVALUE(Fact_CM2[view]), CALCULATE(SUM(Fact_CM2[reviewed_nsv]), KEEPFILTERS(Fact_CM2[record_type] = "SALES")))
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 Reviewed Tax' =
			IF(HASONEVALUE(Fact_CM2[view]), CALCULATE(SUM(Fact_CM2[reviewed_tax]), KEEPFILTERS(Fact_CM2[record_type] = "SALES")))
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 Missing Tax NSV' =
			IF(HASONEVALUE(Fact_CM2[view]), CALCULATE(SUM(Fact_CM2[missing_tax_nsv]), KEEPFILTERS(Fact_CM2[record_type] = "SALES")))
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure NSV_Actual_INR_Sum = SUM(Fact_Financials[NSV_Actual_INR])
		formatString: #,##0.00
		displayFolder: Finance sample

	measure COGS_INR_Sum = SUM(Fact_Financials[COGS_INR])
		formatString: #,##0.00
		displayFolder: Finance sample

	measure Trade_Spend_INR_Sum = SUM(Fact_Financials[Variable_Trade_Spend_INR])
		formatString: #,##0.00
		displayFolder: Finance sample

	measure Freight_INR_Sum = SUM(Fact_Financials[Freight_Logistics_INR])
		formatString: #,##0.00
		displayFolder: Finance sample
