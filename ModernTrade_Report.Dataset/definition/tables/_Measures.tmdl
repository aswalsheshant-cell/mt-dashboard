table _Measures

	measure NSV_L3M_Actuals = ```
		CALCULATE(
		    [NSV_Actual_INR],
		    DATESBETWEEN(
		        'Dim_Date'[Date],
		        DATE(2026, 3, 1),
		        DATE(2026, 5, 31)
		    ),
		    'Fact_Financials'[Scenario] = "Actual"
		)
		```
		formatString: #,##0.00
		displayFolder: GAP-01 Allocation

	measure NSV_L3M_AllChannel_Total = ```
		CALCULATE(
		    [NSV_L3M_Actuals],
		    ALLSELECTED('Dim_Chain'),
		    ALLSELECTED('Dim_Category')
		)
		```
		formatString: #,##0.00
		displayFolder: GAP-01 Allocation

	measure Allocation_Weight_L3M = ```
		DIVIDE(
		    [NSV_L3M_Actuals],
		    [NSV_L3M_AllChannel_Total],
		    0
		)
		```
		formatString: 0.0000%
		displayFolder: GAP-01 Allocation

	measure NSV_Jun26_Allocated = ```
		VAR Unallocated_Jun26_Pool =
		    CALCULATE(
		        [NSV_Pool_INR],
		        'Dim_Date'[YearMonth] = 202606,
		        'Fact_Financials'[Scenario] = "Forecast_Unallocated",
		        ALL('Dim_Chain'),
		        ALL('Dim_Category')
		    )
		VAR CurrentRowActual =
		    CALCULATE(
		        [NSV_Actual_INR],
		        'Dim_Date'[YearMonth] = 202606
		    )
		RETURN
		    IF(
		        ISBLANK(CurrentRowActual) || CurrentRowActual = 0,
		        Unallocated_Jun26_Pool * [Allocation_Weight_L3M],
		        CurrentRowActual
		    )
		```
		formatString: #,##0.00
		displayFolder: GAP-01 Allocation

	measure Contribution_Margin_INR = ```
		[NSV_Actual_INR] - [COGS_INR] - [Variable_Trade_Spend_INR] - [Freight_Logistics_INR]
		```
		formatString: #,##0.00
		displayFolder: GAP-02 Contribution Margin

	measure Cont_Margin_Pct = ```
		DIVIDE(
		    [Contribution_Margin_INR],
		    [NSV_Actual_INR],
		    BLANK()
		)
		```
		formatString: 0.0%
		displayFolder: GAP-02 Contribution Margin

	measure Cont_Margin_Status = ```
		VAR Pct = [Cont_Margin_Pct]
		RETURN
		    SWITCH(
		        TRUE(),
		        ISBLANK(Pct), "No Data",
		        Pct < 0, "Loss-Making (< 0%)",
		        Pct < 0.10, "At-Risk (0-10%)",
		        Pct < 0.20, "Target (10-20%)",
		        "High Margin (> 20%)"
		    )
		```
		displayFolder: GAP-02 Contribution Margin

	measure Cont_Margin_Color = ```
		VAR Pct = [Cont_Margin_Pct]
		RETURN
		    SWITCH(
		        TRUE(),
		        ISBLANK(Pct), "#9E9E9E",
		        Pct < 0, "#D32F2F",
		        Pct < 0.10, "#F57C00",
		        Pct < 0.20, "#388E3C",
		        "#1B5E20"
		    )
		```
		displayFolder: GAP-02 Contribution Margin

	measure Cont_Margin_Badge = ```
		VAR Pct = [Cont_Margin_Pct]
		VAR FormattedPct = FORMAT(Pct, "0.0%")
		RETURN
		    SWITCH(
		        TRUE(),
		        ISBLANK(Pct), "—",
		        Pct < 0, "⚠️ " & FormattedPct & " [LOSS]",
		        Pct < 0.10, "⚡ " & FormattedPct & " [COMPRESSED]",
		        FormattedPct
		    )
		```
		displayFolder: GAP-02 Contribution Margin

	measure 'CM2 Provision Claim' =
			CALCULATE(SUM(Fact_CM2[claim_amount]), KEEPFILTERS(Fact_CM2[view] = "provision"))
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 Recorded DN Claim' =
			CALCULATE(SUM(Fact_CM2[claim_amount]), KEEPFILTERS(Fact_CM2[view] = "recorded_dn"))
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 Provision BA' =
			CALCULATE(SUM(Fact_CM2[ba_amount]), KEEPFILTERS(Fact_CM2[view] = "provision"))
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 NSV' =
			IF(HASONEVALUE(Fact_CM2[view]), CALCULATE(SUM(Fact_CM2[nsv]), Fact_CM2[record_type] = "SALES"))
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 Covered NSV' =
			IF(HASONEVALUE(Fact_CM2[view]), CALCULATE(SUM(Fact_CM2[covered_nsv]), Fact_CM2[record_type] = "SALES"))
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 Coverage Pct' =
			DIVIDE([CM2 Covered NSV], [CM2 NSV])
		formatString: 0.00%
		displayFolder: Governed CM2 Draft

	measure 'CM2 Source Tax' =
			IF(HASONEVALUE(Fact_CM2[view]), CALCULATE(SUM(Fact_CM2[tax]), Fact_CM2[record_type] = "SALES"))
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 GST QC' =
			CONCATENATEX(VALUES(Fact_CM2[gst_qc_status]), Fact_CM2[gst_qc_status], ", ")
		displayFolder: Governed CM2 Draft

	measure 'CM2 Source Status' =
			CONCATENATEX(VALUES(Fact_CM2[source_status]), Fact_CM2[source_status], ", ")
		displayFolder: Governed CM2 Draft

	measure 'CM2 Status' =
			"NOT_AVAILABLE | COGS basis unresolved | PENDING_FINANCE"
		displayFolder: Governed CM2 Draft

	measure 'CM2 Scope' =
			"MT | INR lakh | Brand: NSV-share allocated estimate | Category unsupported"
		displayFolder: Governed CM2 Draft

	measure 'CM2 Modeled' =
			BLANK()
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 Effective GST Pct' =
			IF(HASONEVALUE(Fact_CM2[view]) && CALCULATE(COUNTROWS(Fact_CM2), Fact_CM2[record_type] = "SALES", Fact_CM2[effective_gst_pct_status] = "NOT_AVAILABLE") = 0, DIVIDE([CM2 Source Tax], [CM2 NSV]))
		formatString: 0.00%
		displayFolder: Governed CM2 Draft

	measure 'CM2 Unallocated Claim' =
			IF(HASONEVALUE(Fact_CM2[view]), CALCULATE(SUM(Fact_CM2[claim_amount]), KEEPFILTERS(Fact_CM2[record_type] = "UNALLOCATED_CLAIM"), REMOVEFILTERS(Fact_CM2[brand])))
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 Unallocated BA' =
			CALCULATE(SUM(Fact_CM2[ba_amount]), KEEPFILTERS(Fact_CM2[view] = "provision"), KEEPFILTERS(Fact_CM2[record_type] = "UNALLOCATED_BA"), REMOVEFILTERS(Fact_CM2[brand]))
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 Matched NSV' =
			VAR ProvisionKeys = CALCULATETABLE(SUMMARIZE(Fact_CM2, Fact_CM2[fy], Fact_CM2[month], Fact_CM2[chain]), REMOVEFILTERS(Fact_CM2[view]), Fact_CM2[view] = "provision", Fact_CM2[record_type] = "SALES", Fact_CM2[source_status] <> "NOT_AVAILABLE")
			VAR DNKeys = CALCULATETABLE(SUMMARIZE(Fact_CM2, Fact_CM2[fy], Fact_CM2[month], Fact_CM2[chain]), REMOVEFILTERS(Fact_CM2[view]), Fact_CM2[view] = "recorded_dn", Fact_CM2[record_type] = "SALES", Fact_CM2[source_status] <> "NOT_AVAILABLE")
			VAR Matched = INTERSECT(ProvisionKeys, DNKeys)
			RETURN CALCULATE(SUM(Fact_CM2[nsv]), REMOVEFILTERS(Fact_CM2[view]), Fact_CM2[view] = "provision", Fact_CM2[record_type] = "SALES", KEEPFILTERS(Matched))
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 Matched Claim Gap' =
			VAR ProvisionKeys = CALCULATETABLE(SUMMARIZE(Fact_CM2, Fact_CM2[fy], Fact_CM2[month], Fact_CM2[chain]), REMOVEFILTERS(Fact_CM2[view]), Fact_CM2[view] = "provision", Fact_CM2[record_type] = "SALES", Fact_CM2[source_status] <> "NOT_AVAILABLE")
			VAR DNKeys = CALCULATETABLE(SUMMARIZE(Fact_CM2, Fact_CM2[fy], Fact_CM2[month], Fact_CM2[chain]), REMOVEFILTERS(Fact_CM2[view]), Fact_CM2[view] = "recorded_dn", Fact_CM2[record_type] = "SALES", Fact_CM2[source_status] <> "NOT_AVAILABLE")
			VAR Matched = INTERSECT(ProvisionKeys, DNKeys)
			VAR P = CALCULATE([CM2 Provision Claim], REMOVEFILTERS(Fact_CM2[view]), Fact_CM2[record_type] = "SALES", KEEPFILTERS(Matched))
			VAR D = CALCULATE([CM2 Recorded DN Claim], REMOVEFILTERS(Fact_CM2[view]), Fact_CM2[record_type] = "SALES", KEEPFILTERS(Matched))
			RETURN IF(COUNTROWS(Matched) > 0, D - P)
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 Matched Claim Gap Pct' =
			DIVIDE([CM2 Matched Claim Gap], [CM2 Matched NSV])
		formatString: 0.00%
		displayFolder: Governed CM2 Draft

	measure NSV_Actual_INR = SUM(Fact_Financials[NSV_Actual_INR])
		displayFolder: Finance sample

	measure NSV_Pool_INR = SUM(Fact_Financials[NSV_Pool_INR])
		displayFolder: Finance sample

	measure COGS_INR = SUM(Fact_Financials[COGS_INR])
		displayFolder: Finance sample

	measure Variable_Trade_Spend_INR = SUM(Fact_Financials[Variable_Trade_Spend_INR])
		displayFolder: Finance sample

	measure Freight_Logistics_INR = SUM(Fact_Financials[Freight_Logistics_INR])
		displayFolder: Finance sample

	measure 'CM2 Reviewed Amount' =
			IF(HASONEVALUE(Fact_CM2[view]), CALCULATE(SUM(Fact_CM2[reviewed_amount]), KEEPFILTERS(Fact_CM2[record_type] = "SALES")))
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 Reviewed NSV' =
			IF(HASONEVALUE(Fact_CM2[view]), CALCULATE(SUM(Fact_CM2[reviewed_nsv]), KEEPFILTERS(Fact_CM2[record_type] = "SALES")))
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 Reviewed Tax' =
			IF(HASONEVALUE(Fact_CM2[view]), CALCULATE(SUM(Fact_CM2[reviewed_tax]), KEEPFILTERS(Fact_CM2[record_type] = "SALES")))
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure 'CM2 Missing Tax NSV' =
			IF(HASONEVALUE(Fact_CM2[view]), CALCULATE(SUM(Fact_CM2[missing_tax_nsv]), KEEPFILTERS(Fact_CM2[record_type] = "SALES")))
		formatString: #,##0.00
		displayFolder: Governed CM2 Draft

	measure NSV_Actual_INR_Sum = SUM(Fact_Financials[NSV_Actual_INR])
		formatString: #,##0.00
		displayFolder: Finance sample

	measure COGS_INR_Sum = SUM(Fact_Financials[COGS_INR])
		formatString: #,##0.00
		displayFolder: Finance sample

	measure Trade_Spend_INR_Sum = SUM(Fact_Financials[Variable_Trade_Spend_INR])
		formatString: #,##0.00
		displayFolder: Finance sample

	measure Freight_INR_Sum = SUM(Fact_Financials[Freight_Logistics_INR])
		formatString: #,##0.00
		displayFolder: Finance sample

	measure 'Fact_PrimarySales Source Rows' =
			COUNTROWS(Fact_PrimarySales)
		displayFolder: Full report coverage

	measure 'Fact_PrimarySales Covered Months' =
			COUNTROWS(FILTER(VALUES(Fact_PrimarySales[MonthStart]), NOT ISBLANK(Fact_PrimarySales[MonthStart])))
		displayFolder: Full report coverage

	measure 'Fact_PrimarySales Source Status' =
			IF(COUNTROWS(Fact_PrimarySales) > 0, "Source rows loaded; period coverage and approval unassessed", "Unavailable - no source rows")
		displayFolder: Full report coverage

	measure 'Fact_OfftakeSales Source Rows' =
			COUNTROWS(Fact_OfftakeSales)
		displayFolder: Full report coverage

	measure 'Fact_OfftakeSales Covered Months' =
			COUNTROWS(FILTER(VALUES(Fact_OfftakeSales[MonthStart]), NOT ISBLANK(Fact_OfftakeSales[MonthStart])))
		displayFolder: Full report coverage

	measure 'Fact_OfftakeSales Source Status' =
			IF(COUNTROWS(Fact_OfftakeSales) > 0, "Source rows loaded; period coverage and approval unassessed", "Unavailable - no source rows")
		displayFolder: Full report coverage

	measure 'Fact_Nielsen Source Rows' =
			COUNTROWS(Fact_Nielsen)
		displayFolder: Full report coverage

	measure 'Fact_Nielsen Covered Months' =
			COUNTROWS(FILTER(VALUES(Fact_Nielsen[MonthStart]), NOT ISBLANK(Fact_Nielsen[MonthStart])))
		displayFolder: Full report coverage

	measure 'Fact_Nielsen Source Status' =
			IF(COUNTROWS(Fact_Nielsen) > 0, "Source rows loaded; period coverage and approval unassessed", "Unavailable - no source rows")
		displayFolder: Full report coverage

	measure 'Fact_TDP Source Rows' =
			COUNTROWS(Fact_TDP)
		displayFolder: Full report coverage

	measure 'Fact_TDP Covered Months' =
			COUNTROWS(FILTER(VALUES(Fact_TDP[MonthStart]), NOT ISBLANK(Fact_TDP[MonthStart])))
		displayFolder: Full report coverage

	measure 'Fact_TDP Source Status' =
			IF(COUNTROWS(Fact_TDP) > 0, "Source rows loaded; period coverage and approval unassessed", "Unavailable - no source rows")
		displayFolder: Full report coverage

	measure 'Fact_PrimaryArticle Source Rows' =
			DISTINCTCOUNT(Fact_PrimaryArticle[Source Record ID])
		displayFolder: Full report coverage

	measure 'Fact_PrimaryArticle Covered Months' =
			COUNTROWS(FILTER(VALUES(Fact_PrimaryArticle[MonthStart]), NOT ISBLANK(Fact_PrimaryArticle[MonthStart])))
		displayFolder: Full report coverage

	measure 'Fact_PrimaryArticle Source Status' =
			IF(COUNTROWS(Fact_PrimaryArticle) > 0, "Source rows loaded; period coverage and approval unassessed", "Unavailable - no source rows")
		displayFolder: Full report coverage

	measure 'Fact_SecondarySales Source Rows' =
			COUNTROWS(Fact_SecondarySales)
		displayFolder: Full report coverage

	measure 'Fact_SecondarySales Covered Months' =
			COUNTROWS(FILTER(VALUES(Fact_SecondarySales[MonthStart]), NOT ISBLANK(Fact_SecondarySales[MonthStart])))
		displayFolder: Full report coverage

	measure 'Fact_SecondarySales Source Status' =
			IF(COUNTROWS(Fact_SecondarySales) > 0, "Source rows loaded; period coverage and approval unassessed", "Unavailable - no source rows")
		displayFolder: Full report coverage

	measure 'Offtake Source Status' =
			IF(COUNTROWS(Fact_OfftakeSales) > 0, "Loaded; units/tax basis unresolved - not comparable to primary", "Unavailable - no offtake source rows")
		displayFolder: Full report coverage

	measure 'Finance Sample Source Status' =
			"Unavailable - legacy sample server source is not a governed input"
		displayFolder: Full report coverage

	measure 'Fact_PrimaryArticle Allocated Output Rows' =
			COUNTROWS(Fact_PrimaryArticle)
		displayFolder: Full report coverage

	measure 'Primary NSV INR' =
			IF(COUNTROWS(Fact_PrimaryArticle) = 0, BLANK(), SUM(Fact_PrimaryArticle[Primary NSV]))
		formatString: #,##0
		displayFolder: Full report measures

	measure 'Offtake NSV INR (All)' =
			IF(COUNTROWS(Fact_OfftakeSales) = 0, BLANK(), SUM(Fact_OfftakeSales[Offtake NSV]))
		formatString: #,##0
		displayFolder: Full report measures

	measure 'Reliance Brand Counter Offtake NSV INR' =
			VAR Rows = CALCULATETABLE(Fact_OfftakeSales, Fact_OfftakeSales[Chain] = "Reliance Brand Counter")
			RETURN IF(COUNTROWS(Rows) = 0, BLANK(), SUMX(Rows, Fact_OfftakeSales[Offtake NSV]))
		formatString: #,##0
		displayFolder: Full report measures

	measure 'MT Offtake NSV INR' =
			VAR Rows = CALCULATETABLE(Fact_OfftakeSales, Fact_OfftakeSales[Chain] <> "Reliance Brand Counter")
			RETURN IF(COUNTROWS(Rows) = 0, BLANK(), SUMX(Rows, Fact_OfftakeSales[Offtake NSV]))
		formatString: #,##0
		displayFolder: Full report measures

	measure 'MT Offtake NSV INR LY Same Months' =
			CALCULATE([MT Offtake NSV INR], DATEADD('Dim_Date'[Date], -1, YEAR))
		formatString: #,##0
		displayFolder: Full report measures

	measure 'MT Offtake YoY Comparable' =
			VAR Cur = [Fact_OfftakeSales Covered Months]
			VAR Prior = CALCULATE([Fact_OfftakeSales Covered Months], DATEADD('Dim_Date'[Date], -1, YEAR))
			VAR CurSet = SUMMARIZE(Fact_OfftakeSales, 'Dim_Date'[FiscalMonth])
			VAR PriorSet = CALCULATETABLE(SUMMARIZE(Fact_OfftakeSales, 'Dim_Date'[FiscalMonth]), DATEADD('Dim_Date'[Date], -1, YEAR))
			RETURN IF(Cur > 0 && Cur = Prior && COUNTROWS(EXCEPT(CurSet, PriorSet)) = 0 && COUNTROWS(EXCEPT(PriorSet, CurSet)) = 0, 1, 0)
		displayFolder: Full report measures

	measure 'MT Offtake YoY Pct' =
			IF([MT Offtake YoY Comparable] = 1, DIVIDE([MT Offtake NSV INR] - [MT Offtake NSV INR LY Same Months], [MT Offtake NSV INR LY Same Months]), BLANK())
		formatString: 0.0%
		displayFolder: Full report measures

	measure 'MT Offtake YoY Label' =
			VAR Cur = [Fact_OfftakeSales Covered Months]
			VAR Prior = CALCULATE([Fact_OfftakeSales Covered Months], DATEADD('Dim_Date'[Date], -1, YEAR))
			RETURN IF(Cur = 0, "Unavailable - no offtake rows in the selection", IF([MT Offtake YoY Comparable] = 1, "Like-for-like: " & Cur & " month(s) vs the same month(s) last year", "Not comparable - " & Cur & " covered month(s) vs " & Prior & " last year; growth withheld"))
		displayFolder: Full report measures

	measure 'Primary NSV INR LY Same Months' =
			CALCULATE([Primary NSV INR], DATEADD('Dim_Date'[Date], -1, YEAR))
		formatString: #,##0
		displayFolder: Full report measures

	measure 'Primary YoY Comparable' =
			VAR Cur = [Fact_PrimaryArticle Covered Months]
			VAR Prior = CALCULATE([Fact_PrimaryArticle Covered Months], DATEADD('Dim_Date'[Date], -1, YEAR))
			VAR CurSet = SUMMARIZE(Fact_PrimaryArticle, 'Dim_Date'[FiscalMonth])
			VAR PriorSet = CALCULATETABLE(SUMMARIZE(Fact_PrimaryArticle, 'Dim_Date'[FiscalMonth]), DATEADD('Dim_Date'[Date], -1, YEAR))
			RETURN IF(Cur > 0 && Cur = Prior && COUNTROWS(EXCEPT(CurSet, PriorSet)) = 0 && COUNTROWS(EXCEPT(PriorSet, CurSet)) = 0, 1, 0)
		displayFolder: Full report measures

	measure 'Primary YoY Pct' =
			IF([Primary YoY Comparable] = 1, DIVIDE([Primary NSV INR] - [Primary NSV INR LY Same Months], [Primary NSV INR LY Same Months]), BLANK())
		formatString: 0.0%
		displayFolder: Full report measures

	measure 'Primary YoY Label' =
			VAR Cur = [Fact_PrimaryArticle Covered Months]
			VAR Prior = CALCULATE([Fact_PrimaryArticle Covered Months], DATEADD('Dim_Date'[Date], -1, YEAR))
			RETURN IF(Cur = 0, "Unavailable - no primary rows in the selection", IF([Primary YoY Comparable] = 1, "Like-for-like: " & Cur & " month(s) vs the same month(s) last year", "Not comparable - " & Cur & " covered month(s) vs " & Prior & " last year; growth withheld"))
		displayFolder: Full report measures

	measure 'Primary to MT Offtake Gap INR' =
			VAR P = [Primary NSV INR]
			VAR O = [MT Offtake NSV INR]
			VAR SameCount = [Fact_PrimaryArticle Covered Months] = [Fact_OfftakeSales Covered Months]
			VAR PrimaryOnly = COUNTROWS(EXCEPT(VALUES(Fact_PrimaryArticle[MonthStart]), VALUES(Fact_OfftakeSales[MonthStart])))
			VAR OfftakeOnly = COUNTROWS(EXCEPT(VALUES(Fact_OfftakeSales[MonthStart]), VALUES(Fact_PrimaryArticle[MonthStart])))
			RETURN IF(NOT ISBLANK(P) && NOT ISBLANK(O) && SameCount && PrimaryOnly = 0 && OfftakeOnly = 0, P - O)
		formatString: #,##0
		displayFolder: Full report measures

	measure 'Primary to MT Offtake Gap Label' =
			IF(ISBLANK([Primary to MT Offtake Gap INR]), "Withheld - Primary and MT offtake do not cover the same months, or one is unavailable", "Primary (gross billing) minus MT offtake (excludes Reliance Brand Counter): two different measures, same months only")
		displayFolder: Full report measures

	measure 'Offtake Duplicate Key Rows' =
			IF(COUNTROWS(Fact_OfftakeSales) = 0, BLANK(), COUNTROWS(Fact_OfftakeSales) - COUNTROWS(SUMMARIZE(Fact_OfftakeSales, Fact_OfftakeSales[MonthStart], Fact_OfftakeSales[Store Code], Fact_OfftakeSales[Article Code])))
		formatString: #,##0
		displayFolder: Full report measures

	measure 'Offtake Key Status' =
			IF(COUNTROWS(Fact_OfftakeSales) = 0, "Unavailable - no offtake rows", IF([Offtake Duplicate Key Rows] > 0, [Offtake Duplicate Key Rows] & " duplicate-key row(s) kept as source rows; totals include them", "No duplicate month/store/article keys"))
		displayFolder: Full report measures

	measure 'Offtake Reporting Stores' =
			VAR Stores = CALCULATE(DISTINCTCOUNT(Fact_OfftakeSales[Store Key]), Fact_OfftakeSales[Chain] <> "Reliance Brand Counter")
			RETURN IF(Stores = 0, BLANK(), Stores)
		formatString: #,##0
		displayFolder: Full report measures

	measure 'Nielsen Value Share Pct' =
			VAR Market = SUM(Fact_Nielsen[Market Value Sales])
			VAR Ours = SUM(Fact_Nielsen[Our Brand Sales])
			RETURN IF(COUNTROWS(Fact_Nielsen) = 0, BLANK(), DIVIDE(Ours, Market))
		formatString: 0.0%
		displayFolder: Full report measures

	measure 'Forecast Source Status' =
			"Unavailable - no target or forecast table is loaded in this model; forecast figures stay in the dashboard until a governed source is added"
		displayFolder: Full report measures

	measure 'Alerts Source Status' =
			"Unavailable - alert thresholds are computed in the dashboard pipeline; no governed alert source is loaded in this model"
		displayFolder: Full report measures

	measure 'NPI Source Status' =
			"Unavailable - NPI launch cohorts are computed in the dashboard pipeline; this model has no NPI fact"
		displayFolder: Full report measures

	measure 'NPI YoY Label' =
			"Provisional - observed-only cohorts; not confirmed NPI growth. Confirmed NPI YoY is shown only where the dashboard marks the comparison valid"
		displayFolder: Full report measures
