table Dim_Brand

	column Brand
		dataType: string
		summarizeBy: none
		sourceColumn: Brand

	column 'Brand Key'
		dataType: string
		summarizeBy: none
		sourceColumn: Brand Key
		isKey

	partition Dim_Brand = m
		mode: import
		source = ```
			let
			    Combined = Table.Combine({Table.SelectColumns(qFact_PrimarySales, {"Brand Key", "Brand"}),
			        Table.SelectColumns(qFact_OfftakeSales, {"Brand Key", "Brand"}),
			        Table.SelectColumns(qFact_Nielsen, {"Brand Key", "Brand"}),
			        Table.SelectColumns(qFact_TDP, {"Brand Key", "Brand"}),
			        Table.SelectColumns(qFact_PrimaryArticle, {"Brand Key", "Brand"})}),
			    Valid = Table.SelectRows(Combined, each Record.Field(_, "Brand Key") <> null),
			    Unique = fnDimension(Valid, "Brand Key")
			in Table.Distinct(Unique, {"Brand Key"})
			```
