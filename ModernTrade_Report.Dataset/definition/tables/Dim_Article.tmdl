table Dim_Article

	column 'Article Key'
		dataType: string
		summarizeBy: none
		sourceColumn: Article Key
		isKey

	column 'Article Description'
		dataType: string
		summarizeBy: none
		sourceColumn: Article Description

	column Brand
		dataType: string
		summarizeBy: none
		sourceColumn: Brand

	column Category
		dataType: string
		summarizeBy: none
		sourceColumn: Category

	partition Dim_Article = m
		mode: import
		source = ```
			let
			    Combined = Table.Combine({Table.SelectColumns(qFact_PrimarySales, {"Article Key", "Article Description", "Brand", "Category"}, MissingField.UseNull),
			        Table.SelectColumns(qFact_OfftakeSales, {"Article Key", "Article Description", "Brand", "Category"}, MissingField.UseNull),
			        Table.SelectColumns(qFact_TDP, {"Article Key", "Article Description", "Brand", "Category"}, MissingField.UseNull),
			        Table.SelectColumns(qFact_PrimaryArticle, {"Article Key", "Article Description", "Brand", "Category"}, MissingField.UseNull)}),
			    Valid = Table.SelectRows(Combined, each Record.Field(_, "Article Key") <> null),
			    Unique = fnDimension(Valid, "Article Key")
			in Table.Distinct(Unique, {"Article Key"})
			```
