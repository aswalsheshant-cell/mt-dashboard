expression RepoRoot = "C:/CM2_REPO_ROOT" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

expression pRootFolder = ```
	RepoRoot & "/PowerBI"
	```

expression fnRelationshipKey = ```
	(value as any) as nullable text => if value = null then null else Text.Upper(Text.Trim(Text.From(value)), "en-US")
	```

expression fnCompositeKey = ```
	(values as list) as text => fnRelationshipKey(Text.FromBinary(Json.FromValue(List.Transform(values, each fnRelationshipKey(_))), TextEncoding.Utf8))
	```

expression fnMonthStart = ```
	(value as any) as nullable date =>
	if value = null or Text.Trim(Text.From(value)) = "" then null else
	let
	    parsed = try (
	        if Value.Is(value, type date) or Value.Is(value, type datetime) or Value.Is(value, type number) then Date.StartOfMonth(Date.From(value))
	        else let text = Text.Trim(Text.From(value)),
	                 result = if Text.Contains(text, "'") then
	                    let parts = Text.Split(text, "'"),
	                        month = Record.FieldOrDefault([jan=1,feb=2,mar=3,apr=4,may=5,jun=6,jul=7,aug=8,sep=9,oct=10,nov=11,dec=12], Text.Lower(Text.Start(parts{0}, 3)), null),
	                        yr = Number.FromText(parts{1}), year = if yr < 100 then 2000 + yr else yr
	                    in #date(year, month, 1)
	                 else Date.StartOfMonth(Date.FromText(text, [Culture="en-IN"]))
	             in result)
	in if parsed[HasError] then error Error.Record("InvalidPeriod", "Unparseable source period; refresh blocked", value) else parsed[Value]
	```

expression fnDimension = ```
	(rows as table, key as text) as table =>
	let
	    Attributes = List.RemoveItems(Table.ColumnNames(rows), {key}),
	    Canonical = Table.TransformColumns(rows, {{key, each fnRelationshipKey(_), type nullable text}}),
	    // One row per key. Conflicting labels are explicitly null, never an arbitrary winner.
	    Grouped = Table.Group(Canonical, {key}, List.Transform(Attributes, (name) =>
	        {name, (group) => let values = List.Sort(List.Distinct(List.RemoveNulls(Table.Column(group, name)))),
	                                spellings = List.Distinct(List.Transform(values, each fnRelationshipKey(_)))
	                          in if List.Count(spellings) = 1 then values{0} else null, type nullable text})),
	    Unique = Table.Distinct(Grouped, {key}),
	    Checked = if Table.RowCount(Unique) <> Table.RowCount(Grouped)
	              then error Error.Record("DuplicateDimensionKey", key, null) else Unique
	in Checked
	```

expression fnCombineFolder = ```
	let
	    fnCombineFolder = (FolderPath as text, optional HeaderRow as nullable number) as table =>
	        let
	            Source = Folder.Files(FolderPath),
	            HeaderIndex = if HeaderRow = null then 0 else Number.RoundDown(Number.From(HeaderRow)),

	            // keep only real data files, skip templates / hidden / archive
	            OnlyData = Table.SelectRows(
	                Source,
	                each ([Attributes]?[Hidden]? <> true)
	                    and (Text.StartsWith([Name], "_") = false)
	                    and (
	                        Text.EndsWith(Text.Lower([Extension]), ".csv")
	                        or Text.EndsWith(Text.Lower([Extension]), ".xlsx")
	                        or Text.EndsWith(Text.Lower([Extension]), ".xlsb")
	                    )
	            ),

	            // parse each file into a table depending on its type
	            AddParsed = Table.AddColumn(OnlyData, "Parsed", each
	                let
	                    ext = Text.Lower([Extension]),
	                    bin = [Content],
	                    asTable =
	                        if ext = ".csv" then
	                            Csv.Document(bin, [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv])
	                        else
	                            // xlsx / xlsb : take the first sheet
	                            let
	                                wb = Excel.Workbook(bin, null, true),
	                                firstSheet = wb{0}[Data]
	                            in firstSheet,
	                    promoted =
	                        if HeaderIndex = 0 then
	                            Table.PromoteHeaders(asTable, [PromoteAllScalars=true])
	                        else
	                            let
	                                skipped = Table.Skip(asTable, HeaderIndex),
	                                promotedHeaders = Table.PromoteHeaders(skipped, [PromoteAllScalars=true])
	                            in
	                                promotedHeaders
	                in
	                    Table.AddIndexColumn(promoted, "Source Row Number", 1, 1, Int64.Type)
	            ),

	            // stamp source file + refresh timestamp on every row
	            AddMeta = Table.AddColumn(AddParsed, "WithMeta", each
	                Table.AddColumn(
	                    Table.AddColumn(
	                        Table.AddColumn([Parsed], "Source Record ID", (r) => fnCompositeKey({FolderPath, [Name], r[Source Row Number]}), type text),
	                        "Data Source File", (r) => [Name], type text),
	                    "Refresh Date", (r) => DateTime.LocalNow(), type datetime
	                )
	            ),

	            Combined =
	                if Table.RowCount(AddMeta) = 0 then
	                    #table({"Data Source File","Refresh Date", "Source Row Number", "Source Record ID"}, {})
	                else
	                    Table.Combine(AddMeta[WithMeta])
	        in
	            Combined
	in
	    fnCombineFolder
	```

expression 'Dist Cont Weights' = ```
	let
	    // â”€â”€ Load Timestamp (shared across all rows this refresh) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	    LoadTs = DateTime.ToText(DateTime.LocalNow(), "yyyy-MM-dd HH:mm"),

	    // â”€â”€ CONSTANT: Jun'26 and May'26 month starts â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	    Jun26Start = #date(2026, 6, 1),
	    May26Start = #date(2026, 5, 1),

	    // ======================================================================
	    // P1: Finance-Approved Patch
	    //     Secondary contribution % is in 0-100 format â†’ divide by 100
	    // ======================================================================
	    PatchRaw = Csv.Document(
	        File.Contents(pRootFolder & "\SeedData\Mapping\DistCont_Patch_Approved_2026-07-04.csv"),
	        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
	    PatchHeaders = Table.PromoteHeaders(PatchRaw, [PromoteAllScalars = true]),
	    PatchPicked = Table.SelectColumns(PatchHeaders, {
	        "Ship To Name", "Chain Name", "Brand", "Revised month", "Secondary contribution %"
	    }, MissingField.UseNull),
	    PatchTyped = Table.TransformColumnTypes(PatchPicked, {
	        {"Ship To Name",               type text},
	        {"Chain Name",                 type text},
	        {"Brand",                      type text},
	        {"Revised month",              type date},
	        {"Secondary contribution %",   type number}
	    }),
	    PatchCleaned = Table.SelectRows(PatchTyped,
	        each [Ship To Name] <> null and [Chain Name] <> null
	          and [#"Secondary contribution %"] <> null
	          and [#"Secondary contribution %"] <> 0),
	    PatchAddShipToKey = Table.AddColumn(PatchCleaned, "ShipTo Key",
	        each Text.Lower(Text.Trim([Ship To Name])), type text),
	    PatchAddBrandKey = Table.AddColumn(PatchAddShipToKey, "Brand Key",
	        each Text.Lower(Text.Trim([Brand])), type text),
	    PatchAddMonthStart = Table.AddColumn(PatchAddBrandKey, "MonthStart",
	        each Date.StartOfMonth([Revised month]), type date),
	    // Divide by 100 to get raw 0-1 contribution for normalisation
	    PatchRawCont = Table.AddColumn(PatchAddMonthStart, "RawCont",
	        each [#"Secondary contribution %"] / 100, type number),
	    // Governance
	    PatchGov1 = Table.AddColumn(PatchRawCont,
	        "Source File", each "DistCont_Patch_Approved_2026-07-04.csv", type text),
	    PatchGov2 = Table.AddColumn(PatchGov1,
	        "Source Type", each "Approved Patch", type text),
	    PatchGov3 = Table.AddColumn(PatchGov2,
	        "Approval Status", each "Approved", type text),
	    PatchGov4 = Table.AddColumn(PatchGov3,
	        "Allocation Method", each "Exact Match â€“ Approved Patch", type text),
	    PatchGov5 = Table.AddColumn(PatchGov4,
	        "Provisional Flag", each false, type logical),
	    PatchGov6 = Table.AddColumn(PatchGov5,
	        "Fallback Flag", each false, type logical),
	    PatchGov7 = Table.AddColumn(PatchGov6,
	        "Fallback Source Month", each null, type date),
	    PatchFinal = Table.SelectColumns(PatchGov7, {
	        "ShipTo Key", "Brand Key", "MonthStart",
	        "Ship To Name", "Chain Name", "Brand", "RawCont",
	        "Source File", "Source Type", "Approval Status",
	        "Allocation Method", "Provisional Flag", "Fallback Flag", "Fallback Source Month"
	    }),

	    // ======================================================================
	    // P2: ShipTo CSV â€” Dist. rows only
	    //     Cont% is already in 0-1 fraction form; Chain column = Chain Name
	    // ======================================================================
	    ShipToRaw = Csv.Document(
	        File.Contents(pRootFolder & "\RawDataFolders\Primary_ShipTo_Monthly\Primary_ShipTo_FY25-26_to_May26.csv"),
	        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
	    ShipToHeaders = Table.PromoteHeaders(ShipToRaw, [PromoteAllScalars = true]),
	    ShipToPicked = Table.SelectColumns(ShipToHeaders, {
	        "Ship To Name", "Direct/Distributor", "Chain", "Brand", "MonthStart", "Cont%"
	    }, MissingField.UseNull),
	    ShipToTyped = Table.TransformColumnTypes(ShipToPicked, {
	        {"Ship To Name",         type text},
	        {"Direct/Distributor",   type text},
	        {"Chain",                type text},
	        {"Brand",                type text},
	        {"MonthStart",           type date},
	        {"Cont%",                type number}
	    }),
	    // Keep only Distributor rows with a valid chain and non-zero contribution
	    ShipToDistOnly = Table.SelectRows(ShipToTyped,
	        each [Direct/Distributor] <> null
	          and Text.Lower(Text.Trim([Direct/Distributor])) = "dist."
	          and [Chain] <> null
	          and [#"Cont%"] <> null and [#"Cont%"] <> 0),
	    ShipToRenChain = Table.RenameColumns(ShipToDistOnly, {{"Chain", "Chain Name"}}),
	    ShipToAddShipToKey = Table.AddColumn(ShipToRenChain, "ShipTo Key",
	        each Text.Lower(Text.Trim([Ship To Name])), type text),
	    ShipToAddBrandKey = Table.AddColumn(ShipToAddShipToKey, "Brand Key",
	        each Text.Lower(Text.Trim([Brand])), type text),
	    // Rename Cont% to RawCont (already 0-1 fraction, no scaling needed)
	    ShipToRawCont = Table.RenameColumns(ShipToAddBrandKey, {{"Cont%", "RawCont"}}),
	    // Governance
	    ShipToGov1 = Table.AddColumn(ShipToRawCont,
	        "Source File", each "Primary_ShipTo_FY25-26_to_May26.csv", type text),
	    ShipToGov2 = Table.AddColumn(ShipToGov1,
	        "Source Type", each "ShipTo CSV", type text),
	    ShipToGov3 = Table.AddColumn(ShipToGov2,
	        "Approval Status", each "Approved", type text),
	    ShipToGov4 = Table.AddColumn(ShipToGov3,
	        "Allocation Method", each "Exact Match â€“ ShipTo CSV", type text),
	    ShipToGov5 = Table.AddColumn(ShipToGov4,
	        "Provisional Flag", each false, type logical),
	    ShipToGov6 = Table.AddColumn(ShipToGov5,
	        "Fallback Flag", each false, type logical),
	    ShipToGov7 = Table.AddColumn(ShipToGov6,
	        "Fallback Source Month", each null, type date),
	    ShipToFinal = Table.SelectColumns(ShipToGov7, {
	        "ShipTo Key", "Brand Key", "MonthStart",
	        "Ship To Name", "Chain Name", "Brand", "RawCont",
	        "Source File", "Source Type", "Approval Status",
	        "Allocation Method", "Provisional Flag", "Fallback Flag", "Fallback Source Month"
	    }),

	    // ======================================================================
	    // PRIORITY MERGE: P1 overrides P2 for exact (ShipTo Key Ã— Brand Key Ã— MonthStart)
	    // Remove ShipTo rows whose group key is entirely covered by the Approved Patch
	    // ======================================================================
	    PatchKeyGroups = Table.Distinct(Table.SelectColumns(PatchFinal,
	        {"ShipTo Key", "Brand Key", "MonthStart"})),
	    ShipToNotOverridden = Table.Join(
	        ShipToFinal,  {"ShipTo Key", "Brand Key", "MonthStart"},
	        PatchKeyGroups, {"ShipTo Key", "Brand Key", "MonthStart"},
	        JoinKind.LeftAnti),
	    CombinedBase = Table.Combine({PatchFinal, ShipToNotOverridden}),

	    // ======================================================================
	    // P3: Jun'26 nearest-month fallback
	    // The ShipTo CSV ends May'26. For any (ShipTo Key Ã— Brand Key) with May'26 data
	    // but no Jun'26 data, copy May'26 rows to Jun'26 and mark as Provisional.
	    // These rows must be superseded by a Finance-approved DistCont patch for Jun'26.
	    // ======================================================================
	    May26Rows = Table.SelectRows(CombinedBase, each [MonthStart] = May26Start),
	    Jun26Rows = Table.SelectRows(CombinedBase, each [MonthStart] = Jun26Start),
	    // Keys already covered for Jun'26 (from Approved Patch, if any)
	    Jun26Keys = Table.Distinct(Table.SelectColumns(Jun26Rows, {"ShipTo Key", "Brand Key"})),
	    // May'26 rows whose ShipTo+Brand key has no Jun'26 coverage
	    May26ForFallback = Table.Join(
	        May26Rows,  {"ShipTo Key", "Brand Key"},
	        Jun26Keys,  {"ShipTo Key", "Brand Key"},
	        JoinKind.LeftAnti),
	    Jun26Fallback = Table.TransformColumns(May26ForFallback, {
	        {"MonthStart",        each Jun26Start,
	            type date},
	        {"Source File",       each "Primary_ShipTo_FY25-26_to_May26.csv (Jun'26 fallback from May'26)",
	            type text},
	        {"Source Type",       each "Nearest-Month Fallback",
	            type text},
	        {"Approval Status",   each "Provisional â€“ Jun'26 gap; awaiting Finance approval",
	            type text},
	        {"Allocation Method", each "Nearest-Month Fallback â€“ May'26 applied to Jun'26",
	            type text},
	        {"Provisional Flag",  each true,
	            type logical},
	        {"Fallback Flag",     each true,
	            type logical},
	        {"Fallback Source Month", each May26Start,
	            type date}
	    }),

	    // ======================================================================
	    // COMBINE all sources; normalise fractions per group
	    // ======================================================================
	    AllRows = Table.Combine({CombinedBase, Jun26Fallback}),

	    Grouped = Table.Group(AllRows, {"ShipTo Key", "Brand Key", "MonthStart"}, {
	        {"Raw Pct Sum", each List.Sum([RawCont]), type number},
	        {"Rows",        each _, type table}
	    }),
	    Expanded = Table.ExpandTableColumn(Grouped, "Rows", {
	        "Ship To Name", "Chain Name", "Brand", "RawCont",
	        "Source File", "Source Type", "Approval Status",
	        "Allocation Method", "Provisional Flag", "Fallback Flag", "Fallback Source Month"
	    }),
	    // Normalised fraction: sums to 1 per group by construction
	    AddFrac = Table.AddColumn(Expanded, "Frac",
	        each [RawCont] / [Raw Pct Sum], type number),

	    AddLoadTs = Table.AddColumn(AddFrac, "Load Timestamp", each LoadTs, type text),

	    Final = Table.SelectColumns(AddLoadTs, {
	        "ShipTo Key", "Brand Key", "MonthStart",
	        "Ship To Name", "Chain Name", "Brand",
	        "Frac", "Raw Pct Sum",
	        "Source File", "Source Type", "Approval Status",
	        "Allocation Method", "Provisional Flag", "Fallback Flag",
	        "Fallback Source Month", "Load Timestamp"
	    })
	in
	    Final
	```

expression qFact_PrimarySales = ```
	let
	    RawSource = fnCombineFolder(pRootFolder & "\RawDataFolders\Primary_Weekly"),

	    // enforce types on the standard columns
	    RequiredColumns = {"Week Start Date", "Month", "FY Year", "Quarter", "Chain", "Account", "Zone", "State", "City", "Store Code", "Store Name", "Brand", "Category", "Sub-category", "Range", "Pack Size", "Article Code", "Article Description", "EAN Code", "Primary NSV", "Primary Qty", "MRP Sales", "Data Source Name"},
	    Source = if Table.RowCount(RawSource) = 0 then #table(RequiredColumns & {"Data Source File", "Refresh Date"}, {}) else if List.Count(List.Difference(RequiredColumns, Table.ColumnNames(RawSource))) > 0 then error Error.Record("MissingRequiredColumns", "Source schema mismatch", List.Difference(RequiredColumns, Table.ColumnNames(RawSource))) else RawSource,
	    Typed = Table.TransformColumnTypes(Source, {
	        {"Week Start Date", type date},
	        {"Month", type text},
	        {"FY Year", type text},
	        {"Quarter", type text},
	        {"Chain", type text},
	        {"Account", type text},
	        {"Zone", type text},
	        {"State", type text},
	        {"City", type text},
	        {"Store Code", type text},
	        {"Store Name", type text},
	        {"Brand", type text},
	        {"Category", type text},
	        {"Sub-category", type text},
	        {"Range", type text},
	        {"Pack Size", type text},
	        {"Article Code", type text},
	        {"Article Description", type text},
	        {"EAN Code", type text},
	        {"Primary NSV", type number},
	        {"Primary Qty", type number},
	        {"MRP Sales", type number},
	        {"Data Source Name", type text}
	    }),

	    // trim text keys so joins to masters are clean
	    Trimmed = Table.TransformColumns(Typed, {
	        {"Store Code", each Text.Trim(Text.From(_)), type text},
	        {"Article Code", each Text.Trim(Text.From(_)), type text},
	        {"Chain", each Text.Trim(Text.From(_)), type text},
	        {"Brand", each Text.Trim(Text.From(_)), type text}
	    }),

	    // remove fully blank rows (no NSV and no Qty)
	    Cleaned = Table.SelectRows(Trimmed, each [Primary NSV] <> null or [Primary Qty] <> null),

	    // MonthStart = first day of the month, used to relate to the Date table at month grain
	    AddMonthStart = Table.AddColumn(Cleaned, "MonthStart",
	        each fnMonthStart([Week Start Date]), type date),
	    WithArticle = Table.AddColumn(AddMonthStart, "Article Key", each if Record.FieldOrDefault(_, "EAN Code", null) <> null and Text.Trim([EAN Code]) <> "" then "EAN:" & Text.Trim([EAN Code]) else if [Article Code] <> null and Text.Trim([Article Code]) <> "" then "CODE:" & Text.Trim([Article Code]) else if [Article Description] <> null then "DESC:" & Text.Upper(Text.Trim([Article Description])) else null, type text),
	    WithChain = Table.TransformColumns(WithArticle, {{"Chain", each if _ = null then null else Text.Trim(Text.From(_)), type text}}),
	    WithStore = Table.AddColumn(WithChain, "Store Key", each fnCompositeKey({[Chain], [Store Code]}), type text),
	    WithGeography = Table.AddColumn(WithStore, "Geography Key", each fnCompositeKey({[Zone], Record.FieldOrDefault(_, "State", null), Record.FieldOrDefault(_, "City", null)}), type text),
	    RelationshipKeys0 = Table.AddColumn(WithGeography, "Chain Key", each fnRelationshipKey([Chain]), type nullable text),
	    RelationshipKeys1 = Table.AddColumn(RelationshipKeys0, "Category Key", each fnRelationshipKey([Category]), type nullable text),
	    RelationshipKeys2 = Table.AddColumn(RelationshipKeys1, "Brand Key", each fnRelationshipKey([Brand]), type nullable text),
	    CanonicalKeys = Table.TransformColumns(RelationshipKeys2, {{"Article Key", each fnRelationshipKey(_), type nullable text}, {"Store Key", each fnRelationshipKey(_), type nullable text}, {"Geography Key", each fnRelationshipKey(_), type nullable text}}),
	    FinalModel = CanonicalKeys
	in
	    FinalModel
	```

expression qFact_OfftakeSales = ```
	let
	    // Workflow A: drop the splitter's month CSVs (clean header on row 0).
	    // (If instead you drop the RAW offtake workbook â€” blank first row â€” pass 1.)
	    Source = fnCombineFolder(pRootFolder & "\RawDataFolders\Offtake_Monthly", 0),

	    // keep the columns the model needs (renaming only where required to hit the
	    // canonical Fact Offtake Sales fields used by relationships & measures)
	    Picked = Table.SelectColumns(Source, {
	        "Month", "Year", "Revised Month",
	        "Chain Name", "Zone", "State", "City",
	        "Site Code", "Site Name", "Store Type", "DC Name",
	        "Brand", "Category", "Sub_category", "Range", "Net Weight",
	        "Article", "Article_1", "EAN",
	        "Description as per Fountain", "Chain Article Description",
	        "Sales Qty", "NSV", "MRP Sales Value", "MRP", "Margin",
	        "SO/ASE Emp Code", "SO/ASE Name", "PPT Category", "Data Source File", "Refresh Date"
	    }, MissingField.UseNull),

	    Renamed = Table.RenameColumns(Picked, {
	        {"Month", "Month"},
	        {"Year", "FY Year"},
	        {"Chain Name", "Chain"},
	        {"Zone", "Zone"},
	        {"State", "State"},
	        {"City", "City"},
	        {"Site Code", "Store Code"},
	        {"Site Name", "Store Name"},
	        {"Store Type", "Store Type"},
	        {"DC Name", "DC Name"},
	        {"Brand", "Brand"},
	        {"Category", "Category"},
	        {"Sub_category", "Sub-category"},
	        {"Range", "Range"},
	        {"Net Weight", "Pack Size"},
	        {"Article", "Article Code"},
	        {"Article_1", "Article Code Alt"},
	        {"EAN", "EAN Code"},
	        {"Description as per Fountain", "Article Description"},
	        {"Chain Article Description", "Chain Article Description"},
	        {"Sales Qty", "Offtake Qty"},
	        {"NSV", "Offtake NSV"},
	        {"MRP Sales Value", "MRP Sales"},
	        {"MRP", "MRP Rate"},
	        {"Margin", "Margin"},
	        {"SO/ASE Emp Code", "SO Emp Code"},
	        {"SO/ASE Name", "Sales Person"},
	        {"PPT Category", "PPT Category"}
	    }),

	    Typed = Table.TransformColumnTypes(Renamed, {
	        {"Month", type text}, {"FY Year", type text},
	        {"Chain", type text}, {"Zone", type text}, {"State", type text}, {"City", type text},
	        {"Store Code", type text}, {"Store Name", type text}, {"Store Type", type text}, {"DC Name", type text},
	        {"Brand", type text}, {"Category", type text}, {"Sub-category", type text},
	        {"Range", type text}, {"Pack Size", type text},
	        {"Article Code", type text}, {"Article Code Alt", type text}, {"EAN Code", type text},
	        {"Article Description", type text}, {"Chain Article Description", type text},
	        {"Offtake Qty", type number}, {"Offtake NSV", type number}, {"MRP Sales", type number},
	        {"MRP Rate", type number}, {"Margin", type number},
	        {"SO Emp Code", type text}, {"Sales Person", type text}, {"PPT Category", type text}
	    }),

	    Trimmed = Table.TransformColumns(Typed, {
	        {"Store Code", each Text.Trim(Text.From(_)), type text},
	        {"Article Code", each Text.Trim(Text.From(_)), type text},
	        {"EAN Code", each Text.Trim(Text.From(_)), type text},
	        {"Chain", each Text.Trim(Text.From(_)), type text},
	        {"Brand", each Text.Trim(Text.From(_)), type text}
	    }),

	    // brand spelling normalisation (keep in sync with Brand Master)
	    FixBrand = Table.ReplaceValue(Trimmed, "BBLUNT", "BBlunt", Replacer.ReplaceText, {"Brand"}),

	    // constant audit column
	    AddSource = Table.AddColumn(FixBrand, "Data Source Name", each "Chain Offtake Store Wise", type text),

	    // article key: EAN -> Article Code -> cleaned Description (matches File 2 side)
	    AddKey = Table.AddColumn(AddSource, "Article Key", each
	        if [EAN Code] <> null and Text.Trim([EAN Code]) <> "" then "EAN:" & Text.Trim([EAN Code])
	        else if [Article Code] <> null and Text.Trim([Article Code]) <> "" then "CODE:" & [Article Code]
	        else "DESC:" & Text.Upper(Text.Trim(Text.From([Article Description]))), type text),

	    // period = "Month" (April'24 / Apr'24 text or a date). "Revised Month" kept
	    // as an alternate period column if you later prefer the adjusted month.
	    AddMonthStart = Table.AddColumn(AddKey, "MonthStart", each fnMonthStart([Month]), type date),

	    Cleaned = Table.SelectRows(AddMonthStart, each [Offtake NSV] <> null or [Offtake Qty] <> null),
	    WithChain = Table.TransformColumns(Cleaned, {{"Chain", each if _ = null then null else Text.Trim(Text.From(_)), type text}}),
	    WithStore = Table.AddColumn(WithChain, "Store Key", each fnCompositeKey({[Chain], [Store Code]}), type text),
	    WithGeography = Table.AddColumn(WithStore, "Geography Key", each fnCompositeKey({[Zone], Record.FieldOrDefault(_, "State", null), Record.FieldOrDefault(_, "City", null)}), type text),
	    RelationshipKeys0 = Table.AddColumn(WithGeography, "Chain Key", each fnRelationshipKey([Chain]), type nullable text),
	    RelationshipKeys1 = Table.AddColumn(RelationshipKeys0, "Category Key", each fnRelationshipKey([Category]), type nullable text),
	    RelationshipKeys2 = Table.AddColumn(RelationshipKeys1, "Brand Key", each fnRelationshipKey([Brand]), type nullable text),
	    CanonicalKeys = Table.TransformColumns(RelationshipKeys2, {{"Article Key", each fnRelationshipKey(_), type nullable text}, {"Store Key", each fnRelationshipKey(_), type nullable text}, {"Geography Key", each fnRelationshipKey(_), type nullable text}}),
	    FinalModel = CanonicalKeys
	in
	    FinalModel
	```

expression qFact_Nielsen = ```
	let
	    RawSource = fnCombineFolder(pRootFolder & "\RawDataFolders\Nielsen_Monthly"),
	    RequiredColumns = {"Month", "FY Year", "Nielsen Category", "Brand", "Zone", "Market Value Sales", "Our Brand Sales", "Value Market Share %", "Volume Market Share %", "Data Source Name"},
	    Source = if Table.RowCount(RawSource) = 0 then #table(RequiredColumns & {"Data Source File", "Refresh Date"}, {}) else if List.Count(List.Difference(RequiredColumns, Table.ColumnNames(RawSource))) > 0 then error Error.Record("MissingRequiredColumns", "Source schema mismatch", List.Difference(RequiredColumns, Table.ColumnNames(RawSource))) else RawSource,
	    Typed = Table.TransformColumnTypes(Source, {
	        {"Month", type text},
	        {"FY Year", type text},
	        {"Nielsen Category", type text},
	        {"Brand", type text},
	        {"Zone", type text},
	        {"Market Value Sales", type number},
	        {"Our Brand Sales", type number},
	        {"Value Market Share %", type number},
	        {"Volume Market Share %", type number},
	        {"Data Source Name", type text}
	    }),
	    AddMonthStart = Table.AddColumn(Typed, "MonthStart", each fnMonthStart([Month]), type date),
	    WithGeography = Table.AddColumn(AddMonthStart, "Geography Key", each fnCompositeKey({[Zone], Record.FieldOrDefault(_, "State", null), Record.FieldOrDefault(_, "City", null)}), type text),
	    RelationshipKeys0 = Table.AddColumn(WithGeography, "Brand Key", each fnRelationshipKey([Brand]), type nullable text),
	    CanonicalKeys = Table.TransformColumns(RelationshipKeys0, {{"Geography Key", each fnRelationshipKey(_), type nullable text}}),
	    FinalModel = CanonicalKeys
	in
	    FinalModel
	```

expression qFact_TDP = ```
	let
	    RawSource = fnCombineFolder(pRootFolder & "\RawDataFolders\TDP_Monthly"),
	    RequiredColumns = {"Month", "FY Year", "Chain", "Zone", "State", "Brand", "Category", "Sub-category", "Pack Size", "Article Code", "Article Description", "ACV %", "AIC", "Numeric Distribution", "Weighted Distribution", "Data Source Name"},
	    Source = if Table.RowCount(RawSource) = 0 then #table(RequiredColumns & {"Data Source File", "Refresh Date"}, {}) else if List.Count(List.Difference(RequiredColumns, Table.ColumnNames(RawSource))) > 0 then error Error.Record("MissingRequiredColumns", "Source schema mismatch", List.Difference(RequiredColumns, Table.ColumnNames(RawSource))) else RawSource,
	    Typed = Table.TransformColumnTypes(Source, {
	        {"Month", type text},
	        {"FY Year", type text},
	        {"Chain", type text},
	        {"Zone", type text},
	        {"State", type text},
	        {"Brand", type text},
	        {"Category", type text},
	        {"Sub-category", type text},
	        {"Pack Size", type text},
	        {"Article Code", type text},
	        {"Article Description", type text},
	        {"ACV %", type number},
	        {"AIC", type number},
	        {"Numeric Distribution", type number},
	        {"Weighted Distribution", type number},
	        {"Data Source Name", type text}
	    }),
	    Trimmed = Table.TransformColumns(Typed, {
	        {"Article Code", each Text.Trim(Text.From(_)), type text},
	        {"Chain", each Text.Trim(Text.From(_)), type text},
	        {"Brand", each Text.Trim(Text.From(_)), type text}
	    }),
	    AddMonthStart = Table.AddColumn(Trimmed, "MonthStart", each fnMonthStart([Month]), type date),
	    WithArticle = Table.AddColumn(AddMonthStart, "Article Key", each if Record.FieldOrDefault(_, "EAN Code", null) <> null and Text.Trim([EAN Code]) <> "" then "EAN:" & Text.Trim([EAN Code]) else if [Article Code] <> null and Text.Trim([Article Code]) <> "" then "CODE:" & Text.Trim([Article Code]) else if [Article Description] <> null then "DESC:" & Text.Upper(Text.Trim([Article Description])) else null, type text),
	    WithChain = Table.TransformColumns(WithArticle, {{"Chain", each if _ = null then null else Text.Trim(Text.From(_)), type text}}),
	    WithGeography = Table.AddColumn(WithChain, "Geography Key", each fnCompositeKey({[Zone], Record.FieldOrDefault(_, "State", null), Record.FieldOrDefault(_, "City", null)}), type text),
	    RelationshipKeys0 = Table.AddColumn(WithGeography, "Chain Key", each fnRelationshipKey([Chain]), type nullable text),
	    RelationshipKeys1 = Table.AddColumn(RelationshipKeys0, "Category Key", each fnRelationshipKey([Category]), type nullable text),
	    RelationshipKeys2 = Table.AddColumn(RelationshipKeys1, "Brand Key", each fnRelationshipKey([Brand]), type nullable text),
	    CanonicalKeys = Table.TransformColumns(RelationshipKeys2, {{"Article Key", each fnRelationshipKey(_), type nullable text}, {"Geography Key", each fnRelationshipKey(_), type nullable text}}),
	    FinalModel = CanonicalKeys
	in
	    FinalModel
	```

expression qFact_PrimaryArticle = ```
	let
	    Source = fnCombineFolder(pRootFolder & "\RawDataFolders\Primary_Article_Monthly"),

	    // normalise headers: collapse the embedded line break in
	    // "Chain name(lf)for Dashboard" and squeeze doubled spaces
	    FixedNames = Table.TransformColumnNames(Source, each
	        Text.Trim(Text.Replace(Text.Replace(Text.Replace(_, "#(lf)", " "), "#(cr)", " "), "  ", " "))),

	    Picked = Table.SelectColumns(FixedNames, {
	        "FY", "Month", "Channel", "Inv. Date", "Cust-SAP Code", "Ship To Name",
	        "EAN No.", "net_content", "brand", "PPT Category",
	        "category", "sub_category", "range", "Description", "MRP",
	        "Inv Qty", "Inv. Net value(LOC)", "Inv. Tax Amount(LOC)", "Total MRP sales", "Avg Tot",
	        "MTD-Sale type", "PO Type", "Chain name for Dashboard", "Zone", "State", "Data Source File", "Refresh Date", "Source Record ID"
	    }, MissingField.UseNull),

	    Renamed = Table.RenameColumns(Picked, {
	        {"FY", "FY Year"},
	        {"Cust-SAP Code", "Customer Code"},
	        {"EAN No.", "EAN Code"},
	        {"Description", "Article Description"},
	        {"brand", "Brand"},
	        {"PPT Category", "PPT Category"},
	        {"category", "Category"},
	        {"sub_category", "Sub-category"},
	        {"range", "Range"},
	        {"MRP", "Article MRP"},
	        {"Inv Qty", "Primary Qty"},
	        {"Inv. Net value(LOC)", "Primary NSV"},
	        {"Inv. Tax Amount(LOC)", "Primary Tax Amount"},
	        {"Total MRP sales", "Primary MRP"},
	        {"Avg Tot", "Avg TOT"},
	        {"Chain name for Dashboard", "Chain Dash"}
	    }),

	    Typed = Table.TransformColumnTypes(Renamed, {
	        {"FY Year", type text}, {"Month", type text}, {"Channel", type text},
	        {"Customer Code", type text}, {"Ship To Name", type text},
	        {"EAN Code", type text}, {"net_content", type text}, {"Brand", type text},
	        {"PPT Category", type text}, {"Category", type text}, {"Sub-category", type text},
	        {"Range", type text}, {"Article Description", type text},
	        {"Article MRP", type number}, {"Primary Qty", type number},
	        {"Primary NSV", type number}, {"Primary Tax Amount", type number},
	        {"Primary MRP", type number}, {"Avg TOT", type number},
	        {"MTD-Sale type", type text}, {"PO Type", type text},
	        {"Chain Dash", type text}, {"Zone", type text}, {"State", type text}
	    }),

	    // MonthStart from "April'24"/"Apr'24" text, a date value, or an Excel serial
	    AddMonthStart = Table.AddColumn(Typed, "MonthStart", each fnMonthStart([Month]), type date),

	    Cleaned = Table.SelectRows(AddMonthStart, each [Primary NSV] <> null or [Primary Qty] <> null),

	    // ---------- DIST -> Chain allocation ----------
	    AddIsDist = Table.AddColumn(Cleaned, "Is Dist", each
	        Text.Lower(Text.Trim(Text.From([PO Type] ?? ""))) = "dist."
	        or Text.Lower(Text.Trim(Text.From([PO Type] ?? ""))) = "dist", type logical),

	    DirectRows = Table.SelectRows(AddIsDist, each not [Is Dist]),
	    DirectFinal = Table.AddColumn(DirectRows, "Chain", each [Chain Dash], type text),

	    DistRows = Table.SelectRows(AddIsDist, each [Is Dist]),
	    DistKeys1 = Table.AddColumn(DistRows, "ShipTo Key", each Text.Lower(Text.Trim([Ship To Name] ?? "")), type text),
	    DistKeys2 = Table.AddColumn(DistKeys1, "Brand Key", each Text.Lower(Text.Trim([Brand] ?? "")), type text),
	    Merged = Table.NestedJoin(DistKeys2, {"ShipTo Key", "Brand Key", "MonthStart"},
	        #"Dist Cont Weights", {"ShipTo Key", "Brand Key", "MonthStart"},
	        "W", JoinKind.LeftOuter),
	    ExpandedW = Table.ExpandTableColumn(Merged, "W",
	        {"Chain Name", "Frac", "Source Type", "Approval Status", "Provisional Flag"}),
	    // scale measures by cont% (unmatched rows keep Frac=1 and go to "Unmapped Chain")
	    FillFrac      = Table.ReplaceValue(ExpandedW, null, 1,       Replacer.ReplaceValue, {"Frac"}),
	    FillSrcType   = Table.ReplaceValue(FillFrac,  null, "Unmapped (no ShipTo data)",
	                        Replacer.ReplaceValue, {"Source Type"}),
	    FillApproval  = Table.ReplaceValue(FillSrcType, null, "Unmapped",
	                        Replacer.ReplaceValue, {"Approval Status"}),
	    FillProv      = Table.ReplaceValue(FillApproval, null, false, Replacer.ReplaceValue, {"Provisional Flag"}),
	    Alloc1 = Table.AddColumn(FillProv, "Primary Qty Alloc", each if [Primary Qty] = null then null else [Primary Qty] * [Frac], type number),
	    Alloc2 = Table.AddColumn(Alloc1, "Primary NSV Alloc", each if [Primary NSV] = null then null else [Primary NSV] * [Frac], type number),
	    Alloc3 = Table.AddColumn(Alloc2, "Primary MRP Alloc", each if [Primary MRP] = null then null else [Primary MRP] * [Frac], type number),
	    Alloc4 = Table.AddColumn(Alloc3, "Primary Tax Alloc", each
	        if [Primary Tax Amount] = null then null else [Primary Tax Amount] * [Frac], type number),
	    DistChain = Table.AddColumn(Alloc4, "Chain", each
	        if [Chain Name] <> null then [Chain Name] else "Unmapped Chain", type text),
	    // Allocation Status: readable label for the QC page and DAX measures
	    DistAllocStatus = Table.AddColumn(DistChain, "Allocation Status", each
	        if [Chain Name] = null        then "Unmapped"
	        else if [Provisional Flag]    then "Provisional"
	        else "Allocated", type text),
	    DistSwap = Table.RemoveColumns(
	        Table.RenameColumns(
	            Table.RemoveColumns(DistAllocStatus, {"Primary Qty", "Primary NSV", "Primary MRP", "Primary Tax Amount"}),
	            {{"Primary Qty Alloc", "Primary Qty"}, {"Primary NSV Alloc", "Primary NSV"},
	             {"Primary MRP Alloc", "Primary MRP"}, {"Primary Tax Alloc", "Primary Tax Amount"}}),
	        {"ShipTo Key", "Brand Key", "Chain Name", "Frac", "Approval Status"}),

	    // Add matching governance columns to Direct rows (no allocation applied)
	    DirectWithGov = Table.AddColumn(
	        Table.AddColumn(
	          Table.AddColumn(DirectFinal,
	            "Source Type", each null, type text),
	          "Provisional Flag", each false, type logical),
	        "Allocation Status", each "Direct", type text),

	    Combined = Table.Combine({Table.RemoveColumns(DirectWithGov, {"Is Dist"}),
	                              Table.RemoveColumns(DistSwap, {"Is Dist"})}),

	    // article key: EAN -> cleaned Description (the current format has no Article Code)
	    KeyReady = Table.TransformColumns(Combined, {{"EAN Code", each if _ = null then null else Text.Trim(_), type text}}),
	    AddKey = Table.AddColumn(KeyReady, "Article Key", each
	        if [EAN Code] <> null and Text.Trim([EAN Code]) <> "" then "EAN:" & Text.Trim([EAN Code])
	        else "DESC:" & Text.Upper(Text.Trim(Text.From([Article Description]))), type text),

	    // brand spelling normalisation (keep in sync with Brand Master)
	    FixBrand = Table.ReplaceValue(AddKey, "BBLUNT", "BBlunt", Replacer.ReplaceText, {"Brand"}),
	    WithChain = Table.TransformColumns(FixBrand, {{"Chain", each if _ = null then null else Text.Trim(Text.From(_)), type text}}),
	    WithGeography = Table.AddColumn(WithChain, "Geography Key", each fnCompositeKey({[Zone], Record.FieldOrDefault(_, "State", null), Record.FieldOrDefault(_, "City", null)}), type text),
	    RelationshipKeys0 = Table.AddColumn(WithGeography, "Chain Key", each fnRelationshipKey([Chain]), type nullable text),
	    RelationshipKeys1 = Table.AddColumn(RelationshipKeys0, "Category Key", each fnRelationshipKey([Category]), type nullable text),
	    RelationshipKeys2 = Table.AddColumn(RelationshipKeys1, "Brand Key", each fnRelationshipKey([Brand]), type nullable text),
	    CanonicalKeys = Table.TransformColumns(RelationshipKeys2, {{"Article Key", each fnRelationshipKey(_), type nullable text}, {"Geography Key", each fnRelationshipKey(_), type nullable text}}),
	    FinalModel = CanonicalKeys
	in
	    FinalModel
	```

expression qFact_SecondarySales = ```
	let
	    RequiredColumns = {"Source_Month", "Month_Label", "FY_Year", "Distributor",
	                       "NSV_Lakh", "Data_Source", "Notes"},

	    // â”€â”€ Distributor register files only (name filter before parsing) â”€
	    Files = Folder.Files(pRootFolder & "\RawDataFolders\SecondarySales_Monthly"),
	    DistributorFiles = Table.SelectRows(Files, each
	        Text.StartsWith(Text.Lower([Name]), "secondary_sales_distributor_")
	        and Text.Lower([Extension]) = ".csv"),

	    Parsed = Table.AddColumn(DistributorFiles, "Data", each
	        let
	            t = Table.PromoteHeaders(
	                    Csv.Document([Content], [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
	                    [PromoteAllScalars=true]),
	            // a renamed/missing header fails the refresh instead of loading nulls
	            cols = Table.SelectColumns(t, RequiredColumns, MissingField.Error)
	        in
	            Table.AddColumn(cols, "Data Source File", (r) => [Name], type text)),

	    Source =
	        if Table.RowCount(Parsed) = 0 then
	            #table(RequiredColumns & {"Data Source File"}, {})
	        else
	            Table.Combine(Parsed[Data]),

	    // â”€â”€ Type coercions â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	    Typed = Table.TransformColumnTypes(Source, {
	        {"Source_Month",  type text},
	        {"Month_Label",   type text},
	        {"FY_Year",       type text},
	        {"Distributor",   type text},
	        {"NSV_Lakh",      type number},
	        {"Data_Source",   type text},
	        {"Notes",         type text}
	    }),

	    // â”€â”€ Derive date fields from YYYY-MM â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	    KeyGroups = Table.Group(Typed, {"Source_Month", "Distributor"}, {{"SourceRows", each Table.RowCount(_), Int64.Type}}),
	    Guarded = if List.AnyTrue(List.Transform(KeyGroups[SourceRows], each _ > 1)) then error Error.Record("DuplicateSecondaryKey", "Month/distributor register overlap; refresh blocked", null) else Typed,
	    WithMonth = Table.AddColumn(Guarded, "MonthStart", each
	        fnMonthStart([Source_Month] & "-01"),
	        type date),

	    WithFY = Table.AddColumn(WithMonth, "FY_Derived", each
	        let m = Date.Month([MonthStart])
	        in if m >= 4 then "FY" & Text.From(Date.Year([MonthStart]) + 1)
	                     else "FY" & Text.From(Date.Year([MonthStart])),
	        type text),

	    // â”€â”€ Provisional flag â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	    WithProvisional = Table.AddColumn(WithFY, "Is_Provisional", each
	        Text.Contains(Text.Lower([Notes] ?? ""), "provisional") or Text.Contains(Text.Upper([Notes] ?? ""), "GST"),
	        type logical),

	    // â”€â”€ NSV in Crore (for cross-table consistency) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	    WithCr = Table.AddColumn(WithProvisional, "NSV_Cr", each
	        [NSV_Lakh] / 100, type number),

	    // â”€â”€ Remove helper columns not needed in the model â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
	    Final = Table.SelectColumns(WithCr, {
	        "Source_Month", "Month_Label", "MonthStart",
	        "FY_Year", "FY_Derived",
	        "Distributor", "NSV_Lakh", "NSV_Cr",
	        "Is_Provisional", "Data_Source", "Data Source File"
	    }),
	    FinalModel = Final
	in
	    FinalModel
	```
