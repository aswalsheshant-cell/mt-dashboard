model Model
	culture: en-IN
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

	annotation __PBI_TimeIntelligenceEnabled = 0

	annotation PBIDesktopVersion = 2.138.1452.0

	annotation PBI_QueryOrder = ["Dim_Date","Dim_Chain","Dim_Category","Fact_Financials","_Measures"]

ref table _Measures
ref table Dim_Date
ref table Dim_Chain
ref table Dim_Category
ref table Fact_Financials

ref table Fact_CM2
ref table Dim_CM2Month
ref expression RepoRoot
