{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Store Compliance & Inventory Schema",
  "description": "Defines compliance audit data, PES scores, and inventory fill-rate metrics for dashboard",
  "type": "object",
  "properties": {
    "compliance": {
      "type": "object",
      "description": "Store audit scorecard and Promo Execution Score (PES) calculations",
      "properties": {
        "metadata": {
          "type": "object",
          "properties": {
            "audit_date": { "type": "string", "format": "date" },
            "total_doors_audited": { "type": "integer", "minimum": 0 },
            "macro_pes_percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "coverage": { "type": "string", "description": "FY coverage (e.g., 'FY25-FY26')" }
          },
          "required": ["audit_date", "total_doors_audited", "macro_pes_percent"]
        },
        "accounts": {
          "type": "array",
          "description": "Account-level aggregates (DMart, Reliance Retail, Apollo, etc.)",
          "items": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string" },
              "account_name": { "type": "string" },
              "doors_audited": { "type": "integer", "minimum": 0 },
              "account_pes_percent": { "type": "number", "minimum": 0, "maximum": 100 },
              "weighted_doors": { "type": "number" },
              "price_compliance": { "type": "number", "minimum": 0, "maximum": 100 },
              "fsdu_compliance": { "type": "number", "minimum": 0, "maximum": 100 },
              "osa_compliance": { "type": "number", "minimum": 0, "maximum": 100 }
            },
            "required": ["account_id", "account_name", "doors_audited", "account_pes_percent"]
          }
        },
        "doors": {
          "type": "array",
          "description": "Door-level audit detail with pass/fail flags",
          "items": {
            "type": "object",
            "properties": {
              "door_id": { "type": "string" },
              "door_name": { "type": "string" },
              "account_id": { "type": "string" },
              "audit_date": { "type": "string", "format": "date" },
              "price_flag": { "type": "boolean", "description": "Price audit passed (true=pass)" },
              "fsdu_flag": { "type": "boolean", "description": "FSDU audit passed" },
              "osa_flag": { "type": "boolean", "description": "OSA audit passed" },
              "pes_percent": { "type": "number", "minimum": 0, "maximum": 100 },
              "notes": { "type": "string" }
            },
            "required": ["door_id", "door_name", "account_id", "pes_percent"]
          }
        }
      },
      "required": ["metadata", "accounts", "doors"]
    },
    "inventory_fillrate": {
      "type": "object",
      "description": "Supply chain fill-rate metrics: CFR, OTIF, lost revenue",
      "properties": {
        "metadata": {
          "type": "object",
          "properties": {
            "period": { "type": "string", "description": "Reporting period (e.g., 'FY26')" },
            "macro_cfr_percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "macro_otif_percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "total_lost_revenue_lakh": { "type": "number", "minimum": 0 }
          },
          "required": ["period", "macro_cfr_percent", "macro_otif_percent"]
        },
        "accounts": {
          "type": "array",
          "description": "Account-level fill-rate and lost revenue",
          "items": {
            "type": "object",
            "properties": {
              "account_id": { "type": "string" },
              "account_name": { "type": "string" },
              "cfr_percent": { "type": "number", "minimum": 0, "maximum": 100 },
              "otif_percent": { "type": "number", "minimum": 0, "maximum": 100 },
              "lost_revenue_lakh": { "type": "number", "minimum": 0 }
            },
            "required": ["account_id", "account_name", "cfr_percent", "otif_percent"]
          }
        }
      },
      "required": ["metadata", "accounts"]
    }
  },
  "required": ["compliance", "inventory_fillrate"]
}
